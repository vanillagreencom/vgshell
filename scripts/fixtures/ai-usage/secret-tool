#!/usr/bin/env node
"use strict";
const fs = require("node:fs");
const path = require("node:path");
const args = process.argv.slice(2);
const home = process.env.HOME || ".";
fs.appendFileSync(path.join(home, "secret-tool-calls"), JSON.stringify(args) + "\n");
if (args.length < 5 || args[0] !== "search" || args.length % 2 !== 1) process.exit(2);
const attrs = {};
for (let i = 1; i < args.length; i += 2) attrs[args[i]] = args[i + 1];
const service = attrs.service;
const lookup = service === "copilot-cli" && attrs.username !== undefined ? attrs.username
    : service === "vgs-ai-usage" && attrs.account !== undefined ? service + ":" + attrs.account : "";
if (lookup === "") process.exit(2);
const modeFile = path.join(home, "secret-tool-mode");
const mode = fs.existsSync(modeFile) ? fs.readFileSync(modeFile, "utf8").trim() : "ok";
if (mode === "missing") process.exit(0);
if (mode === "locked") {
    process.stdout.write("[/org/freedesktop/secrets/collection/login/1]\nlabel = Secret\n");
    process.stderr.write("secret-tool: locked\n");
    process.exit(0);
}
if (mode === "failed") process.exit(1);
// A keyring that never answers: the stand-in records its pid for the
// suite and holds, ending by itself after a minute so a failed run leaves
// nothing behind for long.
if (mode === "hold") {
    fs.writeFileSync(path.join(home, "secret-tool-pid"), process.pid + "\n");
    setTimeout(() => process.exit(1), 60000);
    return;
}
const mapFile = path.join(home, "secret-tool-map.json");
const map = fs.existsSync(mapFile) ? JSON.parse(fs.readFileSync(mapFile, "utf8")) : {};
const secret = map[lookup];
if (secret === undefined) process.exit(0);
process.stdout.write("[/org/freedesktop/secrets/collection/login/1]\nlabel = Secret\nsecret = " + secret + "\n");
