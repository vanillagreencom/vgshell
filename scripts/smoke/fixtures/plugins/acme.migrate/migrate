#!/usr/bin/env python3
"""Own only the planted units below this test home's migration-fixture root."""
import json
import os
from pathlib import Path
import select
import sys

assert os.environ.get("VGS_TEST_RUN") == "1"
assert sys.argv[1:] == ["disabled"]
snapshot = Path(__file__).resolve().parent
manifest = json.loads((snapshot / "manifest.json").read_text())
plugin = manifest["id"]
root = Path(os.environ["HOME"]) / ".local/state/vgshell/migration-fixture"
assert root.is_dir()
with (root / "attempts").open("a") as stream:
    stream.write(json.dumps({"id": plugin, "snapshot": str(snapshot)}) + "\n")
print("migration-private-output", flush=True)
print("migration-private-output", file=sys.stderr, flush=True)
if plugin.endswith("b-fail"):
    # The row opens this FIFO only after rescan and snapshot-retention checks.
    # The bound also ends the stand-in if the row cannot release it.
    descriptor = os.open(root / "release", os.O_RDWR | os.O_NONBLOCK)
    try:
        assert select.select([descriptor], [], [], 30)[0], "release not received"
        os.read(descriptor, 1)
    finally:
        os.close(descriptor)
    sys.exit(7)
if plugin.endswith("c-timeout"):
    # A disposable core copy shortens only this attempt's deadline.
    select.select([], [], [], 30)
    sys.exit(8)
if plugin.endswith("d-clean"):
    for suffix in ("service", "timer"):
        (root / ("old-sync." + suffix)).unlink()
    (root / "cleaned").write_text(plugin)
