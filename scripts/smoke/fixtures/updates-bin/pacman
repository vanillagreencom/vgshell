#!/usr/bin/env bash
# Stand-in pacman for rows/updates.sh: package detection needs the binary
# on PATH, and the check runs checkupdates for the system's updates. The
# verified-file source's check asks `-Q -- <name>` for each package it
# takes, none of which this system has; pacman 7.1.0 answers a missing
# package with an error line and exit 1 (`pacman -Q no-such-pkg`, host
# cachy, 2026-11-02), which the source reads as not in use.
if [[ ${1:-} == -Q ]]; then
  shift
  [[ ${1:-} != -- ]] || shift
  for name; do printf "error: package '%s' was not found\n" "$name" >&2; done
  exit 1
fi
exit 0
