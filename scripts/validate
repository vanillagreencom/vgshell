# The branch point, printed on stdout: the merge base of COMMIT, HEAD by
# default, with the remote-tracking copy of the project's base branch, WORKTREE_DEFAULT_BRANCH
# from the environment or from kendex.settings.toml (read by the kendex
# settings loader, so the file has one reader). Exactly one remote may carry
# that branch; none or several is missing, never a guess, so no ref that
# merely contains HEAD is taken for its base. On failure it prints what is
# missing as key=value and returns 1.
branch_point() { # [COMMIT]
  local commit="${1:-HEAD}" branch="${WORKTREE_DEFAULT_BRANCH:-}" loader="$repo/.agents/skills/orch/scripts/lib/kendex-env.sh" ref refs=()
  if [[ -z $branch && -f $repo/kendex.settings.toml ]]; then
    # shellcheck source=/dev/null
    branch="$(source "$loader" && kendex_load_settings_file "$repo/kendex.settings.toml" && printf '%s' "${WORKTREE_DEFAULT_BRANCH:-}")" || branch=""
  fi
  if [[ -z $branch ]]; then
    echo "missing=base-branch source=WORKTREE_DEFAULT_BRANCH"
    return 1
  fi
  while IFS= read -r ref; do
    [[ $ref =~ ^refs/remotes/[^/]+/(.*)$ && ${BASH_REMATCH[1]} == "$branch" ]] && refs+=("$ref")
  done < <(git for-each-ref --format='%(refname)' refs/remotes/)
  if [[ ${#refs[@]} -ne 1 ]]; then
    echo "missing=base-ref branch=$branch remote-refs=${#refs[@]}"
    return 1
  fi
  if ! git merge-base "$commit" "${refs[0]}"; then
    echo "missing=merge-base ref=${refs[0]}"
    return 1
  fi
}

# The commit the whitespace row compares against, printed on stdout, and the
# default change base: VGS_VALIDATE_BASE when set, else the branch point. On
# failure it prints what is missing as key=value and returns 1.
whitespace_base() {
  if [[ -n ${VGS_VALIDATE_BASE:-} ]]; then
    if ! git rev-parse --verify --quiet "${VGS_VALIDATE_BASE}^{commit}"; then
      echo "missing=commit VGS_VALIDATE_BASE=$VGS_VALIDATE_BASE"
      return 1
    fi
    return 0
  fi
  branch_point
}

# Whitespace errors the tree adds over the base: tracked files against the
# base commit, and every untracked file whole, since a new file has no base.
# Names are read NUL-delimited, so a name git would quote reaches git as the
# file's own name. git diff --check exits 2 for findings; with --no-index it
# exits 1 for a clean difference and 3 for findings. Any other status, or a
# clean status with output, is a read error and fails the row with git's
# message. First lines:
#   whitespace: base=<commit>
#   whitespace: findings scope=tracked | scope=untracked path=<file>
#   whitespace: unreadable scope=tracked status=<n> | scope=untracked path=<file> status=<n>
#   whitespace: failed base=<commit>
#   whitespace: status=not-measured reason=no-base <missing key=value>
whitespace_check() {
  local base file out file_status status=0
  if ! base="$(whitespace_base)"; then
    echo "whitespace: status=not-measured reason=no-base ${base##*$'\n'}"
    echo "set VGS_VALIDATE_BASE to the commit to compare against"
    return 77
  fi
  echo "whitespace: base=$base"
  file_status=0
  out="$(git diff --check "$base" -- 2>&1)" || file_status=$?
  case "$file_status" in
    0) ;;
    2) echo "whitespace: findings scope=tracked"; printf '%s\n' "$out"; status=1 ;;
    *) echo "whitespace: unreadable scope=tracked status=$file_status"; printf '%s\n' "$out"; status=1 ;;
  esac
  while IFS= read -r -d '' file; do
    file_status=0
    out="$(git diff --no-index --check -- /dev/null "$file" 2>&1)" || file_status=$?
    case "$file_status" in
      0|1) [[ -z $out ]] && continue
           echo "whitespace: unreadable scope=untracked path=$file status=$file_status" ;;
      3) echo "whitespace: findings scope=untracked path=$file" ;;
      *) echo "whitespace: unreadable scope=untracked path=$file status=$file_status" ;;
    esac
    printf '%s\n' "$out"
    status=1
  done < <(git ls-files -z --others --exclude-standard)
  [[ $status -eq 0 ]] || echo "whitespace: failed base=$base"
  return "$status"
}

# A scratch copy of the index holding the tree the change will commit, for a
# checker that reads index blobs: every tracked and untracked, non-ignored
# file matching PATHSPEC... is added as the worktree holds it, a deleted
# tracked file removed. A tracked file under an ignored directory is added
# with --force; the list names no ignored untracked file. The real index is
# never written. Prints the scratch path, which the caller removes; on
# failure prints the real index path, or `unresolved`, and returns 1.
scratch_index() { # PATHSPEC...
  local index scratch
  index="$(git rev-parse --path-format=absolute --git-path index)" || index=""
  if [[ -z $index ]] || ! scratch="$(scratch_file)"; then
    echo "${index:-unresolved}"
    return 1
  fi
  # With no index yet, git starts the scratch index empty.
  [[ -e $index ]] || rm -f -- "$scratch"
  if { [[ -e $index ]] && ! cp -- "$index" "$scratch"; } ||
     ! git ls-files -z --cached --others --exclude-standard -- "$@" |
       GIT_INDEX_FILE="$scratch" GIT_LITERAL_PATHSPECS=1 git add -A --force --pathspec-from-file=- --pathspec-file-nul; then
    rm -f -- "$scratch" "$scratch.lock"
    echo "$index"
    return 1
  fi
  echo "$scratch"
}

# The document byte ceilings of the doc-limits skill, measured on the tree
# the change will commit: doc-limits reads tracked documents and their index
# blobs, so it runs on a scratch_index of every Markdown file and docs HTML
# file. The checker judges sizes alone and reads no base. A load-point
# document over its ceiling fails the row with the checker's
# notice=document-over-limit; any other document over its ceiling passes
# with notice=document-over-budget. doc-limits exit 2, the check could not
# judge, fails the row. First lines, beside doc-limits' own output:
#   doc-limits: failed status=<n>
#   doc-limits: status=not-measured reason=checker-missing path=<file>
#   doc-limits: status=not-measured reason=index-copy-failed path=<file>
doc_limits_check() {
  local checker=".agents/skills/doc-limits/scripts/doc-limits" scratch status=0
  if [[ ! -x $checker ]]; then
    echo "doc-limits: status=not-measured reason=checker-missing path=$checker"
    return 77
  fi
  if ! scratch="$(scratch_index ':(glob)**/*.md' ':(glob)docs/**/*.html')"; then
    echo "doc-limits: status=not-measured reason=index-copy-failed path=$scratch"
    return 77
  fi
  GIT_INDEX_FILE="$scratch" "$checker" || status=$?
  rm -f -- "$scratch"
  case "$status" in
    0|1) ;;
    *) echo "doc-limits: failed status=$status"; status=1 ;;
  esac
  return "$status"
}

# The links, section routes, decision references and source citations the
# commit-guards md-refs lane judges, on the tree the change will commit.
# md-refs reads callers and targets from the index, so it runs --all on a
# scratch_index of every file. Any tracked file can carry a citation or be
# the target of one, and a removed heading breaks callers the change never
# touched, so this is a repository check and runs on every change. md-refs
# exit 2, a configuration or collection error, fails the row. First lines,
# then md-refs' own output:
#   md-refs: failed status=<n>
#   md-refs: status=not-measured reason=checker-missing path=<file>
#   md-refs: status=not-measured reason=index-copy-failed path=<file>
md_refs_check() {
  local checker=".agents/skills/commit-guards/scripts/md-refs" scratch status=0
  if [[ ! -x $checker ]]; then
    echo "md-refs: status=not-measured reason=checker-missing path=$checker"
    return 77
  fi
  if ! scratch="$(scratch_index)"; then
    echo "md-refs: status=not-measured reason=index-copy-failed path=$scratch"
    return 77
  fi
  GIT_INDEX_FILE="$scratch" "$checker" --all || status=$?
  rm -f -- "$scratch"
  case "$status" in
    0|1) ;;
    *) echo "md-refs: failed status=$status"; status=1 ;;
  esac
  return "$status"
}

# Every scripts/test-* file is named by a row, so a check cannot exist
# without running here.
rows_cover_tests() {
  local row file command word words=" " missing=() split=()
  # Every whole word of every row's command, space-delimited, so a test
  # file's path matches only a word equal to it, never a longer name that
  # starts with it.
  for row in "${rows[@]}"; do
    command="${row#*|}"
    command="${command#*|}"
    command="${command%%|*}"
    read -r -a split <<<"$command"
    for word in "${split[@]}"; do words+="$word "; done
  done
  for file in scripts/test-*; do
    [[ -e $file ]] || continue
    [[ $words == *" $file "* ]] || missing+=("$file")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'validate: refused: test-without-row=%s\n' "$(IFS=,; echo "${missing[*]}")"
    return 1
  fi
  echo "validate: every test file has a row"
}

# An install ships bin, shell, config, themes and VERSION, so no file under
# bin/ or shell/ may load one under scripts/. A load is spelled in code as a
# quoted "scripts" path component, as path.join and os.path.join take it, or
# as a scripts path segment after an expansion or a relative climb:
# $root/scripts/, ${repo}/scripts/, $(...)/scripts/, ../scripts/, and a QML
# import of "../../scripts". A bare scripts/<name>, the way a comment names a
# test, is not matched, and neither is markdown. Tracked and untracked files
# are read. git grep exits 1 both for no match and after a file it could not
# open, so anything on its stderr is a read error too. First lines, the
# refusal followed by each matching line as git grep prints it:
#   validate: refused: runtime-reads-scripts=<matching line count>
#   validate: unreadable: runtime-reads-scripts status=<n>
runtime_reads_no_scripts() {
  local pattern='(["'\'']scripts["'\'']|(\$[A-Za-z_][A-Za-z0-9_]*|[}).])/scripts([/"'\'']|$))'
  local out err err_file status=0 lines=()
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -I -E --untracked -e "$pattern" -- bin shell ':(exclude)*.md' 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: runtime-reads-scripts status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: runtime-reads-scripts=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: the runtime loads nothing under scripts/"
}

# VGS writes monitor rules only through shell/Core/MonitorLogic.js, the
# renderer that judges the rule fields first. No other file an install ships
# from bin/, shell/ or config/ holds an `hl.monitor` call, spelled
# `hl.monitor` then an opening parenthesis with any blanks between them: the
# call itself, or the text a second renderer would write into a Hyprland
# config or hand `hyprctl eval`. Prose that names `hl.monitor` with no
# parenthesis is not matched, and neither is text assembled from parts, such
# as "hl." + "monitor(", which stays open. The nested test compositor's own
# configuration under scripts/smoke/ is no shipped file and is not read.
# Tracked and untracked files are read, binary files skipped. The files are
# the tree's own, listed by git under each root. A root that lists no file
# means the listing is broken, not that the root is clean, so it is refused.
# git grep exits 1 both for no match and after a file it could not open, so
# anything on its stderr is a read error too. First lines, the refusal
# followed by each matching line as git grep prints it:
#   validate: refused: monitor-rule-writer=<matching line count>
#   validate: unreadable: monitor-rule-writer status=<n>
#   validate: unreadable: monitor-rule-writer root=<root> files=0
runtime_writes_monitor_rule_once() {
  local pattern='hl\.monitor[[:space:]]*\('
  local roots=(bin shell config) root listed total=0
  local out err err_file status=0 lines=()
  for root in "${roots[@]}"; do
    if ! listed="$(git ls-files --cached --others --exclude-standard -- "$root")"; then
      echo "validate: unreadable: monitor-rule-writer status=list-failed root=$root"
      return 1
    fi
    if [[ -z $listed ]]; then
      echo "validate: unreadable: monitor-rule-writer root=$root files=0"
      return 1
    fi
    mapfile -t lines <<<"$listed"
    total=$((total + ${#lines[@]}))
  done
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -I -E --untracked -e "$pattern" -- "${roots[@]}" ':(exclude)shell/Core/MonitorLogic.js' 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: monitor-rule-writer status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: monitor-rule-writer=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: monitor rule renderer is unique files=$total"
}

# No file in the tree holds a PEM private-key armor line: PRIVATE KEY with
# or without a key type such as RSA, EC or OPENSSH, and the PGP PRIVATE KEY
# BLOCK, anywhere along a line. The tree is every tracked and untracked,
# non-ignored file as it stands on disk; the index and the commits in history
# are not read. A private key has no exemption: a test that needs a key
# generates it at run time. Certificates and public keys pass. The pattern's
# own spelling below is not a header line, so this file passes. git grep exits
# 1 both for no match and after a file it could not open, so anything on its
# stderr is a read error too. First lines, the refusal followed by one
# path:line:header per match, the header alone, so a key held on one line,
# such as a JSON string, never prints its body:
#   validate: refused: private-key=<match count>
#   validate: unreadable: private-key status=<n>
private_keys_check() {
  local pattern='-----BEGIN ([[:upper:][:digit:]]+ )*PRIVATE KEY( BLOCK)?-----'
  local out err err_file status=0 lines=()
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -o -I -E --untracked -e "$pattern" -- . 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: private-key status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: private-key=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: no private key in the tree"
}

# A pattern index NAME: the input patterns of a set of members, each
# matched against a path once. A pattern with no wildcard is a key of
# NAME_literal, PATTERN -> members; each wildcard pattern is in NAME_globs
# once, with its members in NAME_glob_members. index_add files a member
# under a pattern; index_match sets index_hits to the members, space-led
# and space-delimited, whose patterns match a path. The rows table's index
# and the nested smoke rows' index are both of this kind.
#
# A member filed with `loads` is a row that starts the shell: a nested
# smoke row or a qml row of the table. Its wildcard patterns stand for what
# that shell loads, and the shell loads no Markdown under shell/ but the
# Jarvis skill layers its daemon reads, the only such Markdown
# packaging/install-system.sh installs. Such a pattern matches a Markdown
# file under shell/ only when it ends in .md itself, so a row whose shell
# reads one names it; those members are in NAME_load_members. A literal
# pattern matches its one path for every member.
index_add() { # NAME PATTERN MEMBER [loads]
  local -n index_add_literal="$1_literal" index_add_members="$1_glob_members" index_add_loads="$1_load_members" index_add_globs="$1_globs"
  case "$2" in
    # [[ == ]] reads ( as an extended pattern, so it is no literal.
    *[\*\?\[\\\(]*)
      [[ -n ${index_add_members[$2]+set} || -n ${index_add_loads[$2]+set} ]] || index_add_globs+=("$2")
      if [[ ${4-} == loads && $2 != *.md ]]; then index_add_loads[$2]+=" $3"; else index_add_members[$2]+=" $3"; fi ;;
    *) index_add_literal[$2]+=" $3" ;;
  esac
}
index_match() { # NAME PATH
  local -n index_match_literal="$1_literal" index_match_members="$1_glob_members" index_match_loads="$1_load_members" index_match_globs="$1_globs"
  local glob
  index_hits="${index_match_literal[$2]-}"
  for glob in "${index_match_globs[@]}"; do
    [[ $2 == $glob ]] || continue
    index_hits+="${index_match_members[$glob]-}"
    [[ $2 == shell/*.md ]] || index_hits+="${index_match_loads[$glob]-}"
  done
}

# What smoke_rows_read last read, which selection and the row records
# share: the rows; each row's input globs, smoke_row_lines, and, for a row
# whose reach can be traced, smoke_row_globs; the rows each row reads; the
# harness inputs; the tracked files; the pattern index smoke_index of each
# row's file and globs; the files that load each file, smoke_loaded_by,
# and the rows each loader's path matches, smoke_load_hit; smoke_read_fault;
# and smoke_path_reach's answers.
smoke_names=() smoke_harness_inputs=() smoke_tracked=() smoke_index_globs=() smoke_read_fault=unread
declare -A smoke_row_lines=() smoke_row_globs=() smoke_row_reads=() smoke_path_hit=()
declare -A smoke_loaded_by=() smoke_load_hit=()
declare -A smoke_index_literal=() smoke_index_glob_members=() smoke_index_load_members=()

# The reader of a row's input line and the core rows, smoke_core, both of
# which scripts/qml-smoke.sh shares.
source scripts/smoke/row-inputs.sh

# smoke_input_read KEY FILE: read FILE's input line into smoke_globs
# through smoke_inputs_read and return 0. A line that is missing, repeated
# or empty, or a file that cannot be read, prints its self-check line keyed
# KEY and returns 1. Each glob that matches no file of smoke_tracked,
# matched as the smoke index matches a `loads` member (index_add), prints
# its self-check line and sets
# smoke_glob_unmatched; the caller's hits caches the answer per glob.
smoke_input_read() { # KEY FILE
  local key="$1" file="$2" glob path
  smoke_glob_unmatched=false
  if ! smoke_inputs_read "$file"; then
    case "$smoke_inputs_fault" in
      unreadable) printf 'validate: smoke-input %s unreadable path=%s\n' "$key" "$file" >&2; return 1 ;;
      missing) printf 'validate: smoke-input %s missing; add to the leading comment block of %s: # inputs: GLOB [GLOB...]\n' "$key" "$file" >&2; return 1 ;;
      lines=*) printf 'validate: smoke-input %s %s; keep one line in %s: # inputs: GLOB [GLOB...]\n' "$key" "$smoke_inputs_fault" "$file" >&2; return 1 ;;
      empty) printf 'validate: smoke-input %s empty; fix the line in %s: # inputs: GLOB [GLOB...]\n' "$key" "$file" >&2; return 1 ;;
    esac
  fi
  for glob in "${smoke_globs[@]}"; do
    if [[ -z ${hits[$glob]-} ]]; then
      hits[$glob]=none
      for path in "${smoke_tracked[@]}"; do
        [[ $path != shell/*.md || $glob == *.md ]] || continue
        if [[ $path == $glob ]]; then hits[$glob]=some; break; fi
      done
    fi
    if [[ ${hits[$glob]} == none ]]; then
      printf 'validate: smoke-input %s glob=%s matches-nothing; fix the line in %s: %s\n' "$key" "$glob" "$file" "$smoke_inputs_line" >&2
      smoke_glob_unmatched=true
    fi
  done
}

# smoke_reads_check ROW...: print a self-check line for each function a
# listed row calls, or variable it reads, that neither it nor the harness
# defines but another listed row does, when the row's input line names
# none of the row files that define it: under --rows or a diff-scoped run
# the row then fails whenever the defining row is not selected. The
# definitions are those of the row files, scripts/qml-smoke.sh,
# scripts/smoke/harness.sh and the libraries it sources; a row file a row
# runs through smoke_row and no name lists counts as that row's own. Each
# row file sourced by those parts must also appear on the caller's input line. A
# file the scan cannot read to its end, a quote, heredoc or substitution
# left open, prints its own line, and its names count nowhere. Reads
# smoke_row_lines and smoke_row_reads from smoke_rows_read.
smoke_reads_check() { # ROW...
  local facts fact row kind name definers definer named reach_mode=false
  [[ ${1:-} != --reach ]] || reach_mode=true
  smoke_function_reach=""
  if ! facts="$(python3 -I -B - "$@" <<'PY'
import pathlib, re, subprocess, sys

sys.path.insert(0, str(pathlib.Path("scripts").resolve()))
from shell_source import NAME, Scan, head, SOURCE

def calls(scan, runs):
    """The words SCAN runs as commands: each command's first word and, while
    that word is a runner, the word at its command operand, as
    expect LABEL WANT CMD... runs CMD."""
    found = set()
    for words in scan.commands:
        at = head(words)
        while at < len(words):
            name = words[at][1]
            if name:
                found.add(name)
            if name not in runs:
                break
            at += runs[name] + 1
    return found



def read(rel):
    try:
        return pathlib.Path(rel).read_text()
    except (OSError, UnicodeDecodeError):
        return None


def row_parts(row, scans, listed):
    parts, queue = [], [f"scripts/smoke/rows/{row}.sh"]
    while queue:
        rel = queue.pop(0)
        if rel in scans and scans[rel] not in parts:
            parts.append(scans[rel])
            queue += [f"scripts/smoke/rows/{child}.sh" for child in scans[rel].rows if child not in listed]
    return parts


args = sys.argv[1:]
reach = args[:1] == ["--reach"]
if reach:
    base, changed, *listed = args[1:]
else:
    listed = args
texts, side, queue = {}, [], ["scripts/qml-smoke.sh", "scripts/smoke/harness.sh"]
while queue:
    rel = queue.pop(0)
    if rel not in texts:
        texts[rel] = read(rel)
        side.append(rel)
        queue += SOURCE.findall(texts[rel] or "")
for path in sorted(pathlib.Path("scripts/smoke/rows").glob("*.sh")):
    texts.setdefault(str(path), read(path))


def function_reach():
    """Conservative word reach over the existing shell reading, not a row map.

    Both hunk sides must fit function bodies. Tokens include quoted strings
    and heredocs, so callbacks and generated helpers count too. A top-level
    use reaches every row; missing evidence never proves an empty reach.
    Git's zero-context ranges: https://git-scm.com/docs/diff-format.
    """
    try:
        old = subprocess.check_output(["git", "show", f"{base}:{changed}"], text=True)
        new = pathlib.Path(changed).read_text()
        diff = subprocess.check_output(["git", "diff", "--no-ext-diff", "--no-color",
                                        "--no-textconv", "-U0", base, "--", changed], text=True)
        before, after = Scan(old), Scan(new)
        if before.broken or after.broken or before.partition_broken or after.partition_broken:
            return None

        def lines(text, scan):
            result = []
            for name, start, end in scan.spans:
                # A line shared with top-level code cannot be attributed to
                # the function alone, even though Git reports one line.
                lo, hi = text.rfind("\n", 0, start) + 1, text.find("\n", end)
                hi = len(text) if hi < 0 else hi
                if text[lo:start].strip() or text[end:hi].strip():
                    continue
                result.append((name, text.count("\n", 0, start) + 1,
                               text.count("\n", 0, end) + 1))
            return result

        spans = (lines(old, before), lines(new, after))
        seeds, hunks = set(), 0
        for line in diff.splitlines():
            if not line.startswith("@@"):
                continue
            match = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", line)
            if not match:
                return None
            hunks += 1
            a, ac, b, bc = match.groups()
            for start, count, ranges in ((int(a), int(ac or 1), spans[0]),
                                         (int(b), int(bc or 1), spans[1])):
                # An insertion/deletion also reads the seam on its empty side.
                end = start + count - 1 if count else start + 1
                names = {name for name, lo, hi in ranges if lo <= start and end <= hi}
                if len(names) != 1:
                    return None
                seeds |= names
        if not hunks:
            return None
        # A renamed/removed definition can still have old callers.
        texts[changed] = new
        if changed not in side:
            side.append(changed)
        scans = {}
        for path, text in texts.items():
            if text is not None:
                scan = Scan(text)
                if not scan.broken:
                    scans[path] = scan
            if path in side and path not in scans:
                return None
        scans[changed + ":before"] = before
        side.append(changed + ":before")

        def words(scan, lo, hi):
            return set().union(*(set(NAME.findall(word)) for start, end, word in scan.words
                                 if lo <= start and end <= hi))

        functions, top = {}, {}
        for path, scan in scans.items():
            if scan.partition_broken:
                # An unchanged helper we cannot partition is opaque: any
                # reference to a reached name may be top-level, so it reaches
                # every row. Do not lose that reference with partial spans.
                top[path] = words(scan, 0, scan.n)
                continue
            for name, start, end in scan.spans:
                functions.setdefault(name, set()).update(words(scan, start, end))
            top[path] = set().union(*(set(NAME.findall(word)) for start, end, word in scan.words
                                     if not any(lo <= start and end <= hi for _, lo, hi in scan.spans)))
        reached = set(seeds)
        while True:
            callers = {name for name, used in functions.items() if used & reached}
            if callers <= reached:
                break
            reached |= callers
        if any(top[path] & reached for path in side):
            return None
        found, traced = set(), False
        for row in listed:
            path = f"scripts/smoke/rows/{row}.sh"
            scan = scans.get(path)
            # Unreadable rows always run. All words in a row count, including
            # helpers it invokes later and an unlisted part it sources.
            if any(words(part, 0, part.n) & reached for part in row_parts(row, scans, listed)):
                traced = True
                found.add(row)
            elif scan is None:
                found.add(row)
        # No named caller is not proof of no caller: a computed dispatch can
        # hide its name. Keep the full-area answer in that case.
        return found if traced else None
    except (OSError, UnicodeError, subprocess.CalledProcessError):
        return None


if reach:
    found = function_reach()
    if found is None:
        print("harness")
    else:
        for row in sorted(found):
            print("reach", row)
    sys.exit()
scans = {}
for rel, text in texts.items():
    if text is None or (scan := Scan(text)).broken:
        print("unparsed", rel)
    else:
        scans[rel] = scan
runs = {}
for scan in scans.values():
    runs.update(scan.runners)
for scan in scans.values():
    scan.calls = calls(scan, runs)
side_owned = {field: set().union(*(scans[rel].__dict__[field] for rel in side if rel in scans)) for field in ("funcs", "sets")}
owned = {}
for row in listed:
    parts = row_parts(row, scans, listed)
    owned[row] = {field: set().union(*(s.__dict__[field] for s in parts)) for field in ("funcs", "sets", "calls", "reads")}
    for source in sorted(set().union(*(s.sources for s in parts))):
        print("read", row, "source", source, source)
for row in listed:
    for kind, used, field in (("function", "calls", "funcs"), ("variable", "reads", "sets")):
        for name in sorted(owned[row][used] - owned[row][field] - side_owned[field]):
            definers = [other for other in listed if other != row and name in owned[other][field]]
            if definers:
                print("read", row, kind, name, ",".join(definers))
PY
)"; then
    if [[ $reach_mode == true ]]; then smoke_function_reach=harness; return 0; fi
    echo 'validate: smoke-input reads=unreadable; the function and variable check did not run' >&2; return 0
  fi
  while read -r fact row kind name definers; do
    case "$fact" in
      '') continue ;;
      harness) smoke_function_reach=harness; return 0 ;;
      reach) smoke_function_reach+=" $row"; continue ;;
      unparsed) printf 'validate: smoke-input unparsed path=%s; the function and variable check cannot read it to its end\n' "$row" >&2; continue ;;
      read) ;;
      *) printf 'validate: smoke-input reads=unreadable fact=%q\n' "$fact" >&2; return 0 ;;
    esac
    named=false
    for definer in ${definers//,/ }; do
      if [[ $kind == source ]]; then
        [[ " ${smoke_row_lines[$row]-} " == *" scripts/smoke/rows/$definer.sh "* ]] || continue
      else
        [[ " ${smoke_row_reads[$row]-} " == *" $definer "* ]] || continue
      fi
      named=true
    done
    [[ $named == false ]] || continue
    printf 'validate: smoke-input row=%s %s=%s from=scripts/smoke/rows/%s.sh; add to the line in scripts/smoke/rows/%s.sh: # inputs: %s scripts/smoke/rows/%s.sh\n' \
      "$row" "$kind" "$name" "${definers//,/.sh,scripts/smoke/rows/}" "$row" "${smoke_row_lines[$row]-}" "${definers%%,*}" >&2
  done <<<"$facts"
  if [[ $reach_mode == true ]]; then
    # A row reaches every helper of the rows whose state it consumes too.
    local -A reached=() closure=()
    local member
    for row in $smoke_function_reach; do reached[$row]=1; done
    for row in "${smoke_names[@]}"; do
      closure=([$row]=1)
      smoke_close closure
      for member in "${!closure[@]}"; do
        [[ -z ${reached[$member]-} ]] || { smoke_function_reach+=" $row"; break; }
      done
    done
  fi
}

# smoke_loads_read: read into smoke_loaded_by, PATH -> the files that load
# it, space-led, the static loads of every .qml and .js file under shell/
# and scripts/smoke/, the row fixtures among them: a type the file names
# as a word of its comment-free text that its own directory holds as a
# .qml file or exports through its qmldir, or that a directory it imports
# does, as `qs.<Dir>` for shell/<Dir> or by a relative path; each qmldir
# that resolution consults, of its own directory and each it imports; and
# a file it imports by a relative path, with `import` or `.import`. A word
# in a string counts too: a match too wide adds a row and never skips one.
# It reads the files on disk, so a removed file has no loaders here, and
# smoke_path_reach does not trace one. A load chosen by a value computed at
# run time, such as a Loader source built in code, is not read; the row's
# input line names it. Optional BASE JS_PATH narrows only that file's explicit import edges to
# namespaces that observe its changed functions or local callers, in
# smoke_observed; an unknown hunk or namespace use retains whole-file reach.
# The reading cannot read sets smoke_read_fault to `qml-loads-unreadable
# path=<path>`, and a reading that fails sets it to `qml-loads-failed`,
# with the failed operation and its cause.
smoke_loads_read() { # [BASE JS_PATH]
  local out fact loader loaded status
  smoke_observed=whole
  # -B: the reading writes no bytecode into the tree it reads.
  if out="$(python3 -I -B - "$@" 2>&1 <<'PY'
import os, re, shlex, subprocess, sys

sys.path.insert(0, "scripts")
from qml_controls import qmldir_exports
from qml_source import Unreadable, blank_comments, source_texts

# A file imports its own directory's types, each .qml file whose name
# starts with an uppercase letter, and `import qs[.<Dir>...]` names a
# directory under the shell root, shell/: Implicit imports and Manual
# imports, https://quickshell.org/docs/v0.3.1/guide/qml-language.
IMPORT = re.compile(r'^[ \t]*\.?import[ \t]+(?:"([^"\n]*)"|(qs(?:\.\w+)*)\b)(?:[ \t]+[\d.]+)?(?:[ \t]+as[ \t]+(\w+))?', re.M)
WORD = re.compile(r"[A-Za-z_]\w*")

def changed_functions(base, path, new):
    """Attribute only complete, line-isolated named JS function hunks.

    This is word reach, not a JavaScript execution model. The existing
    literal masker holds brace offsets; an unknown hunk keeps file reach.
    Both sides include an insertion/deletion seam (git diff-format).
    """
    def partition(text):
        shape = blank_comments(text, literals=False)
        stack, ends = [], {}
        for at, ch in enumerate(shape):
            if ch == "{":
                stack.append(at)
            elif ch == "}":
                if not stack:
                    return None
                ends[stack.pop()] = at + 1
        if stack:
            return None
        spans = []
        for match in re.finditer(r"^function[ \t]+(\w+)[ \t]*\([^{}\n]*\)[ \t]*\{", shape, re.M):
            end = ends[match.end() - 1]
            tail = shape[end:shape.find("\n", end)] if "\n" in shape[end:] else shape[end:]
            if tail.strip():
                continue
            spans.append((match.group(1), match.start(), end))
        return spans

    try:
        # An added application file has no old functions. Only a successful
        # tree reading proves that absence; a failed Git read proves nothing.
        operation = "git-ls-tree"
        if not subprocess.check_output(["git", "ls-tree", "--name-only", base, "--", path],
                                       text=True, stderr=subprocess.PIPE):
            return None
        operation = "git-show"
        old = blank_comments(subprocess.check_output(["git", "show", f"{base}:{path}"],
                                                     text=True, stderr=subprocess.PIPE))
        operation = "git-diff"
        diff = subprocess.check_output(["git", "diff", "--no-ext-diff", "--no-color",
                                       "--no-textconv", "-U0", base, "--", path],
                                       text=True, stderr=subprocess.PIPE)
    except (OSError, UnicodeError, subprocess.CalledProcessError) as exc:
        cause = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
        status = f"status={exc.returncode}" if isinstance(exc, subprocess.CalledProcessError) else f"kind={type(exc).__name__}"
        print("failed", f"operation={operation}", f"path={shlex.quote(path)}", status,
              f"cause={shlex.quote(cause)}")
        return None
    sides = [(text, partition(text)) for text in (old, new)]
    if any(spans is None for _, spans in sides):
        return None
    reached, hunks = set(), 0
    for line in diff.splitlines():
        if not line.startswith("@@"):
            continue
        match = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", line)
        if not match:
            return None
        hunks += 1
        a, ac, b, bc = match.groups()
        for (text, spans), start, count in zip(sides, (int(a), int(b)), (int(ac or 1), int(bc or 1))):
            end = start + count - 1 if count else start + 1
            names = {name for name, lo, hi in spans
                     if text.count("\n", 0, lo) + 1 <= start and end <= text.count("\n", 0, hi) + 1}
            if len(names) != 1:
                return None
            reached |= names
    if not hunks:
        return None
    functions, top = {}, set()
    for text, spans in sides:
        remainder = list(text)
        for name, lo, hi in spans:
            functions.setdefault(name, set()).update(WORD.findall(text[lo:hi]))
            remainder[lo:hi] = " " * (hi - lo)
        top.update(WORD.findall("".join(remainder)))
    while True:
        callers = {name for name, words in functions.items() if words & reached}
        if callers <= reached:
            break
        reached |= callers
    return None if top & reached else reached

try:
    code = {}
    for root in ("shell", "scripts/smoke"):
        for path, text in source_texts(root):
            code[os.path.normpath(path)] = blank_comments(text)
    if len(sys.argv) == 3:
        base, changed = sys.argv[1:]
        reached = changed_functions(base, changed, code[changed])
        if reached is not None:
            print("local")
            for path, text in code.items():
                explicit = False
                for relative, module, alias in IMPORT.findall(text):
                    if module or os.path.normpath(os.path.join(os.path.dirname(path), relative)) != changed:
                        continue
                    explicit = True
                    # A namespace handed off or indexed by data can observe
                    # any member. Named references include callbacks and
                    # strings used to generate QML, not only calls.
                    uses = IMPORT.sub("", text)
                    members, unknown = set(), not alias
                    if alias:
                        for use in re.finditer(r"\b" + re.escape(alias) + r"\b", uses):
                            member = re.match(r"\s*\.\s*(\w+)", uses[use.end():])
                            if member:
                                members.add(member.group(1))
                            else:
                                unknown = True
                    if unknown or members & reached:
                        print("observe", path)
                # A qmldir export or another non-namespace load has no
                # member observation here, so it retains its file edge.
                if not explicit:
                    print("observe", path)
        sys.exit()
    files = {}
    for path in code:
        folder, name = os.path.split(path)
        if name.endswith(".qml") and name[:1].isupper():
            files.setdefault(folder, {}).setdefault(name[:-4], set()).add(path)
    tables = {}

    # The types a file that sees FOLDER may name, and the qmldir their
    # resolution consults: a changed or removed export changes what the
    # file loads, so the file loads the qmldir too.
    def named(folder):
        if folder not in tables:
            table = {name: set(paths) for name, paths in files.get(folder, {}).items()}
            consulted = set()
            qmldir = os.path.join(folder, "qmldir")
            if os.path.isfile(qmldir):
                consulted.add(qmldir)
                for name, path in qmldir_exports("", folder, every=True):
                    table.setdefault(name, set()).add(os.path.normpath(path))
            tables[folder] = table, consulted
        return tables[folder]

    for path, text in code.items():
        here = os.path.dirname(path)
        # Stateless/importing JS resources inherit no QML imports, so a
        # diagnostic naming their QML sibling is no implicit type load:
        # https://doc.qt.io/qt-6/qtqml-javascript-imports.html
        # (Imports Within JavaScript Resources).
        isolated_js = path.endswith(".js") and re.search(r"^\s*\.(?:pragma\s+library|import)\b", text, re.M)
        seen, loads = ([] if isolated_js else [named(here)]), set()
        aliases = set()
        for relative, module, alias in IMPORT.findall(text):
            target = os.path.join("shell", *module.split(".")[1:]) if module else os.path.normpath(os.path.join(here, relative))
            if alias:
                aliases.add(alias)
            if os.path.isdir(target):
                seen.append(named(target))
            elif not module:
                loads.add(target)
        # A JS namespace is not the same-named QML type in this directory.
        # Import filenames and namespace declarations are not type uses:
        # https://quickshell.org/docs/v0.3.1/guide/qml-language (Manual imports).
        words = set(WORD.findall(IMPORT.sub("", text))) - aliases
        for table, consulted in seen:
            loads |= consulted
            for name in words.intersection(table):
                loads |= table[name]
        loads.discard(path)
        for target in sorted(loads):
            print("load", path, target)
except Unreadable as exc:
    print("unreadable", f"path={shlex.quote(exc.path)}", f"cause={shlex.quote(exc.strerror)}")
except OSError as exc:
    print("unreadable", f"path={shlex.quote(str(exc.filename))}", f"cause={shlex.quote(str(exc))}")
except KeyError as exc:
    print("failed operation=source-read", f"path={shlex.quote(changed)}", f"cause={shlex.quote(str(exc))}")
PY
)"; then :
  else
    status=$?
    printf -v smoke_read_fault 'qml-loads-failed operation=python status=%s cause=%q' "$status" "$out"; return 0
  fi
  while read -r fact loader loaded; do
    case "$fact" in
      '') ;;
      local) smoke_observed="" ;;
      observe) smoke_observed+=" $loader" ;;
      load) smoke_loaded_by[$loaded]+=" $loader" ;;
      unreadable|failed) smoke_read_fault="qml-loads-$fact $loader${loaded:+ $loaded}"; return 0 ;;
      *) printf -v smoke_read_fault 'qml-loads-failed operation=read-facts cause=%q' "$fact $loader $loaded"; return 0 ;;
    esac
  done <<<"$out"
}

# smoke_rows_read: read what every nested smoke row's reach rests on into
# the smoke_* globals above. `scripts/qml-smoke.sh --list-rows` names the
# rows. Each row's file, scripts/smoke/rows/<row>.sh, carries an input line
# smoke_input_read reads; its globs and the file itself are its inputs,
# filed in the pattern index smoke_index. A row whose line cannot be read
# or holds a glob that matches no tracked file has no smoke_row_globs
# entry: its reach cannot be traced. A row reads the rows whose file its
# line names exactly, their functions or state, and fails without them:
# smoke_row_reads. scripts/smoke/harness.sh carries an input line too,
# naming what the harness and the libraries it sources read for every row.
# The harness inputs are scripts/qml-smoke.sh, which holds the latency
# budgets and the commands the sandbox hides, scripts/smoke/row-inputs.sh,
# which holds the core rows and reads the rows a row brings, harness.sh
# and the paths its line matches; a harness glob that matches nothing only
# reports. smoke_read_fault names a row list, core row, tracked-file list
# or harness line this cannot read, after which no reach is traced, or a
# shell file smoke_loads_read cannot read. The
# self-check lines smoke_input_read prints never change the exit status.
smoke_rows_read() {
  local listed row file needed glob smoke_glob_unmatched smoke_inputs_line smoke_inputs_fault
  local -a smoke_globs smoke_inputs_named
  local -A hits=()
  smoke_names=() smoke_harness_inputs=() smoke_tracked=() smoke_read_fault=""
  smoke_row_lines=() smoke_row_globs=() smoke_row_reads=() smoke_path_hit=()
  smoke_loaded_by=() smoke_load_hit=()
  smoke_index_literal=() smoke_index_glob_members=() smoke_index_load_members=() smoke_index_globs=()
  if ! listed="$(scripts/qml-smoke.sh --list-rows)" || [[ -z $listed ]]; then
    smoke_read_fault=row-list-unreadable; return 0
  fi
  mapfile -t smoke_names <<<"$listed"
  for row in "${smoke_core[@]}"; do
    if [[ " ${smoke_names[*]} " != *" $row "* ]]; then smoke_read_fault="core-row-missing row=$row"; return 0; fi
  done
  if ! mapfile -d '' -t smoke_tracked < <(git ls-files -z) || ! wait "$!" || [[ ${#smoke_tracked[@]} -eq 0 ]]; then
    smoke_read_fault=tracked-list-unreadable; return 0
  fi
  if smoke_input_read harness=scripts/smoke/harness.sh scripts/smoke/harness.sh; then
    smoke_harness_inputs=(scripts/qml-smoke.sh scripts/smoke/row-inputs.sh scripts/smoke/harness.sh "${smoke_globs[@]}")
  else
    smoke_read_fault=harness-line-unreadable
  fi
  for row in "${smoke_names[@]}"; do
    file="scripts/smoke/rows/$row.sh"
    if smoke_input_read "row=$row" "$file" && [[ $smoke_glob_unmatched == false ]]; then
      smoke_row_globs[$row]="${smoke_globs[*]}"
    fi
    smoke_row_lines[$row]="${smoke_globs[*]}"
    smoke_inputs_rows "$row"
    smoke_row_reads[$row]=""
    for needed in "${smoke_inputs_named[@]}"; do
      [[ " ${smoke_names[*]} " != *" $needed "* ]] || smoke_row_reads[$row]+=" $needed"
    done
    for glob in "$file" "${smoke_globs[@]}"; do index_add smoke_index "$glob" "$row" loads; done
  done
  [[ -n $smoke_read_fault ]] || smoke_loads_read
}

# smoke_path_reach BASE PATH: set smoke_reach to what a change to PATH
# against BASE reaches among the rows smoke_rows_read last read: `harness`
# for global or unreadable harness reach; `untraced reason=<reason>`
# for another reach that cannot be read; or else the rows, space-led,
# reached by an attributable harness hunk or whose file or input glob
# matches PATH or a file that loads PATH, directly or through
# other files, as smoke_loads_read read them. scripts/smoke/rows.list,
# which holds the row order, is no harness input: a change to it reaches
# the rows its added lines name, read from the diff against BASE, so a
# moved row runs and a comment reaches nothing, and each row whose line
# names the file of a row
# its removed lines unlist, since that row reads state the unlisted row no
# longer leaves. A list git does not track, a diff this cannot read or an
# added line no listed row holds cannot be traced, nor can a .qml, .js or
# qmldir file under shell/ or scripts/smoke/ that the tree no longer holds,
# whose former loaders the load reading cannot see. Selection and the smoke
# rows' records read this one answer, cached per BASE and PATH.
smoke_path_reach() { # BASE PATH
  local key="$1 $2" glob diff line sign hunk=false row needed
  local -a unlisted=()
  if [[ $smoke_read_fault == qml-load* ]]; then smoke_reach="untraced reason=$smoke_read_fault"; return 0; fi
  if [[ -n ${smoke_path_hit[$key]+set} ]]; then smoke_reach="${smoke_path_hit[$key]}"; return 0; fi
  smoke_reach=""
  for glob in "${smoke_harness_inputs[@]}"; do
    if [[ $2 == $glob ]]; then
      smoke_reads_check --reach "$1" "$2" "${smoke_names[@]}"
      smoke_reach="$smoke_function_reach"
      break
    fi
  done
  if [[ -z $smoke_reach && $2 == scripts/smoke/rows.list ]]; then
    if [[ " ${smoke_tracked[*]} " != *" $2 "* ]]; then
      printf -v smoke_reach 'untraced reason=rows-list-untracked path=%q' "$2"
    elif ! diff="$(git diff -U0 --no-color --no-ext-diff "$1" -- "$2")"; then
      printf -v smoke_reach 'untraced reason=rows-list-diff-unreadable path=%q' "$2"
    else
      while IFS= read -r line; do
        if [[ $line == @@* ]]; then hunk=true; continue; fi
        [[ $hunk == true && ( $line == +* || $line == -* ) ]] || continue
        sign="${line:0:1}"; line="${line:1}"
        [[ -z $line || $line == '#'* ]] && continue
        if [[ $sign == - ]]; then
          [[ " ${smoke_names[*]} " == *" $line "* ]] || unlisted+=("$line")
        elif [[ " ${smoke_names[*]} " != *" $line "* ]]; then
          printf -v smoke_reach 'untraced reason=rows-list-unlisted-line value=%q' "$line"; break
        else
          smoke_reach+=" $line"
        fi
      done <<<"$diff"
      if [[ $smoke_reach != untraced* ]]; then
        for needed in "${unlisted[@]}"; do
          for row in "${smoke_names[@]}"; do
            [[ " ${smoke_row_lines[$row]-} " != *" scripts/smoke/rows/$needed.sh "* ]] || smoke_reach+=" $row"
          done
        done
      fi
    fi
  fi
  if [[ -z $smoke_reach && ( $2 == shell/* || $2 == scripts/smoke/* ) && ( $2 == *.qml || $2 == *.js || ${2##*/} == qmldir ) && ! -f $2 ]]; then
    printf -v smoke_reach 'untraced reason=qml-load-target-absent path=%q' "$2"
  fi
  if [[ $smoke_reach != harness && $smoke_reach != untraced* ]]; then
    index_match smoke_index "$2"
    smoke_reach+="$index_hits"
    smoke_load_reach "$2" "$1"
  fi
  # Refinement reads after the initial index. Failed evidence cannot publish
  # scoped reach, or let a later consumer reuse an earlier cached answer.
  if [[ $smoke_read_fault == qml-load* ]]; then smoke_reach="untraced reason=$smoke_read_fault"; return 0; fi
  smoke_path_hit[$key]="$smoke_reach"
}

# smoke_load_reach PATH: add to smoke_reach each row, once, whose file or
# input glob matches a file that loads PATH, directly or through other
# files, as smoke_loads_read last read them; smoke_load_hit caches each
# loader's matching rows.
smoke_load_reach() { # PATH BASE
  local at=0 loader row smoke_observed=whole
  local -a queue=("$1") loaders
  local -A seen=([$1]=1) added=()
  # Explicit row inputs still observe the whole file. Only the import
  # edges of an attributable JS hunk narrow; after an observing importer
  # ordinary file reach remains conservative.
  if [[ $1 == shell/*.js && -f $1 ]]; then smoke_loads_read "$2" "$1"; fi
  for row in $smoke_reach; do added[$row]=1; done
  while ((at < ${#queue[@]})); do
    read -r -a loaders <<<"${smoke_loaded_by[${queue[at]}]-}"
    at=$((at + 1))
    for loader in "${loaders[@]}"; do
      if [[ ${queue[at-1]} == "$1" && $smoke_observed != whole && " $smoke_observed " != *" $loader "* ]]; then continue; fi
      [[ -z ${seen[$loader]-} ]] || continue
      seen[$loader]=1
      queue+=("$loader")
      if [[ -z ${smoke_load_hit[$loader]+set} ]]; then
        index_match smoke_index "$loader"
        smoke_load_hit[$loader]="$index_hits"
      fi
      for row in ${smoke_load_hit[$loader]}; do
        [[ -z ${added[$row]-} ]] || continue
        added[$row]=1
        smoke_reach+=" $row"
      done
    done
  done
}

# The nested smoke rows a diff-scoped run passes to scripts/qml-smoke.sh as
# --rows, set in smoke_only comma-joined, or empty for every row. A row
# runs when a changed path reaches it (smoke_path_reach against the change
# base), when it is a core row, when its reach cannot be traced, or when a
# running row reads it. Global or unreadable harness reach runs every row, as
# does one whose reach, or a row list, core row, tracked-file list,
# harness line or shell file the load reading reads, cannot be read. No
# time figure removes a reached row: docs/architecture/validation.md §
# Selection.
smoke_rows_selected() { # CHANGED_PATH...
  local row path every=""
  local -A want=()
  smoke_only=""
  smoke_rows_read
  case "$smoke_read_fault" in
    row-list-unreadable|core-row-missing*|tracked-list-unreadable)
      printf 'validate: smoke-rows=all reason=%s\n' "$smoke_read_fault" >&2; return 0 ;;
    ?*) every="reason=$smoke_read_fault" ;;
  esac
  for row in "${smoke_core[@]}"; do want[$row]=1; done
  for row in "${smoke_names[@]}"; do
    [[ -n ${smoke_row_globs[$row]+set} ]] || want[$row]=1
  done
  for path in "$@"; do
    [[ -z $every ]] || break
    smoke_path_reach "$change_base" "$path"
    case "$smoke_reach" in
      harness) printf -v every 'reason=harness-input path=%q' "$path" ;;
      untraced\ *) every="${smoke_reach#untraced }" ;;
      *) for row in $smoke_reach; do want[$row]=1; done ;;
    esac
  done
  smoke_reads_check "${smoke_names[@]}"
  if [[ -n $every ]]; then
    printf 'validate: smoke-rows=all %s\n' "$every" >&2; return 0
  fi
  if [[ ${restack_scope:-false} == true ]]; then
    for row in "${!want[@]}"; do
      [[ -n ${restack_smoke[$row]-} ]] || unset 'want[$row]'
    done
  fi
  smoke_close want
  if [[ ${#want[@]} -eq ${#smoke_names[@]} ]]; then
    printf 'validate: smoke-rows=all reason=every-row-reached total=%s\n' "${#smoke_names[@]}" >&2; return 0
  fi
  printf 'validate: smoke-rows=some selected=%s total=%s\n' "${#want[@]}" "${#smoke_names[@]}" >&2
  for row in "${smoke_names[@]}"; do
    [[ -z ${want[$row]-} ]] || smoke_only+="${smoke_only:+,}$row"
  done
}

# smoke_table_reach: mark the nested smoke table row affected when its own
# inputs match no changed path but one reaches a smoke row (smoke_path_reach
# against the change base). A path another table row owns is no unknown
# input, so without this the smoke rows whose input line names it never
# run. A read that cannot list the rows reaches none, as before. Self-check
# lines are dropped here; smoke_rows_selected reads again and prints them.
smoke_table_reach() {
  local i path row_area command
  for i in "${!rows[@]}"; do
    IFS='|' read -r row_area _ command _ <<<"${rows[i]}"
    [[ $command == scripts/qml-smoke.sh ]] || continue
    [[ ${affected[i]} != true && ( $area == all || $area == "$row_area" ) ]] || return 0
    smoke_rows_read 2>/dev/null
    for path in "${changed_paths[@]}"; do
      smoke_path_reach "$change_base" "$path"
      if [[ -n $smoke_reach ]]; then affected[i]=true; return 0; fi
    done
    return 0
  done
}

# smoke_close NAME: add to the associative array NAME each row a row in it
# reads, as smoke_rows_read last read them, and theirs in turn: a row that
# runs brings them.
smoke_close() { # NAME
  local -n smoke_close_set="$1"
  local row needed count=-1
  while [[ $count -ne ${#smoke_close_set[@]} ]]; do
    count=${#smoke_close_set[@]}
    for row in "${!smoke_close_set[@]}"; do
      for needed in ${smoke_row_reads[$row]-}; do smoke_close_set[$needed]=1; done
    done
  done
}

# smoke_reads_named: the function and variable check as a row that fails.
# It reads the lines smoke_rows_selected prints for no changed path, in a
# subshell, so the selection it makes there reaches no caller. A
# `function=`, `variable=`, `source=` or `unparsed` line fails the row; `reads=unreadable`
# or a reason that returns before the scan, a row list, core row or tracked
# list this cannot read, means the scan did not run, which is exit 77 and
# not a pass. A line of another kind, such as a glob that matches nothing,
# still selects its row on every change and fails nothing here.
smoke_reads_named() {
  local out line status=0
  local gap='^validate: smoke-input (row=[^ ]+ (function|variable|source)=|unparsed path=)'
  local unread='^validate: (smoke-input reads=unreadable|smoke-rows=all reason=(row-list-unreadable|core-row-missing|tracked-list-unreadable))'
  if ! out="$(smoke_rows_selected 2>&1 >/dev/null)"; then
    printf 'smoke-reads: selector=failed\n%s\n' "$out" >&2; return 77
  fi
  while IFS= read -r line; do
    if [[ $line =~ $gap ]]; then
      printf '%s\n' "$line" >&2; status=1
    elif [[ $line =~ $unread ]]; then
      printf '%s\n' "$line" >&2
      [[ $status -ne 0 ]] || status=77
    fi
  done <<<"$out"
  return "$status"
}

if [[ $row_entry == true ]]; then
  unset VGS_VALIDATE_CHANGED
  if ((row_path_count >= 0)); then
    VGS_VALIDATE_CHANGED="$(scratch_file)"
    export VGS_VALIDATE_CHANGED
    : >"$VGS_VALIDATE_CHANGED"
    ((${#row_paths[@]} == 0)) || printf '%s\0' "${row_paths[@]}" >"$VGS_VALIDATE_CHANGED"
  fi
  # The built-in index readers materialize worktree blobs. Keep those
  # objects under the row root and read existing objects through alternates.
  # External test suites own their own fixture repositories.
  if declare -F "${row_words[0]}" >/dev/null; then
    GIT_ALTERNATE_OBJECT_DIRECTORIES="$(git rev-parse --path-format=absolute --git-path objects)"
    export GIT_ALTERNATE_OBJECT_DIRECTORIES
    GIT_OBJECT_DIRECTORY="$(scratch_dir)"
    export GIT_OBJECT_DIRECTORY
  fi
  "${row_words[@]}"
  exit
fi

if [[ $catalog_prepare_only == true ]]; then
  catalog_input_prepare
  exit
fi

# The file that records this area's last pass, in the worktree's own git
# directory, so no other worktree reads it. Empty when git names no git
# directory: then no run reads or records a pass.
if ! pass_record="$(git rev-parse --absolute-git-dir)/vgs-validated-$area"; then pass_record=""; fi

# last_pass: the newest commit after the branch point whose tree is the
# tree pass_record holds, printed on stdout: the commit that holds what the
# area's last passing run read, whether that run read it committed or not.
# An absent record returns 1 silently. A record that names no tree, a
# tree no such commit holds, as after a rebase or on another branch, or a
# commit whose scripts/validate differs from the worktree's prints
# `validate: last-pass=ignored reason=<reason>` on stderr and returns 1, so
# the branch point serves; so does a branch point that cannot be read,
# whose own reader then names what is missing. The selector check holds
# the base sound: a pass proves the rows its own table selected, so a
# table that now maps a path the branch changed before the pass must read
# the whole branch again.
last_pass() {
  local recorded point commits commit tree status=0
  [[ -n $pass_record && -e $pass_record ]] || return 1
  if ! recorded="$(<"$pass_record")" || [[ ! $recorded =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
     [[ "$(git cat-file -t "$recorded" 2>/dev/null)" != tree ]]; then
    printf 'validate: last-pass=ignored reason=unreadable path=%s\n' "$pass_record" >&2; return 1
  fi
  point="$(branch_point)" || return 1
  if ! commits="$(git rev-list --topo-order --format='%H %T' --no-commit-header "$point..HEAD")"; then
    printf 'validate: last-pass=ignored reason=history-unreadable tree=%s\n' "$recorded" >&2; return 1
  fi
  while read -r commit tree; do
    [[ $tree == "$recorded" ]] && break
  done <<<"$commits"
  if [[ $tree != "$recorded" ]]; then
    printf 'validate: last-pass=ignored reason=no-commit-holds-tree tree=%s\n' "$recorded" >&2; return 1
  fi
  git diff --quiet "$commit" -- scripts/validate || status=$?
  case "$status" in
    0) printf '%s\n' "$commit" ;;
    1) printf 'validate: last-pass=ignored reason=selector-changed commit=%s\n' "$commit" >&2; return 1 ;;
    *) printf 'validate: last-pass=ignored reason=selector-unreadable commit=%s status=%s\n' "$commit" "$status" >&2; return 1 ;;
  esac
}

# worktree_tree: the tree id of what a run reads, every tracked and
# untracked, non-ignored file as the worktree holds it, built in a
# scratch_index; a clean worktree gives HEAD's tree. Prints `unreadable`
# when git cannot build it.
worktree_tree() {
  local scratch tree
  if ! scratch="$(scratch_index)"; then echo unreadable; return 0; fi
  tree="$(GIT_INDEX_FILE="$scratch" git write-tree)" || tree=unreadable
  rm -f -- "${scratch:?}" "${scratch:?}.lock"
  printf '%s\n' "$tree"
}

# last_pass_record: record, after a run that passed, the tree it read in
# pass_record. A run proves its tree only when its base did: the branch
# point, an earlier pass or --full. A base a caller named is the caller's
# claim, so that run records nothing. The tree is what passed only when
# worktree_tree read the same tree at the run's start (pass_tree) and its
# end. Prints `validate: last-pass=recorded` or `last-pass=unrecorded
# reason=<reason>` on stderr; a run that records nothing keeps its exit
# status, since the next run's branch point selects more, never less.
last_pass_record() {
  local tree
  case "$base_source" in
    merge-base|last-pass|full) ;;
    argument|DEV_VALIDATE_BASE|VGS_VALIDATE_BASE)
      printf 'validate: last-pass=unrecorded reason=named-base source=%s\n' "$base_source" >&2; return 0 ;;
    *) printf 'validate: internal-error base-source=%s\n' "$base_source" >&2; exit 1 ;;
  esac
  tree="$(worktree_tree)"
  if [[ $pass_tree == unreadable || $tree == unreadable ]]; then
    echo 'validate: last-pass=unrecorded reason=tree-unreadable' >&2; return 0
  fi
  if [[ $tree != "$pass_tree" ]]; then
    printf 'validate: last-pass=unrecorded reason=content-changed from=%s to=%s\n' "$pass_tree" "$tree" >&2; return 0
  fi
  if [[ -z $pass_record ]]; then
    echo 'validate: last-pass=unrecorded reason=git-dir-unresolved' >&2; return 0
  fi
  if ! printf '%s\n' "$tree" >"${pass_record:?}.$$" || ! mv -f -- "${pass_record:?}.$$" "$pass_record"; then
    rm -f -- "${pass_record:?}.$$"
    printf 'validate: last-pass=unrecorded reason=write-failed path=%s\n' "$pass_record" >&2; return 0
  fi
  printf 'validate: last-pass=recorded area=%s tree=%s\n' "$area" "$tree" >&2
}

# The change base and its source, the first that holds: --changed BASE
# (argument); DEV_VALIDATE_BASE, the fix-round base Kendex supplies;
# VGS_VALIDATE_BASE; this area's last pass in this worktree (last-pass);
# the branch point (merge-base). --full reads no base (full).
# Match all rows before filtering by area, so runtime-only inputs do not
# cause an offline run to select unrelated suites.
if [[ -n $change_base ]]; then
  base_source=argument
elif [[ $full_scope == true ]]; then
  base_source=full
elif [[ -n ${DEV_VALIDATE_BASE:-} ]]; then
  change_base="$DEV_VALIDATE_BASE"; base_source=DEV_VALIDATE_BASE
elif [[ -z ${VGS_VALIDATE_BASE:-} ]] && change_base="$(last_pass)"; then
  base_source=last-pass
elif ! change_base="$(whitespace_base)"; then
  printf 'validate: status=not-measured reason=no-base %s\n' "${change_base##*$'\n'}" >&2
  exit 77
elif [[ -n ${VGS_VALIDATE_BASE:-} ]]; then
  base_source=VGS_VALIDATE_BASE
else
  base_source=merge-base
fi
if [[ -n $change_base ]]; then
  export VGS_VALIDATE_BASE="$change_base"
  if ! base_commit="$(git rev-parse --verify --quiet "$change_base^{commit}")"; then base_commit="$change_base"; fi
  printf 'validate: base=%s source=%s\n' "$base_commit" "$base_source" >&2
fi

# A restack intersects incoming reach with the branch's selected inputs,
# through the same indexes and smoke reach used below. Comparing only the
# branch's changed path names loses a change to an unchanged dependency.
restack_scope=false restack_qml_reached=false
declare -A restack_rows=() restack_smoke=()
rebased_scope() { # FILE
  local file="$1" old_point point path status=0 i command row reached=false qml=false branch_qml=false
  local -a paths own_paths
  local -A own=()
  git merge-base --is-ancestor "$base_commit" HEAD 2>/dev/null || status=$?
  [[ $status -eq 1 ]] || return "$status"
  if ! old_point="$(branch_point "$base_commit")" || ! point="$(branch_point)"; then
    printf 'validate: scope=unreadable reason=branch-point base=%s\n' "$base_commit" >&2; return 1
  fi
  if ! mapfile -d '' -t own_paths < <(git diff --name-only --no-renames -z "$old_point" "$base_commit" -- &&
       git diff --name-only --no-renames -z "$point" -- && git ls-files -z --others --exclude-standard) || ! wait "$!" ||
     ! mapfile -d '' -t paths <"$file"; then
    printf 'validate: scope=unreadable reason=diff base=%s\n' "$base_commit" >&2; return 1
  fi
  smoke_rows_read
  [[ -z $smoke_read_fault ]] || return 1
  for path in "${own_paths[@]}"; do
    own[$path]=1
    path_reach "$path"
    [[ ${path_hit[$path]} != full ]] || return 1
    for i in ${path_hit[$path]}; do
      IFS='|' read -r _ _ command _ <<<"${rows[i]}"
      if [[ $command == scripts/qml-smoke.sh ]]; then branch_qml=true
      else restack_rows[$i]=1; fi
    done
    smoke_path_reach "$old_point" "$path"
    case "$smoke_reach" in
      harness|untraced\ *) for row in "${smoke_names[@]}"; do restack_smoke[$row]=1; done ;;
      *) for row in $smoke_reach; do restack_smoke[$row]=1; branch_qml=true; done ;;
    esac
  done
  if [[ $branch_qml == true ]]; then
    for row in "${smoke_core[@]}"; do restack_smoke[$row]=1; done
    for row in "${smoke_names[@]}"; do
      [[ -n ${smoke_row_globs[$row]+set} ]] || restack_smoke[$row]=1
    done
    smoke_close restack_smoke
  fi
  # Read every path before replacing FILE. An unreadable reach leaves the
  # caller's full-area fallback intact, not a partially filtered selection.
  local -a kept=()
  for path in "${paths[@]}"; do
    reached=false qml=false
    path_reach "$path"
    [[ ${path_hit[$path]} != full ]] || return 1
    for i in ${path_hit[$path]}; do
      IFS='|' read -r _ _ command _ <<<"${rows[i]}"
      if [[ $command == scripts/qml-smoke.sh ]]; then qml=true
      elif [[ -n ${restack_rows[$i]-} ]]; then reached=true; fi
    done
    if [[ -n ${own[$path]-} ]]; then
      reached=true
      [[ $qml != true ]] || restack_qml_reached=true
    fi
    smoke_path_reach "$base_commit" "$path"
    case "$smoke_reach" in
      harness|untraced\ *) return 1 ;;
      *) for row in $smoke_reach; do
           if [[ -n ${restack_smoke[$row]-} ]]; then reached=true; restack_qml_reached=true; fi
         done ;;
    esac
    [[ $reached != true ]] || kept+=("$path")
  done
  : >"$file"
  ((${#kept[@]} == 0)) || printf '%s\0' "${kept[@]}" >"$file"
  restack_scope=true
  printf 'validate: scope=rebased base=%s old-point=%s point=%s\n' "$base_commit" "$old_point" "$point" >&2
}
# The path patterns of each row that is not a repo row, its input globs,
# every word of its command that holds a slash, and the world script for a
# row run wraps in the world, filed by row index in the pattern index
# row_index. A `$NAME`, `@NAME`, `%scope` or `device:` input matches no
# path; row_traced[i] is false for a row that holds a `$NAME` or `device:`
# one, since prepared state and devices have no content a record can bind,
# and for a repo row. row_scoped[i] is true for a row whose `%scope` input
# says it reads VGS_VALIDATE_BASE and VGS_VALIDATE_CHANGED. A qml row starts
# the shell, so its patterns are filed with `loads` (index_add).
declare -A row_index_literal=() row_index_glob_members=() row_index_load_members=()
row_index_globs=()
row_traced=()
row_scoped=()
for i in "${!rows[@]}"; do
  IFS='|' read -r row_area _ command inputs owner <<<"${rows[i]}"
  row_traced[i]=false row_scoped[i]=false
  [[ $row_area != repo ]] || continue
  row_traced[i]=true
  row_loads=""
  [[ $row_area != qml ]] || row_loads=loads
  # Command words without a slash, such as node, are not inputs.
  read -r -a patterns <<<"$inputs"
  # run wraps ordinary rows even when their command never names the world.
  if [[ ${owner:-row} == row || $owner == network ]]; then
    patterns+=(scripts/smoke/gpu-fence.sh)
  fi
  read -r -a words <<<"$command"
  for word in "${words[@]}"; do
    if [[ $word == */* ]]; then patterns+=("$word"); fi
  done
  for pattern in "${patterns[@]}"; do
    case "$pattern" in
      \$*|device:*) row_traced[i]=false ;;
      %scope) row_scoped[i]=true ;;
      @*) ;;
      *) index_add row_index "$pattern" "$i" "$row_loads" ;;
    esac
  done
done

# Use the same input index as selection. Hash the complete input set,
# rather than a branch-relative record, so unrelated landings keep the key.
if [[ $input_hash == true ]]; then
  if ! input_tree="$(worktree_tree)" || [[ $input_tree == unreadable ]]; then
    echo 'validate: input-hash=unreadable-tree' >&2; exit 1
  fi
  input_records=("validate-inputs 1" "area=$area")
  input_members=" "
  for i in "${!rows[@]}"; do
    IFS='|' read -r row_area _ <<<"${rows[i]}"
    [[ $row_area == "$area" ]] || continue
    if [[ ${row_traced[i]} != true || ${row_scoped[i]} == true ]]; then
      printf 'validate: input-hash=untraced row=%s\n' "${rows[i]}" >&2; exit 1
    fi
    input_members+="$i "
    input_records+=("${rows[i]}")
  done
  if ! mapfile -d '' -t input_entries < <(git ls-tree -r -z "$input_tree") || ! wait "$!"; then
    echo 'validate: input-hash=unreadable-inputs' >&2; exit 1
  fi
  for entry in "${input_entries[@]}"; do
    path="${entry#*$'\t'}"
    if [[ $path == scripts/validate ]]; then
      input_records+=("$entry")
      continue
    fi
    index_match row_index "$path"
    for i in $index_hits; do
      if [[ $input_members == *" $i "* ]]; then
        input_records+=("$entry")
        break
      fi
    done
  done
  input_sum="$(printf '%s\0' "${input_records[@]}" | sha256sum)"
  printf '%s\n' "${input_sum%% *}"
  exit 0
fi

# path_reach PATH: set path_hit[PATH] to the indexes of the rows one of
# whose patterns matches PATH, space-delimited, or to `full` when none does
# and PATH is a source no row maps, which selects the whole area. Selection
# and the row records read this one answer, cached per path.
declare -A path_hit=()
path_reach() { # PATH
  local path="$1" hits
  [[ -z ${path_hit[$path]+set} ]] || return 0
  index_match row_index "$path"
  hits="$index_hits"
  # A removed test has no remaining command to run. Its mapped consumers
  # still run; other unmapped inputs select full.
  if [[ -z $hits && ! ( $path == scripts/test-* && ! -e $path && ! -L $path ) ]]; then
    case "$path" in
      *.md|*.markdown|LICENSE|docs/*|.gitignore|.kendex*|kendex*.toml|.claude/*|.codex/*|.pi/*|.github/*) ;;
      .agents/skills/vgs-plugin/*) hits=full ;;
      .agents/*|.bot-instructions/*) ;;
      *) hits=full ;;
    esac
  fi
  path_hit[$path]="$hits"
}

comment_dependencies=unread
comment_inputs=""
comment_coverage() { # PATH
  local kind dependency row reach_read=false
  if [[ $comment_dependencies == unread ]]; then
    if comment_inputs="$(python3 -B scripts/check-smoke-needles.py --unresolved-inputs)"; then
      comment_dependencies=read
    else
      comment_dependencies=failed
    fi
  fi
  [[ $comment_dependencies == read ]] || return 1
  while IFS=$'\t' read -r kind dependency; do
    case "$kind" in
      '') ;;
      target) [[ $1 != "$dependency" ]] || return 1 ;;
      producer)
        if [[ $reach_read == false ]]; then
          smoke_rows_read
          [[ -z $smoke_read_fault ]] || return 1
          smoke_path_reach "$change_base" "$1"
          reach_read=true
        fi
        case "$smoke_reach" in harness|untraced*) return 1 ;; esac
        if [[ $dependency == scripts/smoke/rows/* ]]; then
          row=${dependency##*/}; row=${row%.sh}
          [[ " $smoke_reach " != *" $row "* ]] || return 1
        else
          [[ -z $smoke_reach ]] || return 1
        fi ;;
      *) return 1 ;;
    esac
  done <<<"$comment_inputs"
}

# D124 grants source comments only after equality and needle coverage agree.
comment_only() { # BASE PATH
  python3 -I -B - "$1" "$2" <<'PY_COMMENT' || return 1
import pathlib, re, subprocess, sys
sys.path.insert(0, str(pathlib.Path("scripts").resolve()))
from qml_source import blank_comments
base, name = sys.argv[1:]
def reading(text):
    spans = []
    blank_comments(text, comments=spans)
    ordinary = []
    for a, b in spans:
        if not re.match(r"//[ \t]*(?:keyboard-path|pointer-cursor-exempt|focus-indicator):", text[a:b]):
            ordinary.append((a, b))
    kept = []
    offset = 0
    for a, b in ordinary:
        start = text.rfind("\n", 0, a) + 1
        end = text.find("\n", b)
        end = len(text) if end < 0 else end
        if not text[start:a].strip() and not text[b:end].strip():
            a, b = start, min(end + 1, len(text))
            replacement = ""
        else:
            # Inline block-comment line terminators participate in JS ASI,
            # including return/throw and postfix increment/decrement.
            replacement = "".join(re.findall(r"\r\n|[\n\r\u2028\u2029]", text[a:b]))
        kept.append(text[offset:a])
        kept.append(replacement)
        offset = b
    kept.append(text[offset:])
    return "".join(kept)

try:
    path = pathlib.Path(name)
    raw = subprocess.check_output(["git", "diff", "--raw", "--no-renames", base, "--", name], text=True).split()
    if not raw or raw[4] != "M" or raw[0][1:] != raw[1] or path.is_symlink():
        sys.exit(1)
    old = subprocess.check_output(["git", "show", f"{base}:{name}"]).decode("utf-8")
    new = path.read_bytes().decode("utf-8")
    sys.exit(0 if reading(old) == reading(new) else 1)
except (OSError, UnicodeError, subprocess.CalledProcessError):
    sys.exit(1)
PY_COMMENT
  comment_coverage "$2"
}

# The tree a passing run records is read before the diff that selects its
# rows, so an edit after that diff changes the end tree and records nothing.
# The row records bind their inputs in it too, so --list reads it as well.
pass_tree="$(worktree_tree)"
unset VGS_VALIDATE_CHANGED
text_only=false
comment_text=false
smoke_scoped=false
affected=()
for i in "${!rows[@]}"; do affected[i]=true; done
if [[ -n $change_base ]]; then
  paths_file="$(scratch_file)"
  trap 'rm -f -- "${paths_file:?}"' EXIT
  if ! git diff --name-only --no-renames -z "$change_base" -- >"$paths_file" ||
     ! git ls-files -z --others --exclude-standard >>"$paths_file"; then
    echo 'validate: selection=full reason=diff-unreadable' >&2
  else
    mapfile -d '' -t changed_paths <"$paths_file"
    full=false
    # Classify the complete diff before a restack can narrow its paths.
    # D100 exempts documentation and displayed text from product checks.
    if [[ $pass_tree != unreadable && ${#changed_paths[@]} -gt 0 ]]; then
      text_only=true
      for path in "${changed_paths[@]}"; do
        case "$path" in
          *.md|*.markdown|*.txt|LICENSE) ;;
          shell/*.qml|shell/*.js)
            if [[ $area == qml ]] || ! comment_only "$change_base" "$path"; then
              text_only=false; break
            fi
            comment_text=true
            ;;
          *) text_only=false; break ;;
        esac
      done
    fi
    if [[ $text_only == true ]]; then
      export VGS_VALIDATE_CHANGED="$paths_file"
    elif ! rebased_scope "$paths_file"; then
      echo 'validate: selection=full reason=diff-unreadable' >&2
      full=true
    else
      mapfile -d '' -t changed_paths <"$paths_file"
    fi
    for i in "${!rows[@]}"; do affected[i]=false; done
    for path in "${changed_paths[@]}"; do
      path_reach "$path"
      if [[ ${path_hit[$path]} == full ]]; then
        [[ $text_only != true ]] || continue
        printf 'validate: selection=full unknown-input=%q\n' "$path" >&2; full=true; break
      fi
      for i in ${path_hit[$path]}; do affected[i]=true; done
    done
    if [[ $full == true ]]; then
      for i in "${!rows[@]}"; do affected[i]=true; done
    elif [[ $text_only != true ]]; then
      export VGS_VALIDATE_CHANGED="$paths_file"
      smoke_scoped=true
      smoke_table_reach
    fi
  fi
fi
if [[ $restack_scope == true ]]; then
  for i in "${!rows[@]}"; do
    IFS='|' read -r row_area _ command _ <<<"${rows[i]}"
    [[ $row_area == repo ]] && continue
    if [[ $command == scripts/qml-smoke.sh ]]; then
      affected[i]="$restack_qml_reached"
    elif [[ -z ${restack_rows[$i]-} ]]; then
      affected[i]=false
    fi
  done
fi

# The row records, which outlive the run that wrote them; what they let a
# run reuse is docs/architecture/validation.md § Selection. Each row that
# ends appends one line to this worktree's <git-dir>/vgs-validated-rows:
#   <run> <digest> <point> <outcome> <secs> <name>
# run is the validate process as run_name gives it; point is the branch
# point the writing run read, or - when it read none; outcome is pass,
# fail, skip (exit 77) or unproved; secs is - when unknown; name is
# row=<label>, or smoke=<row> for a nested smoke row. digest is
# record_digest's, or - for a row no digest binds, whose line keeps only
# its seconds. `<run> void` withdraws every line of that run, whose tree
# changed while it ran. A row whose newest line for its digest is a pass
# is reused while the commits between that line's point and this run's
# reach none of its inputs (record_holds). The
# nested smoke's rows reach the file through the directory
# VGS_SMOKE_RESULTS_DIR names, <git-dir>/vgs-validated-smoke/<run>, which
# holds `<digest> <point> <row>` lines in digests and the runner's per-row
# results (scripts/qml-smoke.sh); smoke_collect turns them into lines when
# the row's whole group has ended, at validate's exit, or, after a KILL,
# at the next run's start, so a line keeps the point of the run that wrote
# digests.
record_file="" record_smoke_root="" record_run="" records_written=false
reuse=off reuse_reason="" record_point="" record_validate="" record_untraced=""
record_paths=() record_lines=()
smoke_results_dir=""
declare -A record_outcome=() record_at=() record_secs=() reuse_count=() smoke_digests=()
declare -A record_moved_rows=() record_moved_smoke=()

# run_name PID: pid-start-pidns, which no other process shares while PID
# lives, or status 1 when /proc cannot read it.
run_name() { # PID
  local stat ns
  local -a fields
  read -r stat 2>/dev/null <"/proc/$1/stat" || return 1
  read -r -a fields <<<"${stat##*) }"
  ns="$(readlink "/proc/$1/ns/pid" 2>/dev/null)" || return 1
  printf '%s-%s-%s\n' "$1" "${fields[19]}" "${ns//[^0-9]/}"
}

record_append() { # RUN DIGEST POINT OUTCOME SECS NAME
  if printf '%s %s %s %s %s %s\n' "$@" 2>/dev/null >>"$record_file"; then records_written=true; return 0; fi
  printf 'validate: row-records=unwritten path=%s\n' "$record_file" >&2
}

record_outcome_of() { # STATUS
  case "$1" in 0) echo pass ;; 77) echo skip ;; *) echo fail ;; esac
}

# records_load: read the newest outcome of each digest into record_outcome
# and the point it was written at into record_at, and the newest seconds
# of each name into record_secs, past void runs. A file over 5000 lines
# keeps its newest 2500, a few runs' worth; a lost line costs a rerun.
records_load() {
  local run digest point outcome secs name count=0
  local -A void=()
  [[ -e $record_file ]] || return 0
  if ! while read -r run digest _; do
         count=$((count + 1))
         [[ $digest != void ]] || void[$run]=1
       done <"$record_file"; then
    printf 'validate: row-records=unreadable path=%s\n' "$record_file" >&2; return 0
  fi
  while read -r run digest point outcome secs name; do
    [[ $digest != void && -z ${void[$run]-} && -n $name ]] || continue
    [[ $digest == - ]] || record_outcome[$digest]=$outcome record_at[$digest]=$point
    [[ ! $secs =~ ^[0-9]+$ ]] || record_secs[$name]=$secs
  done <"$record_file"
  if ((count > 5000)); then
    if ! tail -n 2500 -- "$record_file" >"${record_file:?}.$$" || ! mv -f -- "${record_file:?}.$$" "$record_file"; then
      rm -f -- "${record_file:?}.$$"
    fi
  fi
}

# smoke_collect DIR: append a line for each row DIR/digests names that the
# nested smoke ran under DIR, with the outcome and seconds smoke_outcomes
# reads over every attempt of every run of scripts/qml-smoke.sh under DIR,
# in the order they ran, then remove DIR/digests and those row journals,
# each attempt's results/, partial/ and judge-readings. The completion
# records and run logs qml-smoke.sh printed stay where it printed them,
# until record_prepare prunes the run. A DIR with no digests was collected.
smoke_collect() { # DIR
  local dir="$1" driver attempt n digest row
  local -a attempts=() numbered
  [[ -f $dir/digests ]] || return 0
  for driver in "$dir"/qml-smoke-resume.*/; do
    [[ -d $driver ]] || continue
    numbered=()
    for attempt in "$driver"*/; do
      n="${attempt%/}"; n="${n##*/}"
      [[ ! $n =~ ^[0-9]+$ ]] || numbered[n]="${attempt%/}"
    done
    attempts+=("${numbered[@]}")
  done
  smoke_outcomes "${attempts[@]}"
  while read -r digest point row; do
    [[ -n $row && -n ${smoke_outcome[$row]-} ]] || continue
    record_append "${dir##*/}" "$digest" "$point" "${smoke_outcome[$row]}" "${smoke_outcome_secs[$row]:--}" "smoke=$row"
  done <"$dir/digests"
  for attempt in "${attempts[@]}"; do
    chmod -R u+rwX -- "$attempt/results" "$attempt/partial" 2>/dev/null || true
    rm -rf -- "${attempt:?}/results" "${attempt:?}/partial" "${attempt:?}/judge-readings"
  done
  rm -f -- "${dir:?}/digests"
}

# record_digest NAME CONTEXT LINES: the sha256 of what a row's result rests
# on: the selector, this file; every changed path no row maps that selects
# the whole area; the row itself, NAME; CONTEXT; and LINES, the
# `<mode> <blob> <path>` of each path the row's inputs match that differs
# from the branch point, a removed one with mode 000000. Every other input
# holds the branch point's content, which the digest leaves to the point
# its record line names: equal digests mean equal inputs once
# record_holds finds that the commits between the two points change none
# of the row's inputs.
record_digest() { # NAME CONTEXT LINES
  local text sum
  printf -v text 'validate-record 2\nvalidate=%s\nuntraced:\n%sname=%s\n%s\ninputs:\n%s' \
    "$record_validate" "$record_untraced" "$1" "$2" "$3"
  sum="$(sha256sum <<<"$text")"
  printf '%s\n' "${sum%% *}"
}

# row_digest I: row I's digest. A row whose `%scope` input says it reads
# VGS_VALIDATE_BASE and VGS_VALIDATE_CHANGED binds the base and whether the
# scope is the changed paths, which its inputs then fix; no other row
# reads them, so none binds them.
row_digest() { # I
  local j lines="" scope=all context=""
  for j in "${!record_paths[@]}"; do
    [[ " ${path_hit[${record_paths[j]}]} " != *" $1 "* ]] || lines+="${record_lines[j]}"$'\n'
  done
  if [[ ${row_scoped[$1]} == true ]]; then
    [[ -z ${VGS_VALIDATE_CHANGED:-} ]] || scope=changed
    context="base=${base_commit:-none} scope=$scope"
  fi
  record_digest "row=${rows[$1]}" "$context" "$lines"
}

# record_moved KIND POINT: read once per POINT, the branch point a record
# was written at, which rows the commits between it and record_point
# reach: for KIND rows into record_moved_rows[POINT], the table rows
# path_reach gives each path they change; for KIND smoke into
# record_moved_smoke[POINT], the nested smoke rows smoke_path_reach gives
# each against POINT, whose diff to this tree holds those commits' hunks.
# The value is space-led and space-delimited; `all` when path_reach finds
# a path that selects the whole area, which every digest binds as
# record_untraced when the branch changes one, or when a smoke reach is
# the whole harness or cannot be traced; `unreadable` when POINT names no
# commit or the diff cannot be read.
record_moved() { # rows|smoke POINT
  local -n record_moved_set="record_moved_$1"
  local point="$2" path reach=" "
  local -a paths
  [[ -z ${record_moved_set[$point]+set} ]] || return 0
  if [[ ! $point =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
     ! mapfile -d '' -t paths < <(git diff-tree -r -z --name-only --no-renames "$point" "$record_point" -- 2>/dev/null) || ! wait "$!"; then
    record_moved_set[$point]=unreadable; return 0
  fi
  for path in "${paths[@]}"; do
    path_reach "$path"
    [[ ${path_hit[$path]} != full ]] || { reach=all; break; }
    if [[ $1 == rows ]]; then
      reach+="${path_hit[$path]} "
    else
      smoke_path_reach "$point" "$path"
      case "$smoke_reach" in
        harness|untraced\ *) reach=all; break ;;
        *) reach+="$smoke_reach " ;;
      esac
    fi
  done
  record_moved_set[$point]="$reach"
}

# record_holds DIGEST rows|smoke MEMBER...: whether the newest record of
# DIGEST is a pass that holds for this run: one written at record_point,
# or at a point whose commits to record_point reach none of the MEMBERs,
# as record_moved reads them. For a smoke row the MEMBERs are its read
# closure, whose inputs its digest binds. A pass that does not hold sets
# record_miss to incoming or point-unreadable; anything else leaves it
# empty.
record_miss=""
record_holds() { # DIGEST rows|smoke MEMBER...
  local digest="$1" kind="$2" point member
  local -n record_holds_moved="record_moved_$kind"
  record_miss=""
  [[ ${record_outcome[$digest]-} == pass ]] || return 1
  point="${record_at[$digest]}"
  [[ $point != "$record_point" ]] || return 0
  record_moved "$kind" "$point"
  case "${record_holds_moved[$point]}" in
    unreadable) record_miss=point-unreadable; return 1 ;;
    all) record_miss=incoming; return 1 ;;
  esac
  for member in "${@:3}"; do
    [[ ${record_holds_moved[$point]} != *" $member "* ]] || { record_miss=incoming; return 1; }
  done
}

# smoke_digests_read: set smoke_digests[ROW] for each nested smoke row
# smoke_rows_read last read, over what the harness reads for every row and
# the changed paths smoke_path_reach gives each row of its read closure:
# the row and every row it reads, and theirs in turn, since a row runs on
# their state. A row whose closure holds a row whose reach cannot be
# traced, or any row when a changed path's reach cannot be, gets -. Which
# other rows ran before a row in its run is selection's, as for any --rows
# run.
smoke_digests_read() {
  local row j member common="" untraced=false lines
  local -A direct=() closure=()
  smoke_digests=()
  for j in "${!record_paths[@]}"; do
    smoke_path_reach "$record_point" "${record_paths[j]}"
    case "$smoke_reach" in
      harness) common+="${record_lines[j]}"$'\n' ;;
      untraced\ *) untraced=true ;;
      *) for row in $smoke_reach; do direct[$row]+="${record_lines[j]}"$'\n'; done ;;
    esac
  done
  for row in "${smoke_names[@]}"; do
    smoke_digests[$row]=-
    [[ $untraced == false ]] || continue
    closure=([$row]=1)
    smoke_close closure
    lines=""
    for member in "${smoke_names[@]}"; do
      [[ -n ${closure[$member]-} ]] || continue
      [[ -n ${smoke_row_globs[$member]+set} ]] || continue 2
      lines+="${direct[$member]-}"
    done
    smoke_digests[$row]="$(record_digest "smoke=$row" "$common" "$lines")"
  done
}

# record_prepare: name this run, collect the smoke results of runs that
# ended without collecting them, keep the newest three collected runs'
# directories, load the records and read what the digests bind. Sets
# reuse_reason when nothing can be reused: --full, which reruns every row
# by request, an unreadable git directory, tree, branch point or diff.
record_prepare() {
  local git_dir dir name own_ns live j mode sha path kept=0
  local -a raw collected=()
  if ! git_dir="$(git rev-parse --absolute-git-dir)" || ! record_run="$(run_name "$$")"; then
    reuse_reason=records-unreadable; return 0
  fi
  record_file="$git_dir/vgs-validated-rows"
  record_smoke_root="$git_dir/vgs-validated-smoke"
  own_ns="${record_run##*-}"
  # A run in another PID namespace cannot be judged gone from here.
  for dir in "$record_smoke_root"/*/; do
    dir="${dir%/}"; name="${dir##*/}"
    [[ -d $dir && $name =~ ^[0-9]+-[0-9]+-[0-9]+$ && ${name##*-} == "$own_ns" ]] || continue
    live="$(run_name "${name%%-*}")" || live=""
    [[ $live != "$name" ]] || continue
    smoke_collect "$dir"
    [[ -f $dir/digests ]] || collected+=("$dir")
  done
  if ((${#collected[@]} > 3)) && mapfile -t collected < <(ls -1dt -- "${collected[@]}"); then
    for dir in "${collected[@]}"; do
      kept=$((kept + 1))
      ((kept <= 3)) || { chmod -R u+rwX -- "$dir" 2>/dev/null || true; rm -rf -- "${dir:?}"; }
    done
  fi
  records_load
  if [[ $full_scope == true ]]; then reuse_reason=full; return 0; fi
  if [[ $pass_tree == unreadable ]] || ! record_validate="$(git rev-parse --verify --quiet "$pass_tree:scripts/validate")"; then
    reuse_reason=tree-unreadable; return 0
  fi
  if ! record_point="$(branch_point)"; then reuse_reason=no-branch-point; return 0; fi
  if ! mapfile -d '' -t raw < <(git diff-tree -r -z --no-renames "$record_point" "$pass_tree") || ! wait "$!"; then
    reuse_reason=diff-unreadable; return 0
  fi
  for ((j = 0; j + 1 < ${#raw[@]}; j += 2)); do
    read -r _ mode _ sha _ <<<"${raw[j]}"
    path="${raw[j + 1]}"
    path_reach "$path"
    record_paths+=("$path")
    record_lines+=("$mode $sha $path")
    [[ ${path_hit[$path]} != full ]] || record_untraced+="$mode $sha $path"$'\n'
  done
  reuse=on
}

# reuse_line KIND SCOPE NAME [REASON]: print one member of the reused or
# rerun set with its last known seconds, and count it.
reuse_line() { # KIND SCOPE NAME [REASON]
  local secs="${record_secs[$3]-}"
  printf 'validate: %s secs=%s%s %s\n' "$1" "${secs:-unknown}" "${4:+ reason=$4}" "$3" >&2
  reuse_count[$2-$1]=$((${reuse_count[$2-$1]:-0} + 1))
  if [[ -n $secs ]]; then
    reuse_count[$2-$1-secs]=$((${reuse_count[$2-$1-secs]:-0} + secs))
  else
    reuse_count[$2-$1-unknown]=$((${reuse_count[$2-$1-unknown]:-0} + 1))
  fi
}

# smoke_reuse: drop from the nested smoke rows this run would run each one
# a recorded pass covers, by docs/architecture/validation.md § Selection,
# keeping every row a kept row reads, since qml-smoke.sh --rows brings it
# back, and set smoke_only to the kept rows. When smoke_rows_read could not
# read what a row's reach rests on, prints `validate: smoke-reuse=off
# reason=<cause>` and reuses and records nothing. Outside --list, write the
# digests this run's results bind to in smoke_results_dir.
smoke_reuse() {
  local row digest
  local -a wanted
  local -A keep=() asked=() missed=() closure=()
  if [[ -n $smoke_read_fault ]]; then
    printf 'validate: smoke-reuse=off reason=%s\n' "$smoke_read_fault" >&2; return 0
  fi
  if [[ -n $smoke_only ]]; then IFS=, read -r -a wanted <<<"$smoke_only"; else wanted=("${smoke_names[@]}"); fi
  smoke_digests_read
  for row in "${wanted[@]}"; do
    asked[$row]=1
    digest="${smoke_digests[$row]:--}"
    if [[ $digest == - || " ${smoke_core[*]} " == *" $row "* ]]; then keep[$row]=1; continue; fi
    closure=([$row]=1)
    smoke_close closure
    if ! record_holds "$digest" smoke "${!closure[@]}"; then
      keep[$row]=1
      [[ -z $record_miss ]] || missed[$row]=$record_miss
    fi
  done
  smoke_close keep
  for row in "${smoke_names[@]}"; do
    if [[ -n ${keep[$row]-} ]]; then
      if [[ ${smoke_digests[$row]} == - ]]; then reuse_line rerun smoke "smoke=$row" untraced
      elif [[ " ${smoke_core[*]} " == *" $row "* ]]; then reuse_line rerun smoke "smoke=$row" core
      elif [[ -n ${missed[$row]-} ]]; then reuse_line rerun smoke "smoke=$row" "${missed[$row]}"
      else reuse_line rerun smoke "smoke=$row"; fi
    elif [[ -n ${asked[$row]-} ]]; then
      reuse_line reused smoke "smoke=$row"
    fi
  done
  if [[ -n $smoke_only ]] || ((${#keep[@]} < ${#wanted[@]})); then
    smoke_only=""
    for row in "${smoke_names[@]}"; do
      [[ -z ${keep[$row]-} ]] || smoke_only+="${smoke_only:+,}$row"
    done
  fi
  [[ $list_only != true && ${#smoke_names[@]} -gt 0 ]] || return 0
  smoke_results_dir="$record_smoke_root/$record_run"
  if ! mkdir -p -- "$smoke_results_dir" ||
     ! for row in "${smoke_names[@]}"; do printf '%s %s %s\n' "${smoke_digests[$row]}" "$record_point" "$row"; done >"$smoke_results_dir/digests"; then
    printf 'validate: row-records=unwritten path=%s\n' "$smoke_results_dir" >&2
    smoke_results_dir=""
  fi
}

# records_finish, from the EXIT trap after the rows have stopped: collect
# this run's smoke results, once stop_rows has seen the nested smoke's
# group end, so the driver has outlived its attempt's world and the
# teardown's closing reading is in, or the stop's window has passed and
# the attempt, with no closing reading, proves no pass. The run loop
# collects them first only when it reaps the row's leader after the
# whole group has ended; when the group outlives the leader, as after a
# unit's stop, the run loop leaves the results here. Then withdraw this
# run's lines when its tree changed while it ran, or print
# `validate: row-records=unwritten` when the withdrawal cannot be written.
# A KILL runs neither: the next run collects the results, and the lines
# stand on the tree the run read at its start.
records_finish() {
  local end
  if [[ -n $smoke_results_dir && -d $smoke_results_dir ]]; then smoke_collect "$smoke_results_dir"; fi
  [[ $records_written == true && $reuse == on ]] || return 0
  if ! end="$(worktree_tree)"; then end=unreadable; fi
  if [[ $end == "$pass_tree" ]]; then return 0; fi
  if printf '%s void\n' "$record_run" 2>/dev/null >>"$record_file"; then
    printf 'validate: row-records=void reason=content-changed from=%s to=%s\n' "$pass_tree" "$end" >&2
  else
    printf 'validate: row-records=unwritten path=%s\n' "$record_file" >&2
  fi
}

record_prepare
[[ $reuse == on ]] || printf 'validate: reuse=off reason=%s\n' "$reuse_reason" >&2

selected_count=0
selected=()
row_command=()
row_digest=()
validate_started=$SECONDS
for i in "${!rows[@]}"; do
  IFS='|' read -r row_area label command inputs owner <<<"${rows[i]}"
  case "$area" in
    all) ;;
    offline) [[ $row_area == qml || $row_area == unit || $row_area == nix || $row_area == package || $owner == network ]] && continue ;;
    *) [[ $area != "$row_area" ]] && continue ;;
  esac
  if [[ $text_only == true ]]; then
    case "$command" in
      whitespace_check|md_refs_check|python3\ scripts/check-user-commands.py) ;;
      doc_limits_check) [[ ${affected[i]} == true ]] || continue ;;
      python3\ scripts/check-keyboard.py\ shell|python3\ scripts/check-pointer-cursor.py|python3\ scripts/check-smoke-needles.py)
        [[ $comment_text == true ]] || continue ;;
      *) continue ;;
    esac
  else
    [[ ${affected[i]} == true || $row_area == repo ]] || continue
  fi
  if [[ $skip_unprepared == true ]]; then
    unprepared=""
    unprepared_kind=unset
    read -r -a patterns <<<"$inputs"
    for pattern in "${patterns[@]}"; do
      name="${pattern#\$}"
      if [[ $pattern == \$* && -z ${!name:-} ]]; then unprepared="$name"; break; fi
      if [[ $pattern == device:* ]]; then
        device_found=false
        # The row declares the device glob; do not interpret it as a path
        # input or infer preparation from the runner's identity.
        for candidate in ${pattern#device:}; do
          if [[ -c $candidate ]]; then device_found=true; break; fi
        done
        if [[ $device_found == false ]]; then unprepared="$pattern"; unprepared_kind=missing; break; fi
      fi
    done
    if [[ -n $unprepared ]]; then
      printf 'validate: unselected %s=%s row=%s\n' "$unprepared_kind" "$unprepared" "$label" >&2
      unselected=true
      continue
    fi
  fi
  # The nested smoke is reused per smoke row (smoke_reuse), whose digests
  # bind each row's read closure; its own inputs bind neither the change
  # base its row selection reads nor the smoke rows' inputs another table
  # row owns, so it records no pass of its own.
  digest=- record_miss=""
  if [[ $reuse == on && ${row_traced[i]} == true && $command != scripts/qml-smoke.sh ]]; then
    digest="$(row_digest "$i")"
    if record_holds "$digest" rows "$i"; then
      reuse_line reused rows "row=$label"
      continue
    fi
  fi
  if [[ $reuse == on ]]; then
    if [[ $command == scripts/qml-smoke.sh ]]; then reuse_line rerun rows "row=$label" smoke-rows
    elif [[ $digest == - ]]; then reuse_line rerun rows "row=$label" untraced
    else reuse_line rerun rows "row=$label" ${record_miss:+"$record_miss"}; fi
  fi
  selected_count=$((selected_count + 1))
  if [[ $command == scripts/qml-smoke.sh ]]; then
    smoke_only=""
    if [[ $smoke_scoped == true ]]; then
      smoke_rows_selected "${changed_paths[@]}"
    elif [[ $reuse == on ]]; then
      # An unscoped run runs every row; reuse needs only what the rows read.
      smoke_rows_read
    fi
    [[ $reuse != on ]] || smoke_reuse
    [[ -z $smoke_only ]] || command+=" --rows $smoke_only"
  fi
  if [[ $list_only == true ]]; then
    printf '%s\n' "$command"
  else
    selected+=("$i")
    row_command+=("$command")
    row_digest+=("$digest")
  fi
done
if [[ $reuse == on ]]; then
  printf 'validate: reuse=on rows-reused=%s rows-rerun=%s reused-secs=%s rerun-secs=%s rerun-secs-unknown=%s' \
    "${reuse_count[rows-reused]:-0}" "${reuse_count[rows-rerun]:-0}" "${reuse_count[rows-reused-secs]:-0}" \
    "${reuse_count[rows-rerun-secs]:-0}" "${reuse_count[rows-rerun-unknown]:-0}" >&2
  printf ' smoke-reused=%s smoke-rerun=%s smoke-reused-secs=%s smoke-rerun-secs=%s smoke-rerun-secs-unknown=%s\n' \
    "${reuse_count[smoke-reused]:-0}" "${reuse_count[smoke-rerun]:-0}" "${reuse_count[smoke-reused-secs]:-0}" \
    "${reuse_count[smoke-rerun-secs]:-0}" "${reuse_count[smoke-rerun-unknown]:-0}" >&2
fi
if [[ $list_only == true ]]; then
  printf 'validate: selected=%s area=%s\n' "$selected_count" "$area" >&2
  exit 0
fi

for command in "${row_command[@]}"; do
  if [[ $command == catalog_wallpaper_names ]]; then
    catalog_input_prepare || exit 1
    break
  fi
done

# The run loop: the selected rows run side by side, at most jobs_max at once,
# each as a job in a process group of its own, so a signal reaches every
# process a row started. A row waits while a running row names one of its
# `@NAME`s; an `@alone` row starts once nothing runs, and no row after it
# in the table starts before it has ended. An `@alone` row, and every row
# at one job, starts once every row before it has printed, so it writes to
# validate's own stdout and stderr as it runs; any other row writes both to
# its log, which prints whole once every row before it has printed. The
# statuses fill failed and skipped in table order.
run_dir="$(scratch_dir)" || { echo 'validate: run-dir=scratch-failed' >&2; exit 1; }
declare -A row_of_pid=() held=()
# smoke_group: the nested smoke row's process group, named by its leader,
# from its start until the run loop collects its results.
smoke_group=""
row_state=() row_alone=() row_locks=() row_status=() row_started=()
for k in "${!selected[@]}"; do
  IFS='|' read -r _ _ _ inputs _ <<<"${rows[selected[k]]}"
  read -r -a patterns <<<"$inputs"
  row_state[k]=pending row_alone[k]=false row_locks[k]=""
  for pattern in "${patterns[@]}"; do
    case "$pattern" in
      @alone) row_alone[k]=true ;;
      @*) row_locks[k]+=" ${pattern#@}" ;;
    esac
  done
done
start_row() { # K
  local k="$1" row_area label name owner results
  IFS='|' read -r row_area label _ _ owner <<<"${rows[selected[k]]}"
  # Job control, on only while the job starts, gives it its own process
  # group and leaves its INT and QUIT at their defaults, which a bare `&`
  # would ignore and the Ctrl-C checks of the fence and TUI rows need.
  set -m
  # Only the nested smoke keeps its per-row results where its run names.
  results=""
  [[ ${row_command[k]} != "scripts/qml-smoke.sh"* ]] || results="$smoke_results_dir"
  if [[ ${row_alone[k]} == true || $jobs_max -eq 1 ]]; then
    # shellcheck disable=SC2086
    VGS_SMOKE_RESULTS_DIR="$results" run "$run_dir/$k" "$owner" "$label" ${row_command[k]} </dev/null &
  else
    # shellcheck disable=SC2086
    VGS_SMOKE_RESULTS_DIR="$results" run "$run_dir/$k" "$owner" "$label" ${row_command[k]} </dev/null >"$run_dir/$k.log" 2>&1 &
  fi
  set +m
  row_of_pid[$!]=$k
  [[ -z $results ]] || smoke_group=$!
  row_started[k]=$SECONDS
  row_state[k]=running
  for name in ${row_locks[k]}; do held[$name]=1; done
}
start_rows() {
  local k pid name
  for pid in "${!row_of_pid[@]}"; do
    k="${row_of_pid[$pid]}"
    [[ ${row_alone[k]} == false ]] || return 0
  done
  for k in "${!selected[@]}"; do
    [[ ${row_state[k]} == pending ]] || continue
    if [[ ${row_alone[k]} == true ]]; then
      [[ ${#row_of_pid[@]} -gt 0 ]] || start_row "$k"
      return 0
    fi
    [[ ${#row_of_pid[@]} -lt $jobs_max ]] || return 0
    for name in ${row_locks[k]}; do
      [[ -z ${held[$name]-} ]] || continue 2
    done
    start_row "$k"
  done
}
# stop_rows, run by the EXIT trap however validate ends, sends TERM to the
# group of every job still running, a row started but not yet recorded
# included, then waits until every row group it started that has not been
# seen to end has ended, and sends KILL to the groups still alive after
# 10 s, which outlasts the smoke's own TERM-then-KILL teardown, or at once
# on a repeat signal. A group is signalled only while its leader is still
# validate's child, since a job bash has already reaped can leave its
# number to another process; once taken, the kernel keeps the group's
# number while any member lives, so the KILL still reaches members whose
# leader the TERM ended. A stop that TERMs every process at once, as a
# unit's stop does (systemd.kill(5), KillMode=control-group), ends a row's
# leader, a subshell with TERM at its default, before this runs, while the
# rest of its group, the nested smoke's driver waiting on its attempt's
# world among them, still runs. Either validate's exit handling or its run
# loop can see that leader end first. In the exit handling the row is
# still in row_of_pid or jobs -p. In the run loop, `wait -n` reaps the
# leader and the run loop leaves the collection to records_finish while
# the group still runs, so the group stays in smoke_group. Such a group,
# whose leader is gone, is waited on but never signalled: the stop
# reached it, and with its leader gone nothing proves the number still
# the row's. The wait is what puts each attempt's closing reading before
# records_finish. A signal that arrives before it has found the groups
# KILLs none, and the stop goes on.
row_groups=()
stopping=false
kill_groups() { # SIGNAL
  local pid
  for pid in "${row_groups[@]}"; do kill -s "$1" -- "-$pid" 2>/dev/null || true; done
  return 0
}
stop_rows() {
  local pid stat ppid pgrp alive tick
  local -a pids=() waited=()
  stopping=true
  jobs -p >"$run_dir/jobs" 2>/dev/null && mapfile -t pids <"$run_dir/jobs" || pids=()
  pids+=("${!row_of_pid[@]}" ${smoke_group:+"$smoke_group"})
  for pid in "${pids[@]}"; do
    [[ " ${waited[*]} " != *" $pid "* ]] || continue
    waited+=("$pid")
    read -r stat 2>/dev/null <"/proc/$pid/stat" || continue
    read -r _ ppid pgrp _ <<<"${stat##*) }"
    if [[ $ppid == "$$" && $pgrp == "$pid" ]]; then row_groups+=("$pid"); fi
  done
  [[ ${#waited[@]} -gt 0 ]] || return 0
  kill_groups TERM
  for ((tick = 0; tick < 100; tick++)); do
    alive=false
    for pid in "${waited[@]}"; do
      if kill -0 -- "-$pid" 2>/dev/null; then alive=true; fi
    done
    [[ $alive == true ]] || return 0
    sleep 0.1
  done
  kill_groups KILL
}
# A signal exits through the EXIT trap. Each exit taken while these traps
# are set marks the stop begun before it leaves, so a later signal neither
# ends validate before the trap's stop, records_finish and scratch removal
# have run nor changes its exit status: it KILLs the row groups stop_rows
# has found, none before it has looked. A signal to validate's whole
# process group, as a second Ctrl-C at a terminal sends, also ends the
# trap's own foreground command, such as stop_rows' sleep; the trap turns
# errexit off first, so that command's status does not end it either.
on_signal() { # EXIT-STATUS
  if [[ $stopping == true ]]; then kill_groups KILL; return 0; fi
  stopping=true
  exit "$1"
}
trap 'set +e; stop_rows; records_finish; chmod -R u+rwx -- "$run_dir" 2>/dev/null; rm -rf -- "${run_dir:?}"; if [[ -n ${paths_file:-} ]]; then rm -f -- "$paths_file"; fi' EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP
trap 'on_signal 131' QUIT
printed=0
while :; do
  start_rows
  [[ ${#row_of_pid[@]} -gt 0 ]] || break
  pid="" status=0
  wait -n -p pid || status=$?
  if [[ -z $pid ]]; then
    printf 'validate: wait=no-child status=%s running=%s\n' "$status" "${#row_of_pid[@]}" >&2; stopping=true; exit 1
  fi
  # Only a row's job counts; any other child is passed over.
  [[ -n ${row_of_pid[$pid]-} ]] || continue
  k="${row_of_pid[$pid]}"
  unset 'row_of_pid[$pid]'
  row_state[k]=ended row_status[k]=$status
  for name in ${row_locks[k]}; do unset 'held[$name]'; done
  if [[ -n $record_file ]]; then
    IFS='|' read -r _ label _ <<<"${rows[selected[k]]}"
    record_append "$record_run" "${row_digest[k]}" "${record_point:--}" "$(record_outcome_of "$status")" "$((SECONDS - row_started[k]))" "row=$label"
    # A group that outlives its leader, as after a unit's stop, may still
    # owe its attempt's closing reading, so records_finish collects it once
    # stop_rows has seen the group end.
    if [[ ${row_command[k]} == "scripts/qml-smoke.sh"* && -n $smoke_results_dir && -d $smoke_results_dir ]] &&
       ! kill -0 -- "-$pid" 2>/dev/null; then
      smoke_collect "$smoke_results_dir"
      smoke_group=""
    fi
  fi
  while [[ $printed -lt ${#selected[@]} && ${row_state[printed]} == ended ]]; do
    IFS='|' read -r _ label _ <<<"${rows[selected[printed]]}"
    if [[ ${row_alone[printed]} == false && $jobs_max -gt 1 ]]; then
      cat -- "$run_dir/$printed.log" || true
    fi
    case "${row_status[printed]}" in
      0) ;;
      77) skipped+=("$label") ;;
      *) failed+=("$label (exit ${row_status[printed]})") ;;
    esac
    printed=$((printed + 1))
  done
done
trap - INT TERM HUP QUIT
printf 'validate: selected=%s area=%s secs=%s\n' "$selected_count" "$area" "$((SECONDS - validate_started))" >&2

if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'validate: failed=%s\n' "$(IFS=';'; echo "${failed[*]}")"
  exit 1
fi
if [[ ${#skipped[@]} -gt 0 ]]; then
  printf 'validate: status=not-measured skipped=%s\n' "$(IFS=';'; echo "${skipped[*]}")"
  exit 77
fi
if [[ $unselected == true ]]; then
  echo 'validate: last-pass=unrecorded reason=unselected' >&2
else
  last_pass_record
fi
echo "validate: ok"
