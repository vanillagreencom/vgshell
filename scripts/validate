#!/usr/bin/env bash
# The product validation manifest, run explicitly rather than by git hooks.
#
# Usage: scripts/validate [AREA] [--changed BASE | --full] [--list] [--skip-unprepared]
#        scripts/validate --prepare-catalog-inputs
#        scripts/validate package|nix --input-hash
#   --input-hash prints the SHA256 of the area's declared repository inputs
#   and this selector, including uncommitted files, without running checks.
#   Nightly uses it to identify a passing container build. It reads no base.
#   AREA is one of: logic, manifests, boundary, cli, tools, repo, offline,
#   unit, package, qml, nix, all (default: all). One area per call.
#   repo holds the checks this file makes itself, the whitespace
#   row, the self-check that every scripts/test-* file has a row, the
#   check that nothing under bin/ or shell/ loads a file under scripts/, the
#   check that no file under bin/, shell/ or config/ writes a monitor rule,
#   the check that no file in the tree holds a PEM private key and the md-refs
#   check of every markdown reference and source citation;
#   scripts/test-validate.sh, under tools, is their control. tools also
#   holds the document byte ceiling check this file makes, selected, unlike
#   a repo row, only when a Markdown file, a file under docs/ or the
#   doc-limits configuration changes; test-validate.sh is its control too.
#   unit runs the QML unit tests, which need Qt and no Wayland session;
#   package builds and installs the Arch recipes in a podman container; nix
#   builds the flake in a container, which needs podman or docker and the
#   network; offline excludes unit, package, nix, nested smoke and the
#   explicitly network-enabled publication row.
#   --changed BASE selects rows whose inputs changed against BASE, including
#   staged, unstaged and untracked files. Renames include both paths. A
#   wildcard input of a qml row or a nested smoke row matches a Markdown
#   file under shell/ only when it ends in .md: index_add. Unknown
#   inputs or an unreadable diff select the whole area. Repository checks
#   always run, except a Markdown/text-only diff selects only text checks,
#   including when the product displays that text. --list prints selected
#   commands without executing them.
#   Without a scope flag, compare against this area's last pass in this
#   worktree, the newest commit since the branch point that holds the tree
#   the last passing run read, else the default branch's merge base.
#   --full explicitly selects every row in the area.
#   A row's input `$NAME` is an environment input it cannot run without,
#   prepared state such as local models; it matches no path. Such a row run
#   with NAME unset exits 77. --skip-unprepared, for a host that holds no
#   prepared state, selects no row whose `$NAME` input is unset or empty and
#   prints `validate: unselected unset=<NAME> row=<label>` on stderr; such a
#   run records no last pass, `validate: last-pass=unrecorded
#   reason=unselected`.
#   A row's input `device:GLOB` requires a character device matching GLOB.
#   --skip-unprepared leaves it unselected when none exists and prints
#   `validate: unselected missing=device:GLOB row=<label>` on stderr.
#   A row's input `%scope` says it reads VGS_VALIDATE_BASE and
#   VGS_VALIDATE_CHANGED to narrow its own work; it matches no path, and
#   only such a row's record binds the base and the scope.
#   A row's input `@NAME` names state it shares with every other row that
#   names it, a fixed file, socket or container; it matches no path. Rows
#   that share a `@NAME` never run at the same time, and a row whose input
#   is `@alone` runs with no other row beside it.
#   A run that compares prints `validate: base=<commit> source=<source>` on
#   stderr, the source one of argument, DEV_VALIDATE_BASE,
#   VGS_VALIDATE_BASE, last-pass or merge-base, in that precedence.
#   A run that passes (exit 0) on the merge base, the last pass or --full
#   records the tree it read, tracked and untracked files git does not
#   ignore, committed or not, as this area's last pass in
#   <git-dir>/vgs-validated-<area> when that tree is the same at its start
#   and end, and prints `validate: last-pass=recorded` or
#   `validate: last-pass=unrecorded reason=<reason>`: last_pass_record.
#   Every executed row prints `validate: secs=<seconds> exit=<status> row=<label>`.
#   The selected rows of one run go side by side, at most
#   VGS_VALIDATE_JOBS at once, and each row's lines from `== <label>` to
#   its secs line print whole in table order; with more than one job, a
#   row not marked `@alone` prints its stderr there on stdout: the run
#   loop below.
#   A diff-scoped run selects the nested smoke when its own inputs match a
#   changed path or one reaches a smoke row, whatever table row owns it
#   (smoke_table_reach), and passes it the rows the
#   change reaches as `scripts/qml-smoke.sh --rows <row>,...`, or no --rows
#   for every row, and prints `validate: smoke-rows=some selected=<n>
#   total=<m>` or `validate: smoke-rows=all reason=<reason>` and the
#   `validate: smoke-input row=<row> ...` self-check lines on stderr:
#   smoke_rows_selected below. Those lines leave that run's exit status
#   alone; the tools row `smoke rows name the rows they read` fails on a
#   `function=`, `variable=`, `source=` or `unparsed` line and exits 77 when the scan
#   could not run: smoke_reads_named below.
#   Each row that ends, and each nested smoke row, records its outcome and
#   seconds in <git-dir>/vgs-validated-rows as it ends, and a selected row
#   a recorded pass covers is reused and not run, by the rule in
#   docs/architecture/validation.md § Selection: the row records below. A
#   run prints each selected row as `validate: reused secs=<s>
#   row=<label>` or `validate: rerun secs=<s> [reason=<reason>]
#   row=<label>`, smoke=<row> for a smoke row, with its last recorded
#   seconds or `unknown`, then `validate: reuse=on rows-reused=<n> ...`
#   with the totals, or `validate: reuse=off reason=<reason>`, --full among
#   the reasons, and `validate: smoke-reuse=off reason=<reason>` when what
#   a smoke row's reach rests on cannot be read.
#
# VGS_VALIDATE_BASE: the commit the whitespace row diffs the tree against;
#   used as the default change base too, ahead of the last pass. --changed
#   and DEV_VALIDATE_BASE override it. Unset,
#   whitespace_base below resolves the base; an unavailable base exits 77.
# DEV_VALIDATE_BASE: the fix-round base supplied by Kendex; used when neither
#   --changed nor --full is present, ahead of VGS_VALIDATE_BASE and the last
#   pass.
# VGS_VALIDATE_CHANGED: on a readable diff-scoped run, the NUL-delimited file
#   of changed paths a row may read to narrow its own work. Unset means
#   everything changed.
# VGS_VALIDATE_JOBS: how many rows run at once, a positive integer; unset or
#   empty is the CPU count, nproc. 1 runs the rows one after another, each
#   printing as it runs.
# The document byte ceiling row reads no base: --changed, VGS_VALIDATE_BASE,
#   DEV_VALIDATE_BASE and the last pass only choose whether it runs.
#
# Exit 0: every selected check passed. Exit 77: every check that ran passed
# but at least one could not run and is named; that is not a pass. Exit 1: a
# check failed. Exit 2: invalid area or arguments, named by
# `validate: refused: area=`, `extra-argument=` or
#   `changed-base=missing-or-repeated` or `scope=conflicting-or-repeated`,
#   or an invalid VGS_VALIDATE_JOBS, `validate: refused: jobs=<value>`.
# Every end of validate bash can see stops the running rows first: an INT,
#   TERM, HUP or QUIT, which exit 130, 143, 129 or 131, and a fatal signal
#   bash takes for its EXIT trap, such as a PIPE. Each row's process group
#   gets TERM, then KILL once 10 s have passed or at a repeat signal; then
#   the nested smoke's per-row results are recorded and the run's scratch
#   directory is removed. A KILL to validate itself cannot be caught: it
#   leaves the running rows going, validate's logs under its temporary
#   directory, and the smoke's results for the next run to record. Each
#   world still owns its row's root.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo="$(cd -- "$(dirname -- "$self")/.." && pwd)"
cd -- "$repo"
# Every row runs under the test-run marker, so the theme judge refuses a
# reload hook that could reach the host's live applications:
# docs/architecture/validation.md.
export VGS_TEST_RUN=1

# Private row re-entry carries selection as data. The parent alone selects
# rows and records a last pass; the child only loads this file's checks.
row_entry=false
if [[ ${1-} == --row ]]; then
  row_entry=true
  export VGS_VALIDATE_BASE="$2"
  row_path_count="$3"
  shift 3
  row_paths=()
  if ((row_path_count >= 0)); then
    row_paths=("${@:1:row_path_count}")
    shift "$row_path_count"
  fi
  shift # the command separator
  row_words=("$@")
  set --
fi

area="all"
area_given=false
change_base=""
list_only=false
full_scope=false
input_hash=false
skip_unprepared=false
unselected=false
catalog_prepare_only=false
catalog_listings=""
if [[ $# == 1 && $1 == --prepare-catalog-inputs ]]; then
  catalog_prepare_only=true
  set --
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --changed)
      if [[ $full_scope == true ]]; then
        echo 'validate: refused: scope=conflicting-or-repeated' >&2; exit 2
      fi
      if [[ $# -lt 2 || -z $2 || $2 == -* || -n $change_base ]]; then
        echo 'validate: refused: changed-base=missing-or-repeated' >&2; exit 2
      fi
      change_base="$2"; shift 2 ;;
    --full)
      if [[ $full_scope == true || -n $change_base ]]; then
        echo 'validate: refused: scope=conflicting-or-repeated' >&2; exit 2
      fi
      full_scope=true; shift ;;
    --list) list_only=true; shift ;;
    --input-hash) input_hash=true; shift ;;
    --skip-unprepared) skip_unprepared=true; shift ;;
    *)
      if [[ $area_given == true ]]; then
        printf 'validate: refused: extra-argument=%s\none area per call\n' "$1" >&2; exit 2
      fi
      area="$1"; area_given=true; shift ;;
  esac
done
case "$area" in
  logic|manifests|boundary|cli|tools|repo|offline|unit|package|qml|nix|all) ;;
  *) printf 'validate: refused: area=%s\n' "$area" >&2; exit 2 ;;
esac
if [[ $input_hash == true ]]; then
  if [[ $area != package && $area != nix ]] || [[ $full_scope == true || -n $change_base || $list_only == true || $skip_unprepared == true ]]; then
    echo 'validate: refused: input-hash=requires-package-or-nix-only' >&2; exit 2
  fi
  full_scope=true
fi
jobs_max="${VGS_VALIDATE_JOBS:-}"
if [[ -z $jobs_max ]]; then
  jobs_max="$(nproc)"
elif [[ ! $jobs_max =~ ^[1-9][0-9]*$ ]]; then
  printf 'validate: refused: jobs=%s\n' "$jobs_max" >&2; exit 2
fi
failed=()
skipped=()
# A scratch file, or with -d a directory, under the row's temporary root. mktemp
# makes it by exclusive creation: the rows of one run share $$ and run side
# by side, so a name picked first and created after can go to two rows, and
# the row that removes it first leaves the other with no file.
scratch_make() { # [-d]
  local root
  root="${TMPDIR:-/tmp}"
  mktemp "$@" -- "$root/validate-$$-XXXXXXXX"
}
scratch_file() { scratch_make; }
scratch_dir() { scratch_make -d; }

# node on PATH may be a version-manager shim that reads the caller's own
# configuration and refuses under a row's temporary home, so each row reaches
# node through a link to the binary it resolves to here.
node_bin=""
if command -v node >/dev/null; then
  node_bin="$(node -e 'process.stdout.write(process.execPath)')" ||
    { echo 'validate: node=unresolved' >&2; exit 1; }
fi

# The world owns each row's home, XDG directories, scratch and cleanup.
# docs/architecture/validation.md § Test isolation.
# Package and nix use their own containers and keep the caller's image
# store. The world's control runs outside so it can test the actual boundary.
run() { # SCRATCH WORLD-OWNER LABEL CMD...
  local row_home="$1" owner="${2:-row}" label="$3" started status elapsed
  local path_count=-1 paths=() declarations=(--fresh)
  shift 3
  if [[ $1 == catalog_wallpaper_names ]]; then
    declarations+=(--input "$catalog_listings")
    set -- "$@" "$catalog_listings"
  fi
  echo "== $label"
  started=$SECONDS
  status=0
  (
    if [[ $owner == container || $owner == control ]]; then
      mkdir -- "$row_home" || exit 1
      trap 'chmod -R u+rwX -- "$row_home" 2>/dev/null; rm -rf -- "${row_home:?}"' EXIT
      export XDG_CONFIG_HOME="$row_home/.config" GIT_CONFIG_GLOBAL="$row_home/gitconfig"
      [[ -z $node_bin ]] || export PATH="${node_bin%/*}:$PATH"
      "$@"
    elif [[ $owner == entry ]]; then
      # A parallel packaging row cannot stop a nested entry from starting.
      "$repo/scripts/smoke/gpu-fence.sh" --fresh -- node "$repo/scripts/check-packaging.js" --installed-engine || exit "$?"
      # Graphical runners own their output declarations before world entry.
      "$@"
    else
      [[ $owner != network ]] || declarations+=(--net)
      if [[ -n ${VGS_VALIDATE_CHANGED:-} ]]; then
        mapfile -d '' -t paths <"$VGS_VALIDATE_CHANGED" || exit 1
        path_count=${#paths[@]}
      fi
      "$repo/scripts/smoke/gpu-fence.sh" "${declarations[@]}" -- "$BASH" "$self" --row "${VGS_VALIDATE_BASE:-}" "$path_count" "${paths[@]}" -- "$@"
    fi
  ) || status=$?
  elapsed=$((SECONDS - started))
  printf 'validate: secs=%s exit=%s row=%s\n' "$elapsed" "$status" "$label"
  return "$status"
}

catalog_input_prepare() {
  local status=0
  catalog_listings="$(realpath -m -- "${XDG_CACHE_HOME:-$HOME/.cache}/vgshell/validate/theme-listings")" || return 1
  printf 'validate: input-step=catalog path=%q\n' "$catalog_listings"
  node "$repo/scripts/check-catalog-wallpaper-names.js" --prepare "$repo/themes" "$catalog_listings" || status=$?
  if [[ $status == 0 && ! -d $catalog_listings ]]; then
    echo 'validate: input-step=failed name=catalog reason=missing-output' >&2
    return 1
  fi
  if [[ $status != 0 ]]; then
    printf 'validate: input-step=failed name=catalog exit=%s\n' "$status" >&2
  fi
  return "$status"
}

catalog_wallpaper_names() {
  node "$repo/scripts/check-catalog-wallpaper-names.js" "$repo/themes" "$1"
}

# Rows: area | label | command | additional input globs, space-delimited,
# and the `$NAME` environment inputs and `@NAME` shared state the header
# names | world owner (default row). An entry owns its world's declarations;
# network retains the world with live network access; a container supplies
# its own boundary. The world's control needs the
# caller's writable checkout to prove entry and read-only checks.
# The command's words that hold a slash are also inputs. Every input glob
# counts, a root file such as VERSION included.
rows=(
