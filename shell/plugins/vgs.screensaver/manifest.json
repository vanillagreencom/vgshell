{
  "schemaVersion": 1,
  "id": "vgs.screensaver",
  "name": "Screensaver",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show animated text art when the desktop is inactive.",
  "license": "MIT",
  "icon": "monitor-play",
  "kinds": ["service", "cover"],
  "entryPoints": { "service": "Service.qml", "cover": "Cover.qml" },
  "capabilities": ["idle", "ipc", "requirements", "session", "shortcut", "status"],
  "requirements": [
    { "command": "ttfx", "packages": { "aur": "ttfx" }, "optional": false, "purpose": "Animates the screensaver text art" }
  ],
  "settings": {
    "idleEnabled": true,
    "idleSeconds": 150,
    "effect": "random",
    "frameRate": 30
  },
  "schema": {
    "idleEnabled": { "type": "boolean", "label": "Start when inactive", "group": "Screensaver" },
    "idleSeconds": {
      "type": "number",
      "label": "Start after",
      "min": 1,
      "max": 86400,
      "step": 30,
      "unit": "seconds",
      "allowCustom": true,
      "presets": [
        { "value": 60 },
        { "value": 120 },
        { "value": 150 },
        { "value": 300 },
        { "value": 600 },
        { "value": 900 },
        { "value": 1800 }
      ],
      "group": "Screensaver"
    },
    "effect": { "type": "string", "label": "Effect", "optionsFrom": "effects", "group": "Screensaver" },
    "frameRate": {
      "type": "number",
      "label": "Frame rate",
      "min": 1,
      "max": 120,
      "step": 1,
      "allowCustom": true,
      "presets": [
        { "value": 15 },
        { "value": 30 },
        { "value": 60 },
        { "value": 120 }
      ],
      "group": "Screensaver"
    }
  },
  "status": {
    "state": { "type": "state", "label": "Screensaver" },
    "effects": { "type": "choices", "label": "Effects", "hidden": true }
  },
  "menu": {
    "system.screensaver": { "label": "Screensaver", "icon": "monitor-play", "shortcut": "start" }
  }
}
