{
  "schemaVersion": 1,
  "id": "vgs.tray",
  "name": "Tray",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show the tray icons of your apps in the bar, with their menus.",
  "license": "MIT",
  "icon": "inbox",
  "kinds": ["bar-widget", "service"],
  "entryPoints": { "bar-widget": "Widget.qml", "service": "Service.qml" },
  "capabilities": ["configure", "ipc", "status"],
  "defaultSection": "right",
  "settings": {
    "pinned": [],
    "hidden": []
  },
  "schema": {
    "pinned": {
      "type": "list",
      "label": "Pinned icons",
      "description": "The other icons wait behind the arrow",
      "items": {
        "item": { "type": "string", "label": "Icon", "optionsFrom": "items", "placeholder": "Choose an app" }
      },
      "defaults": { "item": "" }
    },
    "hidden": {
      "type": "list",
      "label": "Hidden icons",
      "items": {
        "item": { "type": "string", "label": "Icon", "optionsFrom": "items", "placeholder": "Choose an app" }
      },
      "defaults": { "item": "" }
    }
  },
  "status": {
    "items": { "type": "choices", "label": "Tray icons" }
  }
}
