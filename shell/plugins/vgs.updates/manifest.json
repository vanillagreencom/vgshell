{
  "schemaVersion": 1,
  "id": "vgs.updates",
  "name": "Updates",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Update your system, VGS, plugins, themes and tools.",
  "license": "MIT",
  "icon": "refresh-cw",
  "kinds": ["service", "bar-widget", "window", "panel"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "window": "Window.qml", "panel": "RebootNotice.qml" },
  "capabilities": ["configure", "ipc", "run", "screens", "shortcut", "status", "surfaces", "system", "tui"],
  "capabilityKinds": { "run": ["window"] },
  "systemSteps": ["reboot-notice"],
  "defaultSection": "right",
  "requirements": [
    {"command": "busctl", "packages": {"pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd"}, "optional": false, "purpose": "Reads internet connectivity before checking for updates"},
    {"dbus": {"bus": "system", "name": "org.freedesktop.NetworkManager", "label": "NetworkManager"}, "packages": {"pacman": "networkmanager", "apt": "network-manager", "dnf": "NetworkManager", "nix": "networkmanager"}, "optional": false, "purpose": "Reports internet connectivity before checking for updates"},
    {"command": "checkupdates", "packages": {"pacman": "pacman-contrib"}, "optional": false, "purpose": "Checks Arch system updates"},
    {"command": "snapper", "packages": {"pacman": "snapper", "apt": "snapper"}, "optional": true, "purpose": "Saves a system snapshot before updates"},
    {"command": "timeshift", "packages": {"pacman": "timeshift", "apt": "timeshift"}, "optional": true, "purpose": "Saves a system snapshot when Snapper is unavailable"},
    {"command": "less", "packages": {"pacman": "less", "apt": "less", "dnf": "less", "nix": "less"}, "optional": false, "purpose": "Shows the last update log"}
  ],
  "tui": {
    "update": { "script": "tui/update.sh", "title": "Update all", "size": "tall" },
    "update-source": { "script": "tui/update-source.sh", "title": "Update one source", "size": "tall", "requires": [] },
    "log": { "script": "tui/log.sh", "title": "Last update log", "size": "tall", "presentation": "plain" }
  },
  "menu": {
    "packages.install": { "label": "Install", "icon": "package", "tui": "core/pkg-install" },
    "packages.update": { "label": "Update", "icon": "refresh-cw", "aliases": ["Update all"], "shortcut": "update-all" },
    "packages.remove": { "label": "Remove", "icon": "package", "aliases": ["uninstall"], "tui": "core/pkg-remove" }
  },
  "settings": {
    "intervalHours": 6,
    "hideWhenCurrent": false,
    "aurCommand": "",
    "snapshot": "auto",
    "trustPluginUpdates": false,
    "rebootNotice": "",
    "rebootNoticeAnswered": false
  },
  "schema": {
    "intervalHours": {"type": "number", "label": "Check interval", "min": 1, "max": 48, "step": 1, "unit": "hours", "group": "Schedule"},
    "hideWhenCurrent": {"type": "boolean", "label": "Hide when up to date", "description": "Hides the icon only after a recent check finds no updates", "group": "Display"},
    "aurCommand": {"type": "string", "label": "AUR command", "info": "Automatic lets VGS choose the command to update AUR packages.", "group": "Update options", "allowCustom": true, "presets": [{"value": "", "label": "Automatic"}, {"value": "paru -Sua"}, {"value": "yay -Sua"}]},
    "snapshot": {"type": "enum", "label": "System snapshot", "description": "Keeps a copy of system files to restore after a failed update", "info": "Automatic saves a snapshot only if Snapper or Timeshift is installed and set up.\nOff skips the snapshot.", "options": [{"value": "auto", "label": "Automatic"}, {"value": "off", "label": "Off"}], "group": "Update options"},
    "trustPluginUpdates": {"type": "boolean", "label": "Trust plugin and theme updates", "description": "Applies plugin and theme updates without asking you to confirm", "group": "Update options"},
    "rebootNotice": {"type": "string", "label": "Reboot notice", "info": "VGS asks for a restart only when an update needs one.\n\"CachyOS and VGS\" keeps CachyOS notices for every update.\n\"VGS only\" turns those notices off.\nA terminal asks you to confirm this change and can ask for your password.", "group": "Update options", "optionsFrom": "rebootNotices", "hideEmpty": true}
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+U" },
      { "shortcut": "update-all", "key": null }
    ]
  },
  "status": {
    "pending": {"type": "count", "label": "Updates available"},
    "lastCheck": {"type": "time", "label": "Last checked"},
    "checkState": {"type": "state", "label": "Check"},
    "checking": {"type": "data", "label": "Checking"},
    "admission": {"type": "data", "label": "Internet access"},
    "sources": {"type": "data", "label": "Sources"},
    "lastRun": {"type": "data", "label": "Last update"},
    "rebootNotices": {"type": "choices", "label": "Reboot notices"},
    "rebootNoticeOwner": {"type": "state", "label": "Reboot notice"},
    "rebootNotice": {"type": "state", "label": "Reboot notice", "hidden": true, "actions": {"vgsOnly": {"label": "Turn off CachyOS notices", "system": "reboot-notice"}, "both": {"label": "Turn on CachyOS notices", "undo": "reboot-notice"}}}
  }
}
