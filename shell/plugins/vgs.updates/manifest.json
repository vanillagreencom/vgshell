{
  "schemaVersion": 1,
  "id": "vgs.updates",
  "name": "Updates",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Update your system, VGS, plugins, themes and tools.",
  "license": "MIT",
  "icon": "refresh-cw",
  "kinds": ["service", "bar-widget", "window", "panel"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "window": "Window.qml", "panel": "RebootNotice.qml" },
  "capabilities": ["configure", "ipc", "run", "screens", "shortcut", "status", "surfaces", "system", "tui"],
  "capabilityKinds": { "run": ["window"] },
  "systemSteps": ["reboot-notice"],
  "defaultSection": "right",
  "requirements": [
    {"command": "checkupdates", "packages": {"pacman": "pacman-contrib"}, "optional": false, "purpose": "Checks Arch system updates"},
    {"command": "snapper", "packages": {"pacman": "snapper", "apt": "snapper"}, "optional": true, "purpose": "Saves a system snapshot before updates"},
    {"command": "timeshift", "packages": {"pacman": "timeshift", "apt": "timeshift"}, "optional": true, "purpose": "Saves a system snapshot when Snapper is unavailable"},
    {"command": "less", "packages": {"pacman": "less", "apt": "less", "dnf": "less", "nix": "less"}, "optional": false, "purpose": "Shows the last update log"}
  ],
  "tui": {
    "update": { "script": "tui/update.sh", "title": "Update everything", "size": "tall", "entry": { "label": "Update everything", "icon": "refresh-cw", "group": "Update" } },
    "update-source": { "script": "tui/update-source.sh", "title": "Update one source", "size": "tall", "requires": [] },
    "log": { "script": "tui/log.sh", "title": "Last update log", "size": "tall", "presentation": "plain" }
  },
  "menu": {
    "packages.install": { "label": "Install", "icon": "package", "tui": "core/pkg-install" },
    "packages.update": { "label": "Update", "icon": "refresh-cw", "tui": "vgs.updates/update" },
    "packages.remove": { "label": "Remove", "icon": "package", "aliases": ["uninstall"], "tui": "core/pkg-remove" }
  },
  "settings": {
    "intervalHours": 6,
    "hideWhenCurrent": false,
    "aurCommand": "",
    "snapshot": "auto",
    "trustPluginUpdates": false,
    "rebootNotice": "",
    "rebootNoticeAnswered": false
  },
  "schema": {
    "intervalHours": {"type": "number", "label": "Check interval", "min": 1, "max": 48, "step": 1, "unit": "hours", "group": "Schedule"},
    "hideWhenCurrent": {"type": "boolean", "label": "Hide when up to date", "description": "Hides the icon only after a recent check finds no updates", "group": "Display"},
    "aurCommand": {"type": "string", "label": "AUR command", "info": "The command that updates packages from the Arch User Repository. Automatic lets VGS choose.", "group": "Update options", "allowCustom": true, "presets": [{"value": "", "label": "Automatic"}, {"value": "paru -Sua"}, {"value": "yay -Sua"}]},
    "snapshot": {"type": "enum", "label": "System snapshot", "description": "Keeps a copy of system files to restore after a failed update", "info": "Auto saves a snapshot before updates only when Snapper or Timeshift is installed and already set up.\nOff skips the snapshot.", "options": [{"value": "auto", "label": "Auto"}, {"value": "off", "label": "Off"}], "group": "Update options"},
    "trustPluginUpdates": {"type": "boolean", "label": "Trust plugin and theme updates", "description": "Applies plugin and theme updates without asking you to confirm", "group": "Update options"},
    "rebootNotice": {"type": "string", "label": "Reboot notice", "info": "With either choice, VGS asks once after all update steps when an update needs a restart. Choose CachyOS and VGS to keep the CachyOS notices for updates outside VGS. Choose VGS only to turn them off. VGS asks you to confirm in a terminal, and for your password if needed.", "group": "Update options", "optionsFrom": "rebootNotices", "hideEmpty": true}
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+CTRL+U", "info": "Opens the Updates window, or closes it." }
    ]
  },
  "status": {
    "pending": {"type": "count", "label": "Updates waiting"},
    "lastCheck": {"type": "time", "label": "Last checked"},
    "checkState": {"type": "state", "label": "Check"},
    "checking": {"type": "data", "label": "Checking"},
    "sources": {"type": "data", "label": "Sources"},
    "rebootNotices": {"type": "choices", "label": "Reboot notices"},
    "rebootNoticeOwner": {"type": "state", "label": "Reboot notice"},
    "rebootNotice": {"type": "state", "label": "Reboot notice", "hidden": true, "actions": {"vgsOnly": {"label": "Turn off CachyOS notices outside VGS", "system": "reboot-notice"}, "both": {"label": "Turn on CachyOS notices outside VGS", "undo": "reboot-notice"}}}
  }
}
