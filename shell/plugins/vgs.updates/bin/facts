#!/usr/bin/env node
// vgs.updates facts: reads one answer on stdin, a vgshell JSON answer or
// the text a verb names, and prints the facts the update pipeline,
// tui/pipeline.sh, acts on, one `<key> <value>` line each, so bash never
// parses JSON. What an update of VGS runs is `vgshell self status`'s
// own `step`. Whether a plugin or a theme is behind, and the reboot policy are UpdatesLogic.js's
// decisions, the ones the service acts on too, loaded
// through the core's qml-library loader. A command is found on PATH as
// bin/lib/judge-files.js, beside the loader, finds it.
//
//   facts <loader> detect           `vgshell pkg detect --json`
//       `primary <id>` when a primary serves the system, then
//       `present <id> <binary>` for each overlay and source
//   facts <loader> plan             `vgshell pkg plan upgrade <id>`
//       `elevate true|false`, `elevator <command>` or
//       `elevator-refused <refusal>` when the plan elevates, then
//       `step <argv joined by spaces>` per step
//   facts <loader> self             `vgshell self status --json`
//       `error <refusal>` when the status names one; else `package <name>`
//       when a package owns the tree, `current <version>`, `step
//       self|rebuild|install-helper|none` and `reason <reason>` when a step of none
//       names one
//   facts <loader> owner            `vgshell pkg owner <path>`
//       `version <version>`
//   facts <loader> outdated plugins|themes
//                                   `vgshell plugin|theme outdated --json`
//       `update <id>` for each checkout behind its upstream, then
//       `error <text>` naming each checkout whose probe failed
//   facts <loader> settings         `vgshell plugin settings vgs.updates`
//       `aur-command <text>`, `snapshot auto|off`, `trust true|false`
//   facts <loader> reboot <hook> <version>
//                                   the run's changes, `upgrade <name>` or
//                                   `install <name>`, and `mounted <type>`
//                                   per mounted file system, one a line
//       `reboot <name>` per changed package UpdatesLogic.rebootPackages
//       keeps by the reboot hook at path HOOK, `-` when there is none,
//       and the running kernel VERSION, a /proc/version path
// Every refusal is one line on stderr, `updates-facts: refused: <key>=<value>`,
// and exit 2 for a bad invocation, 1 for an answer it cannot read. A value
// holding a control character is refused, since the lines are the protocol.
"use strict";
const fs = require("node:fs");
const path = require("node:path");

function refuse(first, status) {
    process.stderr.write("updates-facts: refused: " + first + "\n");
    process.exit(status);
}

const [loaderPath, verb, source] = process.argv.slice(2);
if (loaderPath === undefined || verb === undefined) refuse("arguments=want-loader-verb", 2);

// The answer on stdin, read only by the verbs that take one.
function text() {
    try {
        return fs.readFileSync(0, "utf8");
    } catch (e) {
        refuse(verb + "=unreadable", 1);
    }
}
function json() {
    try {
        return JSON.parse(text());
    } catch (e) {
        refuse(verb + "=unparseable", 1);
    }
}

const lines = [];
function line(key, value) {
    const text = String(value);
    if (/[\u0000-\u001f\u007f]/.test(text)) refuse(verb + "=control-character key=" + key, 1);
    lines.push(key + " " + text);
}
function isObject(value) {
    return value !== null && typeof value === "object" && !Array.isArray(value);
}
function logic() {
    const { load } = require(loaderPath);
    const PageReference = load(path.join(path.dirname(loaderPath), "..", "..", "shell", "Commons", "PageReference.js"));
    return load(path.join(__dirname, "..", "UpdatesLogic.js"), { "qs.Commons 1.0": { PageReference } });
}

switch (verb) {
case "detect": {
    const answer = json();
    if (!isObject(answer) || !Array.isArray(answer.overlays) || !Array.isArray(answer.sources)) refuse("detect=malformed", 1);
    if (answer.primary !== null) line("primary", answer.primary.id);
    for (const row of answer.overlays.concat(answer.sources)) line("present", row.id + " " + row.binary);
    break;
}
case "plan": {
    const answer = json();
    if (!isObject(answer) || typeof answer.elevate !== "boolean" || !Array.isArray(answer.steps)) refuse("plan=malformed", 1);
    // null exactly when the plan does not elevate, else the table's answer.
    const elevator = answer.elevator;
    const judged = elevator === null ? !answer.elevate
        : answer.elevate && isObject(elevator) && typeof elevator.ok === "boolean" && typeof (elevator.ok ? elevator.command : elevator.error) === "string";
    if (!judged) refuse("plan=malformed", 1);
    line("elevate", answer.elevate);
    if (elevator !== null) line(elevator.ok ? "elevator" : "elevator-refused", elevator.ok ? elevator.command : elevator.error);
    for (const step of answer.steps) line("step", step.join(" "));
    break;
}
case "self": {
    const answer = json();
    if (!isObject(answer)) refuse("self=malformed", 1);
    if (typeof answer.error === "string") {
        line("error", answer.error);
        break;
    }
    const reasons = logic().SELF_STEPS;
    if (answer.error !== null || !Object.hasOwn(reasons, answer.step) || !reasons[answer.step].includes(answer.reason)
        || typeof answer.current !== "string" || (answer.package !== null && typeof answer.package !== "string"))
        refuse("self=malformed", 1);
    if (answer.package !== null) line("package", answer.package);
    line("current", answer.current);
    line("step", answer.step);
    if (answer.reason !== null) line("reason", answer.reason);
    break;
}
case "owner": {
    const answer = json();
    if (!isObject(answer) || typeof answer.version !== "string") refuse("owner=malformed", 1);
    line("version", answer.version);
    break;
}
case "outdated": {
    const answer = json();
    if (source !== "plugins" && source !== "themes") refuse("outdated=" + (source || "missing"), 2);
    const row = logic().normalizeOutdated(source, { status: 0, stdout: JSON.stringify(answer), stderr: "" }, 0);
    if (row.count === null) refuse("outdated=" + source + " reason=" + row.error, 1);
    for (const pkg of row.packages) line("update", pkg.name);
    if (row.error !== null) line("error", row.error);
    break;
}
case "settings": {
    const answer = json();
    if (!isObject(answer) || typeof answer.aurCommand !== "string" || typeof answer.trustPluginUpdates !== "boolean"
        || (answer.snapshot !== "auto" && answer.snapshot !== "off"))
        refuse("settings=malformed", 1);
    line("aur-command", answer.aurCommand);
    line("snapshot", answer.snapshot);
    line("trust", answer.trustPluginUpdates);
    break;
}
case "reboot": {
    if (process.argv.length !== 6) refuse("reboot=want-hook-version", 2);
    const read = file => {
        try {
            return fs.readFileSync(file, "utf8");
        } catch (e) {
            refuse("reboot=unreadable path=" + file + " error=" + e.code, 1);
        }
    };
    const changes = [];
    const mounted = [];
    for (const entry of text().split("\n")) {
        const m = /^(upgrade|install|mounted) (\S+)$/.exec(entry);
        if (m === null) {
            if (entry !== "") refuse("reboot=malformed", 1);
        } else if (m[1] === "mounted") mounted.push(m[2]);
        else changes.push({ operation: m[1] === "upgrade" ? "Upgrade" : "Install", name: m[2] });
    }
    const table = logic();
    const hook = process.argv[4] === "-" ? null : read(process.argv[4]);
    for (const name of table.rebootPackages(hook, changes, table.kernelPackage(read(process.argv[5])), mounted)) line("reboot", name);
    break;
}
default:
    refuse("verb=" + verb, 2);
}
if (lines.length > 0) process.stdout.write(lines.join("\n") + "\n");
