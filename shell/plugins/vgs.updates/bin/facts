#!/usr/bin/env node
// vgs.updates facts: reads one answer on stdin, a vgshell JSON answer or
// the text a verb names, and prints the facts the update pipeline,
// tui/pipeline.sh, acts on, one `<key> <value>` line each, so bash never
// parses JSON. What an update of VGS runs is `vgshell self status`'s
// own `step`. Whether a plugin or a theme is behind, and the reboot policy are UpdatesLogic.js's
// decisions, the ones the service acts on too, loaded
// through the core's qml-library loader. A command is found on PATH as
// bin/lib/judge-files.js, beside the loader, finds it.
//
//   facts <loader> detect           `vgshell pkg detect --json`
//       `primary <id>` when a primary serves the system, then
//       `present <id> <binary>` for each overlay and source
//   facts <loader> plan             `vgshell pkg plan upgrade <id>`
//       `elevate true|false`, `elevator <command>` or
//       `elevator-refused <refusal>` when the plan elevates, then
//       `step <argv joined by spaces>` per step
//   facts <loader> self             `vgshell self status --json`
//       `error <refusal>` when the status names one; else `package <name>`
//       when a package owns the tree, `current <version>`, `step
//       self|rebuild|install-helper|aur-upgrade|none` and `reason <reason>` when a step of none
//       names one
//   facts <loader> check <source>   `vgshell pkg check --json --source <source>`
//       `count <n>` when the check counted SOURCE's updates, `error <error>`
//       when it could not, and nothing when the system takes no package
//       from SOURCE; the rows are UpdatesLogic.normalizePkg's, the
//       window's own
//   facts <loader> owner            `vgshell pkg owner <path>`
//       `version <version>`
//   facts <loader> outdated plugins|themes
//                                   `vgshell plugin|theme outdated --json`
//       `update <id>` for each checkout behind its upstream, then
//       `error <text>` naming each checkout whose probe failed
//   facts <loader> settings         `vgshell plugin settings vgs.updates`
//       `aur-command <text>`, `snapshot auto|off`, `trust true|false`
//   facts <loader> reboot            the run's or package log's changes,
//                                   `upgrade|install|remove <name>` per line
//       `reboot <name>` per package kept by UpdatesLogic.rebootPackages,
//       with the distribution's reboot hook, current mounts and kernel
//   facts <loader> outcome <file>   the last run's outcome JSON; converts
//       older saved outcomes in place before judging the current format
// Every refusal is one line on stderr, `updates-facts: refused: <key>=<value>`,
// and exit 2 for a bad invocation, 1 for an answer it cannot read. A value
// holding a control character is refused, since the lines are the protocol.
"use strict";
const fs = require("node:fs");
const path = require("node:path");
const cp = require("node:child_process");
const FACTS_CHILD_TIMEOUT_MS = 15000;

function refuse(first, status) {
    process.stderr.write("updates-facts: refused: " + first + "\n");
    process.exit(status);
}

const [loaderPath, verb, source] = process.argv.slice(2);
if (loaderPath === undefined || verb === undefined) refuse("arguments=want-loader-verb", 2);

// The answer on stdin, read only by the verbs that take one.
function text() {
    try {
        return fs.readFileSync(0, "utf8");
    } catch (e) {
        refuse(verb + "=unreadable", 1);
    }
}
function json() {
    try {
        return JSON.parse(text());
    } catch (e) {
        refuse(verb + "=unparseable", 1);
    }
}

const lines = [];
function line(key, value) {
    const text = String(value);
    if (/[\u0000-\u001f\u007f]/.test(text)) refuse(verb + "=control-character key=" + key, 1);
    lines.push(key + " " + text);
}
function isObject(value) {
    return value !== null && typeof value === "object" && !Array.isArray(value);
}
function logic() {
    const { load } = require(loaderPath);
    const PageReference = load(path.join(path.dirname(loaderPath), "..", "..", "shell", "Commons", "PageReference.js"));
    return load(path.join(__dirname, "..", "UpdatesLogic.js"), { "qs.Commons 1.0": { PageReference } });
}

switch (verb) {
case "outcome": {
    if (!source || !path.isAbsolute(source)) refuse("outcome=want-absolute-path", 2);
    try { fs.lstatSync(source); }
    catch (error) {
        if (error.code === "ENOENT") { process.stdout.write("null\n"); process.exit(0); }
        refuse("outcome=unreadable cause=" + error.code, 1);
    }
    // The pipeline publishes under this same short lock. A startup
    // migration must never replace an outcome a finishing run just wrote.
    const result = cp.spawnSync("flock", ["-w", "10", "-E", "75", path.join(path.dirname(source), "outcome.lock"), process.execPath, __filename, loaderPath, "outcome-held", source],
        { stdio: "inherit", timeout: FACTS_CHILD_TIMEOUT_MS });
    if (result.error || result.signal) refuse("outcome=lock-unavailable", 1);
    if (result.status === 75) refuse("outcome=busy", 1);
    process.exit(result.status);
    break;
}
// Private continuation of outcome's lock holder, never called by a view.
case "outcome-held": {
    if (!source || !path.isAbsolute(source)) refuse("outcome=want-absolute-path", 2);
    let fd;
    try { fd = fs.openSync(source, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW); }
    catch (error) {
        if (error.code === "ENOENT") { process.stdout.write("null\n"); process.exit(0); }
        refuse("outcome=unreadable cause=" + error.code, 1);
    }
    try {
        let bytes, modifiedAt;
        try {
            const stat = fs.fstatSync(fd);
            if (!stat.isFile() || stat.uid !== process.getuid()) refuse("outcome=unsafe", 1);
            modifiedAt = stat.mtimeMs;
            bytes = fs.readFileSync(fd, "utf8");
        } finally { fs.closeSync(fd); }
        const before = JSON.parse(bytes), judge = logic();
        const converted = judge.migrateOutcome(before, modifiedAt);
        const current = judge.runOutcome(JSON.stringify(converted));
        if (current === null) refuse("outcome=malformed", 1);
        if (before.version !== current.version) {
            const pending = source + "." + process.pid;
            fs.writeFileSync(pending, JSON.stringify(current) + "\n", { mode: 0o600, flag: "wx" });
            fs.renameSync(pending, source);
        }
        process.stdout.write(JSON.stringify(current) + "\n");
        process.exit(0);
    } catch (error) {
        refuse("outcome=unreadable cause=" + (error.code || error.name), 1);
    }
    break;
}
case "detect": {
    const answer = json();
    if (!isObject(answer) || !Array.isArray(answer.overlays) || !Array.isArray(answer.sources)) refuse("detect=malformed", 1);
    if (answer.primary !== null) line("primary", answer.primary.id);
    for (const row of answer.overlays.concat(answer.sources)) line("present", row.id + " " + row.binary);
    break;
}
case "plan": {
    const answer = json();
    if (!isObject(answer) || typeof answer.elevate !== "boolean" || !Array.isArray(answer.steps)) refuse("plan=malformed", 1);
    // null exactly when the plan does not elevate, else the table's answer.
    const elevator = answer.elevator;
    const judged = elevator === null ? !answer.elevate
        : answer.elevate && isObject(elevator) && typeof elevator.ok === "boolean" && typeof (elevator.ok ? elevator.command : elevator.error) === "string";
    if (!judged) refuse("plan=malformed", 1);
    line("elevate", answer.elevate);
    if (elevator !== null) line(elevator.ok ? "elevator" : "elevator-refused", elevator.ok ? elevator.command : elevator.error);
    for (const step of answer.steps) line("step", step.join(" "));
    break;
}
case "self": {
    const answer = json();
    if (!isObject(answer)) refuse("self=malformed", 1);
    if (typeof answer.error === "string") {
        line("error", answer.error);
        break;
    }
    const reasons = logic().SELF_STEPS;
    if (answer.error !== null || !Object.hasOwn(reasons, answer.step) || !reasons[answer.step].includes(answer.reason)
        || typeof answer.current !== "string" || (answer.package !== null && typeof answer.package !== "string"))
        refuse("self=malformed", 1);
    if (answer.package !== null) line("package", answer.package);
    line("current", answer.current);
    line("step", answer.step);
    if (answer.reason !== null) line("reason", answer.reason);
    break;
}
case "check": {
    if (source === undefined) refuse("check=missing", 2);
    const rows = logic().normalizePkg({ status: 0, stdout: text(), stderr: "" });
    const found = rows.filter(row => row.source === source);
    if (found.length !== rows.length || found.length > 1) refuse("check=malformed source=" + source, 1);
    if (found.length === 0) break;
    if (typeof found[0].error === "string") line("error", found[0].error);
    else if (Number.isInteger(found[0].count) && found[0].count >= 0) line("count", found[0].count);
    else refuse("check=malformed source=" + source, 1);
    break;
}
case "owner": {
    const answer = json();
    if (!isObject(answer) || typeof answer.version !== "string") refuse("owner=malformed", 1);
    line("version", answer.version);
    break;
}
case "outdated": {
    const answer = json();
    if (source !== "plugins" && source !== "themes") refuse("outdated=" + (source || "missing"), 2);
    const row = logic().normalizeOutdated(source, { status: 0, stdout: JSON.stringify(answer), stderr: "" }, 0);
    if (row.count === null) refuse("outdated=" + source + " reason=" + row.error, 1);
    for (const pkg of row.packages) line("update", pkg.name);
    if (row.error !== null) line("error", row.error);
    break;
}
case "settings": {
    const answer = json();
    if (!isObject(answer) || typeof answer.aurCommand !== "string" || typeof answer.trustPluginUpdates !== "boolean"
        || (answer.snapshot !== "auto" && answer.snapshot !== "off"))
        refuse("settings=malformed", 1);
    line("aur-command", answer.aurCommand);
    line("snapshot", answer.snapshot);
    line("trust", answer.trustPluginUpdates);
    break;
}
case "reboot": {
    if (source !== undefined) refuse("reboot=unexpected-arguments", 2);
    const read = (file, optional = false) => {
        try {
            return fs.readFileSync(file, "utf8");
        } catch (e) {
            if (optional && e.code === "ENOENT") return null;
            refuse("reboot=unreadable path=" + file + " error=" + e.code, 1);
        }
    };
    const probe = (command, args) => {
        // spawnSync waits for the child after sending the timeout signal.
        // These read-only helpers have nothing to flush before they exit.
        const result = cp.spawnSync(command, args, { encoding: "utf8", timeout: FACTS_CHILD_TIMEOUT_MS, killSignal: "SIGKILL" });
        if (result.error || result.status !== 0) {
            const cause = result.error?.code ?? result.signal ?? result.status;
            refuse("reboot=unreadable operation=" + command + " cause=" + cause, 1);
        }
        return result.stdout.trim();
    };
    const changes = [];
    for (const entry of text().split("\n")) {
        const m = /^(upgrade|install|remove) (\S+)$/.exec(entry);
        if (m === null) {
            if (entry !== "") refuse("reboot=malformed", 1);
        } else changes.push({ operation: m[1][0].toUpperCase() + m[1].slice(1), name: m[2] });
    }
    // pacman-conf(8) prints the resolved RootDir. Read the distribution
    // hook even when the user's higher-priority hook disables it.
    const root = probe("pacman-conf", ["RootDir"]);
    if (!path.isAbsolute(root) || root.includes("\n")) refuse("reboot=rootdir-malformed", 1);
    const hook = read(path.join(root, "usr/share/libalpm/hooks/cachyos-reboot-required.hook"), true);
    if (hook === null) break;
    // findmnt(8): raw, no headings, one file system type per mount.
    const mounted = probe("findmnt", ["-rno", "FSTYPE"]).split("\n");
    const table = logic();
    for (const name of table.rebootPackages(hook, changes, table.kernelPackage(read("/proc/version")), mounted)) line("reboot", name);
    break;
}
default:
    refuse("verb=" + verb, 2);
}
if (lines.length > 0) process.stdout.write(lines.join("\n") + "\n");
