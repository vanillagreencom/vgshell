{
  "schemaVersion": 1,
  "id": "vgs.vpn",
  "name": "VPN",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Connect your saved VPN and WireGuard profiles.",
  "license": "MIT",
  "icon": "shield-check",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml"
  },
  "capabilities": [
    "configure",
    "ipc",
    "requirements",
    "run",
    "status",
    "surfaces",
    "system",
    "tui"
  ],
  "capabilityKinds": {
    "run": ["pane"],
    "system": ["service"]
  },
  "systemSteps": ["vpn-kill-switch"],
  "defaultSection": "right",
  "pane": {
    "group": "Connectivity",
    "order": 40
  },
  "settings": {
    "nordProfile": "",
    "autoConnect": "",
    "trustedNetworks": [],
    "pollSeconds": 30
  },
  "schema": {
    "nordProfile": {
      "type": "string",
      "label": "Profile",
      "description": "The account key stays in NetworkManager",
      "optionsFrom": "nordProfiles",
      "group": "NordVPN"
    },
    "autoConnect": {
      "type": "string",
      "label": "Profile",
      "description": "Connects on a network not on your trusted list",
      "info": "VGS connects this profile when you join an untrusted network or start VGS on one.\nA wired network is trusted by its router and address range.\nWith the kill switch on, traffic is blocked before connecting.\nIf you turn the VPN off, it stays off until the computer changes networks.",
      "optionsFrom": "vpnChoices",
      "problem": "autoConnectProblem",
      "group": "Connect automatically"
    },
    "trustedNetworks": {
      "type": "list",
      "label": "Trusted networks",
      "description": "On these networks the VPN does not connect by itself",
      "info": "Trusting saved Wi-Fi trusts every network with the same name and password. Without a password, the name alone matches.\nTrusting the current wired network saves its router and address range.\nAnother router is not trusted, but a network that copies both values is trusted.\nWired networks with an unreadable router, Bluetooth networks and mobile networks are never trusted.",
      "group": "Connect automatically",
      "items": {
        "network": {
          "type": "string",
          "label": "Network",
          "optionsFrom": "networkChoices",
          "placeholder": "Not set"
        }
      },
      "defaults": {
        "network": ""
      }
    },
    "pollSeconds": {
      "type": "number",
      "label": "Check every",
      "description": "How often VGS reads your VPN profiles while its flyout and System Settings section are closed",
      "unit": "seconds",
      "presets": [
        {
          "value": 10
        },
        {
          "value": 30
        },
        {
          "value": 60
        }
      ],
      "group": "Updates"
    }
  },
  "requirements": [
    {
      "nmVpn": {
        "service": "org.freedesktop.NetworkManager.openvpn",
        "label": "OpenVPN plugin"
      },
      "packages": {
        "pacman": "networkmanager-openvpn",
        "apt": "network-manager-openvpn",
        "dnf": "NetworkManager-openvpn",
        "nix": "networkmanager-openvpn"
      },
      "optional": true,
      "purpose": "Connects OpenVPN profiles and imports OpenVPN files"
    },
    {
      "command": "nm-connection-editor",
      "packages": {
        "pacman": "nm-connection-editor",
        "apt": "network-manager-gnome",
        "dnf": "nm-connection-editor",
        "nix": "networkmanagerapplet"
      },
      "optional": true,
      "purpose": "Adds and changes VPN profiles in NetworkManager's own editor"
    },
    {
      "command": "nmcli",
      "packages": {
        "pacman": "networkmanager",
        "apt": "network-manager",
        "dnf": "NetworkManager",
        "nix": "networkmanager"
      },
      "optional": true,
      "purpose": "Reads, connects and changes your saved VPN profiles"
    },
    {
      "command": "gum",
      "packages": {
        "pacman": "gum",
        "apt": "gum",
        "dnf": "gum",
        "nix": "gum"
      },
      "optional": true,
      "purpose": "Chooses a VPN file to import"
    },
    {
      "command": "ip",
      "packages": {
        "pacman": "iproute2",
        "apt": "iproute2",
        "dnf": "iproute",
        "nix": "iproute2"
      },
      "optional": true,
      "purpose": "Finds the network your traffic uses, for the leak check, and the router of a wired network, to trust it"
    },
    {
      "command": "varlinkctl",
      "packages": {
        "pacman": "systemd",
        "apt": "systemd",
        "dnf": "systemd",
        "nix": "systemd"
      },
      "optional": true,
      "purpose": "Finds the network your DNS lookups use, for the leak check"
    },
    {
      "command": "curl",
      "packages": {
        "pacman": "curl",
        "apt": "curl",
        "dnf": "curl",
        "nix": "curl"
      },
      "optional": true,
      "purpose": "Reads NordVPN locations and recommendations, and checks the VPN's public address"
    }
  ],
  "status": {
    "nordState": { "type": "data", "label": "NordVPN locations" },
    "nordProfiles": { "type": "choices", "label": "NordVPN profiles", "hidden": true },
    "connection": {
      "type": "state",
      "label": "Connection"
    },
    "profiles": {
      "type": "data",
      "label": "VPN profiles"
    },
    "killSwitch": {
      "type": "state",
      "label": "Kill switch",
      "setup": "optional",
      "hint": "Block traffic outside the VPN when the VPN drops",
      "info": "If a VPN started in VGS drops, traffic stays blocked until it reconnects or you turn it off in VGS.\nThe block stays active when VGS closes and after a restart.",
      "action": {
        "label": "Set up",
        "system": "vpn-kill-switch"
      }
    },
    "killSwitchState": {
      "type": "data",
      "label": "Kill switch state"
    },
    "leakCheck": {
      "type": "data",
      "label": "Leak check"
    },
    "vpnChoices": {
      "type": "choices",
      "label": "VPN profiles to connect",
      "hidden": true
    },
    "networkChoices": {
      "type": "choices",
      "label": "Saved networks",
      "hidden": true
    },
    "networks": {
      "type": "data",
      "label": "Networks"
    },
    "wired": {
      "type": "data",
      "label": "Wired network"
    },
    "autoConnectProblem": {
      "type": "text",
      "label": "Connect automatically",
      "hidden": true
    }
  },
  "tui": {
    "import": {
      "script": "tui/import.sh",
      "title": "Import a VPN file",
      "entry": {
        "label": "Import a VPN file",
        "icon": "file-input",
        "group": "VPN"
      },
      "requires": [
        "nmcli",
        "gum"
      ]
    }
  }
}
