{
  "schemaVersion": 1,
  "id": "vgs.vpn",
  "name": "VPN",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Connect your saved VPN and WireGuard profiles.",
  "license": "MIT",
  "icon": "shield-check",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml"
  },
  "capabilities": [
    "configure",
    "ipc",
    "requirements",
    "run",
    "status",
    "surfaces",
    "system",
    "tui"
  ],
  "capabilityKinds": {
    "run": ["pane"],
    "system": ["service"]
  },
  "systemSteps": ["vpn-kill-switch"],
  "defaultSection": "right",
  "pane": {
    "group": "Connectivity",
    "order": 40
  },
  "settings": {
    "pollSeconds": 30
  },
  "schema": {
    "pollSeconds": {
      "type": "number",
      "label": "Check every",
      "description": "How often VGS reads your VPN profiles while its flyout and System Settings section are closed",
      "unit": "seconds",
      "presets": [
        {
          "value": 10
        },
        {
          "value": 30
        },
        {
          "value": 60
        }
      ],
      "group": "Updates"
    }
  },
  "requirements": [
    {
      "nmVpn": {
        "service": "org.freedesktop.NetworkManager.openvpn",
        "label": "OpenVPN plugin"
      },
      "packages": {
        "pacman": "networkmanager-openvpn",
        "apt": "network-manager-openvpn",
        "dnf": "NetworkManager-openvpn",
        "nix": "networkmanager-openvpn"
      },
      "optional": true,
      "purpose": "Connects OpenVPN profiles and imports OpenVPN files"
    },
    {
      "command": "nm-connection-editor",
      "packages": {
        "pacman": "nm-connection-editor",
        "apt": "network-manager-gnome",
        "dnf": "nm-connection-editor",
        "nix": "networkmanagerapplet"
      },
      "optional": true,
      "purpose": "Adds and changes VPN profiles in NetworkManager's own editor"
    },
    {
      "command": "nmcli",
      "packages": {
        "pacman": "networkmanager",
        "apt": "network-manager",
        "dnf": "NetworkManager",
        "nix": "networkmanager"
      },
      "optional": true,
      "purpose": "Reads, connects, imports and removes your VPN profiles"
    },
    {
      "command": "gum",
      "packages": {
        "pacman": "gum",
        "apt": "gum",
        "dnf": "gum",
        "nix": "gum"
      },
      "optional": true,
      "purpose": "Chooses a VPN file to import"
    },
    {
      "command": "ip",
      "packages": {
        "pacman": "iproute2",
        "apt": "iproute2",
        "dnf": "iproute",
        "nix": "iproute2"
      },
      "optional": true,
      "purpose": "Finds the network your IPv4 and IPv6 traffic uses, for the leak check"
    },
    {
      "command": "varlinkctl",
      "packages": {
        "pacman": "systemd",
        "apt": "systemd",
        "dnf": "systemd",
        "nix": "systemd"
      },
      "optional": true,
      "purpose": "Finds the network your DNS lookups use, for the leak check"
    },
    {
      "command": "curl",
      "packages": {
        "pacman": "curl",
        "apt": "curl",
        "dnf": "curl",
        "nix": "curl"
      },
      "optional": true,
      "purpose": "Asks api.nordvpn.com, through the VPN, for the public address it sees"
    }
  ],
  "status": {
    "connection": {
      "type": "state",
      "label": "Connection"
    },
    "profiles": {
      "type": "data",
      "label": "VPN profiles"
    },
    "killSwitch": {
      "type": "state",
      "label": "Kill switch",
      "setup": "optional",
      "hint": "Block traffic outside the VPN when the VPN drops",
      "info": "When a VPN you turned on in VGS drops, the kill switch blocks traffic outside it until it connects again or you turn it off in VGS. It works while VGS is not running and after a restart.",
      "action": {
        "label": "Set up",
        "system": "vpn-kill-switch"
      }
    },
    "killSwitchState": {
      "type": "data",
      "label": "Kill switch state"
    },
    "leakCheck": {
      "type": "data",
      "label": "Leak check"
    }
  },
  "tui": {
    "import": {
      "script": "tui/import.sh",
      "title": "Import a VPN file",
      "entry": {
        "label": "Import a VPN file",
        "icon": "file-input",
        "group": "VPN"
      },
      "requires": [
        "nmcli",
        "gum"
      ]
    }
  }
}
