{
  "schemaVersion": 1,
  "id": "vgs.themes",
  "name": "Themes",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Choose themes and wallpapers.",
  "license": "MIT",
  "icon": "palette",
  "kinds": [
    "panel",
    "background",
    "overlay",
    "service"
  ],
  "entryPoints": {
    "panel": "ThemesPanel.qml",
    "background": "Background.qml",
    "overlay": "Browser.qml",
    "service": "Service.qml"
  },
  "capabilities": [
    "configure",
    "ipc",
    "screens",
    "shortcut",
    "surfaces",
    "theme",
    "tui",
    "notify",
    "requirements",
    "status"
  ],
  "settings": {
    "placement": "top-right",
    "noWindowGaps": false
  },
  "schema": {
    "placement": {"type": "enum", "label": "Panel position", "options": [{"value": "top-left", "label": "Top left"}, {"value": "top", "label": "Top"}, {"value": "top-right", "label": "Top right"}, {"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}, {"value": "bottom-left", "label": "Bottom left"}, {"value": "bottom", "label": "Bottom"}, {"value": "bottom-right", "label": "Bottom right"}]},
    "noWindowGaps": {"type": "boolean", "label": "No window gaps", "description": "Applies to tiled windows on every workspace", "group": "Hyprland"}
  },
  "status": {
    "browserTheming": {"type": "state", "label": "Browser theming", "group": "Browsers", "hint": "Let the selected theme change the colours of Chromium, Chrome, Edge and Brave", "action": {"label": "Install browser theming", "tui": "browser-policy"}},
    "themeWiring": {"type": "presenceList", "label": "Theme files", "hint": "Open the file and line VGS added for each app", "info": "The list shows up to 32 rows. The last row gives the number of files left out."}
  },
  "tui": {
    "browser-policy": {
      "script": "tui/browser-policy.sh",
      "title": "Install browser theming"
    }
  },
  "menu": {
    "style": { "label": "Style", "icon": "paintbrush" },
    "style.theme": { "label": "Theme", "icon": "palette", "aliases": ["theme", "themes"], "shortcut": "themes" },
    "style.wallpaper": { "label": "Wallpaper", "icon": "wallpaper", "aliases": ["wallpaper", "background"], "shortcut": "wallpapers" },
    "style.gaps": { "label": "No window gaps", "icon": "maximize", "aliases": ["gaps"], "shortcut": "gaps", "toggle": { "setting": "noWindowGaps", "label": "Default window gaps", "icon": "layout-grid" } }
  },
  "hyprland": {
    "appearance": {
      "noGaps": "noWindowGaps"
    },
    "binds": [
      { "shortcut": "themes", "key": "SUPER+SHIFT+T", "info": "Opens the theme browser to try and apply a theme, or closes it." },
      { "shortcut": "wallpapers", "key": "SUPER+SHIFT+W", "info": "Opens the wallpaper browser to pick a background, or closes it." },
      { "shortcut": "panel", "key": "SUPER+CTRL+J", "info": "Opens the Themes panel, or closes it." },
      { "shortcut": "gaps", "key": "SUPER+SHIFT+BACKSPACE", "info": "Removes the space between windows, or puts it back." }
    ]
  }
}
