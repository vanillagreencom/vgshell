{
  "schemaVersion": 1, "id": "vgs.traffic", "name": "Network Traffic", "version": "0.1.0", "author": "VanillaGreen",
  "description": "See network speed and traffic per app.", "license": "MIT", "icon": "arrow-down-up",
  "kinds": ["bar-widget", "panel"], "entryPoints": { "bar-widget": "Widget.qml", "panel": "Panel.qml" },
  "capabilities": ["status", "surfaces", "tui"], "defaultSection": "right",
  "requirements": [
    { "command": "ss", "packages": { "pacman": "iproute2", "apt": "iproute2", "dnf": "iproute", "xbps": "iproute2", "emerge": "sys-apps/iproute2", "nix": "iproute2" }, "optional": false, "purpose": "Reads TCP traffic for your apps" },
    { "command": "bandwhich", "packages": { "pacman": "bandwhich" }, "optional": true, "purpose": "See all shows traffic for every app and protocol" }
  ],
  "settings": { "show": "both", "refreshSeconds": 2 },
  "schema": {
    "show": { "type": "enum", "label": "Show in bar", "options": ["both", "download", "upload"], "group": "Display" },
    "refreshSeconds": { "type": "number", "label": "Refresh interval", "min": 1, "max": 10, "step": 1, "unit": "seconds", "group": "Readings" }
  },
  "status": {
    "traffic": { "type": "data", "label": "Traffic" },
    "capture": { "type": "state", "label": "Traffic capture", "hint": "See all shows every app and protocol.", "info": "See all shows every app and protocol. Allowing it lets every account on this computer see network traffic through bandwhich." }
  }
}
