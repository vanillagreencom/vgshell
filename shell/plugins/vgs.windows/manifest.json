{
  "schemaVersion": 1,
  "id": "vgs.windows",
  "name": "Windows",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Set the corners and borders of windows and flyouts, and VGlass.",
  "license": "MIT",
  "icon": "app-window",
  "kinds": ["pane", "service"],
  "entryPoints": { "pane": "Pane.qml", "service": "Service.qml" },
  "capabilities": ["appearance", "compositor", "hyprland", "notify", "shortcut", "tui"],
  "capabilityKinds": { "appearance": ["pane"], "compositor": ["service"], "hyprland": ["pane"], "notify": ["service"], "shortcut": ["service"], "tui": ["pane"] },
  "pane": { "group": "Appearance", "order": 20 },
  "hyprland": {
    "binds": [
      { "shortcut": "group-lock", "key": "SUPER+CTRL+G", "info": "Locks the group of the focused window, or unlocks it, and shows a notification that tells you which. A window in no group stays as it is." }
    ]
  },
  "requirements": [
    { "command": "hyprpm", "optional": true, "purpose": "Manage the optional layer-glass plugin", "packages": { "pacman": "hyprpm" } },
    { "command": "cpio", "optional": true, "purpose": "Prepare layer-glass plugin headers", "packages": { "pacman": "cpio" } },
    { "command": "cmake", "optional": true, "purpose": "Build the layer-glass plugin", "packages": { "pacman": "cmake" } },
    { "command": "pkg-config", "optional": true, "purpose": "Find layer-glass build libraries", "packages": { "pacman": "pkgconf" } },
    { "command": "g++", "optional": true, "purpose": "Build the layer-glass plugin", "packages": { "pacman": "gcc" } },
    { "command": "gcc", "optional": true, "purpose": "Build the layer-glass plugin", "packages": { "pacman": "gcc" } },
    { "command": "git", "optional": true, "purpose": "Download the layer-glass plugin", "packages": { "pacman": "git" } }
  ],
  "tui": {
    "layer-glass": { "script": "tui/layer-glass.sh", "title": "Layer glass", "requires": ["hyprpm", "cpio", "cmake", "pkg-config", "g++", "gcc", "git"] },
    "layer-glass-control": { "script": "tui/layer-glass.sh", "title": "Layer glass", "requires": ["hyprpm"] }
  }
}
