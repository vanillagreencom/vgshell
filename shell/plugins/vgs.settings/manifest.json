{
  "schemaVersion": 1,
  "id": "vgs.settings",
  "name": "Plugins",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Manage your plugins, settings and shortcuts.",
  "license": "MIT",
  "icon": "plug",
  "kinds": [
    "window",
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "window": "Window.qml",
    "bar-widget": "Widget.qml",
    "service": "Service.qml"
  },
  "capabilities": [
    "ipc",
    "manager",
    "screens",
    "shortcut",
    "surfaces",
    "tui"
  ],
  "settings": {},
  "defaultSection": "right",
  "alwaysOn": true,
  "menu": {
    "settings": { "label": "Settings", "icon": "settings" },
    "settings.plugins": { "label": "Plugin settings", "icon": "plug", "aliases": ["plugins"], "shortcut": "open" }
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+M", "info": "Opens the Plugins window, where you turn plugins on and change their settings, or closes it." }
    ]
  }
}
