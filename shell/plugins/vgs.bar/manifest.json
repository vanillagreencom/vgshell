{
  "schemaVersion": 1,
  "id": "vgs.bar",
  "name": "Bar",
  "version": "0.3.0",
  "author": "VanillaGreen",
  "description": "Shows plugin widgets at the top of each screen.",
  "license": "MIT",
  "icon": "panel-top",
  "kinds": [
    "bar",
    "service",
    "window"
  ],
  "entryPoints": {
    "bar": "Bar.qml",
    "service": "Service.qml",
    "window": "AddWidget.qml"
  },
  "capabilities": [
    "builtins",
    "configure",
    "ipc",
    "manager",
    "shortcut",
    "status",
    "surfaces"
  ],
  "capabilityKinds": {
    "builtins": ["bar"],
    "configure": ["service"],
    "ipc": ["service"],
    "manager": ["window"],
    "shortcut": ["service"],
    "status": ["bar", "service"],
    "surfaces": ["bar"]
  },
  "settings": {
    "hidden": false
  },
  "schema": {
    "hidden": {
      "type": "boolean",
      "label": "Hide top bar",
      "description": "Hides the bar on every screen, and windows use its space",
      "group": "Bar"
    }
  },
  "status": {
    "hiddenUntilReveal": { "type": "data", "label": "Hidden until reveal" }
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+SHIFT+SPACE", "info": "Changes Hide top bar.\nIf another app hides the bar, that app controls when it returns." }
    ]
  },
  "menu": {
    "style.bar": { "label": "Hide top bar", "icon": "panel-top-close", "aliases": ["bar"], "shortcut": "toggle", "toggle": { "setting": "hidden", "label": "Show top bar", "icon": "panel-top-open" } }
  }
}
