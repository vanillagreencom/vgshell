{
  "schemaVersion": 1,
  "id": "vgs.power",
  "name": "Power",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show battery level, choose the power profile and see what happens while you are away.",
  "license": "MIT",
  "icon": "battery-medium",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml"
  },
  "capabilities": [
    "configure",
    "idle",
    "ipc",
    "notify",
    "requirements",
    "shortcut",
    "status",
    "system",
    "surfaces"
  ],
  "systemSteps": ["wake-sources"],
  "capabilityKinds": { "system": ["service"] },
  "defaultSection": "right",
  "pane": {
    "group": "Hardware",
    "order": 50
  },
  "requirements": [
    {
      "dbus": {
        "bus": "system",
        "name": "org.freedesktop.UPower.PowerProfiles",
        "label": "Power profiles service"
      },
      "packages": {
        "pacman": "power-profiles-daemon",
        "apt": "power-profiles-daemon",
        "dnf": "ppd-service",
        "nix": "power-profiles-daemon"
      },
      "optional": true,
      "purpose": "The power profiles service, which switches the power profile"
    },
    {
      "command": "gdbus",
      "packages": {
        "pacman": "glib2",
        "apt": "libglib2.0-bin",
        "dnf": "glib2",
        "nix": "glib"
      },
      "optional": false,
      "purpose": "Reads and sets the power profile and Bluetooth wake permission"
    },
    {
      "dbus": { "bus": "system", "name": "org.bluez", "label": "Bluetooth service" },
      "packages": { "pacman": "bluez", "apt": "bluez", "dnf": "bluez", "nix": "bluez" },
      "optional": true,
      "purpose": "Limits Bluetooth wake to keyboards and pointing devices"
    }
  ],
  "settings": {
    "lowThreshold": 20,
    "criticalThreshold": 10,
    "chargerProfile": "performance",
    "batteryProfile": "balanced"
  },
  "schema": {
    "lowThreshold": {
      "type": "number",
      "label": "Low battery alert",
      "description": "Send an alert when the battery falls to this level",
      "unit": "%",
      "min": 1,
      "max": 50,
      "step": 1,
      "presets": [
        {
          "value": 15
        },
        {
          "value": 20
        },
        {
          "value": 25
        }
      ],
      "group": "Battery alerts",
      "shownWhen": "battery"
    },
    "criticalThreshold": {
      "type": "number",
      "label": "Critical battery alert",
      "description": "Send an urgent alert when the battery falls to this level",
      "unit": "%",
      "min": 1,
      "max": 30,
      "step": 1,
      "presets": [
        {
          "value": 5
        },
        {
          "value": 10
        },
        {
          "value": 15
        }
      ],
      "group": "Battery alerts",
      "shownWhen": "battery"
    },
    "chargerProfile": {
      "type": "enum",
      "label": "When charging",
      "description": "Use this profile after you connect power",
      "options": [
        { "value": "power-saver", "label": "Power saver" },
        { "value": "balanced", "label": "Balanced" },
        { "value": "performance", "label": "Performance" }
      ],
      "group": "Power profiles",
      "shownWhen": "profiles"
    },
    "batteryProfile": {
      "type": "enum",
      "label": "On battery",
      "description": "Use this profile after you disconnect power",
      "options": [
        { "value": "power-saver", "label": "Power saver" },
        { "value": "balanced", "label": "Balanced" },
        { "value": "performance", "label": "Performance" }
      ],
      "group": "Power profiles",
      "shownWhen": "profiles"
    }
  },
  "menu": {
    "power-profile": {
      "label": "Power profile",
      "icon": "battery-medium"
    },
    "power-profile.saver": {
      "label": "Use power saver",
      "icon": "leaf",
      "description": "Switch to the power saver profile",
      "shortcut": "power-saver"
    },
    "power-profile.balanced": {
      "label": "Use balanced",
      "icon": "gauge",
      "description": "Switch to the balanced profile",
      "shortcut": "balanced"
    },
    "power-profile.performance": {
      "label": "Use performance",
      "icon": "zap",
      "description": "Switch to the performance profile",
      "shortcut": "performance"
    }
  },
  "status": {
    "wakeSources": {
      "type": "state",
      "label": "Wake sources",
      "setup": true,
      "group": "Wake",
      "hint": "Only keyboards, pointing devices and the power button wake the computer. Connecting a USB device during sleep can also wake it.",
      "action": { "label": "Allow", "system": "wake-sources" }
    },
    "power": {
      "type": "data",
      "label": "Power"
    },
    "battery": {
      "type": "presence",
      "label": "Battery",
      "hidden": true
    },
    "profiles": {
      "type": "presence",
      "label": "Power profiles",
      "hidden": true
    },
    "profileRule": {
      "type": "text",
      "label": "Power profile"
    }
  }
}
