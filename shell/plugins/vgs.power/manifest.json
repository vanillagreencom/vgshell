{
  "schemaVersion": 1,
  "id": "vgs.power",
  "name": "Power",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show battery level, choose the power profile, see what happens while you are away and open the power menu.",
  "license": "MIT",
  "icon": "battery-medium",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane",
    "overlay"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml",
    "overlay": "Overlay.qml"
  },
  "capabilities": [
    "compositor",
    "configure",
    "idle",
    "ipc",
    "manager",
    "notify",
    "requirements",
    "session",
    "shortcut",
    "status",
    "surfaces",
    "system"
  ],
  "capabilityKinds": {
    "compositor": ["service"],
    "idle": ["service", "pane"],
    "manager": ["pane"],
    "session": ["service"],
    "system": ["service"]
  },
  "idleStages": { "displayOff": { "seconds": "displayOffSeconds" }, "sleep": { "seconds": "sleepAfterSeconds" } },
  "systemSteps": ["disk-sleep", "wake-sources"],
  "defaultSection": "right",
  "pane": {
    "group": "Hardware",
    "order": 50
  },
  "requirements": [
    {
      "command": "hdparm",
      "packages": {
        "pacman": "hdparm",
        "apt": "hdparm",
        "dnf": "hdparm",
        "nix": "hdparm"
      },
      "optional": true,
      "purpose": "Lets idle hard disks stop spinning"
    },
    {
      "dbus": {
        "bus": "system",
        "name": "org.freedesktop.UPower.PowerProfiles",
        "label": "Power profiles service"
      },
      "packages": {
        "pacman": "power-profiles-daemon",
        "apt": "power-profiles-daemon",
        "dnf": "ppd-service",
        "nix": "power-profiles-daemon"
      },
      "optional": true,
      "purpose": "The power profiles service, which switches the power profile"
    },
    {
      "dbus": {
        "bus": "system",
        "name": "org.freedesktop.login1",
        "label": "System sleep service"
      },
      "packages": {
        "pacman": "systemd",
        "apt": "systemd",
        "dnf": "systemd",
        "nix": "systemd"
      },
      "optional": true,
      "purpose": "Puts the computer to sleep and turns displays on after it wakes"
    },
    {
      "command": "gdbus",
      "packages": {
        "pacman": "glib2",
        "apt": "libglib2.0-bin",
        "dnf": "glib2",
        "nix": "glib"
      },
      "optional": false,
      "purpose": "Reads and sets power profiles, sleep and Bluetooth wake permission"
    },
    {
      "command": "nmcli",
      "packages": {
        "pacman": "networkmanager",
        "apt": "network-manager",
        "dnf": "NetworkManager",
        "nix": "networkmanager"
      },
      "optional": true,
      "purpose": "Sets Wake on LAN on the wired connections"
    },
    {
      "dbus": { "bus": "system", "name": "org.bluez", "label": "Bluetooth service" },
      "packages": { "pacman": "bluez", "apt": "bluez", "dnf": "bluez", "nix": "bluez" },
      "optional": true,
      "purpose": "Limits Bluetooth wake to keyboards and pointing devices"
    }
  ],
  "settings": {
    "displayOffSeconds": 600,
    "sleepAfterSeconds": 0,
    "sleepAction": "suspend",
    "lowThreshold": 20,
    "criticalThreshold": 10,
    "chargerProfile": "performance",
    "batteryProfile": "balanced",
    "wakeOnLan": false,
    "wakeOnLanChosen": false
  },
  "schema": {
    "displayOffSeconds": {
      "type": "number",
      "label": "Turn displays off",
      "description": "After you stop using the computer",
      "info": "While the screen is locked, the displays turn off after 10 seconds without input. A key press or pointer move turns them on. Never keeps them on while locked too.",
      "unit": "seconds",
      "min": 0,
      "max": 7200,
      "step": 60,
      "presets": [
        { "value": 0, "label": "Never" },
        { "value": 120 },
        { "value": 300 },
        { "value": 600 },
        { "value": 900 },
        { "value": 1800 },
        { "value": 3600 }
      ],
      "allowCustom": true,
      "group": "Displays"
    },
    "sleepAfterSeconds": {
      "type": "number",
      "label": "Sleep after",
      "unit": "seconds",
      "min": 0,
      "max": 86400,
      "step": 60,
      "presets": [
        { "value": 0, "label": "Never" },
        { "value": 900 },
        { "value": 1800 },
        { "value": 3600 },
        { "value": 7200 },
        { "value": 10800 }
      ],
      "allowCustom": true,
      "group": "Sleep",
      "problem": "sleepProblem"
    },
    "sleepAction": {
      "type": "string",
      "label": "Sleep action",
      "optionsFrom": "sleepActions",
      "placeholder": "Choose action",
      "group": "Sleep",
      "shownWhen": "hibernate"
    },
    "lowThreshold": {
      "type": "number",
      "label": "Low battery alert",
      "unit": "%",
      "min": 1,
      "max": 50,
      "step": 1,
      "presets": [
        {
          "value": 15
        },
        {
          "value": 20
        },
        {
          "value": 25
        }
      ],
      "group": "Battery alerts",
      "shownWhen": "battery"
    },
    "criticalThreshold": {
      "type": "number",
      "label": "Critical battery alert",
      "unit": "%",
      "min": 1,
      "max": 30,
      "step": 1,
      "presets": [
        {
          "value": 5
        },
        {
          "value": 10
        },
        {
          "value": 15
        }
      ],
      "group": "Battery alerts",
      "shownWhen": "battery"
    },
    "chargerProfile": {
      "type": "enum",
      "label": "When charging",
      "options": [
        { "value": "power-saver", "label": "Power saver" },
        { "value": "balanced", "label": "Balanced" },
        { "value": "performance", "label": "Performance" }
      ],
      "group": "Power profiles",
      "shownWhen": "profiles"
    },
    "batteryProfile": {
      "type": "enum",
      "label": "On battery",
      "options": [
        { "value": "power-saver", "label": "Power saver" },
        { "value": "balanced", "label": "Balanced" },
        { "value": "performance", "label": "Performance" }
      ],
      "group": "Power profiles",
      "shownWhen": "profiles"
    },
    "wakeOnLan": {
      "type": "boolean",
      "label": "Wake on LAN",
      "description": "A connection in use gets the change the next time it connects",
      "info": "Lets another device on the same wired network wake this computer from sleep.",
      "group": "Network",
      "shownWhen": "ethernet",
      "problem": "wakeOnLanProblem"
    }
  },
  "hyprland": {
    "binds": [
      {
        "shortcut": "power-menu",
        "key": null,
        "info": "Opens the power menu. Hold Space, Enter or the pointer on an action for 3 seconds to run it."
      }
    ]
  },
  "menu": {
    "system.power-menu": {
      "label": "Power menu",
      "icon": "power",
      "description": "Hold an action to log out, suspend, reboot or shut down",
      "shortcut": "power-menu"
    },
    "system.sleep": {
      "label": "Sleep",
      "icon": "moon",
      "provider": "sleepRows",
      "shortcut": "sleep"
    },
    "power-profile": {
      "label": "Power profile",
      "icon": "battery-medium"
    },
    "power-profile.saver": {
      "label": "Use power saver",
      "icon": "leaf",
      "description": "Switch to the power saver profile",
      "shortcut": "power-saver"
    },
    "power-profile.balanced": {
      "label": "Use balanced",
      "icon": "gauge",
      "description": "Switch to the balanced profile",
      "shortcut": "balanced"
    },
    "power-profile.performance": {
      "label": "Use performance",
      "icon": "zap",
      "description": "Switch to the performance profile",
      "shortcut": "performance"
    }
  },
  "status": {
    "actions": {
      "type": "data",
      "label": "Power actions"
    },
    "sleepRows": {
      "type": "launcherRows",
      "label": "Sleep actions"
    },
    "hibernate": {
      "type": "presence",
      "label": "Hibernation",
      "hidden": true
    },
    "sleepActions": {
      "type": "choices",
      "label": "Sleep actions"
    },
    "sleepProblem": {
      "type": "text",
      "label": "Sleep",
      "hidden": true
    },
    "diskSleepInstall": {
      "type": "presence",
      "label": "Disk sleep install",
      "hidden": true
    },
    "diskSleep": {
      "type": "state",
      "label": "Disk sleep",
      "setup": "optional",
      "hint": "Stop hard disks after 30 minutes without use",
      "info": "A hard disk stops after you leave it unused. Opening a file on a stopped disk takes longer while it starts again.",
      "action": {
        "label": "Allow",
        "system": "disk-sleep"
      }
    },
    "wakeSources": {
      "type": "state",
      "label": "Wake sources",
      "setup": true,
      "group": "Wake",
      "hint": "Only keyboards and pointing devices can wake the computer through USB or Bluetooth",
      "info": "The power button and a USB device you connect during sleep also wake the computer.",
      "action": { "label": "Allow", "system": "wake-sources" }
    },
    "power": {
      "type": "data",
      "label": "Power"
    },
    "battery": {
      "type": "presence",
      "label": "Battery",
      "hidden": true
    },
    "profiles": {
      "type": "presence",
      "label": "Power profiles",
      "hidden": true
    },
    "ethernet": {
      "type": "presence",
      "label": "Wired network",
      "hidden": true
    },
    "wakeOnLanProblem": {
      "type": "text",
      "label": "Wake on LAN",
      "hidden": true
    },
    "profileRule": {
      "type": "text",
      "label": "Power profile"
    }
  }
}
