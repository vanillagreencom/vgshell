{
  "schemaVersion": 1,
  "id": "vgs.network",
  "name": "Network",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Join Wi-Fi and see your network connections.",
  "license": "MIT",
  "icon": "wifi",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml"
  },
  "capabilities": [
    "run",
    "status",
    "surfaces",
    "ipc",
    "configure",
    "requirements",
    "system"
  ],
  "capabilityKinds": { "system": ["service"] },
  "systemSteps": ["dns-cloudflare", "dns-google", "dns-custom"],
  "defaultSection": "right",
  "pane": {
    "group": "Connectivity",
    "order": 20
  },
  "requirements": [
    { "command": "xdg-open", "packages": { "pacman": "xdg-utils", "apt": "xdg-utils", "dnf": "xdg-utils", "nix": "xdg-utils" }, "optional": true, "purpose": "Opens the browser for network sign-in" },
    { "command": "nmcli", "packages": { "pacman": "networkmanager", "apt": "network-manager", "dnf": "NetworkManager", "nix": "networkmanager" }, "optional": false, "purpose": "Reads saved profiles for QR sharing, connection details and network permissions" },
    { "command": "qrencode", "packages": { "pacman": "qrencode", "apt": "qrencode", "dnf": "qrencode", "nix": "qrencode" }, "optional": false, "purpose": "Encodes a saved Wi-Fi network for sharing by QR code" },
    { "command": "systemctl", "packages": { "pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd" }, "optional": false, "purpose": "Reads whether NetworkManager is installed and running" }
  ],
  "settings": {
    "showDisconnected": true
  },
  "status": {
    "dnscloudflare": { "type": "state", "label": "Cloudflare DNS", "hidden": true, "action": { "label": "Use Cloudflare", "system": "dns-cloudflare" } },
    "dnsgoogle": { "type": "state", "label": "Google DNS", "hidden": true, "action": { "label": "Use Google", "system": "dns-google" } },
    "dnscustom": { "type": "state", "label": "Your own DNS servers", "hidden": true, "action": { "label": "Use your own servers", "system": "dns-custom" } },
    "dnsDefault": { "type": "state", "label": "Network default DNS", "hidden": true, "actions": {
      "cloudflare": { "label": "Use network default", "undo": "dns-cloudflare" },
      "google": { "label": "Use network default", "undo": "dns-google" },
      "custom": { "label": "Use network default", "undo": "dns-custom" }
    } },
    "connection": {
      "type": "state",
      "label": "Connection"
    },
    "detailsTool": {
      "type": "state",
      "label": "Connection details"
    },
    "network": {
      "type": "data",
      "label": "Network"
    }
  },
  "schema": {
    "showDisconnected": {
      "type": "boolean",
      "label": "Show disconnected icon",
      "group": "Display"
    }
  }
}
