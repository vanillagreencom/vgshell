#!/usr/bin/env python3
"""Create and activate one Wi-Fi profile. Only stdin carries its secret.

The service consumes the typed result on stdout. Child output never leaves this
owner, because NetworkManager diagnostics can contain supplied credentials.
"""
import json
import os
import select
import signal
import subprocess
import sys
import time
import uuid


class Cancelled(Exception):
    pass


class Commands:
    def __init__(self, lifetime):
        self.child = None
        self.lifetime = lifetime

    def check_owner(self):
        if select.select([self.lifetime], [], [], 0)[0]:
            raise Cancelled()

    def run(self, args, feed=None, cleanup=False):
        env = {key: os.environ[key] for key in (
            "PATH", "HOME", "XDG_RUNTIME_DIR", "DBUS_SYSTEM_BUS_ADDRESS",
            "DBUS_SESSION_BUS_ADDRESS") if key in os.environ}
        env["LC_ALL"] = "C"
        try:
            if not cleanup:
                self.check_owner()
            self.child = subprocess.Popen(
                ["nmcli", "--wait", "5" if cleanup else "120"] + args,
                stdin=subprocess.PIPE if feed is not None else subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=env)
            deadline = time.monotonic() + (6 if cleanup else 125)
            while True:
                if not cleanup:
                    self.check_owner()
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return {"kind": "timeout", "code": None}
                try:
                    _, errors = self.child.communicate(feed, timeout=min(.1, remaining))
                    if not cleanup:
                        self.check_owner()
                    break
                except subprocess.TimeoutExpired:
                    # communicate retains pending stdin when resumed:
                    # https://docs.python.org/3/library/subprocess.html
                    feed = None
            code = self.child.returncode
            # NetworkManager's nmcli refusal messages under LC_ALL=C.
            refused = any(text in errors.lower() for text in (
                b"not authorized", b"not authorised", b"permission denied",
                b"insufficient privileges", b"authorization failed"))
            return {"kind": "ok" if code == 0 else "refused" if refused else "failed", "code": code}
        except OSError:
            return {"kind": "start-failed", "code": None}
        finally:
            self.stop()

    def stop(self):
        if self.child is None:
            return
        if self.child.poll() is None:
            self.child.terminate()
            try:
                self.child.wait(timeout=1)
            except subprocess.TimeoutExpired:
                self.child.kill()
                self.child.wait()
        self.child = None


def join(commands, interface, ssid, hidden, method, identity, domain, secret):
    profile = str(uuid.uuid4())
    result = {"kind": "invalid", "phase": "input", "code": None, "uuid": "", "cleanup": "not-needed"}
    if (not interface or not ssid or hidden not in ("yes", "no")
            or method not in ("psk", "peap", "ttls") or not secret
            or any(c in secret for c in ("\n", "\r", "\0"))
            or (method != "psk" and (not identity or not domain))):
        return result
    args = ["connection", "add", "type", "wifi", "ifname", interface,
            "con-name", ssid, "ssid", ssid, "connection.uuid", profile,
            "connection.autoconnect", "no", "802-11-wireless.hidden", hidden]
    if method == "psk":
        args += ["802-11-wireless-security.key-mgmt", "wpa-psk"]
        password_field = "802-11-wireless-security.psk"
    else:
        # Validate both trust and server identity before the EAP password:
        # https://networkmanager.dev/docs/api/latest/settings-802-1x.html
        args += ["802-11-wireless-security.key-mgmt", "wpa-eap",
                 "802-1x.eap", method, "802-1x.phase2-auth", "mschapv2" if method == "peap" else "pap",
                 "802-1x.identity", identity, "802-1x.system-ca-certs", "yes",
                 "802-1x.domain-suffix-match", domain]
        password_field = "802-1x.password"
    created = False
    complete = False
    result.update(uuid=profile, phase="create")
    try:
        result.update(commands.run(args))
        if result["kind"] != "ok":
            return result
        created = True
        result["phase"] = "activate"
        # nmcli documents passwd-file as setting.property:password records:
        # https://networkmanager.dev/docs/api/latest/nmcli.html
        result.update(commands.run(["connection", "up", "uuid", profile,
                                    "passwd-file", "/dev/stdin"],
                                   (password_field + ":" + secret + "\n").encode("utf-8")))
        secret = ""
        complete = result["kind"] == "ok"
        return result
    except Cancelled:
        # Add may have committed before nmcli was interrupted. This fresh
        # UUID belongs only to this attempt, so also remove an uncertain add.
        if result["phase"] == "create":
            created = True
        result.update(kind="canceled", code=None)
        return result
    finally:
        secret = ""
        commands.stop()
        if created and not complete:
            # Cleanup owns this newly created UUID, never a display name.
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            signal.signal(signal.SIGINT, signal.SIG_IGN)
            cleanup = commands.run(["connection", "delete", "uuid", profile], cleanup=True)
            result["cleanup"] = "deleted" if cleanup["kind"] == "ok" else "failed"


def attempt(lifetime):
    commands = Commands(lifetime)
    def cancel(_signal, _frame):
        raise Cancelled()
    signal.signal(signal.SIGTERM, cancel)
    signal.signal(signal.SIGINT, cancel)
    try:
        secret = sys.stdin.read()
        result = join(commands, *sys.argv[1:], secret)
        secret = ""
    except (Cancelled, UnicodeError, ValueError):
        result = {"kind": "canceled", "phase": "input", "code": None, "uuid": "", "cleanup": "not-needed"}
    finally:
        commands.stop()
    try:
        print(json.dumps(result), flush=True)
    except BrokenPipeError:
        pass
    return 0 if result["kind"] == "ok" else 1


def main():
    if len(sys.argv) != 7:
        print(json.dumps({"kind": "invalid", "phase": "input", "code": None, "uuid": "", "cleanup": "not-needed"}))
        return 2
    # Quickshell kills its direct child on service removal. The worker owns
    # nmcli and the UUID; EOF on this private pipe survives that SIGKILL.
    # Quickshell 0.3.1 src/io/process.cpp, Process::~Process.
    lifetime_read, lifetime_write = os.pipe()
    def cancel(_signal, _frame):
        nonlocal lifetime_write
        if lifetime_write is not None:
            os.close(lifetime_write)
            lifetime_write = None
    signal.signal(signal.SIGTERM, cancel)
    signal.signal(signal.SIGINT, cancel)
    worker = os.fork()
    if worker == 0:
        if lifetime_write is not None:
            os.close(lifetime_write)
        try:
            code = attempt(lifetime_read)
        finally:
            os.close(lifetime_read)
        os._exit(code)
    os.close(lifetime_read)
    sys.stdin.close()
    try:
        _, status = os.waitpid(worker, 0)
    finally:
        cancel(None, None)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
