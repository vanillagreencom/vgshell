{
  "schemaVersion": 1,
  "id": "vgs.glass",
  "name": "Glass",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Choose where glass appears and how it looks.",
  "license": "MIT",
  "icon": "blend",
  "kinds": ["pane"],
  "entryPoints": { "pane": "Pane.qml" },
  "capabilities": ["appearance", "hyprland", "tui"],
  "pane": { "group": "Appearance", "order": 25 },
  "requirements": [
    { "command": "hyprpm", "optional": true, "requestOnly": true, "purpose": "Turn layer glass on or off", "packages": { "pacman": "hyprpm" } },
    { "command": "cpio", "optional": true, "requestOnly": true, "purpose": "Install layer glass", "packages": { "pacman": "cpio" } },
    { "command": "cmake", "optional": true, "requestOnly": true, "purpose": "Install layer glass", "packages": { "pacman": "cmake" } },
    { "command": "pkg-config", "optional": true, "requestOnly": true, "purpose": "Install layer glass", "packages": { "pacman": "pkgconf" } },
    { "command": "g++", "optional": true, "requestOnly": true, "purpose": "Install layer glass", "packages": { "pacman": "gcc" } },
    { "command": "gcc", "optional": true, "requestOnly": true, "purpose": "Install layer glass", "packages": { "pacman": "gcc" } },
    { "command": "git", "optional": true, "requestOnly": true, "purpose": "Download the layer-glass plugin", "packages": { "pacman": "git" } }
  ],
  "tui": {
    "layer-glass": { "script": "tui/layer-glass.sh", "title": "Layer glass", "requires": ["hyprpm", "cpio", "cmake", "pkg-config", "g++", "gcc", "git"] },
    "layer-glass-control": { "script": "tui/layer-glass.sh", "title": "Layer glass", "requires": ["hyprpm"] }
  }
}
