{
  "schemaVersion": 1,
  "id": "vgs.agent-warden",
  "name": "Agent Warden",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Keep your AI agents within their memory and process limits.",
  "license": "MIT",
  "icon": "shield-check",
  "kinds": [
    "bar-widget",
    "panel",
    "service"
  ],
  "entryPoints": {
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "service": "Service.qml"
  },
  "capabilities": [
    "ipc",
    "notify",
    "requirements",
    "run",
    "shortcut",
    "status",
    "surfaces",
    "tui"
  ],
  "defaultSection": "right",
  "settings": {
    "showCount": true,
    "hideWhenIdle": false,
    "notify": "problems"
  },
  "schema": {
    "showCount": {
      "type": "boolean",
      "label": "Show count",
      "info": "Shows the number of running agents or problems beside the shield.",
      "group": "Display"
    },
    "hideWhenIdle": {
      "type": "boolean",
      "label": "Hide when idle",
      "description": "Idle means no agents run and no problems need attention",
      "group": "Display"
    },
    "notify": {
      "type": "enum",
      "label": "Notifications",
      "options": [{ "value": "problems", "label": "Problems" }, { "value": "everything", "label": "Everything" }, { "value": "off", "label": "Off" }],
      "group": "Notifications"
    }
  },
  "requirements": [
    { "command": "vsys", "packages": { "aur": "vsys" }, "optional": false, "purpose": "Shows your agents and provides Agent Warden" },
    { "command": "systemctl", "optional": false, "purpose": "Restarts Agent Warden checks", "packages": { "pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd" } },
    { "command": "notify-send", "packages": { "pacman": "libnotify", "apt": "libnotify-bin", "dnf": "libnotify", "nix": "libnotify" }, "optional": false, "purpose": "Sends Agent Warden alerts" }
  ],
  "status": {
    "warden": {"type": "state", "label": "Warden", "info": "Shows whether Agent Warden watches your agents and whether any needs your attention."},
    "setup": {"type": "state", "label": "Warden setup", "action": {"label": "Set up", "tui": "setup"}, "setup": true},
    "agents": {"type": "count", "label": "Agents running"},
    "lastCheck": {"type": "time", "label": "Last check", "info": "If this time stops changing, open the Agent Warden panel and choose Start checks."},
    "detail": {"type": "data", "label": "Detail"}
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+CTRL+Y", "info": "Opens the Agent Warden panel, or closes it when it is open." }
    ]
  },
  "tui": {
    "vsys": {
      "script": "tui/vsys.sh",
      "title": "vsys",
      "size": "wide",
      "presentation": "plain"
    },
    "setup": {
      "script": "tui/setup.sh",
      "title": "Set up Agent Warden",
      "requires": ["vsys"]
    }
  }
}
