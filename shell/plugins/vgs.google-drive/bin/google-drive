#!/usr/bin/env node
// google-drive: the vgs.google-drive runner. It owns the pair list, the systemd
// user units, the per-pair locks, credential loading, the rclone calls, the
// per-pair inventory, the conflict records and the status record. The
// plugin and the command line start the same service; the service runs a
// copy of this file. The plugin never runs rclone.
//
//   google-drive run [--pair <id>]
//       the service's ExecStart: each pair, or the one named, under its own
//       lock. Prints `pair=<id> result=<r>` per pair, r one of idle, paused,
//       busy, initialization-required, offline, authorization-required, error.
//   google-drive status [--quiet]
//       renders the status record, writes it and prints it as one JSON line
//       (nothing with --quiet: the service's ExecStopPost).
//       The record's `units` is installed, absent or stale (unitsState);
//       each of its `pairs` carries `remote` and `local` from the pair list.
//       The record's `attention`, when set, is { reasons, key, notified }:
//       notified is true once `attention-seen` named that key. Each of its
//       `conflicts` carries `needs`, "you" or "nothing" (needsOf), and
//       `needsYou` counts the ones that need the user; only those make the
//       `conflicts` reason and its key. Each conflict also carries `key`,
//       16 hex digits of the whole record (conflictKey), and the record's
//       `dismissed` lists the dismissed keys that name a current row.
//   google-drive attention-seen <key>
//       records that the plugin notified the user of attention KEY, so no
//       later render or shell start notifies again; prints `seen=<key>`.
//   google-drive dismiss <key>
//       hides the conflict row KEY, one that needs nothing, from the
//       popover until its record changes; prints `dismissed=<key>`. A key
//       that names no current row, or a row that needs the user, is
//       refused with `dismiss=unknown` or `dismiss=needs-you`.
//   google-drive probe
//       the presence of every credential account, read without unlocking
//       the store, as one JSON line; a token's row carries `user`, the
//       Google account's address, when its keyring item names one.
//   google-drive authorize
//       Google's consent for the stored client keys' OAuth client, in the browser
//       rclone opens, and the token it returns stored in the keyring as the
//       account's one token item, with the account's address as its `user`
//       attribute when Google names it; pairs that waited for a sign-in read
//       idle; prints `authorized=drive`. The Sign in floating TUI runs it.
//   google-drive sign-out
//       clears the token from the keyring and records each pair as needing a
//       sign-in, an attention the user's own action notifies of; prints
//       `signed-out=drive`. The client keys and every file stay.
//   google-drive install
//       writes the units, reloads the user manager when they changed and
//       enables the timer; prints `installed=<timer> changed=<n>`.
//   google-drive start
//       `systemctl --user start --no-block` of the service: Sync now.
//   google-drive pause|resume [--pair <id>]
//       prints `paused=<id|all>` or `resumed=<id|all>`.
//   google-drive service-mode true|false
//       private Service mirror of Settings into control.json for the hourly service;
//       changes no data, baseline or pause; prints `two-way=<value>`.
//   google-drive initialize --pair <id>
//       the declared initialization TUI's explicit equal-set comparison,
//       preview and confirmation. Never clears a pause. Prints
//       `initialized=<id>` only after supported rclone resync succeeds.
//   google-drive pairs [--lines]
//       one JSON line, { pairs, error }; with --lines, one `<id>\t<label>`
//       line per pair, for the Remove a folder pair TUI's list.
//   google-drive pairs-reset
//       while the pair list is invalid, keeps the damaged list beside it,
//       starts a valid empty list and prints `reset=<kept-name>`.
//   google-drive pair-add --definition <json> | pair-remove <id>
//       one validated change to the pair list; prints `added=<id>` or
//       `removed=<id>`. Removing a pair deletes no file. A pair-add on a
//       home with no units also installs them and prints install's line,
//       or `install=failed <refusal>` with the pair kept and exit 0.
//
// Files: the pair list is $XDG_CONFIG_HOME/vgshell/google-drive/pairs.json;
// the units are $XDG_CONFIG_HOME/systemd/user/vgs-google-drive.service and
// .timer; status.json, control.json (pause, the notified attention key and
// the dismissed conflict keys) and pairs/<id>/ (state.json, inventory.json,
// conflicts/, exports/, bisync/ and bisync-filters.txt) are under
// $XDG_STATE_HOME/vgshell/google-drive/; the locks
// are under $XDG_RUNTIME_DIR/vgshell/google-drive/; the copy the units run
// is $XDG_DATA_HOME/vgshell/google-drive/engine/<hash>/google-drive, since
// the shell runs this file from a snapshot a restart removes. Every file is
// written whole under a temporary name and renamed into place.
//
// Before any verb, every invocation runs the rename from the plugin's
// previous name (the rename section), then the pair list, pair state and
// status record converters. While a sync of the previous name's service
// runs, the rename refuses the invocation with `migration=held` and exit
// 75 and leaves that name's timer enabled. A rename step left for a later invocation,
// such as the keyring step while the keyring is locked, keeps
// rename.pending in the state directory, logs `migration=held` and lets
// the verb go on; an account still under the previous name reads as
// locked or unavailable, never absent.
//
// Exit 0: done, or every pair skipped as paused. 1: a refusal, or a pair
// that did not finish. 2: a bad invocation. 75: a pair whose lock another
// run holds, and no pair failed; or the rename held, with
// `migration=held`: a sync of the previous service runs, its timer could
// not be disabled, or systemctl is missing or gave no state (developer.md,
// the rename steps). A refusal is one stderr line,
// `google-drive: refused: <key>=<value> ...`.
"use strict";
const childProcess = require("child_process");
const crypto = require("crypto");
const fs = require("fs");
const path = require("path");

const SERVICE = "vgs-google-drive.service";
const TIMER = "vgs-google-drive.timer";
// The manifest's `secrets` service and label; the core's SecretWriter
// stores each account under the attributes `service` and `account`, with
// the label and the account as its item label, and authorize does the same.
const SECRET_SERVICE = "vgs-google-drive";
const SECRET_LABEL = "VGS Google Drive";
// One credential reads and writes the folder pairs with Google Drive's full
// drive scope. Drive's default deletion policy sends files to Trash.
const DRIVE_SCOPE = "drive";
const CREDENTIAL_PARTS = ["client-id", "client-secret", "token"];
const OLD_DIRECTIONS = ["pull", "upload"];
const OLD_ACCOUNTS = [].concat(...OLD_DIRECTIONS.map(direction => CREDENTIAL_PARTS.map(part => direction + "-" + part)));
// The remote exists only in the rclone child's environment.
const REMOTE = "vgsdrive";
const REMOTE_ENV = "RCLONE_CONFIG_VGSDRIVE_";
const EXPORT_FORMATS = "docx,xlsx,pptx,svg";
// Data is current for one timer interval plus one missed run.
const FRESH_MS = 2 * 60 * 60 * 1000;
const KEEP_MS = 30 * 24 * 60 * 60 * 1000;
const EXIT_BUSY = 75;
// What never enters a mirror or leaves the upload folder: editor temp
// files and unfinished downloads; repository and agent state; `local/`,
// which holds the personal design's extraction output (local/derived/);
// credentials; and legacy backups. Conflict storage is under the state
// directory, outside every pair, so it needs no rule. No age or size rule.
const EXCLUDES = [
    "~$*", ".~lock.*#", "*.swp", "*.swx", "*~", ".#*",
    "*.partial", "*.crdownload", "*.part",
    ".git/**", ".agents/**", "local/**", "archive/legacy-backups/**",
    "*.pem", "*.key", "*.p12", "*.pfx", "*.kdbx", "credentials*", "token*.json", "client_secret*.json",
    ".env", ".env.*", ".netrc", "rclone.conf", "id_rsa*", "id_ecdsa*", "id_ed25519*"
];
const BISYNC_FILTERS = EXCLUDES.map(pattern => "- " + pattern).join("\n") + "\n";
// The binding includes every fixed view/semantic option: changing policy
// requires owner reconciliation, not reinterpreting rclone's old listings.
const BISYNC_POLICY = crypto.createHash("sha256").update(BISYNC_FILTERS + "\nsize,modtime,checksum;hash;newer;delete;skip-gdocs;empty-dirs;check-access;max-delete=50").digest("hex");
// rclone's failure text, first match wins. Lines rclone v1.75.1 printed:
// `couldn't fetch token: Post "https://oauth2.googleapis.com/token": dial tcp
// [...]:443: connect: cannot assign requested address` (no network),
// `failed to create oauth client: empty token found`, `token expired and
// there's no refresh token`. invalid_grant, invalid_client and
// unauthorized_client are Google's OAuth error codes, which rclone repeats.
const FAILURES = [
    { kind: "authorization-refused", pattern: /invalid_grant|invalid_client|unauthorized_client|failed to create oauth client|empty token found|there's no refresh token|Token has been expired or revoked|insufficient authentication scopes/i },
    { kind: "offline", pattern: /dial tcp|no such host|network is unreachable|connection refused|i\/o timeout|TLS handshake timeout|connection reset by peer|cannot assign requested address|temporary failure in name resolution/i },
    { kind: "deletion-limit", pattern: /too many deletes/i },
    { kind: "bisync-recovery-required", pattern: /cannot find prior Path1 or Path2 listings|Must run --resync to recover|path1 and path2 are out of sync/i }
];
// The pair state a lastError kind makes; every other kind is `error`.
const FAILURE_STATES = {
    "credential-absent": "authorization-required",
    "credential-locked": "authorization-required",
    "authorization-refused": "authorization-required",
    "initialization-required": "initialization-required",
    offline: "offline"
};
const USAGE = "usage: google-drive run [--pair <id>] | initialize --pair <id> | status [--quiet] | attention-seen <key> | dismiss <key> | probe | authorize | sign-out | install | start | pause [--pair <id>] | resume [--pair <id>] | pairs [--lines] | pairs-reset | pair-add --definition <json> | pair-remove <id>";

function bad(first) {
    process.stderr.write("google-drive: refused: " + first + "\n" + USAGE + "\n");
    process.exit(2);
}

function stampOf(ms) {
    return new Date(ms).toISOString().replace(/[-:]/g, "").replace(/\.\d+Z$/, "Z") + "-" + process.pid;
}

function refuse(first) {
    process.stderr.write("google-drive: refused: " + first + "\n");
    process.exit(1);
}

function log(line) {
    process.stderr.write("google-drive: " + line + "\n");
}

// ------------------------------------------------------------ the places

const home = process.env.HOME || "";
if (!home.startsWith("/")) refuse("home=unset");
// XDG's rule: an unset or relative value takes the default.
function absoluteOr(value, fallback) {
    return typeof value === "string" && value.startsWith("/") ? value : fallback;
}
const configHome = absoluteOr(process.env.XDG_CONFIG_HOME, path.join(home, ".config"));
const stateHome = absoluteOr(process.env.XDG_STATE_HOME, path.join(home, ".local", "state"));
const dataHome = absoluteOr(process.env.XDG_DATA_HOME, path.join(home, ".local", "share"));
const runtimeDir = absoluteOr(process.env.XDG_RUNTIME_DIR, "");
const pairsFile = path.join(configHome, "vgshell", "google-drive", "pairs.json");
const unitDir = path.join(configHome, "systemd", "user");
const stateDir = path.join(stateHome, "vgshell", "google-drive");
const statusFile = path.join(stateDir, "status.json");
const controlFile = path.join(stateDir, "control.json");
const engineRoot = path.join(dataHome, "vgshell", "google-drive", "engine");
const lockDir = runtimeDir === "" ? "" : path.join(runtimeDir, "vgshell", "google-drive");

function pairDir(id) {
    return path.join(stateDir, "pairs", id);
}

function pairLock(id) {
    return path.join(lockDir, id + ".lock");
}

// --------------------------------------------------------------- helpers

function which(command) {
    for (const dir of String(process.env.PATH || "").split(path.delimiter)) {
        if (!dir.startsWith("/")) continue;
        const candidate = path.join(dir, command);
        try {
            fs.accessSync(candidate, fs.constants.X_OK);
            if (fs.statSync(candidate).isFile()) return candidate;
        } catch (_e) {
            // Not here; keep looking.
        }
    }
    return null;
}

function requireCommand(command) {
    const bin = which(command);
    if (bin === null) refuse(command + "=missing");
    return bin;
}

// Every child gets this environment and what its caller adds, never the
// caller's whole environment: a user's RCLONE_* variables must not reach
// the rclone call. secret-tool and systemctl need the session bus.
function childEnv(extra) {
    const env = { LANG: "C.UTF-8" };
    for (const name of ["PATH", "HOME", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "TMPDIR"])
        if (process.env[name]) env[name] = process.env[name];
    return Object.assign(env, extra || {});
}

function run(command, args, options) {
    return childProcess.spawnSync(command, args, Object.assign({ encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], env: childEnv() }, options || {}));
}

function now() {
    return new Date().toISOString();
}

function writeAtomic(file, text, mode) {
    fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
    const temp = path.join(path.dirname(file), "." + path.basename(file) + ".tmp-" + process.pid);
    fs.writeFileSync(temp, text, { mode: mode || 0o600 });
    fs.renameSync(temp, file);
}

function writeJson(file, value) {
    writeAtomic(file, JSON.stringify(value, null, 2) + "\n");
}

// { kind: "absent" } | { kind: "ok", value } | { kind: "bad", reason }
function readJson(file) {
    let text;
    try {
        text = fs.readFileSync(file, "utf8");
    } catch (e) {
        if (e.code === "ENOENT") return { kind: "absent" };
        return { kind: "bad", reason: "unreadable-" + (e.code || "error") };
    }
    try {
        return { kind: "ok", value: JSON.parse(text) };
    } catch (_e) {
        return { kind: "bad", reason: "not-json" };
    }
}

function readText(file) {
    try {
        return fs.readFileSync(file, "utf8");
    } catch (e) {
        if (e.code === "ENOENT") return null;
        throw e;
    }
}

function plain(value) {
    return value !== null && typeof value === "object" && !Array.isArray(value);
}

function hasOwn(object, key) {
    return Object.prototype.hasOwnProperty.call(object, key);
}

// Whether CHILD is PARENT or lies under it; paths, or Drive paths with no
// leading slash.
function within(parent, child) {
    return child === parent || child.startsWith(parent === "/" ? "/" : parent + "/");
}

function md5File(file) {
    const hash = crypto.createHash("md5");
    const fd = fs.openSync(file, "r");
    try {
        const buffer = Buffer.alloc(1 << 20);
        let read;
        while ((read = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) hash.update(buffer.subarray(0, read));
    } finally {
        fs.closeSync(fd);
    }
    return hash.digest("hex");
}

// Every regular file under DIR, as paths relative to it; no symlink is
// followed.
function filesUnder(dir) {
    const found = [];
    const walk = rel => {
        let entries;
        try {
            entries = fs.readdirSync(path.join(dir, rel), { withFileTypes: true });
        } catch (e) {
            if (e.code === "ENOENT") return;
            throw e;
        }
        for (const entry of entries) {
            const child = rel === "" ? entry.name : rel + "/" + entry.name;
            if (entry.isDirectory()) walk(child);
            else if (entry.isFile()) found.push(child);
        }
    };
    walk("");
    return found.sort();
}

// ------------------------------------------------------------------ locks

// flock(1) locks the open file description it is handed as fd 3, which
// this process shares, so the lock outlives the flock child and ends when
// every process holding that description closes it or dies. Node opens
// files close-on-exec, so no child holds a lock but the rclone of a pair
// run, which is handed the pair's lock (rclone): a runner killed while its
// rclone still copies leaves the pair locked until that copy ends.
function lockFd(file, flags) {
    if (lockDir === "") refuse("runtime-dir=unset");
    fs.mkdirSync(lockDir, { recursive: true, mode: 0o700 });
    const fd = fs.openSync(file, "a", 0o600);
    const out = run(requireCommand("flock"), flags.concat(["-E", String(EXIT_BUSY), "3"]), { stdio: ["ignore", "ignore", "pipe", fd] });
    if (out.status === 0) return fd;
    fs.closeSync(fd);
    if (out.status === EXIT_BUSY) return null;
    refuse("flock=failed exit=" + out.status + " lock=" + path.basename(file));
}

// Whether a run holds FILE's lock. lockFd opens the file afresh, so this
// process's own lock reads as held too.
function lockHeld(file) {
    if (lockDir === "" || !fs.existsSync(file)) return false;
    const fd = lockFd(file, ["-n"]);
    if (fd === null) return true;
    fs.closeSync(fd);
    return false;
}

// FN under the state lock, which orders every write of the pair list, the
// pause record, a pair's state and the status record. A run takes it only
// while it writes, after its pair lock, never the other way round.
function withStateLock(fn) {
    const fd = lockFd(path.join(lockDir, "state.lock"), ["-w", "30"]);
    if (fd === null) refuse("state-lock=timeout");
    try {
        return fn();
    } finally {
        fs.closeSync(fd);
    }
}

// ------------------------------------------------------------------ pairs

const OLD_PAIR_KEYS = ["direction", "id", "label", "local", "remote"];
const PAIR_KEYS = ["id", "label", "local", "remote"];

function refusal(pair, rule) {
    const id = plain(pair) && typeof pair.id === "string" && /^[a-z0-9-]{1,32}$/.test(pair.id) ? pair.id : "?";
    return "pair=" + id + " rule=" + rule;
}

// The real path of P where it exists, else P itself, so a symlink cannot
// slip a pair past the home and overlap rules.
function real(p) {
    try {
        return fs.realpathSync(p);
    } catch (_e) {
        return p;
    }
}

const CONTROL = /[\u0000-\u001f\u007f]/;

// The refusal of one pair alone, or null.
function pairError(pair) {
    if (!plain(pair) || Object.keys(pair).sort().join(",") !== PAIR_KEYS.join(",")) return refusal(pair, "shape");
    if (typeof pair.id !== "string" || !/^[a-z0-9][a-z0-9-]{0,31}$/.test(pair.id)) return refusal(pair, "id");
    if (typeof pair.label !== "string" || pair.label.trim() === "" || pair.label.length > 64 || CONTROL.test(pair.label)) return refusal(pair, "label");
    if (typeof pair.remote !== "string" || CONTROL.test(pair.remote)) return refusal(pair, "remote");
    if (pair.remote === "") return refusal(pair, "drive-root");
    if (pair.remote.split("/").some(part => part === "" || part === "." || part === "..")) return refusal(pair, "remote");
    if (typeof pair.local !== "string" || !path.isAbsolute(pair.local) || path.normalize(pair.local) !== pair.local || pair.local.endsWith("/") && pair.local !== "/" || CONTROL.test(pair.local)) return refusal(pair, "local");
    const local = real(pair.local);
    if (within(local, real(home))) return refusal(pair, "home-or-above");
    if (fs.existsSync(path.join(local, ".git"))) return refusal(pair, "repository-root");
    if (within(local, real(stateDir)) || within(real(stateDir), local)) return refusal(pair, "state-overlap");
    // What runs as code here: the runner copy and installed plugins, the
    // shell's configuration and the user's units. Drive content written
    // there would run on this computer.
    for (const dir of [path.join(dataHome, "vgshell"), path.join(configHome, "vgshell")])
        if (within(local, real(dir)) || within(real(dir), local)) return refusal(pair, "vgs-overlap");
    if (within(local, real(unitDir)) || within(real(unitDir), local)) return refusal(pair, "unit-overlap");
    if (holdsRepository(local)) return refusal(pair, "repository-inside");
    return null;
}

// Whether a directory under DIR, symlinks not followed, holds `.git`.
function holdsRepository(dir) {
    let entries;
    try {
        entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch (_e) {
        return false;
    }
    for (const entry of entries) {
        if (!entry.isDirectory()) continue;
        const child = path.join(dir, entry.name);
        if (fs.existsSync(path.join(child, ".git")) || holdsRepository(child)) return true;
    }
    return false;
}

// The first refusal of a pair list, or null: each pair alone, then every
// two pairs against each other.
function pairsError(pairs) {
    for (const pair of pairs) {
        const error = pairError(pair);
        if (error !== null) return error;
    }
    for (let i = 0; i < pairs.length; i++) {
        for (let j = 0; j < i; j++) {
            const a = pairs[i];
            const b = pairs[j];
            if (a.id === b.id) return refusal(a, "duplicate-id");
            const la = real(a.local);
            const lb = real(b.local);
            if (within(la, lb) || within(lb, la)) return refusal(a, "local-overlap");
            if (within(a.remote, b.remote) || within(b.remote, a.remote)) return refusal(a, "remote-overlap");
        }
    }
    return null;
}

function oldPairList(value) {
    return plain(value) && Object.keys(value).join(",") === "pairs" && Array.isArray(value.pairs) && value.pairs.length > 0
        && value.pairs.every(pair => plain(pair) && Object.keys(pair).sort().join(",") === OLD_PAIR_KEYS.join(",")
            && OLD_DIRECTIONS.indexOf(pair.direction) !== -1);
}

function migratePairListIfNeeded() {
    const read = readJson(pairsFile);
    if (read.kind !== "ok" || !oldPairList(read.value)) return;
    withStateLock(() => {
        const again = readJson(pairsFile);
        if (again.kind !== "ok" || !oldPairList(again.value)) return;
        const pairs = again.value.pairs.map(pair => ({ id: pair.id, label: pair.label, local: pair.local, remote: pair.remote }));
        writeJson(pairsFile, { pairs: pairs });
        log("migration=pairs old=direction result=written");
    });
}

// { pairs, error }: an absent file is no pairs; a defect names itself and
// runs no pair.
function readPairs() {
    const read = readJson(pairsFile);
    if (read.kind === "absent") return { pairs: [], error: null };
    if (read.kind === "bad") return { pairs: [], error: "pairs-file=" + read.reason };
    if (!plain(read.value) || Object.keys(read.value).join(",") !== "pairs" || !Array.isArray(read.value.pairs))
        return { pairs: [], error: "pairs-file=shape" };
    const error = pairsError(read.value.pairs);
    return error === null ? { pairs: read.value.pairs, error: null } : { pairs: [], error: error };
}

// ---------------------------------------------------------- pause record

// { paused, pausedPairs, notifiedKey, dismissed }: notifiedKey is the
// attention key the plugin last notified of, or null; dismissed the
// conflict keys the user dismissed (dismissVerb). A record with no list,
// as every record before dismissals has, or a list that is not keys,
// dismisses nothing: the rows show again, and nothing else is lost.
function readControl() {
    const read = readJson(controlFile);
    if (read.kind === "ok" && plain(read.value) && typeof read.value.paused === "boolean" && Array.isArray(read.value.pausedPairs)) {
        if (hasOwn(read.value, "twoWaySync") && typeof read.value.twoWaySync !== "boolean")
            return { paused: true, pausedPairs: [], notifiedKey: null, dismissed: [], twoWaySync: true, error: "two-way-shape" };
        const dismissed = read.value.dismissed;
        return { paused: read.value.paused, pausedPairs: read.value.pausedPairs, notifiedKey: typeof read.value.notifiedKey === "string" ? read.value.notifiedKey : null,
            dismissed: Array.isArray(dismissed) && dismissed.every(k => typeof k === "string" && CONFLICT_KEY.test(k)) ? dismissed : [],
            modeAdmitted: read.value.modeAdmitted,
            twoWaySync: read.value.twoWaySync === undefined ? true : read.value.twoWaySync };
    }
    if (read.kind === "absent") return { paused: false, pausedPairs: [], notifiedKey: null, dismissed: [], twoWaySync: true };
    // A pause record that cannot be read holds every run back, so a pause
    // the user set is never lost to a damaged file.
    log("control=" + (read.kind === "bad" ? read.reason : "shape") + " paused=assumed");
    return { paused: true, pausedPairs: [], notifiedKey: null, dismissed: [], twoWaySync: true, error: read.kind === "bad" ? read.reason : "shape" };
}

// Decide once before pair-add can turn an empty install into one with pairs.
// Only Service admits existing pairs after confirming the saved Settings choice.
function migrateModeIfNeeded() {
    withStateLock(() => {
        const raw = readJson(controlFile);
        if (raw.kind === "ok" && plain(raw.value) && hasOwn(raw.value, "modeAdmitted")) return;
        const control = readControl();
        if (control.error) return;
        const pairs = readPairs();
        if (pairs.error !== null) return;
        writeJson(controlFile, Object.assign(control, { modeAdmitted: pairs.pairs.length === 0 }));
    });
}

function isPaused(control, id) {
    return control.paused || control.pausedPairs.indexOf(id) !== -1;
}

// ----------------------------------------------------------- pair state

function readPairState(id) {
    const read = readJson(path.join(pairDir(id), "state.json"));
    const empty = { state: "idle", startedAt: null, lastAttempt: null, lastSuccess: null, lastError: null, changes: null, records: [], baseline: null };
    if (read.kind === "absent") return empty;
    if (read.kind === "ok" && plain(read.value) && validRecords(read.value.records)) return Object.assign(empty, read.value);
    return Object.assign(empty, { state: "error", lastError: { kind: "baseline-evidence-unreadable", at: null, mayHaveChanged: false } });
}

function writePairState(id, state) {
    writeJson(path.join(pairDir(id), "state.json"), state);
}

function readInventory(id) {
    const read = readJson(path.join(pairDir(id), "inventory.json"));
    return read.kind === "ok" && plain(read.value) && plain(read.value.entries) ? read.value.entries : {};
}

// The pair state's converter steps, oldest first (D107). The first form
// kept local edits in `localEdits` and Drive-side records in the
// inventory. The second recorded a doubled Drive name as
// OLD_DUPLICATE_KIND, which said nothing of its copies.
const OLD_DUPLICATE_KIND = "duplicate-on-drive";

function oldPairState(value) {
    return plain(value) && Array.isArray(value.localEdits);
}

function oldDuplicates(value) {
    return plain(value) && Array.isArray(value.records) && value.records.some(r => plain(r) && r.kind === OLD_DUPLICATE_KIND);
}

function pairStateOutdated(value) {
    return oldPairState(value) || oldDuplicates(value);
}

function migratePairStateIfNeeded(id) {
    const stateFile = path.join(pairDir(id), "state.json");
    const inventoryFile = path.join(pairDir(id), "inventory.json");
    const stateRead = readJson(stateFile);
    if (stateRead.kind !== "ok" || !pairStateOutdated(stateRead.value)) return;
    const state = Object.assign({}, stateRead.value);
    if (oldPairState(state)) {
        const inventoryRead = readJson(inventoryFile);
        const inventory = inventoryRead.kind === "ok" && plain(inventoryRead.value) && plain(inventoryRead.value.entries) ? inventoryRead.value.entries : {};
        const records = Array.isArray(state.records) ? state.records.slice() : [];
        const migrationTime = Date.now();
        const migratedStamp = stampOf(migrationTime);
        for (const edit of state.localEdits) {
            if (!plain(edit) || typeof edit.path !== "string" || typeof edit.stored !== "string") continue;
            const slash = edit.stored.indexOf("/");
            const renamed = slash === -1 ? edit.stored : migratedStamp + edit.stored.slice(slash);
            const oldFile = path.join(pairDir(id), "conflicts", edit.stored);
            const newFile = path.join(pairDir(id), "conflicts", renamed);
            if (fs.existsSync(oldFile) && oldFile !== newFile) {
                fs.mkdirSync(path.dirname(newFile), { recursive: true });
                fs.renameSync(oldFile, newFile);
            }
            addRecord(records, { kind: "both-changed", path: edit.path, stored: renamed, since: new Date(migrationTime).toISOString() });
        }
        delete state.localEdits;
        for (const rel of Object.keys(inventory)) {
            const entry = inventory[rel];
            if (!plain(entry) || (entry.state !== "removed-on-drive" && entry.state !== "renamed")) continue;
            addRecord(records, { kind: entry.state, path: rel, since: new Date(migrationTime).toISOString(), to: entry.to });
            delete entry.state;
            delete entry.since;
            delete entry.to;
        }
        state.records = records;
        if (inventoryRead.kind === "ok") writeJson(inventoryFile, { entries: inventory });
    }
    // A doubled-name record is dropped, not converted: whether its copies
    // match and who owns them takes a Drive listing, and this step runs
    // with no credential or network. It holds no kept copy, and the
    // download leg decides these kinds afresh each run (withDriveRecords),
    // so the next sync that meets the name records it whole. Dropping adds
    // no record, so it raises no notification.
    if (oldDuplicates(state)) {
        const dropped = state.records.filter(r => plain(r) && r.kind === OLD_DUPLICATE_KIND).length;
        state.records = state.records.filter(r => !(plain(r) && r.kind === OLD_DUPLICATE_KIND));
        log("migration=pair-state pair=" + id + " dropped=" + OLD_DUPLICATE_KIND + " count=" + dropped);
    }
    writeJson(stateFile, state);
    log("migration=pair-state pair=" + id + " result=written");
}

// Whether a pair state was converted, so the caller rewrites the status
// record, which an earlier runner rendered from the earlier form.
function migratePairStatesIfNeeded() {
    const root = path.join(stateDir, "pairs");
    let ids;
    try {
        ids = fs.readdirSync(root, { withFileTypes: true }).filter(e => e.isDirectory()).map(e => e.name);
    } catch (e) {
        if (e.code === "ENOENT") return false;
        throw e;
    }
    const old = ids.some(id => {
        const stateRead = readJson(path.join(pairDir(id), "state.json"));
        return stateRead.kind === "ok" && pairStateOutdated(stateRead.value);
    });
    if (!old) return false;
    withStateLock(() => ids.forEach(migratePairStateIfNeeded));
    return true;
}

// ------------------------------------------------------------ credentials

// The words after `secret-tool` for one account's items: VERB's words, the
// attributes every item of SERVICE carries, then EXTRA. An argv with no
// shell between, so no word is quoted; a secret never enters it. SERVICE
// is this plugin's own but in the rename migration, which reads and clears
// the previous name's items.
function secretArgs(verb, account, extra = [], service = SECRET_SERVICE) {
    return verb.concat(["service", service, "account", account], extra);
}

// One account's secret, searched without --unlock so an unattended run
// raises no unlock prompt. `secret-tool search` prints the first match's
// `label = ` and, only when its collection is unlocked, `secret = <value>`
// on stdout (libsecret tool/secret-tool.c). The value stays in this
// process and the rclone child's environment. Only the rename reads
// SERVICE's item as it is; every other reader calls readSecret.
function searchItem(tool, account, service) {
    const out = run(tool, secretArgs(["search"], account, [], service), { timeout: 10000, killSignal: "SIGKILL" });
    if (out.status !== 0) return { kind: "unavailable", reason: out.status === null ? "secret-tool-timeout" : "secret-tool-failed" };
    const lines = out.stdout.split("\n");
    const secret = lines.find(line => line.startsWith("secret = "));
    if (secret !== undefined && secret.length > "secret = ".length) return { kind: "found", value: secret.slice("secret = ".length), user: userAttribute(out.stderr) };
    if (lines.some(line => line.startsWith("label = "))) return { kind: "locked" };
    return { kind: "absent" };
}

// ACCOUNT's secret under this plugin's service. An item the rename still
// holds under the previous name reads as that item reads there, never as
// absent: a locked keyring stays the locked case, not a missing key.
function readSecret(tool, account) {
    const got = searchItem(tool, account, SECRET_SERVICE);
    if (got.kind !== "absent") return got;
    const held = renameHeldPresence(account);
    if (held === "locked") return { kind: "locked" };
    if (held === "unavailable") return { kind: "unavailable", reason: "secret-tool-failed" };
    return got;
}

// { kind: "found", values: { part: value }, address }, address the
// token's `user` attribute or null, or the first account that failed:
// { kind: "absent"|"locked"|"unavailable", account, reason? }.
function readCredential() {
    const tool = which("secret-tool");
    const values = {};
    let address = null;
    for (const part of CREDENTIAL_PARTS) {
        const account = part;
        if (tool === null) return { kind: "unavailable", account: account, reason: "secret-tool-missing" };
        const got = readSecret(tool, account);
        if (got.kind !== "found") return Object.assign({ account: account }, got);
        values[part] = got.value;
        if (part === "token") address = got.user;
    }
    return { kind: "found", values: values, address: address };
}

// A Google account address as the keyring's `user` attribute and the
// Settings line hold it: printable, at most 254 characters, one `@` with
// text on each side.
function validAddress(value) {
    return typeof value === "string" && value.length <= 254 && /^[^@\s\u0000-\u001f\u007f-\u009f]+@[^@\s\u0000-\u001f\u007f-\u009f]+$/.test(value);
}

// The item's `user` attribute in secret-tool search's STDERR, when it
// holds an address, else null.
function userAttribute(stderr) {
    const named = String(stderr).split("\n").find(line => line.startsWith("attribute.user = "));
    return named !== undefined && validAddress(named.slice("attribute.user = ".length)) ? named.slice("attribute.user = ".length) : null;
}

// Presence without the value: stdout goes nowhere; an item found, locked
// or not, prints its `attribute.` lines on stderr, and a locked one also a
// `secret-tool: ` line naming the lock, gnome-keyring's `Cannot get secret
// of a locked object`. { presence, user }: user is the item's `user`
// attribute when it holds an address, else null. Only the rename probes
// SERVICE's item as it is; every other reader calls probeAccount.
function probeItem(tool, account, service) {
    if (tool === null) return { presence: "unavailable", user: null };
    const out = run(tool, secretArgs(["search"], account, [], service), { stdio: ["ignore", "ignore", "pipe"], timeout: 10000, killSignal: "SIGKILL" });
    if (out.status !== 0) return { presence: "unavailable", user: null };
    const lines = out.stderr.split("\n");
    const found = lines.some(line => line.startsWith("attribute."));
    const failure = lines.find(line => line.startsWith("secret-tool: "));
    const user = userAttribute(out.stderr);
    if (!found && failure === undefined) return { presence: "absent", user: null };
    if (found && failure === undefined) return { presence: "present", user: user };
    if (found && /locked/i.test(failure)) return { presence: "locked", user: user };
    return { presence: "unavailable", user: null };
}

// ACCOUNT's presence under this plugin's service, an item the rename
// holds read as readSecret reads it.
function probeAccount(tool, account) {
    const probed = probeItem(tool, account, SECRET_SERVICE);
    if (probed.presence !== "absent") return probed;
    const held = renameHeldPresence(account);
    return held === null ? probed : { presence: held, user: null };
}

// Removes every item of ACCOUNT that is unlocked: libsecret's clear leaves
// a locked item (secret_service_clear), so a caller that needs it gone
// probes after. secret-tool clear exits 1 with nothing on stderr when no
// item matched (tool/secret-tool.c, libsecret 0.21.8), which is nothing
// to clear; an error it prints is a failure.
function clearAccount(tool, account) {
    const out = run(tool, secretArgs(["clear"], account), { timeout: 30000, killSignal: "SIGKILL" });
    if (out.status === 1 && out.stderr === "") return;
    if (out.status !== 0) refuse("clear=failed exit=" + out.status + " account=" + account);
}

function clearAccountResult(tool, account, service = SECRET_SERVICE) {
    const out = run(tool, secretArgs(["clear"], account, [], service), { timeout: 30000, killSignal: "SIGKILL" });
    if (out.status === 1 && out.stderr === "") return { ok: true };
    if (out.status !== 0) return { ok: false, reason: "clear-failed", account: account };
    return { ok: true };
}

function storeSecret(tool, account, value, extra = []) {
    const stored = childProcess.spawnSync(tool, secretArgs(["store", "--label=" + SECRET_LABEL + " " + account], account, extra),
        { input: value, encoding: "utf8", stdio: ["pipe", "ignore", "pipe"], env: childEnv(), timeout: 30000, killSignal: "SIGKILL" });
    return stored.status === 0 ? { ok: true } : { ok: false, reason: "store-failed", account: account };
}

function migrateCredentialsIfNeeded() {
    const tool = which("secret-tool");
    if (tool === null) return;
    if (probeAccount(tool, "token").presence !== "absent") return;
    const oldPresence = OLD_ACCOUNTS.map(account => [account, probeAccount(tool, account).presence]);
    if (!oldPresence.some(row => row[1] !== "absent")) return;
    if (oldPresence.some(row => row[1] === "locked" || row[1] === "unavailable")) {
        const row = oldPresence.find(r => r[1] === "locked" || r[1] === "unavailable");
        log("migration=held reason=credential-" + row[1] + " account=" + row[0]);
        return;
    }
    const pull = ["pull-client-id", "pull-client-secret"].map(account => [account, readSecret(tool, account)]);
    const upload = ["upload-client-id", "upload-client-secret"].map(account => [account, readSecret(tool, account)]);
    const source = pull.every(row => row[1].kind === "found") ? pull : upload.every(row => row[1].kind === "found") ? upload : null;
    if (source !== null) for (const [index, part] of ["client-id", "client-secret"].entries()) {
        if (probeAccount(tool, part).presence !== "absent") continue;
        const stored = storeSecret(tool, part, source[index][1].value);
        if (!stored.ok) {
            log("migration=held reason=" + stored.reason + " account=" + stored.account);
            return;
        }
    }
    if (probeAccount(tool, "client-id").presence !== "present" || probeAccount(tool, "client-secret").presence !== "present") {
        log("migration=held reason=credential-incomplete");
        return;
    }
    for (const account of OLD_ACCOUNTS) {
        const cleared = clearAccountResult(tool, account);
        if (!cleared.ok) {
            log("migration=held reason=" + cleared.reason + " account=" + account);
            return;
        }
    }
    const left = OLD_ACCOUNTS.map(account => [account, probeAccount(tool, account).presence]).find(row => row[1] !== "absent");
    if (left !== undefined) {
        log("migration=held reason=credential-" + left[1] + " account=" + left[0]);
        return;
    }
    log("migration=credentials result=written");
}

// ----------------------------------------------------------------- rclone

function filterArgs() {
    return [].concat(...EXCLUDES.map(pattern => ["--exclude", pattern]));
}

function remotePath(pair) {
    return REMOTE + ":" + pair.remote;
}

// The rclone child's environment: the remote defined by variables alone,
// with no config file (`--config /dev/null` keeps rclone's configuration
// in memory). rclone refreshes the access token in memory each run. The
// stored refresh token does not change: Google's refresh response carries
// no refresh_token (developers.google.com/identity/protocols/oauth2/
// native-app, "Refreshing an access token"), and golang.org/x/oauth2 keeps
// the one it sent (internal/token.go, RetrieveToken). So nothing is stored
// back.
function rcloneEnv(values) {
    const extra = {};
    extra[REMOTE_ENV + "TYPE"] = "drive";
    extra[REMOTE_ENV + "CLIENT_ID"] = values["client-id"];
    extra[REMOTE_ENV + "CLIENT_SECRET"] = values["client-secret"];
    extra[REMOTE_ENV + "TOKEN"] = values.token;
    extra[REMOTE_ENV + "SCOPE"] = DRIVE_SCOPE;
    return childEnv(extra);
}

// rclone exit 3 is its documented "directory not found": a missing source.
function failureKind(status, stderr) {
    if (status === 3) return "source-missing";
    const row = FAILURES.find(r => r.pattern.test(stderr));
    return row === undefined ? "rclone-failed" : row.kind;
}

// Runs rclone ARGS holding LOCK, the pair's lock descriptor, as its fd 3:
// { ok, stdout, stderr } or { ok: false, kind, exit, stderr }. Its stderr
// reaches this runner's stderr, the journal, with every secret value
// replaced.
function rclone(args, env, secrets, lock) {
    const bin = which("rclone");
    if (bin === null) return { ok: false, kind: "rclone-missing", exit: null, stderr: "" };
    const out = run(bin, ["--config", "/dev/null"].concat(args), { env: env, maxBuffer: 1 << 30, stdio: ["ignore", "pipe", "pipe", lock] });
    let stderr = String(out.stderr || "");
    for (const secret of secrets) stderr = stderr.split(secret).join("[secret]");
    if (stderr.trim() !== "") process.stderr.write(stderr.length > 65536 ? stderr.slice(-65536) : stderr);
    if (out.status === 0) return { ok: true, stdout: out.stdout, stderr: stderr };
    return { ok: false, kind: failureKind(out.status, stderr), exit: out.status, stderr: stderr };
}

// ------------------------------------------------------- conflict records

function recordKey(record) {
    return record.kind + "\n" + record.path + "\n" + (record.stored || "") + "\n" + (record.operation || "copy");
}

function addRecord(records, record) {
    if (records.some(r => recordKey(r) === recordKey(record))) return;
    const kept = { kind: record.kind, path: record.path, since: record.since || now() };
    if (typeof record.stored === "string") kept.stored = record.stored;
    if (typeof record.to === "string") kept.to = record.to;
    if (typeof record.reason === "string") kept.reason = record.reason;
    if (typeof record.mine === "boolean") kept.mine = record.mine;
    if (typeof record.owner === "string") kept.owner = record.owner;
    if (typeof record.version === "string") kept.version = record.version;
    for (const key of ["operation", "outcome", "recovery"])
        if (typeof record[key] === "string") kept[key] = record[key];
    records.push(kept);
}

// A conflict row's key: 16 hex digits of PAIR's stored RECORD whole, so a
// change to any of its facts, or the record going and coming back with a
// new `since`, makes a new key that no dismissal names.
const CONFLICT_KEY = /^[0-9a-f]{16}$/;
function conflictKey(pairId, record) {
    const facts = [pairId, record.kind, record.path, record.since, record.stored, record.to, record.reason, record.mine, record.owner, record.version];
    // Preserve historical keys byte for byte; newly tagged events carry their route.
    if (record.operation !== undefined) facts.push(record.operation, record.outcome, record.recovery);
    return crypto.createHash("sha256").update(JSON.stringify(facts.map(f => f === undefined ? null : f))).digest("hex").slice(0, 16);
}

// rclone v1.75.1's lines about one Drive file, after its date and time, as
// the journal of a run with a dangling shortcut and a doubled name holds
// them: the file's error, whatever its cause, the line that ends each
// attempt with the count of errors in that attempt, and the notice of a
// name Drive holds twice, of which rclone copies one.
const FILE_ERROR = /^\S+ \S+ ERROR : (.+?): Failed to copy: (.+)$/;
const ATTEMPT_END = /^\S+ \S+ ERROR : Attempt \d+\/\d+ failed with (\d+) errors and: /;
const DUPLICATE = /^\S+ \S+ NOTICE: (.+): Duplicate object found in source - ignoring$/;
// The reason rclone v1.75.1 gave for a Drive shortcut whose target is
// gone: "failed to open source object: can't read dangling shortcut".
const DANGLING = /can't read dangling shortcut/;
// The record kinds a download leg alone decides, each run afresh.
const DRIVE_KINDS = ["unreadable-on-drive", "duplicate-identical", "duplicate-different"];

// Whether a review record needs the user, "you", or only tells them what
// the sync did, "nothing". A doubled name needs the user only when the
// copies differ and the signed-in account owns one of them; only an
// owner can remove a copy.
function needsOf(record) {
    switch (record.kind) {
    case "both-changed": return "you";
    case "conflict-unresolved": return "you";
    case "local-recovery": return "nothing";
    case "removed-locally":
    case "removed-on-drive":
    case "renamed":
    case "duplicate-identical": return "nothing";
    case "unreadable-on-drive": return DANGLING.test(record.reason) ? "nothing" : "you";
    case "duplicate-different": return record.mine === true ? "you" : "nothing";
    }
    throw new Error("google-drive: review record kind " + JSON.stringify(record.kind) + " is not one this runner writes");
}

function validRecords(records) {
    if (!Array.isArray(records) || records.some(r => !plain(r) || !relativePath(r.path)
        || !Number.isFinite(Date.parse(r.since)) || r.stored !== undefined && !relativePath(r.stored))) return false;
    try { records.forEach(needsOf); } catch (_e) { return false; }
    return true;
}

// The md5 a listed Drive item carries, or null; rclone's drive backend
// lists none for a Google-native document.
function listedMd5(item) {
    return plain(item.Hashes) && typeof item.Hashes.md5 === "string" ? item.Hashes.md5 : null;
}

// The duplicate record of REL from COPIES, the folder listing's items of
// that name: identical when every copy has an md5 and every copy has the
// same md5 and size, else different, a Google-native document among
// them. ADDRESS is the signed-in account's, or null when the token names
// none. `mine` is true only when a copy's owner is ADDRESS, compared as
// Google compares addresses, without case: a copy that names no owner,
// as a shared drive's files do, or an unknown ADDRESS never counts as the
// user's, so no record claims the user can remove a copy that is not
// shown to be theirs. A record that is not mine names the first copy's
// owner that is an address, when one is. `version` hashes every copy's
// md5, size and modification time, in an order the listing's does not
// change, so an edit to any copy changes the row's key.
function duplicateRecord(rel, copies, address) {
    const md5s = copies.map(listedMd5);
    const identical = md5s.every(m => m !== null && /^[0-9a-f]{32}$/.test(m) && m === md5s[0]) && copies.every(c => c.Size === copies[0].Size);
    const owners = copies.map(c => plain(c.Metadata) && validAddress(c.Metadata.owner) ? c.Metadata.owner : null);
    const mine = address !== null && owners.some(o => o !== null && o.toLowerCase() === address.toLowerCase());
    const facts = copies.map((c, i) => JSON.stringify([md5s[i], c.Size === undefined ? null : c.Size, c.ModTime === undefined ? null : c.ModTime])).sort();
    const version = crypto.createHash("sha256").update(JSON.stringify(facts)).digest("hex").slice(0, 16);
    const record = { kind: identical ? "duplicate-identical" : "duplicate-different", path: rel, mine: mine, version: version };
    const named = owners.find(o => o !== null);
    if (!mine && named !== undefined) record.owner = named;
    return record;
}

// The records of DOUBLED, the names the download met twice, from one
// read-only listing per folder that holds one, LIST_FOLDER(folder) being
// that listing's rclone call: { kind: "read", records } or
// { kind: "failed", result }, result an rclone failure or null when its
// answer is not JSON. rclone's listing names every copy (the copy leg's
// notice is about the one it ignored), so a name it now lists once has
// changed on Drive since the copy and is left for the next run.
function duplicateRecords(doubled, listFolder, address) {
    const folders = new Map();
    for (const rel of doubled) {
        const slash = rel.lastIndexOf("/");
        const folder = slash === -1 ? "" : rel.slice(0, slash);
        if (!folders.has(folder)) folders.set(folder, []);
        folders.get(folder).push(rel);
    }
    const records = [];
    for (const [folder, paths] of folders) {
        const listed = listFolder(folder);
        if (!listed.ok) return { kind: "failed", result: listed };
        let items;
        try {
            items = JSON.parse(listed.stdout);
        } catch (_e) {
            return { kind: "failed", result: null };
        }
        if (!Array.isArray(items)) return { kind: "failed", result: null };
        for (const rel of paths) {
            const copies = items.filter(item => plain(item) && item.Path === rel.slice(folder === "" ? 0 : folder.length + 1));
            if (copies.length < 2) log("duplicate=gone copies=" + copies.length);
            else records.push(duplicateRecord(rel, copies, address));
        }
    }
    return { kind: "read", records: records };
}

// The files the download leg RESULT leaves for review, { unreadable,
// doubled }: a record of each file it could not copy, and the path of
// each name Drive holds twice, or null when the copy could not run.
// rclone "will accumulate errors as it goes along,
// and only exit with a non-zero exit code if (after retries) there were
// still failed transfers", with a log line for every error counted that
// names its file (rclone.org/docs/#exit-code, `man rclone` of v1.75.1). So
// a copy ran to its end when every error its last attempt counted is one
// file's error: the files that attempt names are as many as its count. An
// unreadable source file ends rclone v1.75.1 with exit 1 (a local-backend
// copy of a mode 000 file, 2026-10-13). Exit 7 is that page's "Fatal
// error", which stops the copy, and a credential or network cause
// (failureKind) keeps its kind even when it shows as file errors.
function downloadReview(result) {
    const lines = result.stderr.split("\n");
    const found = { unreadable: [], doubled: [] };
    for (const line of lines) {
        const twice = DUPLICATE.exec(line);
        if (twice !== null && found.doubled.indexOf(twice[1]) === -1) found.doubled.push(twice[1]);
    }
    if (result.ok) return found;
    if (result.kind !== "rclone-failed" || result.exit === 7) return null;
    const ends = lines.map((line, at) => ATTEMPT_END.test(line) ? at : -1).filter(at => at !== -1);
    if (ends.length === 0) return null;
    const last = ends[ends.length - 1];
    const reasons = new Map();
    for (const line of lines.slice(ends.length > 1 ? ends[ends.length - 2] + 1 : 0, last)) {
        const error = FILE_ERROR.exec(line);
        if (error !== null) reasons.set(error[1], error[2]);
    }
    if (reasons.size !== Number(ATTEMPT_END.exec(lines[last])[1])) return null;
    for (const [rel, reason] of reasons) addRecord(found.unreadable, { kind: "unreadable-on-drive", path: rel, reason: reason });
    return found;
}

// RECORDS with the download leg's kinds replaced by REVIEW, so a file that
// copies now leaves no record; one that stands keeps its first time.
function withDriveRecords(records, review) {
    const kept = records.filter(r => DRIVE_KINDS.indexOf(r.kind) === -1);
    for (const record of review) {
        const old = records.find(r => recordKey(r) === recordKey(record));
        addRecord(kept, old === undefined ? record : Object.assign({}, record, { since: old.since, operation: old.operation }));
    }
    return kept;
}

function stampMs(name) {
    const match = /^(\d{8}T\d{6}Z)-\d+(?:-[A-Za-z0-9]+)?$/.exec(name);
    if (match === null) return null;
    const s = match[1];
    return Date.parse(s.slice(0, 4) + "-" + s.slice(4, 6) + "-" + s.slice(6, 8) + "T" + s.slice(9, 11) + ":" + s.slice(11, 13) + ":" + s.slice(13, 15) + "Z");
}

function pruneConflictStorage(id, records, local) {
    const root = path.join(pairDir(id), "conflicts");
    const cutoff = Date.now() - KEEP_MS;
    if (fs.existsSync(root)) for (const dir of fs.readdirSync(root, { withFileTypes: true })) {
        if (!dir.isDirectory()) continue;
        const ms = stampMs(dir.name);
        if (ms === null) {
            log("pair=" + id + " conflict-storage=kept reason=stamp-unreadable name=" + dir.name);
            continue;
        }
        if (ms < cutoff) fs.rmSync(path.join(root, dir.name), { recursive: true, force: true });
    }
    // A download decides its own kinds afresh (withDriveRecords), so their
    // age removes none: a file that stays unreadable keeps its first time.
    return records.filter(r => {
        if (r.kind === "conflict-unresolved") return fs.existsSync(path.join(local, r.path));
        if (DRIVE_KINDS.indexOf(r.kind) === -1 && Date.parse(r.since) < cutoff && typeof r.stored !== "string") return false;
        return typeof r.stored !== "string" || fs.existsSync(path.join(root, r.stored));
    });
}

function localEntry(file) {
    try {
        const st = fs.lstatSync(file);
        return st.isFile() ? { size: st.size, mtimeMs: Math.floor(st.mtimeMs) } : null;
    } catch (_e) {
        return null;
    }
}

function baselineDiffers(base, entry) {
    if (base === undefined || base.export) return false;
    if (entry === null) return true;
    return base.size !== entry.size || base.mtimeMs !== entry.mtimeMs;
}

function driveDiffers(base, item) {
    if (base === undefined || item === undefined) return false;
    if (base.export) return item.Size !== -1 || Date.parse(item.ModTime) !== base.mtimeMs;
    const md5 = listedMd5(item);
    return base.size !== item.Size || base.mtimeMs !== Date.parse(item.ModTime) || (base.hash !== null && md5 !== null && base.hash !== md5);
}

function classifyBeforeCopy(pair, listing, inventory, records) {
    const byPath = {};
    const pathOfId = {};
    for (const item of listing) {
        byPath[item.Path] = item;
        if (item.ID) pathOfId[item.ID] = item.Path;
    }
    // A path both sides hold with no baseline, such as a pair added over two
    // full folders: a newer, different local file replaces Drive's, whose
    // older version Drive keeps, so the user hears of it. A newer Drive file
    // is displaced into conflict storage and recorded there. An export never
    // uploads, so it is no conflict.
    for (const item of listing) {
        if (hasOwn(inventory, item.Path) || item.Size === -1) continue;
        const file = path.join(pair.local, item.Path);
        const local = localEntry(file);
        if (local === null || local.mtimeMs <= Date.parse(item.ModTime)) continue;
        const md5 = listedMd5(item);
        const differs = item.Size !== local.size || md5 !== null && md5File(file) !== md5;
        if (differs) addRecord(records, { kind: "both-changed", path: item.Path });
    }
    for (const rel of Object.keys(inventory).sort()) {
        const base = inventory[rel];
        const item = byPath[rel];
        const localPath = path.join(pair.local, rel);
        const local = localEntry(localPath);
        if (local === null && item !== undefined) {
            // Baseline path vanished locally but still exists on Drive:
            // download restores it without deleting Drive's copy.
            addRecord(records, { kind: "removed-locally", path: rel });
        } else if (local !== null && item === undefined) {
            // Baseline path vanished from Drive but still exists locally:
            // upload restores it, or `renamed` records the Drive object id's
            // new path while never deleting the old local name.
            const to = base.id && hasOwn(pathOfId, base.id) ? pathOfId[base.id] : null;
            addRecord(records, { kind: to === null ? "removed-on-drive" : "renamed", path: rel, to: to });
        } else if (local === null && item === undefined) {
            // Gone on both sides: no review record remains.
        } else if (baselineDiffers(base, local) && driveDiffers(base, item)) {
            // Both sides changed since the baseline. When local is newer,
            // upload wins and Drive keeps the older version in its 30-day
            // version history, so no local stored copy is recorded.
            const driveTime = Date.parse(item.ModTime);
            if (local.mtimeMs > driveTime) addRecord(records, { kind: "both-changed", path: rel });
        }
    }
    // A both-changed record with a kept copy outlives its file: that copy is
    // the only version left. pruneConflictStorage has already dropped a
    // record whose kept copy is gone.
    return records.filter(record => {
        const item = byPath[record.path];
        const localGone = !fs.existsSync(path.join(pair.local, record.path));
        if ((record.kind === "removed-locally" || record.kind === "removed-on-drive" || record.kind === "renamed"
            || record.kind === "both-changed" && typeof record.stored !== "string")
            && item === undefined && localGone) return false;
        return true;
    });
}

// Classifies every file rclone moved into conflict storage (--backup-dir)
// that no record names yet. A displaced file that matches its inventory
// baseline (size, modification time, and md5 where the baseline has one)
// is this runner's own earlier download, which is removed, the one
// deletion the runner makes. Any other displaced file is kept and
// recorded as both-changed.
function classifyDisplaced(id, inventory, records) {
    const root = path.join(pairDir(id), "conflicts");
    const kept = records.slice();
    const known = new Set(kept.map(r => r.stored));
    for (const stored of filesUnder(root)) {
        if (known.has(stored)) continue;
        const rel = stored.slice(stored.indexOf("/") + 1);
        const file = path.join(root, stored);
        const st = fs.statSync(file);
        const base = hasOwn(inventory, rel) ? inventory[rel] : undefined;
        const unedited = base !== undefined && !base.export && base.size === st.size && base.mtimeMs === Math.floor(st.mtimeMs)
            && (base.hash === null || md5File(file) === base.hash);
        if (unedited) {
            fs.unlinkSync(file);
        } else {
            addRecord(kept, { kind: "both-changed", path: rel, stored: stored });
            log("pair=" + id + " both-changed=kept");
        }
    }
    for (const dir of fs.existsSync(root) ? fs.readdirSync(root) : []) removeEmptyDirs(path.join(root, dir));
    return kept;
}

function removeEmptyDirs(dir) {
    let entries;
    try {
        entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch (_e) {
        return;
    }
    for (const entry of entries) if (entry.isDirectory()) removeEmptyDirs(path.join(dir, entry.name));
    try {
        fs.rmdirSync(dir);
    } catch (_e) {
        // Not empty: it holds a kept version.
    }
}

// HELD names the paths whose download failed this run: the copy here is
// still the one BEFORE describes, so each keeps that baseline, or none,
// and counts as no change.
function nextInventory(pair, listing, before, held) {
    const entries = {};
    let added = 0;
    let updated = 0;
    for (const item of listing) {
        if (held.has(item.Path)) {
            if (hasOwn(before, item.Path)) entries[item.Path] = before[item.Path];
            continue;
        }
        let st;
        try {
            st = fs.lstatSync(path.join(pair.local, item.Path));
        } catch (_e) {
            continue;
        }
        if (!st.isFile()) continue;
        const md5 = listedMd5(item);
        const modTime = Date.parse(item.ModTime);
        // rclone's Google Drive backend lists Google-native Docs, Sheets,
        // Slides and Drawings with Size -1. They are exports, so a local
        // export file can differ in size and still belong to the baseline.
        const exportItem = item.Size === -1;
        const old = hasOwn(before, item.Path) ? before[item.Path] : undefined;
        // After both copy legs, Drive's listed state is the agreed baseline
        // whenever a local file exists. A later local save then reads as a
        // local change against this Drive state, not as both sides changed.
        const baseline = { size: item.Size, mtimeMs: modTime, hash: md5, id: item.ID || null, export: exportItem || undefined };
        // copy --update skips a newer local edit. Certify exported bytes
        // only at the downloaded timestamp; otherwise retain earlier proof.
        if (exportItem) Object.assign(baseline, Math.floor(st.mtimeMs) === modTime
            ? { size: st.size, mtimeMs: modTime, hash: md5File(path.join(pair.local, item.Path)), id: item.ID || null, export: true }
            : old && old.export ? old : baseline);
        if (old === undefined) added += 1;
        else if (old.size !== baseline.size || old.mtimeMs !== baseline.mtimeMs || old.export !== baseline.export) updated += 1;
        entries[item.Path] = baseline;
    }
    for (const rel of Object.keys(before)) {
        if (!before[rel].export || hasOwn(entries, rel) || !fs.existsSync(path.join(pair.local, rel))) continue;
        entries[rel] = before[rel];
    }
    return { entries: entries, changes: { added: added, updated: updated } };
}

function exportPaths(listing, inventory) {
    const paths = new Set(listing.filter(item => item.Size === -1).map(item => item.Path));
    for (const rel of Object.keys(inventory)) if (inventory[rel].export) paths.add(rel);
    return Array.from(paths).sort();
}

function rcloneFilterLiteral(rel) {
    return "/" + rel.replace(/[\\*?\[\]{}]/g, "\\$&");
}

function writeExportExcludeFile(pair, paths) {
    const file = path.join(pairDir(pair.id), "export-excludes.txt");
    if (paths.length === 0) return null;
    writeAtomic(file, paths.map(rcloneFilterLiteral).join("\n") + "\n");
    return file;
}

// --------------------------------------------------------------- one pair

function failureState(kind) {
    return hasOwn(FAILURE_STATES, kind) ? FAILURE_STATES[kind] : "error";
}

function failed(state, kind, extra) {
    return Object.assign(state, {
        state: failureState(kind),
        lastError: Object.assign({ kind: kind, at: now() }, extra || {})
    });
}

function rcloneFailed(state, result, mayHaveChanged = true) {
    return failed(state, result.kind, Object.assign({ mayHaveChanged: mayHaveChanged }, result.exit === null ? {} : { exit: result.exit }));
}

// ADDRESS is the signed-in account's address, or null (duplicateRecord).
function runPairCopy(pair, state, env, secrets, lock, address) {
    const inventory = readInventory(pair.id);
    state.records = pruneConflictStorage(pair.id, state.records || [], pair.local);
    const stamp = now().replace(/[-:]/g, "").replace(/\.\d+Z$/, "Z") + "-" + process.pid;
    const backup = path.join(pairDir(pair.id), "conflicts", stamp);
    const common = filterArgs().concat(["--drive-export-formats", EXPORT_FORMATS]);
    const listed = rclone(["lsjson", "-R", "--files-only", "--fast-list", "--hash", "--hash-type", "md5", remotePath(pair)].concat(common), env, secrets, lock);
    const hasBaseline = Object.keys(inventory).length > 0;
    if (!listed.ok && (listed.kind !== "source-missing" || hasBaseline)) return rcloneFailed(state, listed);
    const emptyRemote = !listed.ok && listed.kind === "source-missing";
    let listing;
    try {
        listing = emptyRemote ? [] : JSON.parse(listed.stdout);
    } catch (_e) {
        return failed(state, "listing-unreadable");
    }
    state.records = classifyBeforeCopy(pair, listing, inventory, state.records);
    if (isPaused(readControl(), pair.id)) return Object.assign(state, { state: "paused" });
    // Even a failed or killed first copy can change the interpretation of
    // old bisync history. Persist invalidation before handing rclone data.
    state.baseline = null;
    withStateLock(() => writePairState(pair.id, state));
    // rclone's own atomic download, a `.partial` name renamed when whole,
    // keeps a cut-off run from leaving a half file in the mirror;
    // --backup-dir moves every local file the copy replaces into conflict
    // storage first. A copy that ran to its end with files rclone could not
    // open is a sync with those files to review, not a failure.
    const held = new Set();
    if (emptyRemote) {
        state.records = withDriveRecords(state.records, []);
    } else {
        const downloaded = rclone(["copy", "--update", remotePath(pair), pair.local, "--backup-dir", backup].concat(common), env, secrets, lock);
        state.records = classifyDisplaced(pair.id, inventory, state.records);
        const review = downloadReview(downloaded);
        if (review === null) return rcloneFailed(state, downloaded);
        for (const record of review.unreadable) held.add(record.path);
        // If a later leg fails, the downloaded mirror still agrees with
        // Drive's first listing, so keep that baseline.
        writeJson(path.join(pairDir(pair.id), "inventory.json"), { entries: nextInventory(pair, listing, inventory, held).entries });
        // The first listing holds every copy's size and md5 but no owner,
        // so each folder that holds a doubled name gets one read-only
        // listing that carries all three, and only when the copy met one.
        // The owner is rclone v1.75.2's `owner` metadata key, which
        // --drive-metadata-owner read gives (its default, named here); it
        // gives no key that says whether the account may change a copy.
        const listFolder = folder => rclone(["lsjson", "--files-only", "--hash", "--hash-type", "md5", "--metadata", "--drive-metadata-owner", "read",
            remotePath(pair) + (folder === "" ? "" : "/" + folder)].concat(common), env, secrets, lock);
        const doubled = duplicateRecords(review.doubled, listFolder, address);
        if (doubled.kind === "failed") return doubled.result === null ? failed(state, "listing-unreadable") : rcloneFailed(state, doubled.result);
        state.records = withDriveRecords(state.records, review.unreadable.concat(doubled.records));
    }
    const excludes = writeExportExcludeFile(pair, exportPaths(listing, inventory));
    const uploadArgs = ["copy", "--update", pair.local, remotePath(pair)].concat(filterArgs());
    if (excludes !== null) uploadArgs.push("--exclude-from", excludes);
    if (isPaused(readControl(), pair.id)) return Object.assign(state, { state: "paused" });
    const uploaded = rclone(uploadArgs, env, secrets, lock);
    if (excludes !== null) fs.rmSync(excludes, { force: true });
    if (!uploaded.ok) return rcloneFailed(state, uploaded);
    const listedAgain = rclone(["lsjson", "-R", "--files-only", "--fast-list", "--hash", "--hash-type", "md5", remotePath(pair)].concat(common), env, secrets, lock);
    if (!listedAgain.ok) return rcloneFailed(state, listedAgain);
    let nextListing;
    try {
        nextListing = JSON.parse(listedAgain.stdout);
    } catch (_e) {
        return failed(state, "listing-unreadable");
    }
    const next = nextInventory(pair, nextListing, inventory, held);
    writeJson(path.join(pairDir(pair.id), "inventory.json"), { entries: next.entries });
    return Object.assign(state, { state: "idle", lastSuccess: now(), lastError: null, records: state.records, changes: next.changes });
}

// --------------------------------------------------------------- two-way

function bisyncFilters(pair) {
    return path.join(pairDir(pair.id), "bisync-filters.txt");
}

function ordinaryArgs(pair) {
    return ["--filter-from", bisyncFilters(pair), "--drive-skip-gdocs", "--disable", "ListR"];
}

function bisyncArgs(pair, backup, filters = bisyncFilters(pair)) {
    return ["bisync", pair.local, remotePath(pair),
        "--workdir", path.join(pairDir(pair.id), "bisync"),
        "--compare", "size,modtime,checksum", "--track-renames", "--track-renames-strategy", "hash",
        "--conflict-resolve", "newer", "--conflict-loser", "delete", "--backup-dir1", backup,
        "--filters-file", filters, "--drive-skip-gdocs",
        "--check-access", "--create-empty-src-dirs", "--max-delete", "50",
        "--resilient", "--recover", "--max-lock", "2m", "--disable", "ListR", "--verbose"];
}

function initializationRequired(state, reason) {
    return failed(state, "initialization-required", { reason: reason, mayHaveChanged: false });
}

function bindingReason(pair, state) {
    const b = state.baseline;
    if (!plain(b)) return "baseline-missing";
    if (b.local !== pair.local || b.remote !== pair.remote) return "roots-changed";
    if (b.policy !== BISYNC_POLICY) return "policy-changed";
    try {
        if (fs.readFileSync(bisyncFilters(pair), "utf8") !== BISYNC_FILTERS) return "filters-changed";
        if (!fs.statSync(path.join(pairDir(pair.id), "bisync")).isDirectory()) return "history-missing";
    } catch (e) {
        return e.code === "ENOENT" ? "history-missing" : "history-unreadable";
    }
    return null;
}

// Rclone lsjson lists a directory's ID (rclone.org/commands/rclone_lsjson).
// Read its parent to refuse duplicated Drive folder names, not whichever
// object a path lookup happens to choose. Local identity pins replacement
// roots even when their spelling stays the same.
function pairIdentity(pair, env, secrets, lock, address) {
    if (!validAddress(address)) return { ok: false, kind: "identity-unknown" };
    let st;
    try {
        st = fs.statSync(pair.local);
        if (!st.isDirectory()) return { ok: false, kind: "local-root-missing" };
    } catch (_e) {
        return { ok: false, kind: "local-root-missing" };
    }
    let parent = "";
    let remoteIdentity;
    // Refuse ambiguous ancestors as well as the pair's final folder.
    for (const name of pair.remote.split("/")) {
        const listed = rclone(["lsjson", REMOTE + ":" + parent, "--dirs-only", "--disable", "ListR"], env, secrets, lock);
        if (!listed.ok) return listed;
        let items;
        try { items = JSON.parse(listed.stdout); } catch (_e) { return { ok: false, kind: "identity-unreadable" }; }
        if (!Array.isArray(items) || items.some(item => !plain(item) || typeof item.Path !== "string"))
            return { ok: false, kind: "identity-unreadable" };
        const matches = items.filter(item => item.Path === name);
        if (matches.length !== 1 || matches[0].IsDir !== true || typeof matches[0].ID !== "string" || matches[0].ID === "")
            return { ok: false, kind: matches.length > 1 ? "listing-ambiguous" : "identity-unknown", path: REMOTE + ":" + (parent ? parent + "/" : "") + name };
        remoteIdentity = matches[0].ID;
        parent = parent === "" ? name : parent + "/" + name;
    }
    return { ok: true, binding: {
        account: address.toLowerCase(), local: pair.local, localIdentity: [real(pair.local), st.dev, st.ino],
        remote: pair.remote, remoteIdentity: remoteIdentity, policy: BISYNC_POLICY
    } };
}

function sameBinding(a, b) {
    return ["account", "local", "localIdentity", "remote", "remoteIdentity", "policy"]
        .every(key => JSON.stringify(a[key]) === JSON.stringify(b[key]));
}

function relativePath(value) {
    return typeof value === "string" && value !== "" && !value.startsWith("/") && !CONTROL.test(value)
        && !value.split("/").some(p => p === "" || p === "." || p === "..");
}

// Complete listings are admission evidence, never a second sync inventory.
// Drive can emit duplicate names and unknown hashes; neither proves equality.
function readListing(root, args, env, secrets, lock) {
    const listed = rclone(["lsjson", root, "-R", "--hash", "--hash-type", "md5"].concat(args), env, secrets, lock);
    if (!listed.ok) return listed;
    let items;
    try { items = JSON.parse(listed.stdout); } catch (_e) { return { ok: false, kind: "listing-unreadable" }; }
    const names = new Set();
    if (!Array.isArray(items)) return { ok: false, kind: "listing-unreadable" };
    for (const item of items) {
        if (!plain(item) || !relativePath(item.Path)
            || names.has(item.Path) || typeof item.IsDir !== "boolean" || !Number.isFinite(item.Size))
            return { ok: false, kind: "listing-ambiguous", path: plain(item) && relativePath(item.Path) ? root + "/" + item.Path : root };
        names.add(item.Path);
    }
    return { ok: true, items: items };
}

function nativeListing(pair, env, secrets, lock) {
    return readListing(remotePath(pair), filterArgs().concat(["--drive-export-formats", EXPORT_FORMATS, "--disable", "ListR"]), env, secrets, lock);
}

function nativeCollision(pair, listing, oldExports) {
    // Drive imports an ordinary .xlsx onto a same-named Google Sheet even
    // with skip-gdocs. See rclone.org/bisync/#google-docs-and-other-files-of-unknown-size.
    for (const rel of new Set(listing.filter(i => !i.IsDir && i.Size === -1).map(i => i.Path).concat(oldExports || [])))
        if (fs.existsSync(path.join(pair.local, rel))) return rel;
    return null;
}

function baselineEvidence(pair) {
    const state = readJson(path.join(pairDir(pair.id), "state.json"));
    const inventory = readJson(path.join(pairDir(pair.id), "inventory.json"));
    if (state.kind === "bad" || state.kind === "ok" && (!plain(state.value) || !validRecords(state.value.records)))
        return { ok: false, kind: "baseline-evidence-unreadable" };
    if (inventory.kind === "bad" || inventory.kind === "ok" && (!plain(inventory.value) || !plain(inventory.value.entries)
        || Object.entries(inventory.value.entries).some(([rel, e]) => !relativePath(rel) || !plain(e)
            || !Number.isFinite(e.size) || !Number.isFinite(e.mtimeMs)
            || e.hash !== null && !/^[0-9a-f]{32}$/.test(e.hash || "")
            || e.id !== null && typeof e.id !== "string"
            || e.export !== undefined && typeof e.export !== "boolean")))
        return { ok: false, kind: "baseline-evidence-unreadable" };
    const records = state.kind === "absent" ? [] : state.value.records;
    const entries = inventory.kind === "absent" ? {} : inventory.value.entries;
    return { ok: true, records: records, entries: entries, exports: Object.keys(entries).filter(rel => entries[rel].export === true),
        fingerprint: JSON.stringify([state.kind === "absent" ? null : state.value, entries]) };
}

function equalSet(pair, env, secrets, lock, address, evidence, prepare = false) {
    const identity = pairIdentity(pair, env, secrets, lock, address);
    if (!identity.ok) return identity;
    const native = nativeListing(pair, env, secrets, lock);
    if (!native.ok) return native;
    const moves = [];
    for (const rel of new Set(native.items.filter(i => !i.IsDir && i.Size === -1).map(i => i.Path).concat(evidence.exports))) {
        const source = path.join(pair.local, rel);
        if (!fs.existsSync(source)) continue;
        const base = evidence.entries[rel];
        const st = fs.lstatSync(source);
        // Historical native listings stored unknown size/MD5. Matching the
        // recorded download time permits a preserving move, never disposal.
        const historical = base && (base.size === -1 || base.hash === null);
        const matchesDownload = base && base.export === true && base.mtimeMs === Math.floor(st.mtimeMs)
            && (historical || base.size === st.size && md5File(source) === base.hash);
        if (!prepare || !st.isFile() || !matchesDownload)
            return { ok: false, kind: "native-export-in-sync-root", path: source };
        const destination = path.join(pairDir(pair.id), "exports", rel);
        if (exists(destination)) return { ok: false, kind: "export-destination-exists", path: destination };
        moves.push({ path: rel, source: source, destination: destination, size: st.size, mtimeMs: Math.floor(st.mtimeMs), hash: md5File(source) });
    }
    const args = ordinaryArgs(pair).concat(moves.flatMap(move => ["--exclude", rcloneFilterLiteral(move.path)]));
    const listings = [];
    for (const root of [pair.local, remotePath(pair)]) {
        const listing = readListing(root, root === pair.local ? args : ordinaryArgs(pair), env, secrets, lock);
        if (!listing.ok) return listing;
        if (listing.items.some(i => !i.IsDir && (i.Size < 0 || !/^[0-9a-f]{32}$/.test(listedMd5(i) || ""))))
            return { ok: false, kind: "comparison-incomplete", path: root };
        listings.push(listing.items.sort((a, b) => a.Path.localeCompare(b.Path)));
    }
    const view = items => items.map(i => [i.Path, i.IsDir, i.IsDir ? null : i.Size, i.IsDir ? null : listedMd5(i)]);
    if (listings.some(items => items.some(i => i.Path === "RCLONE_TEST" && i.IsDir)))
        return { ok: false, kind: "access-path-occupied", path: pair.local + "/RCLONE_TEST and " + remotePath(pair) + "/RCLONE_TEST" };
    const sentinels = listings.map(items => items.find(i => !i.IsDir && i.Path === "RCLONE_TEST"));
    const hasAccess = listings.every(items => items.some(i => !i.IsDir && path.posix.basename(i.Path) === "RCLONE_TEST"));
    const access = hasAccess ? null : { source: sentinels[0] ? "local" : sentinels[1] ? "remote" : "new" };
    const comparison = access && access.source !== "new" ? listings.map(items => items.filter(i => i.Path !== "RCLONE_TEST")) : listings;
    if (JSON.stringify(view(comparison[0])) !== JSON.stringify(view(comparison[1]))) {
        const paths = new Set(listings.flatMap(items => items.map(i => i.Path)));
        const differing = Array.from(paths).filter(rel => JSON.stringify(view(listings[0].filter(i => i.Path === rel))) !== JSON.stringify(view(listings[1].filter(i => i.Path === rel))));
        return { ok: false, kind: "folders-differ", path: differing.map(rel => pair.local + "/" + rel + " and " + remotePath(pair) + "/" + rel).join(", ") };
    }
    if (access && !prepare) return { ok: false, kind: "access-file-missing", path: pair.local + "/RCLONE_TEST and " + remotePath(pair) + "/RCLONE_TEST" };
    // check's combined report is a documented machine interface. Its exit
    // plus all '=' rows prove two-direction equality; --one-way is not used.
    const checked = rclone(["check", pair.local, remotePath(pair), "--combined", "-"].concat(args,
        access && access.source !== "new" ? ["--exclude", "/RCLONE_TEST"] : []), env, secrets, lock);
    if (!checked.ok) return checked;
    const matched = checked.stdout.trimEnd() === "" ? [] : checked.stdout.trimEnd().split("\n");
    const paths = comparison[0].filter(i => !i.IsDir).map(i => i.Path).sort();
    if (matched.some(line => !line.startsWith("= ")) || JSON.stringify(matched.map(line => line.slice(2)).sort()) !== JSON.stringify(paths))
        return { ok: false, kind: "comparison-incomplete" };
    const nativeView = native.items.filter(i => !i.IsDir && i.Size === -1).sort((a, b) => a.Path.localeCompare(b.Path));
    const fingerprint = items => JSON.stringify([identity.binding, items.map(list => list.map(i => [i.Path, i.IsDir, i.Size, listedMd5(i), i.IsDir ? null : Date.parse(i.ModTime)])), nativeView, evidence.fingerprint]);
    return { ok: true, binding: identity.binding, moves: moves, access: access, listings: listings,
        fingerprint: fingerprint(listings), fingerprintFor: fingerprint };
}

function recoveryDirectory(pair) {
    const root = path.join(pairDir(pair.id), "conflicts");
    fs.mkdirSync(root, { recursive: true, mode: 0o700 });
    // Exclusive run identity, not a path guessed from a PID.
    return fs.mkdtempSync(path.join(root, stampOf(Date.now()) + "-"));
}

// Only upstream reports determine outcomes. This table consumes rclone
// v1.75.2 output retained in VGS-2355's local-design-proof logs and
// cmd/bisync/operations.go. It never matches hashes or executes a move.
function bisyncRecords(pair, state, result, backup, operation = "two-way") {
    const text = result.stderr.replace(/\x1b\[[0-9;]*m/g, "");
    const queued = new Map();
    const renamed = new Map();
    const winners = new Map();
    const copied = new Set();
    const lines = text.split("\n");
    for (const line of lines) {
        const deletion = /: - (Path[12])\s+Queue delete\s+- (.+)$/.exec(line);
        if (deletion !== null) {
            // Queue messages use the corresponding fs root, which rclone
            // reports at the start. This also serves the local test backend.
            const roots = /Synching Path1 "(.+?)\/?" with Path2 "(.+?)\/?"/.exec(text);
            if (roots !== null) {
                const root = roots[deletion[1] === "Path1" ? 1 : 2].replace(/\/$/, "");
                if (deletion[2].startsWith(root + "/")) queued.set(deletion[2].slice(root.length + 1), deletion[1]);
            }
        }
        const rename = / INFO\s+: (.+?): Renamed from "(.+)"$/.exec(line);
        if (rename !== null) renamed.set(rename[2], rename[1]);
        const winner = / INFO\s+: (.+?): The winner is: (Path[12])$/.exec(line);
        if (winner !== null) winners.set(winner[1], winner[2]);
        const copy = / INFO\s+: (.+?): Copied \(/.exec(line);
        if (copy !== null) copied.add(copy[1]);
    }
    const add = record => addRecord(state.records, Object.assign({ operation: operation, outcome: result.ok ? "completed" : "partial" }, record));
    const storedRoot = path.relative(path.join(pairDir(pair.id), "conflicts"), backup);
    for (const rel of filesUnder(backup)) {
        const side = queued.get(rel);
        add({ kind: operation === "initialize" ? "local-recovery"
            : result.ok && side === "Path1" && !renamed.has(rel) ? "removed-on-drive"
            : result.ok && winners.get(rel) === "Path2" ? "both-changed" : "local-recovery",
        path: rel, stored: storedRoot + "/" + rel, recovery: "local-recovery" });
    }
    // A failed operation can already have changed files. Do not promote
    // queued intentions to completed removal/rename notes on that path.
    if (!result.ok || operation === "initialize") return;
    for (const [rel, side] of queued)
        if (side === "Path2" && !renamed.has(rel)) add({ kind: "removed-locally", path: rel, recovery: "drive-trash" });
    for (const [rel, to] of renamed) add({ kind: "renamed", path: rel, to: to });
    for (const [rel, side] of winners)
        if (side === "Path1") add({ kind: "both-changed", path: rel, recovery: "drive-trash" });
    for (const rel of copied)
        if (/\.conflict\d+(?:\.[^/]*)?$/.test(rel)) add({ kind: "conflict-unresolved", path: rel, recovery: "active-conflicts" });
}

function refreshNativeExports(pair, state, listing, env, secrets, lock) {
    const paths = listing.filter(i => !i.IsDir && i.Size === -1).map(i => i.Path);
    if (paths.length === 0) return state;
    const allow = path.join(pairDir(pair.id), "export-includes.txt");
    const backup = recoveryDirectory(pair);
    const exports = path.join(pairDir(pair.id), "exports");
    // Include literals through the existing escaping owner, not broad
    // Office-extension rules. This allow-list never enters bisync.
    writeAtomic(allow, paths.map(rel => "+ " + rcloneFilterLiteral(rel)).join("\n") + "\n- **\n");
    let result;
    try {
        result = rclone(["copy", remotePath(pair), exports, "--backup-dir", backup,
            "--drive-export-formats", EXPORT_FORMATS, "--filter-from", allow, "--disable", "ListR"], env, secrets, lock);
    } finally {
        fs.rmSync(allow, { force: true });
    }
    const generation = path.basename(backup);
    for (const rel of filesUnder(backup)) addRecord(state.records, {
        kind: "local-recovery", operation: "exports", outcome: result.ok ? "completed" : "partial",
        path: rel, stored: generation + "/" + rel, recovery: "local-recovery"
    });
    return result.ok ? state : rcloneFailed(state, result);
}

function runPairTwoWay(pair, state, env, secrets, lock, address) {
    const reason = bindingReason(pair, state);
    if (reason !== null) return initializationRequired(state, reason);
    const identity = pairIdentity(pair, env, secrets, lock, address);
    if (!identity.ok) return failed(state, identity.kind, { mayHaveChanged: false });
    if (!sameBinding(state.baseline, identity.binding)) return initializationRequired(state, "identity-changed");
    const listing = nativeListing(pair, env, secrets, lock);
    if (!listing.ok) return rcloneFailed(state, listing, false);
    const collision = nativeCollision(pair, listing.items);
    if (collision !== null) return initializationRequired(state, "native-export-in-sync-root");
    if (isPaused(readControl(), pair.id)) return Object.assign(state, { state: "paused" });
    state.records = pruneConflictStorage(pair.id, state.records || [], pair.local);
    const backup = recoveryDirectory(pair);
    const result = rclone(bisyncArgs(pair, backup), env, secrets, lock);
    bisyncRecords(pair, state, result, backup);
    if (!result.ok) {
        if (result.kind === "bisync-recovery-required") state.baseline = null;
        return failed(state, result.kind, { exit: result.exit, mayHaveChanged: result.kind !== "deletion-limit" });
    }
    if (isPaused(readControl(), pair.id)) return Object.assign(state, { state: "paused" });
    state.lastError = null;
    state = refreshNativeExports(pair, state, listing.items, env, secrets, lock);
    if (state.lastError !== null && state.state !== "running") {
        state.lastError.operation = "exports";
        state.lastError.mayHaveChanged = true;
        return state;
    }
    return Object.assign(state, { state: "idle", lastSuccess: now(), lastError: null, changes: null });
}

function initializeRefusal(result, pair) {
    const location = result.path || pair.local + " and " + remotePath(pair);
    let action;
    switch (result.kind) {
    case "listing-ambiguous": action = "Rename or remove the duplicate names in Drive before trying again"; break;
    case "native-export-in-sync-root": action = "Keep any edits by moving this download copy outside the synced folder yourself; its saved download record does not match"; break;
    case "export-destination-exists": action = "Choose where to keep both download copies; the export destination already exists"; break;
    case "folders-differ": action = "Make both folders contain the same ordinary files and bytes before trying again"; break;
    case "access-file-missing": action = "Run setup again to create the missing access files"; break;
    case "access-path-occupied": action = "Move the folder named RCLONE_TEST aside so setup can create its access file"; break;
    case "copy-selected": action = "Turn on Two-way sync before running this setup"; break;
    case "credential-absent": case "credential-locked": case "credential-unavailable":
    case "authorization-required": action = "Sign in to Google Drive and unlock your keyring before trying again"; break;
    case "local-root-missing": action = "Restore the local folder before trying again"; break;
    case "identity-unknown": case "identity-unreadable": action = "Check the signed-in account and choose an existing, uniquely named Drive folder"; break;
    case "baseline-evidence-unreadable": action = "Restore readable saved sync records before trying again; they were kept"; break;
    case "control-unreadable": action = "Restore readable saved sync controls before trying again"; break;
    case "comparison-incomplete": case "listing-unreadable": action = "Make every file readable and available for a complete comparison before trying again"; break;
    case "comparison-changed": case "control-changed": case "filters-changed": case "roots-changed": case "account-changed":
        action = "Keep these folders, account and sync settings unchanged, then review setup again"; break;
    case "confirmation-failed": action = "Open setup in a terminal and answer the confirmation again"; break;
    case "preparation-failed": action = "Make this location writable, then review setup again; any copies already moved were kept"; break;
    default: action = "Check the connection and file access, then review setup again";
    }
    process.stdout.write(action + ": " + location + ".\n");
    refuse("initialize=" + result.kind + " path=" + JSON.stringify(location));
}

function initializeVerb(words) {
    const id = pairOption(words);
    if (id === null) bad("pair=missing");
    const read = readPairs();
    if (read.error !== null) refuse(read.error);
    const pair = read.pairs.find(p => p.id === id);
    if (pair === undefined) refuse("pair=unknown");
    const fd = lockFd(pairLock(id), ["-n"]);
    if (fd === null) { process.stdout.write("pair=" + id + " result=busy\n"); process.exit(EXIT_BUSY); }
    try {
        const control = readControl();
        if (control.error) initializeRefusal({ kind: "control-unreadable" }, pair);
        if (!control.twoWaySync) initializeRefusal({ kind: "copy-selected" }, pair);
        const evidence = baselineEvidence(pair);
        if (!evidence.ok) initializeRefusal(evidence, pair);
        const credential = readCredential();
        if (credential.kind !== "found") initializeRefusal({ kind: "credential-" + credential.kind }, pair);
        const env = rcloneEnv(credential.values);
        const secrets = CREDENTIAL_PARTS.map(part => credential.values[part]);
        // A failed explicit attempt requires a fresh comparison and consent.
        // Keep rclone history in place for investigation, never erase it.
        const reviewedEvidence = baselineEvidence(pair);
        if (!reviewedEvidence.ok) initializeRefusal(reviewedEvidence, pair);
        process.stdout.write("Local folder: " + pair.local + "\nGoogle Drive folder: " + pair.remote
            + "\nEarlier records (evidence, not removal instructions):\n" + JSON.stringify(reviewedEvidence.records, null, 2) + "\n");
        writeAtomic(bisyncFilters(pair), BISYNC_FILTERS);
        const before = equalSet(pair, env, secrets, fd, credential.address, reviewedEvidence, true);
        if (!before.ok) initializeRefusal(before, pair);
        for (const move of before.moves) process.stdout.write("Move download copy: " + move.source + " -> " + move.destination + "\n");
        if (before.access) process.stdout.write("Create access file: " + pair.local + "/RCLONE_TEST and " + remotePath(pair) + "/RCLONE_TEST\n");
        const backup = recoveryDirectory(pair);
        const previewFilters = path.join(pairDir(pair.id), "initialize-preview-filters.txt");
        writeAtomic(previewFilters, BISYNC_FILTERS + before.moves.map(move => "- " + rcloneFilterLiteral(move.path) + "\n").join("")
            + (before.access && before.access.source !== "new" ? "- /RCLONE_TEST\n" : ""));
        let preview;
        // v1.75.2 cmd/bisync/resync.go checks access even during dry-run.
        // The preview lists planned creation; the real run checks both files.
        const previewArgs = bisyncArgs(pair, backup, previewFilters).filter(arg => !before.access || arg !== "--check-access");
        try { preview = rclone(previewArgs.concat(["--resync", "--resync-mode", "newer", "--dry-run"]), env, secrets, fd); }
        finally { fs.rmSync(previewFilters, { force: true }); }
        process.stdout.write(preview.stderr);
        if (!preview.ok) initializeRefusal({ kind: "preview-failed" }, pair);
        // The declaration's TUI owns this visible terminal. No unattended
        // mode, argv --yes, or setting write supplies initialization consent.
        const promptEnv = { VGS_TUI_LIB: process.env.VGS_TUI_LIB || "" };
        for (const key of Object.keys(process.env))
            if (key.startsWith("GUM_")) promptEnv[key] = process.env[key];
        const confirmed = run("/usr/bin/bash", [path.join(__dirname, "..", "tui", "initialize-confirm.sh")],
            { stdio: ["inherit", "inherit", "inherit"], env: childEnv(promptEnv) });
        if (confirmed.status === 1) return;
        if (confirmed.status !== 0) initializeRefusal({ kind: "confirmation-failed" }, pair);
        const currentControl = readControl();
        if (currentControl.error || !currentControl.twoWaySync || isPaused(currentControl, id) !== isPaused(control, id))
            initializeRefusal({ kind: "control-changed" }, pair);
        if (readText(bisyncFilters(pair)) !== BISYNC_FILTERS) initializeRefusal({ kind: "filters-changed" }, pair);
        const currentPair = readPairs().pairs.find(p => p.id === id);
        if (JSON.stringify(currentPair) !== JSON.stringify(pair)) initializeRefusal({ kind: "roots-changed" }, pair);
        const currentCredential = readCredential();
        if (currentCredential.kind !== "found" || currentCredential.address !== credential.address
            || CREDENTIAL_PARTS.some(part => currentCredential.values[part] !== credential.values[part]))
            initializeRefusal({ kind: "account-changed" }, pair);
        const afterEvidence = baselineEvidence(pair);
        if (!afterEvidence.ok) initializeRefusal(afterEvidence, pair);
        const rechecked = equalSet(pair, env, secrets, fd, credential.address, afterEvidence, true);
        if (!rechecked.ok) initializeRefusal(rechecked, pair);
        if (before.fingerprint !== rechecked.fingerprint || JSON.stringify(before.moves) !== JSON.stringify(rechecked.moves)
            || JSON.stringify(before.access) !== JSON.stringify(rechecked.access))
            initializeRefusal({ kind: "comparison-changed" }, pair);
        for (const move of before.moves) {
            try {
                fs.mkdirSync(path.dirname(move.destination), { recursive: true, mode: 0o700 });
                // COPYFILE_EXCL refuses an occupied export path, including across
                // filesystems. Keep the source if the exclusive copy fails.
                fs.copyFileSync(move.source, move.destination, fs.constants.COPYFILE_EXCL);
                fs.utimesSync(move.destination, move.mtimeMs / 1000, move.mtimeMs / 1000);
            } catch (error) {
                initializeRefusal({ kind: error.code === "EEXIST" ? "export-destination-exists" : "preparation-failed", path: move.destination }, pair);
            }
            try {
                if (md5File(move.source) !== move.hash || Math.floor(fs.statSync(move.source).mtimeMs) !== move.mtimeMs)
                    initializeRefusal({ kind: "comparison-changed", path: move.source }, pair);
                fs.unlinkSync(move.source);
            } catch (_error) { initializeRefusal({ kind: "preparation-failed", path: move.source }, pair); }
        }
        const expected = before.listings.map(items => items.slice());
        if (before.access) {
            const file = path.join(pair.local, "RCLONE_TEST");
            const remote = remotePath(pair) + "/RCLONE_TEST";
            let item;
            if (before.access.source === "new") {
                try { fs.writeFileSync(file, "VGS Google Drive access check\n", { flag: "wx", mode: 0o600 }); }
                catch (_error) { initializeRefusal({ kind: "preparation-failed", path: file }, pair); }
                const st = fs.statSync(file);
                item = { Path: "RCLONE_TEST", IsDir: false, Size: st.size, Hashes: { md5: md5File(file) }, ModTime: new Date(st.mtimeMs).toISOString() };
            } else item = before.listings[before.access.source === "local" ? 0 : 1].find(i => i.Path === "RCLONE_TEST");
            // rclone copyto --ignore-existing skips every occupied destination
            // (rclone.org/flags/#copy); the exact recheck below judges its bytes.
            const copied = rclone(["copyto", before.access.source === "remote" ? remote : file,
                before.access.source === "remote" ? file : remote, "--ignore-existing", "--disable", "ListR"], env, secrets, fd);
            if (!copied.ok) initializeRefusal(copied, pair);
            for (const items of expected) if (!items.some(i => i.Path === "RCLONE_TEST")) items.push(item);
        }
        for (const items of expected) items.sort((a, b) => a.Path.localeCompare(b.Path));
        const after = equalSet(pair, env, secrets, fd, credential.address, afterEvidence);
        if (!after.ok) initializeRefusal(after, pair);
        if (after.fingerprint !== before.fingerprintFor(expected)) initializeRefusal({ kind: "comparison-changed" }, pair);
        let state = readPairState(id);
        state.baseline = null;
        state.route = "two-way";
        state.operation = "initialize";
        state.state = "running";
        state.startedAt = now();
        state.lastAttempt = now();
        withStateLock(() => { writePairState(id, state); writeStatus(); });
        // Rename tracking is ignored during resync (installed v1.75.2 proof).
        // Admission, not conflict flags, makes this equal-set action safe.
        let result = rclone(bisyncArgs(pair, backup).concat(["--resync", "--resync-mode", "newer"]), env, secrets, fd);
        bisyncRecords(pair, state, result, backup, "initialize");
        if (result.ok) {
            const final = equalSet(pair, env, secrets, fd, credential.address, afterEvidence);
            if (!final.ok || !sameBinding(final.binding, after.binding))
                result = { ok: false, kind: final.ok ? "identity-changed" : final.kind, exit: null };
        }
        if (result.ok) {
            state = Object.assign(state, { baseline: Object.assign(after.binding, { initializedAt: now() }),
                state: "idle", lastSuccess: now(), lastError: null, changes: null });
            // Settled restoration notes are retired, never converted into
            // deletion instructions. Kept bytes and unrelated review remain.
            state.records = state.records.filter(r => !["removed-locally", "removed-on-drive", "renamed"].includes(r.kind)
                || r.operation === "two-way" || r.stored !== undefined);
        } else state = failed(state, result.kind, { operation: "initialize", exit: result.exit, mayHaveChanged: true });
        state.startedAt = null;
        withStateLock(() => { writePairState(id, state); writeStatus(); });
        if (!result.ok) initializeRefusal(result, pair);
        process.stdout.write("initialized=" + id + "\n");
    } finally {
        fs.closeSync(fd);
    }
}

// One pair under its lock: `busy` when another run holds it.
function runPair(pair, control) {
    if (isPaused(control, pair.id)) return "paused";
    const fd = lockFd(pairLock(pair.id), ["-n"]);
    if (fd === null) return "busy";
    try {
        control = readControl();
        if (isPaused(control, pair.id)) return "paused";
        // A normal On hold must not rewrite unreadable historical evidence
        // into an empty, apparently valid first-baseline record.
        if (control.twoWaySync && !plain(readPairState(pair.id).baseline) && !baselineEvidence(pair).ok) {
            log("pair=" + pair.id + " error=baseline-evidence-unreadable");
            return "error";
        }
        let state = withStateLock(() => {
            const route = control.twoWaySync ? "two-way" : "copy";
            const begun = Object.assign(readPairState(pair.id), { state: "running", route: route, operation: route, startedAt: now(), lastAttempt: now() });
            writePairState(pair.id, begun);
            writeStatus();
            return begun;
        });
        const historical = new Set((state.records || []).map(recordKey));
        const credential = readCredential();
        if (credential.kind === "found") {
            const secrets = CREDENTIAL_PARTS.map(part => credential.values[part]);
            const env = rcloneEnv(credential.values);
            state = state.route === "two-way"
                ? runPairTwoWay(pair, state, env, secrets, fd, credential.address)
                : runPairCopy(pair, state, env, secrets, fd, credential.address);
        } else {
            const kind = credential.kind === "unavailable" ? credential.reason : "credential-" + credential.kind;
            state = failed(state, kind, { account: credential.account, mayHaveChanged: false });
        }
        state.startedAt = null;
        state.records = (state.records || []).map(r => r.operation === undefined && !historical.has(recordKey(r))
            ? Object.assign(r, { operation: state.route }) : r);
        if (state.lastError !== null && state.lastError.operation === undefined) state.lastError.operation = state.route;
        withStateLock(() => {
            carryDismissals(pair.id, readPairState(pair.id).records || [], state.records || []);
            writePairState(pair.id, state);
            writeStatus();
        });
        return state.state;
    } finally {
        fs.closeSync(fd);
    }
}

// The converter step of a doubled name's `version` (D107). A record
// written before records held one gets it at the first sync that lists
// the copies again, since only Drive's listing gives it, and that changes
// the row's key. A dismissal of the record BEFORE carries to the record
// AFTER that only adds the version, as nothing the user saw changed.
function carryDismissals(pairId, before, after) {
    const control = readControl();
    const carried = [];
    for (const old of before) {
        if (old.version !== undefined || control.dismissed.indexOf(conflictKey(pairId, old)) === -1) continue;
        const next = after.find(r => r.version !== undefined && conflictKey(pairId, Object.assign({}, r, { version: undefined })) === conflictKey(pairId, old));
        if (next !== undefined) carried.push(conflictKey(pairId, next));
    }
    if (carried.length > 0) writeJson(controlFile, Object.assign(control, { dismissed: control.dismissed.concat(carried) }));
}

// ----------------------------------------------------------------- units

// One word of DIRECTIVE's line, quoted as systemd reads it back: a
// backslash and a quote escaped, and `%` doubled so no specifier expands,
// which every line does. A command line, ExecStart= or ExecStopPost=, also
// expands `$`, so its words double it (systemd.service(5), Command lines);
// Environment= gives `$` no special meaning, so it stays single there
// (systemd.exec(5), Environment=).
function systemdQuote(directive, arg) {
    const s = String(arg);
    if (CONTROL.test(s)) refuse("unit-argument=control-character");
    const quoted = s.replace(/\\/g, "\\\\").replace(/"/g, "\\\"").replace(/%/g, "%%");
    return "\"" + (directive === "Environment" ? quoted : quoted.replace(/\$/g, "$$$$")) + "\"";
}

function engineHash() {
    return crypto.createHash("sha256").update(fs.readFileSync(__filename)).digest("hex").slice(0, 16);
}

function engineFile(hash) {
    return path.join(engineRoot, hash, "google-drive");
}

// The service names node by its own path and the engine copy, and hands
// the runner the directories resolved here, since a user manager's
// environment need not hold the same ones. A busy run (75) is no failure.
function serviceText(hash) {
    const env = ["XDG_CONFIG_HOME=" + configHome, "XDG_STATE_HOME=" + stateHome, "XDG_DATA_HOME=" + dataHome, "XDG_RUNTIME_DIR=" + runtimeDir];
    const runner = [process.execPath, engineFile(hash)];
    return [
        "# Written by vgs.google-drive install; install replaces it.",
        "[Unit]",
        "Description=VGS Google Drive",
        "",
        "[Service]",
        "Type=oneshot",
        "Environment=" + env.map(word => systemdQuote("Environment", word)).join(" "),
        "ExecStart=" + runner.concat(["run"]).map(word => systemdQuote("ExecStart", word)).join(" "),
        // Runs after any end of the run, a kill included, so the status
        // record does not keep reading `running`.
        "ExecStopPost=" + runner.concat(["status", "--quiet"]).map(word => systemdQuote("ExecStopPost", word)).join(" "),
        "SuccessExitStatus=" + EXIT_BUSY,
        "Nice=10",
        "IOSchedulingClass=idle",
        ""
    ].join("\n");
}

function timerText() {
    return [
        "# Written by vgs.google-drive install; install replaces it.",
        "[Unit]",
        "Description=VGS Google Drive schedule",
        "",
        "[Timer]",
        "OnCalendar=hourly",
        "Persistent=true",
        "",
        "[Install]",
        "WantedBy=timers.target",
        ""
    ].join("\n");
}

// installed: both units as install would write them now; absent: neither;
// stale: anything else, such as a unit naming an older runner copy or
// another node.
function unitsState() {
    const service = readText(path.join(unitDir, SERVICE));
    const timer = readText(path.join(unitDir, TIMER));
    if (service === null && timer === null) return "absent";
    return service === serviceText(engineHash()) && timer === timerText() ? "installed" : "stale";
}

// null, or the refusal of a failed `systemctl --user ARGS`.
function systemctlFailure(args, scheduling = "enabled") {
    const bin = which("systemctl");
    if (bin === null) return "systemctl=missing";
    const out = run(bin, ["--user"].concat(args), scheduling === "disabled" ? { timeout: 10000, killSignal: "SIGKILL" } : {});
    return out.status === 0 ? null : "systemctl=failed args=" + args.join(",") + " exit=" + out.status;
}

function systemctl(args) {
    const failure = systemctlFailure(args);
    if (failure !== null) refuse(failure);
}

// The runner copy the units start, written under a temporary name and
// renamed into place, so a unit never names a half-written copy.
function ensureEngine(hash) {
    const file = engineFile(hash);
    if (fs.existsSync(file)) return;
    fs.mkdirSync(engineRoot, { recursive: true });
    const temp = fs.mkdtempSync(path.join(engineRoot, ".tmp-"));
    fs.writeFileSync(path.join(temp, "google-drive"), fs.readFileSync(__filename), { mode: 0o755 });
    try {
        fs.renameSync(temp, path.dirname(file));
    } catch (e) {
        fs.rmSync(temp, { recursive: true, force: true });
        if (!fs.existsSync(file)) throw e;
    }
}

// Writes the engine copy and the units, reloads the user manager when a
// unit changed and, under enabled scheduling, enables the timer:
// { changed, failure }, failure null
// or the refusal of the systemctl call that failed. EXISTING_ONLY rewrites
// only unit files that exist, for the refresh of an earlier install. A
// failed call puts each unit's earlier text back and removes a unit that
// did not exist, since a manager that did not reload keeps running the
// earlier units and a timer the manager did not enable never runs: the
// status must read them stale or absent, never installed, and the next
// invocation tries again.
function writeInstall(existingOnly, scheduling = "enabled") {
    const hash = engineHash();
    ensureEngine(hash);
    const wanted = {};
    wanted[SERVICE] = serviceText(hash);
    wanted[TIMER] = timerText();
    const names = Object.keys(wanted).filter(name => !existingOnly || readText(path.join(unitDir, name)) !== null);
    const earlier = {};
    for (const name of names) earlier[name] = readText(path.join(unitDir, name));
    const changed = names.filter(name => earlier[name] !== wanted[name]);
    for (const name of changed) writeAtomic(path.join(unitDir, name), wanted[name], 0o644);
    let failure = changed.length > 0 ? systemctlFailure(["daemon-reload"], scheduling) : null;
    if (scheduling === "enabled" && failure === null && (!existingOnly || names.indexOf(TIMER) !== -1)) failure = systemctlFailure(["enable", "--now", TIMER]);
    if (failure !== null) {
        for (const name of changed) {
            if (earlier[name] === null) fs.rmSync(path.join(unitDir, name), { force: true });
            else writeAtomic(path.join(unitDir, name), earlier[name], 0o644);
        }
        return { changed: changed.length, failure: failure };
    }
    for (const name of fs.existsSync(engineRoot) ? fs.readdirSync(engineRoot) : [])
        if (name !== hash) fs.rmSync(path.join(engineRoot, name), { recursive: true, force: true });
    return { changed: changed.length, failure: null };
}

// Units an earlier runner installed name its own engine copy, which would
// keep running hourly and read the migrated files as damaged, so any later
// runner rewrites them to name itself. It never installs units the user
// did not set up. A failed refresh leaves the units stale, which the status
// reports as `units-stale`, and the verb goes on.
function refreshStaleInstallIfNeeded() {
    if (unitsState() !== "stale") return;
    if (lockDir === "") return;
    const done = writeInstall(true);
    if (done.failure !== null) log("units=stale refresh=failed " + done.failure);
}

function installVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    // The service shares its locks with the plugin and the command line
    // through this directory, so a unit without it is never written.
    if (lockDir === "") refuse("runtime-dir=unset");
    const done = writeInstall(false);
    if (done.failure !== null) refuse(done.failure);
    withStateLock(writeStatus);
    process.stdout.write("installed=" + TIMER + " changed=" + done.changed + "\n");
}

// ----------------------------------------------------------------- status

const PAIR_PRECEDENCE = ["authorization-required", "error", "initialization-required", "offline", "paused", "idle"];

function staleAfter(iso) {
    return iso === null ? null : new Date(Date.parse(iso) + FRESH_MS).toISOString();
}

// The oldest of ISO times, null when any is null or there are none.
function oldest(values) {
    if (values.length === 0 || values.some(v => v === null)) return null;
    return values.slice().sort()[0];
}

function conflictsOf(pair, stored) {
    const found = [];
    const root = path.join(pairDir(pair.id), "conflicts");
    for (const r of stored.records || []) {
        const localPath = path.join(r.operation === "exports" ? path.join(pairDir(pair.id), "exports") : pair.local, r.path);
        const out = { kind: r.kind, pair: pair.id, pairLabel: pair.label, path: r.path, since: r.since };
        // A file the download could not copy has a folder here only while
        // an older copy of it is here.
        if (r.kind !== "unreadable-on-drive" || fs.existsSync(localPath)) out.localPath = localPath;
        if (typeof r.stored === "string" && fs.existsSync(path.join(root, r.stored))) out.storedPath = path.join(root, r.stored);
        if (typeof r.to === "string") out.to = r.to;
        if (typeof r.reason === "string") out.reason = r.reason;
        if (typeof r.mine === "boolean") out.mine = r.mine;
        if (typeof r.owner === "string") out.owner = r.owner;
        for (const key of ["operation", "outcome", "recovery"])
            if (typeof r[key] === "string") out[key] = r[key];
        if (r.kind === "conflict-unresolved" && !fs.existsSync(localPath)) continue;
        out.needs = needsOf(r);
        out.key = conflictKey(pair.id, r);
        if (r.kind !== "both-changed" || out.storedPath !== undefined || r.stored === undefined) found.push(out);
    }
    return found;
}

// The status record, read from the pair list, the pause record, each
// pair's state and inventory, its lock and the units. A pair stored as
// running whose lock nobody holds was cut short: it reads as an error.
function renderStatus() {
    const read = readPairs();
    const control = readControl();
    const units = unitsState();
    const pairs = [];
    let conflicts = [];
    for (const pair of read.pairs) {
        const stored = readPairState(pair.id);
        let state = stored.state;
        let lastError = stored.lastError;
        const initializationReason = bindingReason(pair, stored)
            || (lastError !== null && lastError.kind === "initialization-required" ? lastError.reason : null);
        if (control.twoWaySync && !plain(stored.baseline) && !baselineEvidence(pair).ok) {
            state = "error";
            lastError = { kind: "baseline-evidence-unreadable", at: null, operation: "two-way", mayHaveChanged: false };
        }
        if (control.twoWaySync && state === "idle" && initializationReason !== null) state = "initialization-required";
        if (state === "running" && !lockHeld(pairLock(pair.id))) {
            state = "error";
            lastError = { kind: "interrupted", at: stored.startedAt, operation: stored.operation || stored.route, mayHaveChanged: true };
        }
        if (state !== "running" && isPaused(control, pair.id)) state = "paused";
        pairs.push({
            id: pair.id, label: pair.label, remote: pair.remote, local: pair.local, state: state,
            route: state === "running" ? stored.route : control.twoWaySync ? "two-way" : "copy",
            operation: stored.operation || stored.route || null,
            initialization: { state: initializationReason === null ? "ready" : "required", reason: initializationReason },
            recoveryPath: path.join(pairDir(pair.id), "conflicts"), exportsPath: path.join(pairDir(pair.id), "exports"),
            lastSuccess: stored.lastSuccess, staleAfter: staleAfter(stored.lastSuccess), lastError: lastError, changes: stored.changes
        });
        conflicts = conflicts.concat(conflictsOf(pair, stored));
    }
    let state;
    if (read.error !== null) state = "error";
    else if (pairs.length === 0) state = "not-set-up";
    else if (pairs.some(p => p.state === "running")) state = "running";
    else if (units === "absent") state = "not-set-up";
    else state = PAIR_PRECEDENCE.find(s => pairs.some(p => p.state === s));
    const errors = pairs.filter(p => p.lastError !== null).map(p => Object.assign({ pair: p.id }, p.lastError));
    errors.sort((a, b) => String(b.at).localeCompare(String(a.at)));
    const lastError = read.error !== null ? { kind: "pairs-invalid", detail: read.error } : errors.length === 0 ? null : errors[0];
    // A running pair stands as its run left it before, which runPair keeps
    // in lastError, so a run's own renders do not change the reasons.
    const standing = pairs.map(p => ({ pair: p, state: p.state === "running" && p.lastError !== null ? failureState(p.lastError.kind) : p.state }));
    const failing = standing.filter(s => s.state === "authorization-required" || s.state === "error").map(s => s.pair)
        .sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
    // Only a review record that needs the user asks for attention: one that
    // needs nothing, such as a file the sync put back, needs no action.
    const needing = conflicts.filter(c => c.needs === "you");
    const reasons = [];
    if (standing.some(s => s.state === "authorization-required")) reasons.push("authorization-required");
    if (standing.some(s => s.state === "initialization-required")) reasons.push("initialization-required");
    if (read.error !== null || standing.some(s => s.state === "error")) reasons.push("error");
    if (needing.length > 0) reasons.push("conflicts");
    if (units === "stale") reasons.push("units-stale");
    // The key changes when a reason, a conflict that needs the user or the
    // cause of a failure that needs the user changes, never with the time a
    // failure repeats, the order pairs run in or a row that needs nothing, so
    // the plugin notifies once per change that needs the user. The cause is
    // every failing pair's, by pair id.
    const cause = read.error !== null ? [["pairs-invalid", null, null, read.error]]
        : failing.map(p => [p.lastError.kind, p.id, p.lastError.account || null, p.lastError.detail || null]);
    const key = crypto.createHash("sha256").update(JSON.stringify([reasons, needing.map(c => [c.kind, c.pair, c.path, c.since]), cause])).digest("hex").slice(0, 16);
    const lastSuccess = oldest(pairs.map(p => p.lastSuccess));
    // The dismissals that still name a row. While the pair list cannot be
    // read no row is known, so every dismissal stands.
    const dismissed = read.error !== null ? control.dismissed : control.dismissed.filter(k => conflicts.some(c => c.key === k));
    return {
        state: state,
        twoWaySync: control.twoWaySync,
        copyModeMigration: control.modeAdmitted === false,
        paused: control.paused,
        units: units,
        lastSuccess: lastSuccess,
        staleAfter: staleAfter(lastSuccess),
        lastError: lastError,
        pairs: pairs,
        conflicts: conflicts,
        needsYou: needing.length,
        dismissed: dismissed,
        attention: reasons.length === 0 ? null : { reasons: reasons, key: key, notified: control.notifiedKey === key },
        writtenAt: now()
    };
}

// Called under the state lock. A settled record that needs nothing clears
// the notified key, so a cause that returns after a recovery notifies
// again; a render while a pair runs leaves it. A dismissal that names no
// row is dropped, so the list stays as long as the rows it hides and an
// old dismissal never hides a later record.
function writeStatus() {
    const status = renderStatus();
    if (status.attention === null && !status.pairs.some(p => p.state === "running")) {
        const control = readControl();
        if (control.notifiedKey !== null) writeJson(controlFile, Object.assign(control, { notifiedKey: null }));
    }
    const control = readControl();
    if (control.dismissed.length !== status.dismissed.length) writeJson(controlFile, Object.assign(control, { dismissed: status.dismissed }));
    writeJson(statusFile, status);
    return status;
}

// The status record's converter step (D107). An earlier runner's record
// has no `needsYou`, and its attention key hashed every review record,
// notes included, so the key the plugin was notified of is no key this
// runner renders. When that record's attention was notified, the attention
// rendered now counts as notified while every reason it gives is one that
// record gave: it names the same review records or fewer, so the update
// raises no notification of its own. REWRITE is whether an earlier step
// changed what the record renders from.
function migrateStatusIfNeeded(rewrite) {
    const earlierForm = read => read.kind === "ok" && plain(read.value) && !hasOwn(read.value, "needsYou");
    if (!earlierForm(readJson(statusFile)) && !rewrite) return;
    withStateLock(() => {
        const read = readJson(statusFile);
        const earlier = earlierForm(read) && plain(read.value.attention) ? read.value.attention : null;
        const after = renderStatus().attention;
        if (earlier !== null && earlier.notified === true && Array.isArray(earlier.reasons) && after !== null
            && after.reasons.every(r => earlier.reasons.indexOf(r) !== -1))
            writeJson(controlFile, Object.assign(readControl(), { notifiedKey: after.key }));
        writeStatus();
    });
}

// ------------------------------------------------------------- the rename

// The plugin's name before it was Google Drive. A converter step under
// D107: an install that ran the previous plugin has its state directory,
// since that plugin's service wrote the status record at every shell
// start, and keeps its units and keyring items under the old names until
// this step moves them. The previous runner's locks under
// $XDG_RUNTIME_DIR stay where they are: a lock file holds no data, and
// the old service has stopped before anything moves.
const OLD_NAME = "cloud-sync";
const OLD_SERVICE = "vgs-cloud-sync.service";
const OLD_TIMER = "vgs-cloud-sync.timer";
const OLD_SECRET_SERVICE = "vgs-cloud-sync";
// Each previous directory and the one it becomes: the pair list and the
// setup log's neighbours, the status, pause and per-pair records with the
// kept copies, and the runner copies the units ran.
const OLD_DIRS = [
    [path.join(configHome, "vgshell", OLD_NAME), path.dirname(pairsFile)],
    [path.join(stateHome, "vgshell", OLD_NAME), stateDir],
    [path.join(dataHome, "vgshell", OLD_NAME), path.dirname(engineRoot)]
];
// Present from the rename's first move until its last step ends, so an
// invocation that finds no previous directory or unit still waits on the
// state lock for a rename in progress, and a held step is retried. It
// holds `held`: each keyring account whose item stays under the previous
// name alone, mapped to the presence readSecret and probeAccount give it.
const RENAME_PENDING = path.join(stateDir, "rename.pending");
// `systemctl is-active` words (systemctl(1)): a oneshot service reads
// activating while its sync runs and deactivating while ExecStopPost runs.
const UNIT_BUSY = ["active", "activating", "deactivating", "reloading", "refreshing"];
const UNIT_ENDED = ["inactive", "failed"];

function exists(p) {
    try {
        fs.lstatSync(p);
        return true;
    } catch (e) {
        if (e.code === "ENOENT") return false;
        throw e;
    }
}

function oldUnitFiles() {
    return [OLD_SERVICE, OLD_TIMER].filter(name => exists(path.join(unitDir, name)));
}

function renameNeeded() {
    return exists(RENAME_PENDING) || OLD_DIRS.some(dirs => exists(dirs[0])) || oldUnitFiles().length > 0;
}

// The presence ACCOUNT reads with while the rename holds its item under
// the previous name, or null. The previous name's two-client accounts
// stand for the account they become. A damaged record holds nothing; the
// rename rewrites it at the next invocation.
function renameHeldPresence(account) {
    const pending = readJson(RENAME_PENDING);
    if (pending.kind !== "ok" || !plain(pending.value) || !plain(pending.value.held)) return null;
    for (const name of [account].concat(OLD_DIRECTIONS.map(direction => direction + "-" + account))) {
        const presence = pending.value.held[name];
        if (presence === "locked" || presence === "unavailable") return presence;
    }
    return null;
}

// A rename step that waits on the previous service: the invocation ends
// with EXIT_BUSY, which the plugin's service reads as held and retries.
function holdRename(reason) {
    process.stderr.write("google-drive: refused: migration=held " + reason + "\n");
    process.exit(EXIT_BUSY);
}

// The previous service's is-active word when it reads busy, else null.
// No word from systemctl holds the rename.
function oldServiceBusy() {
    const bin = which("systemctl");
    if (bin === null) holdRename("systemctl=missing");
    const out = run(bin, ["--user", "is-active", OLD_SERVICE], { timeout: 10000, killSignal: "SIGKILL" });
    const word = String(out.stdout || "").trim();
    if (UNIT_BUSY.indexOf(word) !== -1) return word;
    if (UNIT_ENDED.indexOf(word) === -1) holdRename("reason=old-service-unknown");
    return null;
}

// Disables the previous timer once no sync of its service runs, so no
// previous runner writes a directory while it moves. A sync that runs
// holds the rename with the timer still enabled: the hourly sync goes on
// under the previous units until a later invocation finds the sync ended.
// The timer's Persistent=true starts a catch-up sync at the first login
// after a missed hour, as the new shell starts, and a oneshot service has
// no start timeout, so the sync is waited out by retries, never by this
// call. systemctl has no verb that waits for a unit's end without
// stopping it, and stopping would cut the sync short.
function stopOldUnits(names) {
    const busy = oldServiceBusy();
    if (busy !== null) holdRename("reason=old-service-" + busy);
    if (names.indexOf(OLD_TIMER) === -1) return;
    const failure = systemctlFailure(["disable", "--now", OLD_TIMER]);
    if (failure !== null) holdRename(failure);
    // The timer can start a sync between the read above and the disable;
    // that sync is waited out like any other, with the timer enabled again.
    const started = oldServiceBusy();
    if (started === null) return;
    const restored = systemctlFailure(["enable", "--now", OLD_TIMER]);
    holdRename("reason=old-service-" + started + (restored === null ? "" : " restore=" + restored));
}

const DISABLED_STOP_POST = "[Service]\nExecStopPost=\n";

function disabledStopPostFile(name) {
    return path.join(runtimeDir, "systemd", "user", name + ".d", "90-vgs-google-drive-migrate.conf");
}

function clearDisabledStopPost(scheduling) {
    if (runtimeDir === "") return;
    let changed = false;
    for (const name of [OLD_SERVICE, SERVICE]) {
        const file = disabledStopPostFile(name);
        if (!exists(file)) continue;
        fs.unlinkSync(file);
        changed = true;
    }
    if (changed) {
        const failure = systemctlFailure(["daemon-reload"], scheduling);
        if (failure !== null) holdRename("reason=stop-post-reload-failed");
    }
}

// Shipped services, including an earlier engine's units, run status in
// ExecStopPost. That runner can take the state lock and enable its timer.
// systemctl(1) daemon-reload reloads all unit files; systemd service.c's
// service_enter_stop_post reads the reloaded ExecStopPost command list.
// The overrides belong to this stop attempt. Restore the services' future
// stop commands before reporting either a successful or a failed stop.
function stopDisabledUnits() {
    if (lockDir === "") refuse("runtime-dir=unset");
    const names = [OLD_TIMER, TIMER, OLD_SERVICE, SERVICE].filter(name => exists(path.join(unitDir, name)));
    const failures = [];
    for (const name of names.filter(name => name.endsWith(".timer"))) {
        const failure = systemctlFailure(["disable", "--now", name], "disabled");
        if (failure !== null) failures.push(failure);
    }
    const services = names.filter(name => name.endsWith(".service"));
    let reloadFailed = false;
    try {
        for (const name of services) writeAtomic(disabledStopPostFile(name), DISABLED_STOP_POST, 0o644);
        if (services.length > 0) reloadFailed = systemctlFailure(["daemon-reload"], "disabled") !== null;
        if (!reloadFailed) {
            for (const name of services) {
                const failure = systemctlFailure(["disable", "--now", name], "disabled");
                if (failure !== null) failures.push(failure);
            }
            const bin = which("systemctl");
            for (const name of services) {
                if (bin === null) continue;
                const out = run(bin, ["--user", "is-active", name], { timeout: 10000, killSignal: "SIGKILL" });
                if (UNIT_ENDED.indexOf(String(out.stdout || "").trim()) === -1) failures.push("service=not-ended");
            }
        }
    } finally {
        clearDisabledStopPost("disabled");
    }
    if (reloadFailed) holdRename("reason=stop-post-reload-failed");
    if (failures.length > 0) holdRename("reason=disabled-stop-failed");
}

// Moves FROM to TO. A floating TUI makes the new state directory for its
// setup log before its first runner call, so TO may exist: then each entry
// moves on its own. The TUI holds the new setup log open and reads its
// own lines from the offset it began at, so the previous setup log keeps
// its own name beside it. Any other entry both hold stays, logged, and
// keeps the rename pending. Returns whether FROM is gone.
function moveTree(from, to) {
    let fromStat;
    try {
        fromStat = fs.lstatSync(from);
    } catch (e) {
        if (e.code === "ENOENT") return true;
        throw e;
    }
    if (!exists(to)) {
        fs.mkdirSync(path.dirname(to), { recursive: true, mode: 0o700 });
        fs.renameSync(from, to);
        return true;
    }
    const toStat = fs.lstatSync(to);
    if (fromStat.isDirectory() && toStat.isDirectory()) {
        let gone = true;
        for (const name of fs.readdirSync(from)) gone = moveTree(path.join(from, name), path.join(to, name)) && gone;
        if (gone) fs.rmdirSync(from);
        return gone;
    }
    if (path.basename(to) === "setup.log") return moveTree(from, path.join(path.dirname(to), "setup.before-rename.log"));
    log("migration=held reason=both-exist path=" + to);
    return false;
}

// One keyring account of the previous name moved to this one in the
// order migrateCredentialsIfNeeded keeps: copy, check the copy, clear the
// old item. An account this name already holds keeps its item, an
// earlier invocation's copy or a sign-in made since. Returns null when
// nothing is left of it, or { reason, held }: held is the presence the
// account reads with here while its value stays under the previous name
// alone, or null once a copy here stands for it.
function moveKeyringItem(tool, account) {
    const unmoved = reason => ({ reason: reason, held: reason === "credential-locked" ? "locked" : "unavailable" });
    const old = probeItem(tool, account, OLD_SECRET_SERVICE);
    if (old.presence === "absent") return null;
    if (old.presence !== "present") return unmoved("credential-" + old.presence);
    const current = probeItem(tool, account, SECRET_SERVICE);
    if (current.presence === "absent") {
        const value = searchItem(tool, account, OLD_SECRET_SERVICE);
        if (value.kind !== "found") return unmoved("credential-" + (value.kind === "unavailable" ? value.reason : value.kind));
        // Both shipped writers use the default collection. If it locks
        // after this read, store can show one unlock prompt; no data is lost.
        const stored = storeSecret(tool, account, value.value, old.user === null ? [] : ["user", old.user]);
        if (!stored.ok) return unmoved("store-failed");
        const copy = searchItem(tool, account, SECRET_SERVICE);
        if (copy.kind !== "found" || copy.value !== value.value || probeItem(tool, account, SECRET_SERVICE).user !== old.user) {
            // A later invocation would take a copy that stands for the
            // old item, so this one goes and the old item stays.
            clearAccountResult(tool, account);
            return unmoved("copy-differs");
        }
    } else if (current.presence !== "present") {
        return { reason: "credential-" + current.presence, held: null };
    }
    if (!clearAccountResult(tool, account, OLD_SECRET_SERVICE).ok) return { reason: "clear-failed", held: null };
    const left = probeItem(tool, account, OLD_SECRET_SERVICE).presence;
    return left === "absent" ? null : { reason: "credential-" + left, held: null };
}

// Every account's move, the two-client accounts too, for
// migrateCredentialsIfNeeded to convert: { held, holds }, held as
// RENAME_PENDING keeps it and holds the log line of each step left for a
// later invocation.
function moveKeyringItems() {
    const tool = which("secret-tool");
    if (tool === null) return { held: {}, holds: ["reason=secret-tool-missing"] };
    const held = {};
    const holds = [];
    for (const account of CREDENTIAL_PARTS.concat(OLD_ACCOUNTS)) {
        const moved = moveKeyringItem(tool, account);
        if (moved === null) continue;
        holds.push("reason=" + moved.reason + " account=" + account);
        if (moved.held !== null) held[account] = moved.held;
    }
    return { held: held, holds: holds };
}

// The rename, under the state lock: stop the previous units, move the
// directories, move the keyring items, then install this name's units in
// place of the previous ones when those were installed. The new units are
// written before the old files go, so an invocation cut off at any point
// still finds the old files or RENAME_PENDING and finishes. A held step
// keeps RENAME_PENDING and lets the verb go on; only a running previous
// sync holds the whole invocation (stopOldUnits). Returns whether a rename
// ran, so the caller rewrites the status record, which names stored
// copies by their full path.
function migrateRenameIfNeeded(scheduling = "enabled") {
    if (scheduling === "enabled") clearDisabledStopPost(scheduling);
    const stopPostPending = runtimeDir !== "" && [OLD_SERVICE, SERVICE].some(name => exists(disabledStopPostFile(name)));
    if (scheduling === "disabled" && (renameNeeded() || stopPostPending)) stopDisabledUnits();
    if (!renameNeeded()) return false;
    withStateLock(() => {
        if (!renameNeeded()) return;
        const units = oldUnitFiles();
        if (scheduling === "enabled" && units.length > 0) stopOldUnits(units);
        if (!exists(RENAME_PENDING)) writeJson(RENAME_PENDING, { held: {} });
        // moveTree logs each entry it leaves.
        const moved = OLD_DIRS.map(dirs => moveTree(dirs[0], dirs[1])).every(Boolean);
        const holds = [];
        const keyring = moveKeyringItems();
        holds.push(...keyring.holds);
        if (units.length > 0) {
            const installed = writeInstall(false, scheduling);
            if (installed.failure !== null) {
                holds.push(installed.failure);
            } else {
                for (const name of units) fs.rmSync(path.join(unitDir, name), { force: true });
                // A manager that missed this reload still holds the old
                // units, disabled and stopped, until its next reload.
                const failure = systemctlFailure(["daemon-reload"], scheduling);
                if (failure !== null) holds.push("reload=failed " + failure);
                // The manager keeps a previous unit whose last run failed,
                // listed as not-found failed, until this or its restart.
                // A unit it no longer holds fails this, which changes nothing.
                systemctlFailure(["reset-failed", OLD_SERVICE, OLD_TIMER], scheduling);
            }
        }
        if (moved && holds.length === 0) {
            fs.rmSync(RENAME_PENDING, { force: true });
            log("migration=rename old=" + OLD_NAME + " result=written");
            return;
        }
        writeJson(RENAME_PENDING, { held: keyring.held });
        for (const hold of holds) log("migration=held " + hold);
    });
    return true;
}

// ------------------------------------------------------------------ verbs

function pairOption(words) {
    if (words.length === 0) return null;
    if (words.length !== 2 || words[0] !== "--pair") bad("argument=" + words[0]);
    return words[1];
}

function runVerb(words) {
    const only = pairOption(words);
    migrateCredentialsIfNeeded();
    const read = readPairs();
    if (read.error !== null) {
        withStateLock(writeStatus);
        refuse(read.error);
    }
    const chosen = only === null ? read.pairs : read.pairs.filter(p => p.id === only);
    if (only !== null && chosen.length === 0) refuse("pair=unknown");
    if (chosen.length === 0) log("skipped reason=no-pairs");
    const control = readControl();
    let exit = 0;
    for (const pair of chosen) {
        const result = runPair(pair, control);
        process.stdout.write("pair=" + pair.id + " result=" + result + "\n");
        log("pair=" + pair.id + " result=" + result);
        if (result === "busy" && exit === 0) exit = EXIT_BUSY;
        else if (["idle", "paused", "busy"].indexOf(result) === -1) exit = 1;
    }
    withStateLock(writeStatus);
    process.exit(exit);
}

function statusVerb(words) {
    if (words.length > 1 || (words.length === 1 && words[0] !== "--quiet")) bad("argument=" + words[0]);
    const status = withStateLock(() => {
        // systemd.exec(5), $EXIT_CODE/$EXIT_STATUS: stop-post receives
        // killed/TERM for a TERM stop, including for this oneshot service.
        // spawnSync blocks Node's event loop (node:child_process docs), so
        // stop-post owns this write after the runner and its child end.
        if (words.length === 1 && process.env.EXIT_CODE === "killed" && process.env.EXIT_STATUS === "TERM") {
            for (const pair of readPairs().pairs) {
                const stored = readPairState(pair.id);
                if (stored.state !== "running" || lockHeld(pairLock(pair.id))) continue;
                writePairState(pair.id, Object.assign(stored, {
                    state: stored.lastError === null ? "idle" : failureState(stored.lastError.kind), startedAt: null
                }));
            }
        }
        return writeStatus();
    });
    if (words.length === 0) process.stdout.write(JSON.stringify(status) + "\n");
}

// The service runs this once it has notified of KEY. A key that is no
// longer the record's is written all the same: it marks nothing notified.
function attentionSeenVerb(words) {
    if (words.length !== 1 || !/^[0-9a-f]{16}$/.test(words[0])) bad("key=" + (words[0] || "missing"));
    withStateLock(() => {
        writeJson(controlFile, Object.assign(readControl(), { notifiedKey: words[0] }));
        writeStatus();
    });
    process.stdout.write("seen=" + words[0] + "\n");
}

// The popover's Dismiss on a row that needs nothing. A sync can change the
// row between the popover's read and the click, so a key that names no
// row now is refused rather than kept; a row that needs the user stays,
// since its fix is still the user's.
function dismissVerb(words) {
    if (words.length !== 1 || !CONFLICT_KEY.test(words[0])) bad("key=" + (words[0] || "missing"));
    const key = words[0];
    withStateLock(() => {
        const row = renderStatus().conflicts.find(c => c.key === key);
        if (row === undefined) refuse("dismiss=unknown key=" + key);
        if (row.needs === "you") refuse("dismiss=needs-you key=" + key);
        const control = readControl();
        if (control.dismissed.indexOf(key) === -1) writeJson(controlFile, Object.assign(control, { dismissed: control.dismissed.concat([key]) }));
        writeStatus();
    });
    process.stdout.write("dismissed=" + key + "\n");
}

function probeVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    migrateCredentialsIfNeeded();
    const tool = which("secret-tool");
    const needed = readPairs().pairs.length > 0;
    const credentials = [];
    for (const part of CREDENTIAL_PARTS) {
        const probed = probeAccount(tool, part);
        const row = { account: part, presence: probed.presence, needed: needed };
        if (part === "token" && probed.user !== null) row.user = probed.user;
        credentials.push(row);
    }
    process.stdout.write(JSON.stringify({ credentials: credentials }) + "\n");
}

// rclone prints the token between these lines on stdout
// (fs/config/authorize.go, Authorize, rclone v1.75.1).
const PASTE_START = "Paste the following into your remote machine --->";
const PASTE_END = "<---End paste";
// rclone waits for Google's answer without end; a consent left open this
// long is given up, so the terminal can close.
const AUTHORIZE_MS = 15 * 60 * 1000;
// What xdg-open, which rclone runs to open the consent page, and the
// browser it starts read from the graphical session.
const BROWSER_ENV = ["DISPLAY", "WAYLAND_DISPLAY", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "XDG_DATA_DIRS", "XDG_CONFIG_DIRS", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "BROWSER"];

// The token JSON between rclone's paste lines, or null. A token without a
// refresh token would stop working after an hour, so it is refused.
function pastedToken(stdout) {
    const lines = String(stdout).split("\n");
    const at = lines.indexOf(PASTE_START);
    if (at === -1 || lines[at + 2] !== PASTE_END) return null;
    const text = lines[at + 1];
    let token;
    try {
        token = JSON.parse(text);
    } catch (_e) {
        return null;
    }
    if (!plain(token) || typeof token.refresh_token !== "string" || token.refresh_token === "" || CONTROL.test(text)) return null;
    return text;
}

// Drive's `about` resource names the account a token belongs to; both
// scopes may read it (developers.google.com/drive/api/reference/rest/v3/
// about/get, Authorization scopes). A read longer than this is given up.
const ABOUT_URL = "https://www.googleapis.com/drive/v3/about?fields=user(emailAddress)";
const ABOUT_SECONDS = 20;

// The address of the Google account TOKEN, rclone's token JSON, signs in:
// { kind: "read", address } | { kind: "unread", reason }. The access token
// reaches curl as a header line on its stdin (`--header @-`, curl 7.55.0
// and later), never argv; -q, first, keeps a user's .curlrc out; curl's
// stderr is dropped.
function accountAddress(token) {
    const access = JSON.parse(token).access_token;
    if (typeof access !== "string" || !/^[\x21-\x7e]+$/.test(access)) return { kind: "unread", reason: "access-token" };
    const bin = which("curl");
    if (bin === null) return { kind: "unread", reason: "curl-missing" };
    const out = childProcess.spawnSync(bin, ["-q", "--silent", "--fail", "--proto", "=https", "--max-time", String(ABOUT_SECONDS), "--header", "@-", ABOUT_URL],
        { input: "Authorization: Bearer " + access + "\n", encoding: "utf8", stdio: ["pipe", "pipe", "ignore"], env: childEnv(), timeout: (ABOUT_SECONDS + 10) * 1000, killSignal: "SIGKILL" });
    if (out.status === null) return { kind: "unread", reason: "curl-timeout" };
    if (out.status !== 0) return { kind: "unread", reason: "curl-failed exit=" + out.status };
    let about;
    try {
        about = JSON.parse(out.stdout);
    } catch (_e) {
        return { kind: "unread", reason: "not-json" };
    }
    const address = plain(about) && plain(about.user) ? about.user.emailAddress : undefined;
    return validAddress(address) ? { kind: "read", address: address } : { kind: "unread", reason: "address-invalid" };
}

// `rclone authorize drive` for the stored client keys, which rclone
// reads from RCLONE_DRIVE_CLIENT_ID and RCLONE_DRIVE_CLIENT_SECRET in its
// environment (fs/configmap.go, optionEnvVars), never from argv, with the
// drive scope. rclone's link and messages reach the terminal on
// stderr; its stdout, the token, stays in this process and reaches
// secret-tool on stdin alone, with no newline, as SecretWriter writes.
function authorizeVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    const tool = requireCommand("secret-tool");
    const client = {};
    for (const part of ["client-id", "client-secret"]) {
        const account = part;
        const got = readSecret(tool, account);
        if (got.kind !== "found") refuse("credential=" + (got.kind === "unavailable" ? got.reason : got.kind) + " account=" + account);
        client[part] = got.value;
    }
    const session = {};
    for (const name of BROWSER_ENV) if (process.env[name]) session[name] = process.env[name];
    const env = childEnv(Object.assign(session, {
        RCLONE_DRIVE_CLIENT_ID: client["client-id"],
        RCLONE_DRIVE_CLIENT_SECRET: client["client-secret"],
        RCLONE_DRIVE_SCOPE: DRIVE_SCOPE
    }));
    const out = childProcess.spawnSync(requireCommand("rclone"), ["--config", "/dev/null", "authorize", "drive"],
        { encoding: "utf8", stdio: ["inherit", "pipe", "inherit"], env: env, timeout: AUTHORIZE_MS, killSignal: "SIGTERM" });
    if (out.status !== 0) refuse("authorize=failed exit=" + out.status);
    const token = pastedToken(out.stdout);
    if (token === null) refuse("authorize=no-token");
    const account = "token";
    const read = accountAddress(token);
    if (read.kind === "unread") log("account=unread reason=" + read.reason);
    // The account's older items go before the store, so one item remains:
    // an item without `user` matches every search of the account, so it
    // could not be cleared after the store without the new one. A store
    // that fails after this leaves VGS signed out of Google Drive.
    clearAccount(tool, account);
    const stored = storeSecret(tool, account, token, read.kind === "read" ? ["user", read.address] : []);
    if (!stored.ok) refuse("store=failed account=" + account);
    // With every credential now stored, pairs that
    // waited for a sign-in no longer read so until a run says otherwise.
    withStateLock(() => {
        for (const pair of readPairs().pairs) {
            if (lockHeld(pairLock(pair.id))) continue;
            const state = readPairState(pair.id);
            if (state.state === "authorization-required") writePairState(pair.id, Object.assign(state, { state: "idle", lastError: null }));
        }
        writeStatus();
    });
    process.stdout.write("authorized=drive\n");
}

// Each pair that no run holds reads as credential-absent from now on, as
// its next run would record; a running pair records what its run read. The
// user asked for this, so the attention it makes counts as notified,
// unless the record held one not yet notified.
function signOutVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    const tool = requireCommand("secret-tool");
    const account = "token";
    clearAccount(tool, account);
    const left = probeAccount(tool, account).presence;
    if (left === "locked") refuse("credential=locked account=" + account);
    if (left !== "absent") refuse("sign-out=incomplete presence=" + left + " account=" + account);
    withStateLock(() => {
        const before = renderStatus().attention;
        for (const pair of readPairs().pairs) {
            if (lockHeld(pairLock(pair.id))) continue;
            writePairState(pair.id, failed(readPairState(pair.id), "credential-absent", { account: account }));
        }
        const after = renderStatus().attention;
        if (after !== null && (before === null || before.notified)) writeJson(controlFile, Object.assign(readControl(), { notifiedKey: after.key }));
        writeStatus();
    });
    process.stdout.write("signed-out=drive\n");
}

function startVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    if (unitsState() === "absent") refuse("units=absent");
    systemctl(["start", "--no-block", SERVICE]);
    process.stdout.write("started=" + SERVICE + "\n");
}

function pauseVerb(words, paused) {
    const only = pairOption(words);
    withStateLock(() => {
        if (only !== null && !readPairs().pairs.some(p => p.id === only)) refuse("pair=unknown");
        const control = readControl();
        const next = only === null
            ? { paused: paused, pausedPairs: paused ? control.pausedPairs : [], notifiedKey: control.notifiedKey }
            : { paused: control.paused, pausedPairs: control.pausedPairs.filter(id => id !== only).concat(paused ? [only] : []), notifiedKey: control.notifiedKey };
        if (control.error) refuse("control=" + control.error);
        writeJson(controlFile, Object.assign(next, { dismissed: control.dismissed, twoWaySync: control.twoWaySync, modeAdmitted: control.modeAdmitted }));
        writeStatus();
    });
    process.stdout.write((paused ? "paused=" : "resumed=") + (only === null ? "all" : only) + "\n");
}

function serviceModeVerb(words) {
    if (words.length !== 1 || !["true", "false"].includes(words[0])) bad("two-way=boolean");
    withStateLock(() => {
        const control = readControl();
        if (control.error) refuse("control=" + control.error);
        writeJson(controlFile, Object.assign(control, { twoWaySync: words[0] === "true", modeAdmitted: true }));
        writeStatus();
    });
    process.stdout.write("two-way=" + words[0] + "\n");
}

// A label holds no control character (pairError), so a tab parts the
// fields of a line.
function pairsVerb(words) {
    if (words.length > 1 || (words.length === 1 && words[0] !== "--lines")) bad("argument=" + words[0]);
    const read = readPairs();
    if (words.length === 0) process.stdout.write(JSON.stringify(read) + "\n");
    else if (read.error !== null) refuse("pairs=invalid " + read.error);
    else for (const pair of read.pairs) process.stdout.write(pair.id + "\t" + pair.label + "\n");
}

function stamp() {
    return new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
}

function pairsResetVerb(words) {
    if (words.length !== 0) bad("argument=" + words[0]);
    let keptName = "";
    withStateLock(() => {
        const read = readPairs();
        if (read.error === null) refuse("pairs=valid");
        keptName = "pairs.json.damaged-" + stamp();
        const kept = path.join(path.dirname(pairsFile), keptName);
        try {
            fs.lstatSync(kept);
            refuse("kept=exists");
        } catch (e) {
            if (e.code !== "ENOENT") throw e;
        }
        const temp = path.join(path.dirname(pairsFile), ".pairs.json.reset-" + process.pid);
        fs.writeFileSync(temp, JSON.stringify({ pairs: [] }, null, 2) + "\n", { mode: 0o600 });
        fs.renameSync(pairsFile, kept);
        fs.renameSync(temp, pairsFile);
        writeStatus();
    });
    process.stdout.write("reset=" + keptName + "\n");
}

function pairAddVerb(words) {
    if (words.length !== 2 || words[0] !== "--definition") bad("option=--definition value=missing");
    let pair;
    try {
        pair = JSON.parse(words[1]);
    } catch (_e) {
        bad("definition=not-json");
    }
    // The hourly sync is no setup step: a pair-add on a home without the
    // units installs them, under the state lock, so two adds install once.
    // The install runs before the pair is written, so a unit it refuses to
    // write leaves nothing changed; a failed systemctl call keeps the pair,
    // and the units read absent in the status.
    let installed = null;
    withStateLock(() => {
        const read = readPairs();
        if (read.error !== null) refuse("pairs=invalid " + read.error);
        const next = read.pairs.concat([pair]);
        const error = pairsError(next);
        if (error !== null) refuse(error);
        if (unitsState() === "absent") installed = writeInstall(false);
        writeJson(pairsFile, { pairs: next });
        writeStatus();
    });
    process.stdout.write("added=" + pair.id + "\n");
    if (installed === null) return;
    process.stdout.write(installed.failure === null ? "installed=" + TIMER + " changed=" + installed.changed + "\n" : "install=failed " + installed.failure + "\n");
}

function pairRemoveVerb(words) {
    if (words.length !== 1) bad("argument=" + (words[1] || "missing"));
    withStateLock(() => {
        const read = readPairs();
        if (read.error !== null) refuse("pairs=invalid " + read.error);
        if (!read.pairs.some(p => p.id === words[0])) refuse("pair=unknown");
        writeJson(pairsFile, { pairs: read.pairs.filter(p => p.id !== words[0]) });
        writeStatus();
    });
    process.stdout.write("removed=" + words[0] + "\n");
}

// ------------------------------------------------------------------- main

const verb = process.argv[2];
const rest = process.argv.slice(3);
if (verb === "migrate") {
    if (rest.length !== 1 || rest[0] !== "disabled") bad("migration=argument");
    migrateRenameIfNeeded("disabled");
    if (exists(RENAME_PENDING)) holdRename("reason=disabled-incomplete");
    process.exit(0);
}
const renamed = migrateRenameIfNeeded();
migratePairListIfNeeded();
const converted = migratePairStatesIfNeeded();
migrateModeIfNeeded();
migrateStatusIfNeeded(renamed || converted);
if (verb !== "install" && verb !== "service-mode" && verb !== "initialize") refreshStaleInstallIfNeeded();
switch (verb) {
case "run": runVerb(rest); break;
case "initialize": initializeVerb(rest); break;
case "service-mode": serviceModeVerb(rest); break;
case "status": statusVerb(rest); break;
case "attention-seen": attentionSeenVerb(rest); break;
case "dismiss": dismissVerb(rest); break;
case "probe": probeVerb(rest); break;
case "authorize": authorizeVerb(rest); break;
case "sign-out": signOutVerb(rest); break;
case "install": installVerb(rest); break;
case "start": startVerb(rest); break;
case "pause": pauseVerb(rest, true); break;
case "resume": pauseVerb(rest, false); break;
case "pairs": pairsVerb(rest); break;
case "pairs-reset": pairsResetVerb(rest); break;
case "pair-add": pairAddVerb(rest); break;
case "pair-remove": pairRemoveVerb(rest); break;
default: bad("verb=" + (verb || "missing"));
}
