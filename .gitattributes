# Vendored kendex renders: upstream bytes, not this repo's whitespace to police.
.agents/** -whitespace
.claude/** -whitespace
.codex/** -whitespace
.pi/** -whitespace
# Canned package-manager output: the bytes each tool prints, padding included.
scripts/fixtures/pkg/** -whitespace
# Build transcripts: a pty's CRLF line ends are the classifier's input.
scripts/fixtures/pkg/check-failure/*.out -text
# Binary assets: declared binary so git keeps them out of textual diffs and
# doc-limits does not read their NUL bytes as a text file gone binary.
*.png binary
*.jpg binary
*.cur binary
*.ani binary
*.qsb binary
*.wav binary
*.ttf binary
*.mp4 binary
scripts/smoke/user-config.sh text eol=lf
scripts/smoke/fixtures/tui/vgs.jarvis/tui/repair-home.sh text eol=lf
*.webp binary
scripts/smoke/fixtures/sysmon/*.json text eol=lf
themes/targets/starship/* text eol=lf
themes/targets/yazi/* text eol=lf
themes/targets/bat/* text eol=lf
themes/targets/fastfetch/* text eol=lf
themes/targets/television/* text eol=lf
themes/targets/ghostty/* text eol=lf
themes/targets/neovim/* text eol=lf
themes/targets/pi/* text eol=lf
config/system/udev/69-vgs-disk-sleep.rules text eol=lf
