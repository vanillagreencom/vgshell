{
  "app": "btop",
  "runsCode": false,
  "encoder": "hex6",
  "files": [{ "template": "btop.theme", "destination": "btop.theme" }],
  "detect": ["btop"],
  "wiring": { "base": "config", "dir": "btop/themes", "owned": false, "links": { "vgs.theme": "btop.theme" } },
  "select": { "base": "config", "file": "btop/btop.conf", "format": "toml", "key": ["color_theme"], "value": "vgs" },
  "reload": { "command": ["sh", "-c", "pkill -USR2 -x -u \"$(id -u)\" btop; [ \"$?\" -le 1 ]"], "timeoutMs": 5000, "always": true }
}
