{
  "app": "Claude Desktop",
  "runsCode": false,
  "encoder": "hsl",
  "files": [{ "template": "claude-desktop.json", "destination": "claude-desktop.json" }],
  "detect": ["claude-desktop"],
  "accounts": { "base": "config", "prefix": "Claude" },
