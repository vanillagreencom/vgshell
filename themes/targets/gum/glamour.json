{
  "document": { "color": "#@{color.text}", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ " },
  "list": { "level_indent": 2 },
  "heading": { "color": "#@{color.textHeading}", "bold": true, "block_suffix": "\n" },
  "h1": { "color": "#@{color.onAccent}", "background_color": "#@{color.accent}", "prefix": " ", "suffix": " " },
  "h2": { "prefix": "▌ " },
  "h3": { "prefix": "┃ " },
  "h4": { "prefix": "│ " },
  "h5": { "prefix": "┆ " },
  "h6": { "color": "#@{color.textHeading}", "prefix": "┊ ", "bold": false },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#@{color.borderStrong}", "format": "\n──────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#@{color.info}", "underline": true },
  "link_text": { "color": "#@{color.info}", "bold": true },
  "image": { "color": "#@{color.info}", "underline": true },
  "image_text": { "color": "#@{color.textMuted}", "format": "Image: {{.text}}" },
  "code": { "color": "#@{color.text}", "background_color": "#@{color.surfaceRaised}", "prefix": " ", "suffix": " " },
  "code_block": {
    "color": "#@{color.text}",
    "chroma": {
      "text": { "color": "#@{color.text}" },
      "error": { "color": "#@{color.onDanger}", "background_color": "#@{color.danger}" },
      "comment": { "color": "#@{color.textFaint}" },
      "comment_preproc": { "color": "#@{terminal.color1}" },
      "keyword": { "color": "#@{terminal.color5}" },
      "keyword_reserved": { "color": "#@{terminal.color5}" },
      "keyword_namespace": { "color": "#@{terminal.color5}" },
      "keyword_type": { "color": "#@{terminal.color3}" },
      "operator": { "color": "#@{color.textMuted}" },
      "punctuation": { "color": "#@{color.textMuted}" },
      "name": { "color": "#@{color.text}" },
      "name_builtin": { "color": "#@{terminal.color6}" },
      "name_tag": { "color": "#@{terminal.color1}" },
      "name_attribute": { "color": "#@{terminal.color3}" },
      "name_class": { "color": "#@{terminal.color3}", "underline": true, "bold": true },
      "name_constant": {},
      "name_decorator": { "color": "#@{terminal.color3}" },
      "name_exception": {},
      "name_function": { "color": "#@{terminal.color4}" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "#@{terminal.color3}" },
      "literal_date": {},
      "literal_string": { "color": "#@{terminal.color2}" },
      "literal_string_escape": { "color": "#@{terminal.color3}" },
      "generic_deleted": { "color": "#@{color.danger}" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#@{color.success}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#@{color.textHeading}" },
      "background": { "background_color": "#@{color.background}" }
    }
  },
  "definition_description": { "block_prefix": "\n🠶 " }
}
