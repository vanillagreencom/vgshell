<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>name</key><string>vgs</string>
<key>settings</key><array>
<dict><key>settings</key><dict><key>foreground</key><string>#@{color.text}</string><key>background</key><string>#@{color.background}</string><key>caret</key><string>#@{color.text}</string><key>invisibles</key><string>#@{color.textFaint}</string><key>gutterForeground</key><string>#@{color.textMuted}</string><key>gutter</key><string>#@{color.background}</string><key>lineHighlight</key><string>#@{color.background}</string><key>selection</key><string>#@{mix({color.background}, {color.text}, 0.13)}</string></dict></dict>
<dict><key>scope</key><string>comment</string><key>settings</key><dict><key>foreground</key><string>#@{color.textFaint}</string></dict></dict>
<dict><key>scope</key><string>string, markup.raw</string><key>settings</key><dict><key>foreground</key><string>#@{color.success}</string></dict></dict>
<dict><key>scope</key><string>constant</string><key>settings</key><dict><key>foreground</key><string>#@{color.warning}</string></dict></dict>
<dict><key>scope</key><string>variable, storage.type, entity.name.type, support.type</string><key>settings</key><dict><key>foreground</key><string>#@{color.text}</string></dict></dict>
<dict><key>scope</key><string>keyword, storage.modifier</string><key>settings</key><dict><key>foreground</key><string>#@{color.accent}</string></dict></dict>
<dict><key>scope</key><string>entity.name.function, support.function</string><key>settings</key><dict><key>foreground</key><string>#@{color.info}</string></dict></dict>
<dict><key>scope</key><string>punctuation</string><key>settings</key><dict><key>foreground</key><string>#@{color.textMuted}</string></dict></dict>
<dict><key>scope</key><string>markup.heading</string><key>settings</key><dict><key>foreground</key><string>#@{color.accent}</string></dict></dict>
<dict><key>scope</key><string>markup.underline.link</string><key>settings</key><dict><key>foreground</key><string>#@{color.info}</string></dict></dict>
<dict><key>scope</key><string>markup.inserted, diff.inserted</string><key>settings</key><dict><key>foreground</key><string>#@{color.success}</string></dict></dict>
<dict><key>scope</key><string>markup.deleted, diff.deleted, invalid</string><key>settings</key><dict><key>foreground</key><string>#@{color.danger}</string></dict></dict>
</array></dict></plist>
