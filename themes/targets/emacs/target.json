{
  "app": "Emacs",
  "runsCode": true,
  "encoder": "hex6",
  "files": [{ "template": "emacs.el", "destination": "emacs.el" }],
  "detect": ["emacs"],
  "wiring": { "file": "emacs/init.el", "line": "(load \"@{state}/emacs.el\" nil t)", "create": true, "last": true, "init": "emacs" },
  "reload": { "command": ["emacsclient", "-a", "true", "--eval", "(load \"@{state}/emacs.el\" nil t)"], "timeoutMs": 5000, "always": true }
}
