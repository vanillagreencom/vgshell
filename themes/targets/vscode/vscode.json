    "terminal.initialHintForeground": "#@{color.info}",
    "terminalStickyScrollHover.background": "#@{color.surfaceRaised}",
    "terminalSymbolIcon.flagForeground": "#@{color.info}",
    "terminalSymbolIcon.aliasForeground": "#@{terminal.color5}",
    "terminalSymbolIcon.optionValueForeground": "#@{terminal.color2}",
    "terminalSymbolIcon.methodForeground": "#@{terminal.color4}",
    "terminalSymbolIcon.argumentForeground": "#@{color.text}",
    "terminalSymbolIcon.optionForeground": "#@{color.info}",
    "testing.iconFailed": "#@{color.danger}",
    "testing.iconErrored": "#@{color.danger}",
    "testing.iconPassed": "#@{color.success}",
    "testing.runAction": "#@{color.success}",
    "testing.iconQueued": "#@{color.warning}",
    "testing.iconUnset": "#@{color.textFaint}",
    "testing.iconSkipped": "#@{color.textFaint}",
    "testing.message.error.badgeBackground": "#@{color.danger}",
    "testing.message.error.badgeBorder": "#@{color.danger}",
    "testing.message.error.badgeForeground": "#@{color.onDanger}",
    "testing.iconErrored.retired": "#@{color.danger}",
    "testing.iconFailed.retired": "#@{color.danger}",
