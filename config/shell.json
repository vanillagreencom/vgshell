        { "id": "vgs.bluetooth" },
        { "id": "vgs.sound" },
        { "id": "vgs.displays" },
        { "id": "vgs.keyboard" },
        { "id": "vgs.settings" }
      ]
    }
  },
  "manager": { "id": "vgs.settings" },
