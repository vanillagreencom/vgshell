    { "id": "vgs.settings", "shortcut": "toggle", "from": "SUPER+M", "to": "SUPER+PERIOD" },
    { "id": "vgs.system", "shortcut": "toggle", "from": "SUPER+PERIOD", "to": "SUPER+COMMA" },
