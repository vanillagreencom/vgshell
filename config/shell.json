    { "id": "vgs.jarvis", "shortcut": "stop", "from": "SUPER+ALT+PERIOD", "to": "SUPER+CTRL+X", "targetVersion": 5 },
    { "id": "vgs.jarvis", "shortcut": "confirm", "from": "SUPER+ALT+Y", "to": "SUPER+CTRL+Y", "targetVersion": 5 },
    { "id": "vgs.voice", "shortcut": "toggle", "from": "SUPER+CTRL+X", "to": null, "targetVersion": 5 },
    { "id": "vgs.agent-warden", "shortcut": "toggle", "from": "SUPER+CTRL+Y", "to": null, "targetVersion": 5 }
  ],
  "bar": {
