#!/bin/bash -p
# vgshell-sudo-grant: the passwordless sudo grant, timed or indefinite, both halves.
#
#   vgshell-sudo-grant status            whether a grant is active, until when, and the root half's state
#   vgshell-sudo-grant grant [duration]  ask how long, warn, ask, and grant passwordless sudo; DURATION,
#                                     1 to 1440 minutes or `indefinite`, 15 when absent, is the choice
#                                     the question starts on; while a grant is active it revokes that
#                                     grant instead
#   vgshell-sudo-grant revoke            end the active grant now, timed or indefinite
#   vgshell-sudo-grant install           install the root half and its boot cleanup, once; sudo asks
#   vgshell-sudo-grant uninstall         remove every grant, then the root half and its boot cleanup; sudo asks
#
# Run as the user, from the checkout through `vgshell sudo`, the file is the
# user half and takes those five verbs. `install` prints what it places,
# then through sudo copies bin/lib/tmpfiles.d/vgs-sudo-grant.conf to
# /etc/tmpfiles.d/vgs-sudo-grant.conf, whose `r!` line removes every timed
# grant at boot, and then this file to /usr/local/bin/vgs-sudo-grant, both
# root:root, so the root half is never in place without its boot cleanup.
# `grant` runs that same step first when the root half is absent or is not
# this file, so the first grant needs no separate install.
# `uninstall` revokes the user's grant, runs the boot cleanup's own line now
# through `systemd-tmpfiles --remove --boot`, so no account's timed grant
# outlives the file that ends it at boot, removes every account's
# indefinite grant, which nothing else would end once the root half is
# gone, then removes the root half and the boot cleanup.
#
# `status` never asks and runs nothing as root: it reads the caller's own
# rules through `sudo -n -l -l`. sudo lists them without a password while
# any of them is NOPASSWD, its default `listpw=any`, each under a
# `Sudoers entry: <file>` line, a timed one with its `NotAfter:` deadline,
# which an expired rule still shows; with none it refuses with `sudo: a
# password is required`, which reads as no grant. It prints one line:
# `sudo-grant=active until=<ISO 8601>|indefinite root-half=current|stale`,
# or `sudo-grant=inactive root-half=current|stale|absent`. A listing with
# no `Sudoers entry:` line is a sudo too old to name its files.
#
# Run as root, the file is the root half: the installed copy, which the user
# half reaches only through `sudo -N` after `sudo -k`, so every root action
# asks for the password unless a grant is active, and no sudo timestamp
# outlives the command. It runs under `bash -p`, runs itself again with an
# environment of PATH, LC_ALL and SUDO_UID alone, holds /run/vgs-sudo-grant.lock,
# and takes three actions, each for SUDO_UID's own account and nothing else:
#
#   __status <uid>              print `active deadline=<YYYYMMDDHHMMSS>Z` or `active indefinite`
#                               and exit 0, or `inactive` and exit 3
#   __enable <uid> <duration>   write the rule, arm a timed rule's expiry, publish it; print as __status
#   __disable <uid>             stop the expiry and remove both rules; print `revoked`, or `inactive`
#                               and exit 3
#
# A timed grant is one file, /etc/sudoers.d/99-vgs-nopasswd-<uid>, holding
# `<user> ALL=(ALL) NOTAFTER=<UTC deadline> NOPASSWD: ALL`: sudo itself
# refuses it after the deadline, suspend included. An indefinite grant is
# /etc/sudoers.d/99-vgs-permanent-nopasswd-<uid>, holding `<user> ALL=(ALL)
# NOPASSWD: ALL`, a name outside the boot cleanup's glob, so it stays across
# a reboot until it is revoked. __enable writes either to a dotted name sudo
# ignores, checks it with `visudo -cf`, for a timed rule arms the transient
# timer vgs-sudo-grant-expire-<uid> that removes it at the deadline, then
# renames it into place. It refuses while either grant is active, an
# existing rule it cannot read as its own, a deadline `date` did not give
# in sudo's form, and a boot cleanup file that is absent, not root's or not
# exactly the one line. An expired rule is removed as found. After the user
# half enables a grant it drops the sudo credential and runs `sudo -n -N
# /usr/bin/true`; a sudo that does not honour the rule has it revoked again.
#
# Every refusal prints one keyed line first: `vgs-sudo-grant: refused: <key>=<value>`.
# On NixOS, detected through the package-manager table before any sudo
# call, every user verb writes nothing and runs no sudo. Each reports
# `skipped=nixos-config`; `grant` prints a `security.sudo.extraRules`
# snippet with the same `NOTAFTER` deadline, or none for `indefinite`. If
# that detection fails or its first line cannot be read, the user half
# refuses as `system=undetected`.
# Detection runs as the user before any sudo call. A command planted on the
# caller's PATH can only choose the NixOS branch, which writes nothing and
# runs no sudo, or the normal branch, whose commands still resolve in the
# system directories alone; vgshell itself was already resolved from that PATH.
# Exit 0 on success, 1 on a refusal, 2 on a bad invocation, 3 from
# __status and __disable when no grant is active, 130 when a question is
# cancelled. docs/architecture/commands-are-data.md § System steps,
# docs/decisions/D103.
#
# /bin/bash -p rather than env: as root nothing here resolves through a
# PATH, a startup file or a function a user chose.
set -euo pipefail

# Every system path below derives from prefix, empty in production.
prefix=
safe_path="$prefix/usr/local/sbin:$prefix/usr/local/bin:$prefix/usr/sbin:$prefix/usr/bin:$prefix/sbin:$prefix/bin:$prefix/run/current-system/sw/bin"
# Only the NixOS package-manager check reads the caller's PATH.
caller_path="${PATH-}"
# In either half a bare command resolves in the system directories alone,
# so no checkout or user-writable directory supplies sudo, gum or visudo.
export PATH="$safe_path"
umask 022

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
lib_dir="${self%/*}/lib"
installed="$prefix/usr/local/bin/vgs-sudo-grant"
sudoers_d="$prefix/etc/sudoers.d"
tmpfiles_d="$prefix/etc/tmpfiles.d"
boot_file="$tmpfiles_d/vgs-sudo-grant.conf"
# The boot cleanup's one active line, as systemd-tmpfiles reads it: remove
# every timed grant's file at boot only, since the expiry timer does not
# survive a reboot. An indefinite grant's name falls outside its glob.
boot_rule='r! /etc/sudoers.d/99-vgs-nopasswd-*'
lock_file="$prefix/run/vgs-sudo-grant.lock"
default_duration=15
max_minutes=1440
status_inactive=3
# Digit classes spelled out: a range follows the collation of the locale
# the user half keeps.
digit='[0123456789]'
nonzero='[123456789]'

say() { printf 'vgs-sudo-grant: %s\n' "$@" >&2; }
refuse() { # STATUS FIRST_LINE [ENGLISH...]
  local status="$1"
  printf 'vgs-sudo-grant: refused: %s\n' "$2" >&2
  shift 2
  (($# == 0)) || printf '%s\n' "$@" >&2
  exit "$status"
}
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self" >&2; }
bad_invocation() { # FIRST_LINE
  printf 'vgs-sudo-grant: refused: %s\n' "$1" >&2
  usage
  exit 2
}

# Whether MINUTES is a whole number from 1 to max_minutes.
minutes_valid() { # MINUTES
  [[ $1 =~ ^0*$nonzero$digit{0,3}$ ]] && ((10#$1 <= max_minutes))
}

# Whether DURATION is minutes_valid or `indefinite`.
duration_valid() { # DURATION
  [[ $1 == indefinite ]] || minutes_valid "$1"
}

# The active lines of a tmpfiles file: every line that is not blank or a comment.
boot_lines() { # FILE
  awk '!/^[[:space:]]*(#|$)/ { print }' "$1"
}

rule_path() { printf '%s/99-vgs-nopasswd-%s' "$sudoers_d" "$1"; }
permanent_path() { printf '%s/99-vgs-permanent-nopasswd-%s' "$sudoers_d" "$1"; }
timer_unit() { printf 'vgs-sudo-grant-expire-%s' "$1"; }

# The UTC deadline D, YYYYMMDDHHMMSSZ, as ISO 8601.
iso() { # D
  printf '%s-%s-%sT%s:%s:%sZ' "${1:0:4}" "${1:4:2}" "${1:6:2}" "${1:8:2}" "${1:10:2}" "${1:12:2}"
}

# Sets expires and deadline for a grant MINUTES from the current wall clock.
deadline_for_minutes() { # MINUTES
  local now
  now="$(date +%s)" || refuse 1 "clock=unreadable"
  [[ $now =~ ^[0-9]+$ ]] || refuse 1 "clock=malformed value=$(printf '%q' "$now")"
  expires=$((now + $1 * 60))
  deadline="$(date -u -d "@$expires" +%Y%m%d%H%M%SZ)" || refuse 1 "deadline=unreadable"
  [[ $deadline =~ ^[0-9]{14}Z$ ]] || refuse 1 "deadline=malformed value=$(printf '%q' "$deadline")" "sudo reads NOTAFTER as YYYYMMDDHHMMSSZ"
}

# ---------------------------------------------------------------- root half

# Runs this file again under an environment of PATH, LC_ALL and SUDO_UID
# alone, unless the environment it was started with holds nothing else.
# bash -p ignores BASH_ENV and exported functions itself; visudo,
# systemd-run and every other child would still receive them.
sanitize() { # ARGS...
  local entry
  local -a entries
  mapfile -d '' -t entries <"/proc/$$/environ" || refuse 1 "environment=unreadable"
  for entry in "${entries[@]}"; do
    case "${entry%%=*}" in
      PATH|LC_ALL|SUDO_UID) ;;
      *) exec env -i PATH="$safe_path" LC_ALL=C SUDO_UID="${SUDO_UID:-}" "$BASH" -p -- "$self" "$@" ;;
    esac
  done
}

# Whether PATH is a real directory or regular file root owns that only root can write.
trusted() { # PATH
  local info
  [[ (-d $1 || -f $1) && ! -L $1 ]] || return 1
  info="$(stat -c '%u %a' -- "$1")" || return 1
  [[ $info == "0 "* ]] && (((8#${info#* } & 8#022) == 0))
}

# The uid the root half acts for: a uid other than root's, and the one sudo
# names as its caller, so a user can grant or revoke only for themselves.
caller() { # UID
  [[ $1 =~ ^$nonzero$digit{0,9}$ ]] && (($1 <= 4294967294)) || bad_invocation "uid=$(printf '%q' "$1")"
  [[ ${SUDO_UID:-} == "$1" ]] || refuse 1 "caller=mismatch uid=$1 sudo-uid=${SUDO_UID:-none}" "the root half acts only for the user who ran sudo"
}

# Sets account to UID's login name. sudoers reads an upper-case word as an
# alias and gives meaning to many other characters, so only a lower-case
# portable name is written into a rule.
resolve_account() { # UID
  local entry name uid_field
  entry="$(getent passwd "$1")" || refuse 1 "account=unknown uid=$1"
  IFS=: read -r name _ uid_field _ <<<"$entry"
  [[ $uid_field == "$1" ]] || refuse 1 "account=mismatch uid=$1"
  [[ $name =~ ^[a-z_][a-z0-9_-]{0,31}\$?$ ]] || refuse 1 "account=unsupported name=$(printf '%q' "$name")" "a grant is written only for a lower-case portable login name"
  account="$name"
}

with_lock() { # FUNCTION ARGS...
  trusted "$prefix/run" || refuse 1 "untrusted=$prefix/run"
  exec 9>>"$lock_file" || refuse 1 "lock=open path=$lock_file"
  flock -w 60 9 || refuse 1 "lock=busy path=$lock_file" "another grant action held the lock for 60 s"
  "$@"
}

# Stops UNIT's timer and service; one that is not loaded counts as stopped.
stop_unit() { # UNIT
  local part status
  for part in timer service; do
    status=0
    systemctl stop "$1.$part" >/dev/null 2>&1 || status=$?
    ((status == 0 || status == 5)) || return 1
  done
}

# Reads UID's rule: returns 0 with grant_deadline set while it is active,
# status_inactive when there is none or it expired, which removes it, and 1
# for a rule that is not a root-owned file of this file's one form for
# account.
read_grant() { # UID
  local file contents now
  file="$(rule_path "$1")"
  [[ -e $file || -L $file ]] || return "$status_inactive"
  trusted "$file" && [[ -f $file ]] || return 1
  contents="$(<"$file")" || return 1
  [[ $contents =~ ^([a-z_][a-z0-9_-]*\$?)\ ALL=\(ALL\)\ NOTAFTER=([0-9]{14}Z)\ NOPASSWD:\ ALL$ ]] || return 1
  [[ ${BASH_REMATCH[1]} == "$account" ]] || return 1
  grant_deadline="${BASH_REMATCH[2]}"
  now="$(date -u +%Y%m%d%H%M%SZ)" || return 1
  [[ $now =~ ^[0-9]{14}Z$ ]] || return 1
  [[ $now < $grant_deadline ]] && return 0
  rm -f -- "$file" || return 1
  return "$status_inactive"
}

# Reads UID's indefinite rule: returns 0 while it is a root-owned file of
# this file's one form for account, status_inactive when there is none,
# and 1 for anything else at its path.
read_permanent() { # UID
  local file contents
  file="$(permanent_path "$1")"
  [[ -e $file || -L $file ]] || return "$status_inactive"
  trusted "$file" && [[ -f $file ]] || return 1
  contents="$(<"$file")" || return 1
  [[ $contents == "$account ALL=(ALL) NOPASSWD: ALL" ]]
}

# Sets grant to UID's active grant: `indefinite`, `deadline=<deadline>` or
# `none`. Refuses a rule at either path it cannot read as its own.
current_grant() { # UID
  local status=0
  read_permanent "$1" || status=$?
  case "$status" in
    0) grant=indefinite; return ;;
    "$status_inactive") ;;
    *) refuse 1 "grant=malformed path=$(permanent_path "$1")" "vgshell sudo revoke removes it" ;;
  esac
  status=0
  read_grant "$1" || status=$?
  case "$status" in
    0) grant="deadline=$grant_deadline" ;;
    "$status_inactive") grant=none ;;
    *) refuse 1 "grant=malformed path=$(rule_path "$1")" "vgshell sudo revoke removes it" ;;
  esac
}

root_status() { # UID
  resolve_account "$1"
  current_grant "$1"
  if [[ $grant == none ]]; then
    printf 'inactive\n'
    exit "$status_inactive"
  fi
  printf 'active %s\n' "$grant"
}

# Undoes what an __enable that stops early set up: the staged file, a rule
# it published and the timer it armed.
enable_undo() {
  local status=$?
  trap - EXIT
  [[ -z $enable_staged ]] || rm -f -- "$enable_staged" || say "cleanup=failed path=$enable_staged"
  [[ -z $enable_file ]] || rm -f -- "$enable_file" || say "cleanup=failed path=$enable_file" "the timer still removes it at the deadline"
  [[ -z $enable_unit ]] || stop_unit "$enable_unit" || say "cleanup=failed unit=$enable_unit"
  exit "$status"
}

# A timed DURATION publishes its NOTAFTER rule only once its expiry is
# armed; `indefinite` publishes the rule with no deadline and arms nothing.
root_enable() { # UID DURATION
  local uid="$1" duration="$2" now expires deadline file unit rule
  resolve_account "$uid"
  trusted "$tmpfiles_d" && trusted "$boot_file" && [[ $(boot_lines "$boot_file") == "$boot_rule" ]] ||
    refuse 1 "boot-cleanup=absent path=$boot_file" "vgshell sudo install places it"
  trusted "$sudoers_d" || refuse 1 "untrusted=$sudoers_d"
  unit="$(timer_unit "$uid")"
  current_grant "$uid"
  [[ $grant == none ]] || refuse 1 "grant=active $grant" "vgshell sudo revoke ends it first"
  if [[ $duration == indefinite ]]; then
    file="$(permanent_path "$uid")"
    rule="$account ALL=(ALL) NOPASSWD: ALL"
  else
    file="$(rule_path "$uid")"
    deadline_for_minutes "$((10#$duration))"
    rule="$account ALL=(ALL) NOTAFTER=$deadline NOPASSWD: ALL"
  fi
  enable_staged="" enable_file="" enable_unit=""
  trap enable_undo EXIT
  # The dot keeps sudo from reading the file before the rename publishes it whole.
  enable_staged="$(mktemp -- "$sudoers_d/.vgs-nopasswd.XXXXXX")" || refuse 1 "staging=$sudoers_d"
  printf '%s\n' "$rule" >"$enable_staged" || refuse 1 "write=$enable_staged"
  { chown root:root -- "$enable_staged" && chmod 0440 -- "$enable_staged"; } || refuse 1 "mode=$enable_staged"
  visudo -cqf "$enable_staged" >/dev/null || refuse 1 "rule=refused" "visudo rejected the rule; nothing was published"
  if [[ $duration != indefinite ]]; then
    stop_unit "$unit" || refuse 1 "timer=stop-failed unit=$unit"
    enable_unit="$unit"
    systemd-run --quiet --collect --on-calendar="@$expires" --timer-property=AccuracySec=1s \
      --unit="$unit" -- "$prefix/usr/bin/rm" -f -- "$file" >/dev/null || refuse 1 "timer=arm-failed unit=$unit"
    systemctl is-active --quiet "$unit.timer" || refuse 1 "timer=inactive unit=$unit"
  fi
  mv -fT -- "$enable_staged" "$file" || refuse 1 "publish=$file"
  enable_staged="" enable_file="$file"
  if [[ $duration != indefinite ]]; then
    now="$(date +%s)" && ((now < expires)) || refuse 1 "deadline=passed" "the grant expired while it was written"
  fi
  enable_file="" enable_unit=""
  trap - EXIT
  if [[ $duration == indefinite ]]; then printf 'active indefinite\n'; else printf 'active deadline=%s\n' "$deadline"; fi
}

root_disable() { # UID
  local file unit removed=0
  unit="$(timer_unit "$1")"
  stop_unit "$unit" || refuse 1 "timer=stop-failed unit=$unit"
  for file in "$(rule_path "$1")" "$(permanent_path "$1")"; do
    [[ -e $file || -L $file ]] || continue
    [[ ! -d $file || -L $file ]] || refuse 1 "grant=not-a-file path=$file"
    rm -f -- "$file" || refuse 1 "remove=$file"
    removed=1
  done
  if ((removed == 0)); then
    printf 'inactive\n'
    exit "$status_inactive"
  fi
  printf 'revoked\n'
}

root_main() {
  [[ $- == *p* ]] || refuse 2 "startup=unprivileged" "the root half runs as #!/bin/bash -p"
  sanitize "$@"
  export LC_ALL=C
  case "${1:-}:$#" in
    __status:2) caller "$2"; with_lock root_status "$2" ;;
    __enable:3)
      caller "$2"
      duration_valid "$3" || bad_invocation "duration=$(printf '%q' "$3")"
      with_lock root_enable "$2" "$3"
      ;;
    __disable:2) caller "$2"; with_lock root_disable "$2" ;;
    status:*|grant:*|revoke:*|install:*|uninstall:*)
      refuse 1 "root=$1" "run vgshell sudo $1 as your own user; sudo asks for the password"
      ;;
    *) bad_invocation "argument=$(printf '%q' "${1-}") count=$#" ;;
  esac
}

# ---------------------------------------------------------------- user half

# Reads the package-manager table the same way `vgshell pkg detect` does, and
# sets detected_system to the first line's primary id or none.
detect_system() {
  local first status=0
  system_detect_output="$(env PATH="$caller_path" node "${self%/*}/vgshell-pkg" detect 2>&1)" || status=$?
  system_detect_status="$status"
  first="${system_detect_output%%$'\n'*}"
  if ((status != 0)); then
    detected_system=
    return 1
  fi
  if [[ $first == primary=none ]]; then
    detected_system=none
    return 0
  fi
  if [[ $first =~ ^primary=([a-z][a-z0-9_-]*)\ binary=.+$ ]]; then
    detected_system="${BASH_REMATCH[1]}"
    return 0
  fi
  detected_system=
  return 1
}

detect_or_refuse() {
  if detect_system; then return; fi
  if [[ -n $system_detect_output ]]; then
    refuse 1 "system=undetected exit=$system_detect_status" "$system_detect_output"
  fi
  refuse 1 "system=undetected exit=$system_detect_status" "the package manager detector printed no first line"
}

nixos_status() {
  printf 'sudo-grant=skipped=nixos-config\n'
}

# The security.sudo.extraRules snippet that grants account COMMAND.
nixos_snippet() { # COMMAND
  printf 'Add this rule to your system configuration, then run nixos-rebuild switch:\n'
  printf 'security.sudo.extraRules = [\n'
  printf '  {\n'
  printf '    users = [ "%s" ];\n' "$account"
  printf '    runAs = "ALL";\n'
  printf '    commands = [ "%s" ];\n' "$1"
  printf '  }\n'
  printf '];\n'
}

nixos_grant() { # [DURATION]
  local duration="${1:-$default_duration}" expires deadline
  resolve_account "$uid"
  if [[ $duration == indefinite ]]; then
    printf 'ok sudo-grant=skipped=nixos-config until=indefinite\n'
    printf 'NixOS builds /etc from its configuration, so VGS writes no sudo rule here.\n'
    printf 'WARNING: until you remove the rule, ANY process running as %s can run ANY command as root WITHOUT a password.\n' "$account"
    printf 'Anything with access to your account gets full root for that time.\n'
    nixos_snippet "NOPASSWD: ALL"
    printf 'The rule stays in the configuration, across restarts, until you remove it.\n'
    printf 'Remove it and run nixos-rebuild switch to end it.\n'
    return
  fi
  deadline_for_minutes "$((10#$duration))"
  printf 'ok sudo-grant=skipped=nixos-config minutes=%s until=%s\n' "$((10#$duration))" "$(iso "$deadline")"
  printf 'NixOS builds /etc from its configuration, so VGS writes no sudo rule here.\n'
  printf 'WARNING: until %s, ANY process running as %s can run ANY command as root WITHOUT a password.\n' "$(iso "$deadline")" "$account"
  printf 'Anything with access to your account gets full root for that time.\n'
  nixos_snippet "NOTAFTER=$deadline NOPASSWD: ALL"
  printf 'sudo refuses the rule after %s.\n' "$(iso "$deadline")"
  printf 'The rule stays in the configuration until you remove it.\n'
  printf 'Remove it and run nixos-rebuild switch to end it early or once it expired.\n'
}

nixos_revoke() {
  printf 'ok sudo-grant=skipped=nixos-config\n'
  printf 'VGS wrote no rule on NixOS. Remove the rule from security.sudo.extraRules and run nixos-rebuild switch.\n'
}

nixos_install() {
  printf 'ok sudo-grant=skipped=nixos-config\n'
  printf 'Nothing is installed because NixOS sudo rules come from its configuration. Run vgshell sudo grant to print the rule.\n'
}

nixos_uninstall() {
  printf 'ok sudo-grant=skipped=nixos-config\n'
  printf 'Nothing is removed because NixOS sudo rules come from its configuration. Run vgshell sudo grant to print the rule.\n'
}

# Drops any cached sudo credential now and again when this command ends.
cold_sudo() {
  sudo -k || refuse 1 "sudo=reset-failed"
  trap 'sudo -k || say "sudo=revoke-failed" "the sudo credential may still be cached; run sudo -k"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# The root half runs through `sudo -N`, which leaves no timestamp behind.
needs_no_update() {
  local help
  help="$(LC_ALL=C sudo -h 2>&1)" || refuse 1 "sudo=help-failed"
  grep -Eq '^usage: sudo .*\[[^]]*N[^]]*\]' <<<"$help" ||
    refuse 1 "sudo=no-update-unsupported" "this sudo has no -N (--no-update), which the grant needs"
}

requires_installed() {
  [[ -x $installed ]] || refuse 1 "root-half=absent path=$installed" "vgshell sudo install places it"
}

# `current` when the installed root half is this file byte for byte, else `stale`.
root_half_state() {
  local status=0
  cmp -s -- "$self" "$installed" || status=$?
  case "$status" in
    0) echo current ;;
    1) echo stale ;;
    *) refuse 1 "root-half=unreadable path=$installed" ;;
  esac
}

# Runs one root-half action through sudo -N. Sets reply to its stdout and
# reply_status to its exit status.
root_half() { # ACTION ARGS...
  reply_status=0
  reply="$(sudo -N -- "$installed" "$@" </dev/null)" || reply_status=$?
}

# Sets deadline from the root half's `active` reply to __enable DURATION,
# refusing any other reply.
enabled_reply() { # DURATION
  if [[ $1 == indefinite ]]; then
    [[ $reply_status == 0 && $reply == 'active indefinite' ]] ||
      refuse 1 "enable=failed exit=$reply_status reply=$(printf '%q' "$reply")"
    return
  fi
  [[ $reply_status == 0 && $reply =~ ^active\ deadline=($digit{14})Z$ ]] ||
    refuse 1 "enable=failed exit=$reply_status reply=$(printf '%q' "$reply")"
  deadline="${BASH_REMATCH[1]}Z"
}

# The lines LISTING, `sudo -l -l` output, holds under FILE's `Sudoers
# entry:` line, that line first, up to the next entry; nothing when sudo
# did not list FILE.
listed_entry() { # LISTING FILE
  awk -v want="Sudoers entry: $2" '/^Sudoers entry: / { on = ($0 == want) } on { print }' <<<"$1"
}

# Sets state to active or inactive and, while active, until to the ISO
# deadline or `indefinite`, from the caller's own rules as `sudo -n -l -l`
# lists them, which neither asks nor elevates (the header states how sudo
# answers). A listed entry for either grant's file that is not of its
# form is refused, as the root half refuses that file.
listed_grant() {
  local listing status=0 entry line deadline="" now
  listing="$(LC_ALL=C sudo -n -l -l </dev/null 2>&1)" || status=$?
  if [[ $status == 1 && $listing == 'sudo: a password is required' ]]; then
    state=inactive
    return
  fi
  [[ $status == 0 ]] || refuse 1 "status=unreadable exit=$status reply=$(printf '%q' "${listing%%$'\n'*}")"
  grep -q '^Sudoers entry: ' <<<"$listing" ||
    refuse 1 "sudo=unsupported" "this sudo names no Sudoers entry when it lists rules, which the status read needs"
  entry="$(listed_entry "$listing" "$(permanent_path "$uid")")"
  if [[ -n $entry ]]; then
    [[ $entry != *NotAfter:* ]] || refuse 1 "grant=malformed path=$(permanent_path "$uid")" "vgshell sudo revoke removes it"
    state=active until=indefinite
    return
  fi
  state=inactive
  entry="$(listed_entry "$listing" "$(rule_path "$uid")")"
  [[ -n $entry ]] || return 0
  while IFS= read -r line; do
    if [[ $line =~ ^\ +NotAfter:\ ($digit{14}Z)$ ]]; then deadline="${BASH_REMATCH[1]}"; fi
  done <<<"$entry"
  [[ -n $deadline ]] || refuse 1 "grant=malformed path=$(rule_path "$uid")" "vgshell sudo revoke removes it"
  now="$(date -u +%Y%m%d%H%M%SZ)" || refuse 1 "clock=unreadable"
  [[ $now =~ ^$digit{14}Z$ ]] || refuse 1 "clock=malformed value=$(printf '%q' "$now")"
  if [[ $now < $deadline ]]; then
    state=active until="$(iso "$deadline")"
  fi
}

user_status() {
  local half state until
  if [[ ! -e $installed && ! -L $installed ]]; then
    printf 'sudo-grant=inactive root-half=absent\n'
    return
  fi
  requires_installed
  half="$(root_half_state)"
  listed_grant
  case "$state" in
    active) printf 'sudo-grant=active until=%s root-half=%s\n' "$until" "$half" ;;
    inactive) printf 'sudo-grant=inactive root-half=%s\n' "$half" ;;
  esac
}

user_revoke() {
  requires_installed
  needs_no_update
  cold_sudo
  root_half __disable "$uid"
  case "$reply_status:$reply" in
    0:revoked) printf 'ok sudo-grant=revoked\n' ;;
    "$status_inactive:inactive") printf 'ok sudo-grant=inactive\n' ;;
    *) refuse 1 "revoke=failed exit=$reply_status reply=$(printf '%q' "$reply")" ;;
  esac
}

# The words the question shows for DURATION, as `grant` normalizes it.
duration_label() { # DURATION
  case "$1" in
    indefinite) echo Indefinitely ;;
    1) echo "1 minute" ;;
    60) echo "1 hour" ;;
    1440) echo "1 day" ;;
    *) echo "$1 minutes" ;;
  esac
}

# Asks how long the grant lasts, starting on DURATION, and sets duration to
# the answer: 15 minutes, 1 hour, 1 day and Indefinitely, with DURATION
# in minute order when it is another number of minutes.
choose_duration() { # DURATION
  local values=() labels=() value answer status=0 placed=false i
  for value in 15 60 1440; do
    if [[ $1 != indefinite && $placed == false ]] && (($1 <= value)); then
      (($1 == value)) || values+=("$1")
      placed=true
    fi
    values+=("$value")
  done
  values+=(indefinite)
  for value in "${values[@]}"; do labels+=("$(duration_label "$value")"); done
  answer="$(vgs_tui_choose --header "Turn on passwordless sudo for how long?" --selected "$(duration_label "$1")" "${labels[@]}")" || status=$?
  case "$status" in
    0) ;;
    1) refuse 1 "declined=grant" "No change made." ;;
    *) exit "$status" ;;
  esac
  for i in "${!labels[@]}"; do
    if [[ ${labels[i]} == "$answer" ]]; then
      duration="${values[i]}"
      return
    fi
  done
  refuse 1 "choice=unknown value=$(printf '%q' "$answer")"
}

# Asks QUESTION, defaulting to no; anything but yes ends the grant.
confirm_grant() { # QUESTION
  local answer=0
  # A root grant is never answered for the user, unattended or not.
  VGS_TUI_UNATTENDED='' vgs_tui_confirm "$1" --default=false || answer=$?
  case "$answer" in
    0) ;;
    1) refuse 1 "declined=grant" "No change made." ;;
    *) exit "$answer" ;;
  esac
}

# Sets template to the boot cleanup this file ships, refusing one that is
# not the one line.
boot_template() {
  template="$lib_dir/tmpfiles.d/vgs-sudo-grant.conf"
  [[ -f $template ]] || refuse 1 "template=missing path=$template"
  [[ $(boot_lines "$template") == "$boot_rule" ]] || refuse 1 "template=malformed path=$template"
}

# Prints what the install places, then places the boot cleanup, from
# boot_template, and then the root half through sudo, which asks for the
# password.
place_root_half() {
  printf 'vgshell sudo install places, as root:\n'
  printf '  %s  the boot cleanup: %s\n' "$boot_file" "$boot_rule"
  printf '  %s  the root half vgshell sudo grant runs through sudo\n' "$installed"
  printf 'sudo asks for your password.\n'
  sudo install -m 0644 -o root -g root -T -- "$template" "$boot_file" </dev/null || refuse 1 "install=boot-cleanup path=$boot_file"
  sudo install -m 0755 -o root -g root -T -- "$self" "$installed" </dev/null || refuse 1 "install=root-half path=$installed"
}

user_grant() { # [DURATION]
  local duration="${1:-$default_duration}" user half=absent label template
  [[ $duration == indefinite ]] || duration="$((10#$duration))"
  needs_no_update
  # shellcheck source=lib/tui.sh
  source "$lib_dir/tui.sh" || refuse 1 "library=missing path=$lib_dir/tui.sh"
  user="$(id -un)" || refuse 1 "user=unknown"
  cold_sudo
  if [[ -e $installed || -L $installed ]]; then half="$(root_half_state)"; fi
  if [[ $half != current ]]; then
    vgs_tui_step "Setting up passwordless sudo"
    boot_template
    place_root_half
  fi
  listed_grant
  if [[ $state == active ]]; then
    vgs_tui_step "Revoking passwordless sudo"
    root_half __disable "$uid"
    [[ $reply_status == 0 && $reply == revoked ]] || refuse 1 "revoke=failed exit=$reply_status reply=$(printf '%q' "$reply")"
    printf 'ok sudo-grant=revoked\n'
    printf 'Sudo asks for your password again.\n'
    return
  fi
  choose_duration "$duration"
  if [[ $duration == indefinite ]]; then
    vgs_tui_warn "WARNING: until you turn it off, ANY process running as $user can run"
    vgs_tui_warn "ANY command as root WITHOUT a password. Anything with access to your"
    vgs_tui_warn "account gets full root for that time."
    vgs_tui_warn "It stays on after a restart. Run this again, or vgshell sudo revoke, to end it."
    confirm_grant "Enable passwordless sudo until you turn it off? This is a significant security risk!"
    confirm_grant "Passwordless sudo stays on after a restart, until you turn it off. Turn it on anyway?"
  else
    label="$(duration_label "$duration")"
    vgs_tui_warn "WARNING: for $label, ANY process running as $user can run"
    vgs_tui_warn "ANY command as root WITHOUT a password. Anything with access to your"
    vgs_tui_warn "account gets full root for that time."
    vgs_tui_warn "The grant ends by itself after $label, and at the next boot if the"
    vgs_tui_warn "machine restarts first. Run this again, or vgshell sudo revoke, to end it early."
    confirm_grant "Enable passwordless sudo for $label? This is a significant security risk!"
  fi
  root_half __enable "$uid" "$duration"
  enabled_reply "$duration"
  # A credential the install or the enable cached would pass the check
  # below whether or not sudo honours the rule.
  sudo -k || refuse 1 "sudo=reset-failed before=check"
  if ! sudo -n -N -- /usr/bin/true </dev/null >/dev/null 2>&1; then
    root_half __disable "$uid"
    refuse 1 "grant=not-effective revoke-exit=$reply_status" "sudo did not honour the rule; its configuration may not read /etc/sudoers.d"
  fi
  if [[ $duration == indefinite ]]; then
    printf 'ok sudo-grant=enabled until=indefinite\n'
    printf 'Passwordless sudo is on until you turn it off, also after a restart. Run this again, or vgshell sudo revoke, to end it.\n'
    return
  fi
  printf 'ok sudo-grant=enabled minutes=%s until=%s\n' "$duration" "$(iso "$deadline")"
  printf 'Passwordless sudo is on until %s. Run this again, or vgshell sudo revoke, to end it early.\n' \
    "$(date -d "$(iso "$deadline")" '+%H:%M %Z')"
}

user_install() {
  local template
  boot_template
  trap 'sudo -k || say "sudo=revoke-failed"' EXIT
  place_root_half
  printf 'ok sudo-grant=installed root-half=%s boot-cleanup=%s\n' "$installed" "$boot_file"
}

user_uninstall() {
  trap 'sudo -k || say "sudo=revoke-failed"' EXIT
  if [[ -e $installed || -L $installed ]]; then
    reply_status=0
    reply="$(sudo -- "$installed" __disable "$uid" </dev/null)" || reply_status=$?
    [[ $reply_status == 0 || $reply_status == "$status_inactive" ]] ||
      refuse 1 "revoke=failed exit=$reply_status" "the root half stays until the grant is revoked"
  fi
  if [[ -e $boot_file || -L $boot_file ]]; then
    sudo systemd-tmpfiles --remove --boot -- "$boot_file" </dev/null ||
      refuse 1 "uninstall=grants path=$boot_file" "the root half and the boot cleanup stay until every grant is removed"
  fi
  # sudoers.d is root's alone, so root expands the indefinite grants' name.
  sudo find "$sudoers_d" -maxdepth 1 -name '99-vgs-permanent-nopasswd-*' ! -type d -delete </dev/null ||
    refuse 1 "uninstall=indefinite-grants path=$sudoers_d" "the root half and the boot cleanup stay until every grant is removed"
  sudo rm -f -- "$installed" </dev/null || refuse 1 "uninstall=root-half path=$installed"
  sudo rm -f -- "$boot_file" </dev/null || refuse 1 "uninstall=boot-cleanup path=$boot_file"
  printf 'ok sudo-grant=uninstalled\n'
}

user_main() {
  local verb="${1:-}"
  (($# == 0)) || shift
  case "$verb" in
    status|revoke|install|uninstall) (($# == 0)) || bad_invocation "argument=$(printf '%q' "$1")" ;;
    grant)
      (($# <= 1)) || bad_invocation "argument=$(printf '%q' "$2")"
      (($# == 0)) || duration_valid "$1" || bad_invocation "duration=$(printf '%q' "$1")"
      ;;
    *) bad_invocation "verb=$(printf '%q' "$verb")" ;;
  esac
  uid="$(id -u)" || refuse 1 "user=unknown"
  detect_or_refuse
  if [[ $detected_system == nix ]]; then
    "nixos_$verb" "$@"
    return
  fi
  "user_$verb" "$@"
}

if ((EUID == 0)); then root_main "$@"; else user_main "$@"; fi
