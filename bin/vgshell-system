#!/usr/bin/env bash
# vgshell-system: the system steps, the closed table of one-time root setup a
# plugin's status action can ask for.
#
#   vgshell-system status [--json]   probe every step and print its state
#   vgshell-system apply <step>      show the step's root commands, ask once, run them through sudo
#   vgshell-system undo <step>       show the commands that revert what VGS changed for the step,
#                                 ask once, run them through sudo
#
# The table, and nothing else, names what may change:
#
#   apple-displays       install config/system/udev/60-vgs-apple-displays.rules as
#                        /etc/udev/rules.d/60-vgs-apple-displays.rules, then
#                        `udevadm control --reload` and
#                        `udevadm trigger --subsystem-match=hidraw --action=change --settle`
#   disk-sleep           install config/system/udev/69-vgs-disk-sleep.rules in
#                        /etc/udev/rules.d, reload udev and trigger a change on
#                        whole rotational disks; a resolved absolute hdparm -S 241
#                        sets their standby timeout to 30 minutes. Its probe
#                        compares installed rule bytes only: hdparm cannot
#                        read this timeout, and the probe performs no drive
#                        action. Undo removes the rule but cannot restore an
#                        unreadable previous timer; it stays programmed until
#                        the device is reinitialized.
#   wake-sources         install config/system/udev/90-vgs-wake.rules, then reload
#                        udev and trigger USB change events; enables keyboards,
#                        mice, Bluetooth controllers and every USB hub
#   i2c-dev              `modprobe i2c-dev`, then `udevadm settle`; the ddcutil package's
#                        own udev rule and modules-load.d file grant the access and
#                        load it at boot
#   service-bluetooth    `systemctl enable --now bluetooth.service`
#   service-tailscaled   `systemctl enable --now tailscaled.service`
#   service-cups         `systemctl enable --now cups.service`; the probe reads
#                        ready while cups.service or cups.socket is active,
#                        since the socket starts the service on demand
#   service-sshd         `systemctl enable --now sshd.service`, ssh.service where
#                        that unit is installed, as Debian names it
#   tailscale-operator   `tailscale set --operator=<the caller's own login name>`; a
#                        login name outside `[a-z_][a-z0-9_-]*$?` reads this step
#                        unknown, reason user-unsupported
#   tailscale-account-add  repeatable account sign-in with the caller as operator;
#                        one TUI sudo session owns login, browser opening as the
#                        desktop user, verified completion and previous-profile
#                        recovery after cancellation or failure
#   vpn-kill-switch      install config/system/kill-switch/vgs-kill-switch as
#                        /usr/local/bin/vgs-kill-switch, mode 0755, and the
#                        same directory's vgs-kill-switch.service,
#                        vgs-kill-switch.path, vgs-kill-switch-status.socket and
#                        vgs-kill-switch-status@.service in /etc/systemd/system,
#                        mode 0644; make /var/lib/vgshell/vpn the caller's, 0755,
#                        and /var/lib/vgshell/kill-switch root's, 0700; then
#                        `systemctl daemon-reload` after a new unit file,
#                        `systemctl reset-failed` of a failed path unit or
#                        socket, `systemctl restart` of that unit and of an
#                        enabled one whose file it rewrote, and
#                        `systemctl enable --now` of the path unit, the socket
#                        and vgs-kill-switch.service, whose start applies the
#                        rule once. It reads ready while the five files hold the
#                        shipped bytes, the three units are enabled, the path
#                        unit and the socket have not failed, and both
#                        directories have those owners; denied, reason
#                        other-account, while another account owns
#                        /var/lib/vgshell/vpn; denied, reason systemd-missing or
#                        nft-missing, without systemctl or nft; and denied,
#                        reason nixos-unsupported, on NixOS. Its record holds
#                        `script=`, `sync-unit=`, `path-unit=`, `socket-unit=` and
#                        `status-unit=` <sha256> of the files, and `state-dir=1`
#                        and `cache-dir=1` for each directory it made. Undo runs
#                        `systemctl disable --now` of the three units, deletes the
#                        nftables table inet vgshell_kill_switch, refusing
#                        without nft, removes each file
#                        while its bytes hash to the record, then each directory
#                        it made
#   bandwhich-capture    grant cap_sys_ptrace, cap_dac_read_search, cap_net_raw
#                        and cap_net_admin, effective and permitted, on the
#                        resolved, root-owned bandwhich binary; undo removes
#                        the grant only from the same recorded binary
#   greeter              write /etc/greetd/vgshell.toml, a greetd configuration whose
#                        greeter, the first account of `greeter` and `_greetd`
#                        that exists, runs Hyprland with
#                        config/system/greeter/hyprland.lua and shell/greeter.qml on
#                        the VT the packaged /etc/greetd/config.toml names, else 1,
#                        and whose `[general] service` names /etc/pam.d/vgs-greeter,
#                        installed from config/system/greeter/vgs-greeter.pam; write
#                        the drop-in /etc/systemd/system/greetd.service.d/vgs.conf,
#                        whose ExecStart runs greetd with that configuration; make
#                        /var/lib/vgshell/greeter/theme, root's, 0755, with its `vgs`
#                        directory the caller's, 0755, and /var/lib/vgshell/greeter/state,
#                        the greeter account's, 0700; then `systemctl daemon-reload`
#                        after a new drop-in, `systemctl enable greetd.service`, never
#                        --now, since a start takes over the console of the running
#                        session, and `systemctl set-default graphical.target` while
#                        another target is the default, since only graphical.target
#                        starts a display manager
#   vgs-quickshell-repository  enable vanillagreen/vgshell in Fedora COPR;
#                        keep errornointernet/quickshell for cpptrace
#   voxtype-engine       `voxtype setup onnx --enable`; undo disables ONNX
#                        only while the step has a root-owned record
#   reboot-notice        link /etc/pacman.d/hooks/cachyos-reboot-required.hook to
#                        /dev/null, pacman's own override of the CachyOS hook of
#                        that name in /usr/share/libalpm/hooks, which turns its
#                        reboot notice off; make /etc/pacman.d/hooks first while
#                        it is missing
#   dns-cloudflare       Omarchy's Cloudflare choice without its global DNS= line:
#                        write /etc/systemd/resolved.conf.d/60-vgs-dns.conf with
#                        Quad9 as FallbackDNS and DNSOverTLS=opportunistic, never
#                        /etc/systemd/resolved.conf; set each Wi-Fi and Ethernet
#                        profile's ipv4.ignore-auto-dns and ipv6.ignore-auto-dns to
#                        yes and its ipv4.dns and ipv6.dns to 1.1.1.1, 1.0.0.1,
#                        2606:4700:4700::1111 and 2606:4700:4700::1001, each with
#                        the TLS name cloudflare-dns.com, past every port but a
#                        VRF's, which alone keeps IP settings; then `nmcli general
#                        reload conf`, `nmcli device reapply` of each connected
#                        Wi-Fi or Ethernet device, which only warns when
#                        NetworkManager refuses it, since the device then takes
#                        the change when it next connects, `systemctl reload
#                        systemd-resolved.service`, a restart when that fails,
#                        and `nmcli general reload dns-full`. A family whose
#                        ipvX.method takes no DNS servers keeps its two fields
#   dns-google           the same with 8.8.8.8, 8.8.4.4, 2001:4860:4860::8888 and
#                        2001:4860:4860::8844, each with the TLS name dns.google
#   dns-custom           the same with the IPv4 and IPv6 addresses typed in the
#                        step's terminal, which asks for them even while servers
#                        it set are in effect, and no DNSOverTLS line. Undo of any
#                        DNS step is the network default: it puts back each
#                        profile's recorded fields and removes the drop-in
#
# Each step's state is one of:
#
#   ready     the probe reads the access the step grants
#   needed    the probe reads it missing, and apply grants it
#   denied    the probe reads it missing, and apply cannot grant it
#   absent    the step has nothing to act on: no such device, unit or command
#   unknown   the probe could not answer; never read as ready
#   nixos     on NixOS, where the configuration grants it: needed, or a
#             service step's absent with reason unit-missing, whose
#             configuration snippet installs and enables the unit
#
# Probes read real access, never a file's presence: the hidraw node of each
# Apple display, 05ac:1114 or 05ac:9243 by the HID_ID of its sysfs device,
# opens read-write; a display-class i2c adapter's node (an ancestor's sysfs
# `class` starting 0x03, ddcutil's own match) opens read-write once the
# i2c-dev class exists; `systemctl is-active` holds for the unit; `tailscale
# get operator` names the caller. A rule VGS did not write, under any name,
# therefore reads ready when it grants the access. The greeter compares
# bytes instead: it reads ready when the three files hold the bytes apply
# would write now, its directories exist, greetd.service is enabled and
# graphical.target is the default; a greetd set up another way
# reads needed. It reads absent while greetd.service, greetd,
# Hyprland or the greeter account is missing; denied, reason
# other-display-manager, while display-manager.service names another unit,
# which apply never disables; denied, reason install-path-unsupported, for
# an install path outside `[A-Za-z0-9._/+-]`; denied, reason
# install-untrusted, unless the install tree, every directory above it, its
# shell, config/system/greeter and plugin directories and the files greetd
# and Hyprland start are root's and writable by no one else, since the
# greeter account runs them where every password is typed; and denied,
# reason other-account, while another account owns the theme copy's
# directory. On NixOS it reads ready once display-manager.service names
# greetd.service and the snippet's directories exist with their owners.
# The reboot notice reads the link itself, since pacman acts on the link:
# ready, reason notice-off, while a link to /dev/null that VGS's record
# names is there; denied, reason foreign-link, for a link to /dev/null
# without that record; needed while nothing is; denied, reason
# foreign-file, for any other file or link, which apply and undo never
# touch; absent, reason hook-missing, without the CachyOS hook.
# A DNS step reads NetworkManager's Wi-Fi and Ethernet profiles: ready,
# reason in-effect, while its drop-in and every such profile hold what it
# sets and the record names its provider; needed, reason foreign, while a
# profile carries servers that no provider VGS recorded set; needed,
# reason partial, while the recorded provider misses a profile, a network
# joined after the choice included, or its drop-in; needed, reason
# not-set, otherwise; denied, reason foreign-dropin, for a file at the
# drop-in VGS did not write; absent without nmcli, a running
# NetworkManager or a Wi-Fi or Ethernet profile; and unknown while
# systemd-resolved is inactive or /etc/resolv.conf is no link to its stub.
#
# `status` prints one `system=<step> state=<state> reason=<key>` line per
# step in table order; `--json` prints one line, the text the shell's
# SystemSteps owner reads:
#   {"steps":{"<step>":{"state":"<state>","reason":"<key>"},...}}
# with every step of the table. Each reason is a key of lower case letters
# and dashes. status exits 0 whatever the states are.
#
# `apply` probes the step first: `ready` prints `ok system=<step>
# state=ready` and runs nothing; `denied`, `absent` and `unknown` refuse as
# `state=<state> reason=<key>`. For `needed` it prints each exact root
# command, every program named by its path in the system directories,
# then asks one question, which VGS_TUI_UNATTENDED never answers, and only
# after a yes starts one sudo session (bin/lib/tui.sh's
# vgs_tui_sudo_session). Nothing is written and no sudo runs before the
# answer. It then holds a flock on the record directory, plans again and
# refuses `plan=changed` if the plan differs from the one shown, writes the
# step's record, runs the commands, and probes again: `ok system=<step>
# state=ready`, or a refusal naming the state still read.
#
# The record: /var/lib/vgshell/system/<step>, root's, one `key=value` per line,
# written before the step's commands run, so a command that fails partway
# leaves what it may have changed on record. `uid` is the caller's, and
# each step records only what it changed: `rule=<sha256>` of the rule it
# installs; `loaded=1` with the `boot` id for the module it loaded;
# `enabled=1` for a unit that was not enabled, `started=1` with the `boot`
# id for one that was not active; `config=`, `pam=` and `dropin=` <sha256> of the
# greeter's files, `enabled=1` when greetd.service was not enabled,
# `target=<unit>` for the default target it replaced, and `dropin-dir=1`,
# `greeter-dir=1`, `theme-dir=1`, `copy-dir=1` and `state-dir=1` for each
# directory it made; `link=1` for the reboot notice's link and `hooks-dir=1`
# when it made the hooks directory. The three DNS steps share the record
# `dns`: `provider=` the step's, `ipv4=` and `ipv6=` the custom servers,
# `dropin=<sha256>`, `dropin-dir=1` when it made resolved.conf.d, and one
# `profile-<uuid>=<ipv4.ignore-auto-dns> <ipv4.dns> <ipv6.ignore-auto-dns>
# <ipv6.dns>` per Wi-Fi and Ethernet profile, `-` for no servers, as the
# profile held them before VGS first changed it; a later provider keeps
# them. While a change of provider runs, `prior-<uuid>=<ipv4.dns>
# <ipv6.dns>` names the servers an earlier provider set on a profile not
# yet changed, so a change that stops part way still reads them as VGS's;
# the record drops it once every profile holds the new servers. Undo
# restores a profile only while it still holds what the recorded provider
# set, or its `prior-` servers. `undo` reverts only that: it removes the rule
# and the greeter's files only while their bytes still hash to the record,
# the reboot notice's link only while it still links to /dev/null,
# unloads the module and stops the unit only in the boot that changed
# them, disables only a unit it enabled, restores the default target only
# while graphical.target is still the default, removes only the
# directories it made, resets the operator only while it still names the
# recorded user, and refuses a record another uid wrote. greetd reads its
# configuration only when it starts, so while greetd.service is active
# undo of the greeter keeps the PAM service and the directories on record,
# with `deferred=<boot>`, prints `ok system=greeter state=deferred`, and a
# later undo removes them once greetd is inactive or a later boot started
# it. With no record it prints
# `ok system=<step> state=untouched` and runs nothing.
#
# Tailscale records are version 2 JSON owned by lib/tailscale-account.py:
# tailscale-operator keeps uid and operator/previous grants keyed by the daemon's
# saved profile ID. Its old uid/operator/previous file migrates in place on first
# transaction read, retaining the grant as unbound because no historical profile
# ID exists; that entry can never authorize undo on the current profile.
# tailscale-account-add retains the previous profile, operator and WantRunning
# before login starts, and remains after failed recovery for the next press to
# retry. Success and verified recovery remove it. Add reports ready only for an
# authenticated Running profile, or a distinct needs-approval completion for an
# authenticated profile whose administrator must approve the device.
#
# A destination the table names is refused when it is a symbolic link, and
# a file at it whose bytes no record of VGS's hashes to is refused as
# foreign, never overwritten: /etc/greetd/config.toml and /etc/pam.d/greetd
# are never among them. The reboot notice's link is the one link the table
# writes, and any other file or link at its path is foreign. A directory the commands write into, and a record,
# must be root's and writable by no one else.
#
# On NixOS, detected through the package-manager table when a step reads
# needed or a service unit is missing and whenever the greeter is probed, `needed`
# and a service step's `absent` with reason `unit-missing` read `nixos`, `apply` prints `ok system=<step>
# skipped=nixos-config` and the configuration snippet, and `undo` prints
# `ok system=<step> skipped=nixos-config`; neither writes or runs sudo. A
# detection that fails reads a needed step `unknown`, reason
# `system-undetected`, leaves a missing unit `absent`, and refuses apply and
# undo as `system=undetected`, or apply of a missing unit as `state=absent`.
#
# Every refusal prints one keyed line first: `vgs-system: refused:
# <key>=<value>`. It runs as the caller only and refuses root. Every system
# path derives from `prefix`, empty in production, and every command
# resolves in the system directories alone. Exit 0 on success, 1 on a
# refusal, 2 on a bad invocation, 130 when the question is cancelled.
# docs/architecture/commands-are-data.md § System steps, docs/decisions/D081.
set -euo pipefail

# Every system path below derives from prefix, empty in production.
prefix=
safe_path="$prefix/usr/local/sbin:$prefix/usr/local/bin:$prefix/usr/sbin:$prefix/usr/bin:$prefix/sbin:$prefix/bin:$prefix/run/current-system/sw/bin"
# Only the NixOS package-manager check reads the caller's PATH.
caller_path="${PATH-}"
# A bare command resolves in the system directories alone, so no checkout
# or user-writable directory supplies sudo, gum, udevadm or tailscale.
export PATH="$safe_path"
umask 022
shopt -s nullglob

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
bin_dir="${self%/*}"
lib_dir="$bin_dir/lib"
rule_source="${bin_dir%/*}/config/system/udev/60-vgs-apple-displays.rules"
rules_dir="$prefix/etc/udev/rules.d"
rule_dest="$rules_dir/60-vgs-apple-displays.rules"
wake_rule_source="${bin_dir%/*}/config/system/udev/90-vgs-wake.rules"
wake_rule_dest="$rules_dir/90-vgs-wake.rules"
record_dir="$prefix/var/lib/vgshell/system"
# The CachyOS reboot hook pacman runs from its system hook directory, and
# the same name in /etc/pacman.d/hooks, pacman's default HookDir, which
# replaces it.
notice_hook="$prefix/usr/share/libalpm/hooks/cachyos-reboot-required.hook"
pacman_dir="$prefix/etc/pacman.d"
hooks_dir="$pacman_dir/hooks"
notice_link="$hooks_dir/cachyos-reboot-required.hook"
# The greeter step's sources, read from the install tree beside this script,
# and its destinations. greeter_home is the path the greeter reads at boot,
# which the rendered files name; greeter_dir is the same directory under
# prefix, which the commands write.
install_root="${bin_dir%/*}"
greeter_pam_source="$install_root/config/system/greeter/vgs-greeter.pam"
greeter_lua="$install_root/config/system/greeter/hyprland.lua"
greeter_host="$install_root/shell/greeter.qml"
greeter_plugin="$install_root/shell/plugins/vgs.greeter"
greeter_view="$greeter_plugin/Greeter.qml"
greetd_dir="$prefix/etc/greetd"
greeter_config="$greetd_dir/vgshell.toml"
# The distribution's greetd configuration, read for its VT, never written.
greetd_packaged="$greetd_dir/config.toml"
pam_dir="$prefix/etc/pam.d"
greeter_pam="$pam_dir/vgs-greeter"
units_dir="$prefix/etc/systemd/system"
dropin_dir="$units_dir/greetd.service.d"
greeter_dropin="$dropin_dir/vgs.conf"
greeter_home=/var/lib/vgshell/greeter
greeter_dir="$prefix$greeter_home"
greeter_theme="$greeter_dir/theme"
greeter_copy="$greeter_theme/vgshell"
greeter_state="$greeter_dir/state"
# The greeter's directories as the record names them, each with its path.
greeter_dirs=("dropin-dir:$dropin_dir" "greeter-dir:$greeter_dir" "theme-dir:$greeter_theme" "copy-dir:$greeter_copy" "state-dir:$greeter_state")
# The VPN kill switch's files, each `<record key>|<name in
# config/system/kill-switch>|<destination>|<mode>`, and its units, enabled in
# this order, so the service's start applies the rule last.
kill_switch_source="$install_root/config/system/kill-switch"
local_bin="$prefix/usr/local/bin"
kill_switch_files=(
  "script|vgs-kill-switch|$local_bin/vgs-kill-switch|0755"
  "sync-unit|vgs-kill-switch.service|$units_dir/vgs-kill-switch.service|0644"
  "path-unit|vgs-kill-switch.path|$units_dir/vgs-kill-switch.path|0644"
  "socket-unit|vgs-kill-switch-status.socket|$units_dir/vgs-kill-switch-status.socket|0644"
  "status-unit|vgs-kill-switch-status@.service|$units_dir/vgs-kill-switch-status@.service|0644"
)
kill_switch_units=(vgs-kill-switch.path vgs-kill-switch-status.socket vgs-kill-switch.service)
# The units that must stay running. A failed path unit stops watching, as
# its trigger limit leaves it, and a failed socket stops answering, until
# each is restarted. The sync service fails with each refused sync and runs
# again on the next trigger.
kill_switch_watchers=(vgs-kill-switch.path vgs-kill-switch-status.socket)
# The user's VPN state, which the shell writes, and root's profile cache.
vpn_state_dir="$prefix/var/lib/vgshell/vpn"
vpn_cache_dir="$prefix/var/lib/vgshell/kill-switch"
sys="$prefix/sys"
dev="$prefix/dev"
boot_id_file="$prefix/proc/sys/kernel/random/boot_id"

# hdparm -S only sets ATA IDLE's standby timeout; hdparm -C reads the
# current power state, not the timer. hdparm 9.65 source, process_dev's
# set_standby and process_args's SET_PARM('S'):
# https://sources.debian.org/src/hdparm/9.65%2Bds-1/hdparm.c/
# The disk-sleep probe therefore compares installed rule bytes only. It
# neither opens a drive nor verifies that its firmware accepted the timer.
disk_rule_source="$install_root/config/system/udev/69-vgs-disk-sleep.rules"
disk_rule_dest="$rules_dir/69-vgs-disk-sleep.rules"

# The DNS steps. systemd-resolved reads drop-ins in resolved.conf.d over
# resolved.conf, which VGS never writes, and a lookup reaches resolved
# only through the stub /etc/resolv.conf links to.
systemd_dir="$prefix/etc/systemd"
resolved_conf_dir="$systemd_dir/resolved.conf.d"
dns_dropin="$resolved_conf_dir/60-vgs-dns.conf"
resolv_conf="$prefix/etc/resolv.conf"
resolved_stub=/run/systemd/resolve/stub-resolv.conf
# Omarchy's servers, TLS names and Quad9 fallback, comma-joined as nmcli
# prints a list: basecamp/omarchy@cbd0029f bin/omarchy-dns:262-282.
# Omarchy names the TLS name only in resolved's global DNS= line. VGS
# writes no global server, so that a full-tunnel VPN that takes the
# default DNS route sends public names to its own servers alone, and
# keeps the TLS name on each profile server instead: NetworkManager passes
# a server's `#name` to resolved since 1.42 (NEWS; in 1.58.1
# nm-dns-systemd-resolved.c update_add_ip_config), and keeps a plain
# address with its name unchanged (nm_dns_uri_normalize).
dns_fallback='9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net'
declare -A dns_ipv4=([cloudflare]='1.1.1.1#cloudflare-dns.com,1.0.0.1#cloudflare-dns.com' [google]='8.8.8.8#dns.google,8.8.4.4#dns.google')
declare -A dns_ipv6=([cloudflare]='2606:4700:4700::1111#cloudflare-dns.com,2606:4700:4700::1001#cloudflare-dns.com' [google]='2001:4860:4860::8888#dns.google,2001:4860:4860::8844#dns.google')

# The closed table, in the order status prints it.
steps=(apple-displays disk-sleep i2c-dev service-bluetooth service-tailscaled service-cups service-sshd tailscale-operator tailscale-account-add greeter bandwhich-capture reboot-notice voxtype-engine vgs-quickshell-repository wake-sources dns-cloudflare dns-google dns-custom vpn-kill-switch)
declare -A step_description=(
  [apply:apple-displays]='Give this desktop access to Apple display controls. This lets VGS change their brightness.'
  [undo:apple-displays]='Remove the Apple display access rule that VGS added. This removes the brightness access from that rule.'
  [apply:disk-sleep]='Allow hard disks to sleep after 30 minutes without disk activity. This installs a disk rule and applies it to connected hard disks.'
  [undo:disk-sleep]='Remove the disk sleep rule that VGS installed. This leaves the timer already set on each disk unchanged.'
  [apply:wake-sources]='Allow keyboards, mice and the power button to wake the computer. Connecting a device to any USB port can also wake it.'
  [undo:wake-sources]='Remove the wake rule that VGS added. USB devices return to the remaining system wake rules.'
  [apply:i2c-dev]='Enable brightness controls for external displays. This lets VGS change their brightness.'
  [undo:i2c-dev]='Remove the display control access that VGS enabled during this start of the computer. This removes that access to external display controls.'
  [apply:service-bluetooth]='Start Bluetooth and enable it when the computer starts. This lets VGS connect your Bluetooth devices.'
  [undo:service-bluetooth]='Undo the Bluetooth service changes that VGS made. This restores when the service starts.'
  [apply:service-tailscaled]='Start Tailscale and enable it when the computer starts. This lets VGS connect this computer to your private network.'
  [undo:service-tailscaled]='Undo the Tailscale service changes that VGS made. This restores when the service starts.'
  [apply:service-cups]='Start the print service and enable it when the computer starts. This lets VGS manage your printers and print jobs.'
  [undo:service-cups]='Undo the print service changes that VGS made. This restores when the service starts.'
  [apply:service-sshd]='Start the SSH server and enable it when the computer starts. This lets other computers sign in to this one over SSH.'
  [undo:service-sshd]='Undo the SSH server changes that VGS made. This restores when the service starts.'
  [apply:tailscale-operator]='Tailscale lets only the administrator change it. This lets VGS connect and disconnect for you without a password.'
  [undo:tailscale-operator]='Restore the Tailscale access setting that VGS changed. Your account will need its previous permission to connect and disconnect.'
  [apply:tailscale-account-add]='Add a Tailscale account and let your login control it. If sign-in fails or you cancel here, VGS restores the previous account and connection setting.'
  [undo:tailscale-account-add]='An account add has no setup change to undo. Sign out of the account from the Tailscale card.'
  [apply:greeter]='Set VGS as the login screen for the next start of the computer. This lets you sign in through VGS when the computer starts.'
  [undo:greeter]='Undo the login screen changes that VGS made. This removes the VGS login screen setup and restores how the computer starts.'
  [apply:vpn-kill-switch]='Let VGS block all traffic outside the VPN when the VPN drops. This installs a firewall service that keeps the block in place even when VGS is not running.'
  [undo:vpn-kill-switch]='Remove the VPN kill switch that VGS installed. Traffic is no longer blocked when the VPN drops.'
  [apply:bandwhich-capture]='Give the network monitor access to connection details. This lets VGS show which applications use your network.'
  [undo:bandwhich-capture]='Remove the network monitor access that VGS granted. This stops that access to application connection details.'
  [apply:reboot-notice]='Turn off CachyOS reboot notices for package updates outside VGS. VGS still asks once after all its update steps finish when a restart is needed.'
  [undo:reboot-notice]='Restore CachyOS reboot notices for package updates outside VGS. VGS still asks once after all its update steps finish when a restart is needed.'
  [apply:vgs-quickshell-repository]='Enable the VGS software repository. This supplies the VGS engine and its updates.'
  [undo:vgs-quickshell-repository]='Disable the VGS software repository that VGS enabled. This stops engine updates from that repository.'
  [apply:voxtype-engine]='Enable the speech engine for dictation. This lets VGS turn your speech into text.'
  [undo:voxtype-engine]='Disable the speech engine that VGS enabled. Dictation will need another speech engine.'
  [apply:dns-cloudflare]='Use Cloudflare to look up addresses on every Wi-Fi and wired network this computer knows now. A network you join later uses its own DNS until you choose Cloudflare again.'
  [undo:dns-cloudflare]='Return address lookups to the network default. Each network gets back the DNS servers it had before VGS changed them.'
  [apply:dns-google]='Use Google to look up addresses on every Wi-Fi and wired network this computer knows now. A network you join later uses its own DNS until you choose Google again.'
  [undo:dns-google]='Return address lookups to the network default. Each network gets back the DNS servers it had before VGS changed them.'
  [apply:dns-custom]='Use the DNS servers you typed on every Wi-Fi and wired network this computer knows now. A network you join later uses its own DNS until you choose them again.'
  [undo:dns-custom]='Return address lookups to the network default. Each network gets back the DNS servers it had before VGS changed them.'
)
capture_caps=cap_sys_ptrace,cap_dac_read_search,cap_net_raw,cap_net_admin

# Character classes spelled out: a range follows the collation of the
# caller's locale, which this script keeps for gum.
digit='[0123456789]'
hex='[0123456789abcdefABCDEF]'
lower='[abcdefghijklmnopqrstuvwxyz]'
upper='[ABCDEFGHIJKLMNOPQRSTUVWXYZ]'
name_pattern="^($lower|_)($lower|$digit|[_-])*\\\$?$"
# An install path the greeter's configuration can name unquoted.
install_path_pattern="^(/($lower|$upper|$digit|[._+-])+)+$"
# A NetworkManager profile's UUID, a record key of the DNS steps.
uuid_pattern="^($hex|-){36}$"
# A DNS server list as nmcli prints it: comma-joined name server URIs,
# nm_dns_uri_parse's grammar in NetworkManager 1.58.1
# (src/libnm-core-aux-intern/nm-libnm-core-utils.c).
dns_char="($lower|$upper|$digit|[].:%#/+_,[-])"
dns_list_pattern="^$dns_char*$"
# A DNS record's saved profile: both ignore-auto-dns values and lists.
dns_saved_pattern="^(yes|no) $dns_char+ (yes|no) $dns_char+$"
# A DNS record's prior servers: both lists.
dns_prior_pattern="^$dns_char+ $dns_char+$"

refuse() { # STATUS FIRST_LINE [ENGLISH...]
  local status="$1"
  printf 'vgs-system: refused: %s\n' "$2" >&2
  shift 2
  (($# == 0)) || printf '%s\n' "$@" >&2
  exit "$status"
}
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self" >&2; }
bad_invocation() { # FIRST_LINE
  printf 'vgs-system: refused: %s\n' "$1" >&2
  usage
  exit 2
}

known_step() { # NAME
  local step
  for step in "${steps[@]}"; do [[ $step == "$1" ]] && return 0; done
  return 1
}

# Sets unit to service STEP's systemd unit.
unit_of() { # STEP
  case "$1" in
    service-bluetooth) unit=bluetooth.service ;;
    service-tailscaled) unit=tailscaled.service ;;
    service-cups) unit=cups.service ;;
    service-sshd)
      # Debian's openssh-server names the unit ssh.service; sshd.service
      # there is an alias that exists only while the unit is enabled.
      unit=sshd.service
      [[ $(systemctl show --property=LoadState --value ssh.service 2>/dev/null) != loaded ]] || unit=ssh.service ;;
    *) refuse 1 "internal=unit-of step=$1" "only a service step names a unit" ;;
  esac
}

# Whether PATH is a real directory or regular file root owns that only root can write.
trusted() { # PATH
  local info
  [[ (-d $1 || -f $1) && ! -L $1 ]] || return 1
  info="$(stat -c '%u %a' -- "$1")" || return 1
  [[ $info == "0 "* ]] && (((8#${info#* } & 8#022) == 0))
}

# Sets VAR to the path NAME resolves to in the system directories. The
# helpers that refuse set a variable rather than print, since a refusal
# inside a command substitution would end only the subshell.
program() { # VAR NAME
  local found
  found="$(command -v -- "$2")" || refuse 1 "command=missing name=$2" "the step needs $2 in the system directories"
  [[ $found == /* ]] || refuse 1 "command=not-a-file name=$2"
  printf -v "$1" '%s' "$found"
}

# Whether NODE exists and opens for reading and writing: the real access a
# device grant gives, which a mode or a rule file alone does not prove.
opens_rw() { # NODE
  local fd
  [[ -e $1 ]] || return 1
  { exec {fd}<>"$1"; } 2>/dev/null || return 1
  exec {fd}>&-
}

# Sets boot to this boot's id.
read_boot_id() {
  boot="$(<"$boot_id_file")" || refuse 1 "boot-id=unreadable path=$boot_id_file"
  [[ $boot =~ ^($hex|-){36}$ ]] || refuse 1 "boot-id=malformed path=$boot_id_file"
}

# Sets sum to FILE's sha256.
sha256_of() { # FILE
  sum="$(sha256sum -- "$1")" || refuse 1 "hash=failed path=$1"
  sum="${sum%% *}"
  [[ $sum =~ ^$hex{64}$ ]] || refuse 1 "hash=malformed path=$1"
}

# ---------------------------------------------------------------- probes

# A probe's reading: its state and reason, and for a refusal apply makes on
# it, the `fix=` value and the English lines that follow, both empty unless
# the probe sets them.
set_probe() { probe_state="$1" probe_reason="$2" probe_fix="" probe_hint=(); }

# The vendor:product of a HID device's uevent, lower case, `none` when it
# names no HID_ID; 1 when the file cannot be read.
hid_id() { # UEVENT
  local line
  [[ -f $1 && -r $1 ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^HID_ID=$hex{4}:$hex{4}($hex{4}):$hex{4}($hex{4})$ ]]; then
      printf '%s:%s\n' "${BASH_REMATCH[1],,}" "${BASH_REMATCH[2],,}"
      return 0
    fi
  done <"$1" || return 1
  echo none
}

probe_apple_displays() {
  local entry id node found=0 denied=0
  for entry in "$sys"/class/hidraw/hidraw*; do
    id="$(hid_id "$entry/device/uevent")" || { set_probe unknown sysfs-unreadable; return; }
    case "$id" in 05ac:1114|05ac:9243) ;; *) continue ;; esac
    found=1
    node="$dev/${entry##*/}"
    [[ -e $node ]] || { set_probe unknown node-missing; return; }
    opens_rw "$node" || denied=1
  done
  if ((found == 0)); then set_probe absent no-device
  elif ((denied == 1)); then set_probe needed hidraw-denied
  else set_probe ready granted
  fi
}

probe_wake_sources() {
  local entry interface class wake interface_class subclass protocol expected found=0
  for entry in "$sys"/bus/usb/devices/*; do
    # Interfaces have no bDeviceClass; empty wakeup means no wake support.
    [[ -f $entry/bDeviceClass && -f $entry/power/wakeup ]] || continue
    [[ -r $entry/bDeviceClass && -r $entry/power/wakeup ]] || { set_probe unknown sysfs-unreadable; return; }
    class="$(<"$entry/bDeviceClass")" || { set_probe unknown sysfs-unreadable; return; }
    wake="$(<"$entry/power/wakeup")" || { set_probe unknown sysfs-unreadable; return; }
    [[ -n $wake ]] || continue
    found=1 expected=disabled
    case "$class" in
      09|e0) expected=enabled ;;
      *)
        for interface in "$entry"/*:*; do
          [[ -f $interface/bInterfaceClass ]] || continue
          [[ -r $interface/bInterfaceClass && -r $interface/bInterfaceSubClass && -r $interface/bInterfaceProtocol ]] || { set_probe unknown sysfs-unreadable; return; }
          interface_class="$(<"$interface/bInterfaceClass")" && subclass="$(<"$interface/bInterfaceSubClass")" && protocol="$(<"$interface/bInterfaceProtocol")" || { set_probe unknown sysfs-unreadable; return; }
          if [[ $interface_class == 03 && $subclass == 01 && $protocol == 0[12] ]]; then
            expected=enabled
            break
          fi
        done
        ;;
    esac
    case "$wake" in enabled|disabled) ;; *) set_probe unknown sysfs-unreadable; return ;; esac
    [[ $wake == "$expected" ]] || { set_probe needed wake-mismatch; return; }
  done
  if ((found)); then set_probe ready granted; else set_probe absent no-device; fi
}

# Whether the i2c adapter at sysfs PATH serves a display: an ancestor's
# `class` attribute starts 0x03, the match ddcutil's own rule makes.
display_adapter() { # PATH
  local dir class
  dir="$(readlink -f -- "$1")" || return 2
  while [[ $dir == "$sys/devices/"* ]]; do
    if [[ -f $dir/class ]]; then
      class="$(<"$dir/class")" || return 2
      [[ $class == 0x03* ]] && return 0
    fi
    dir="${dir%/*}"
  done
  return 1
}

probe_disk_sleep() {
  local entry rotational found=0
  [[ -d $sys/block && -r $sys/block && -x $sys/block ]] || { set_probe unknown sysfs-unreadable; return; }
  # /sys/block lists whole devices; partitions live below each device.
  for entry in "$sys"/block/*; do
    [[ -d $entry ]] || continue
    rotational="$(<"$entry/queue/rotational")" || { set_probe unknown sysfs-unreadable; return; }
    case "$rotational" in
      1) found=1 ;;
      0) ;;
      *) set_probe unknown sysfs-unreadable; return ;;
    esac
  done
  ((found == 1)) || { set_probe absent no-disk; return; }
  command -v hdparm >/dev/null || { set_probe needed hdparm-missing; return; }
  [[ -f $disk_rule_source && ! -L $disk_rule_source ]] || { set_probe unknown source-missing; return; }
  render_disk_rule
  if [[ -f $disk_rule_dest && ! -L $disk_rule_dest ]]; then
    sha256_of "$disk_rule_dest"
    if [[ $sum == "$disk_rule_sum" ]]; then set_probe ready granted; return; fi
  fi
  set_probe needed not-set-up
}

probe_i2c_dev() {
  local entry name status found=0 granted=0
  for entry in "$sys"/bus/i2c/devices/i2c-*; do
    name="${entry##*/}"
    [[ $name =~ ^i2c-$digit+$ ]] || continue
    status=0
    display_adapter "$entry" || status=$?
    case "$status" in
      0) ;;
      1) continue ;;
      *) set_probe unknown sysfs-unreadable; return ;;
    esac
    if ((found == 0)) && [[ ! -d $sys/class/i2c-dev ]]; then
      set_probe needed module-not-loaded
      return
    fi
    found=1
    [[ -e $dev/$name ]] || { set_probe unknown node-missing; return; }
    opens_rw "$dev/$name" && granted=1
  done
  if ((found == 0)); then set_probe absent no-adapter
  elif ((granted == 1)); then set_probe ready granted
  else set_probe denied no-uaccess-rule
  fi
}

probe_service() { # UNIT
  local load
  command -v systemctl >/dev/null || { set_probe unknown systemctl-missing; return; }
  if systemctl is-active --quiet "$1"; then set_probe ready active; return; fi
  load="$(systemctl show --property=LoadState --value "$1" 2>/dev/null)" || { set_probe unknown systemctl-failed; return; }
  case "$load" in
    loaded) set_probe needed inactive ;;
    not-found) set_probe absent unit-missing ;;
    masked) set_probe denied unit-masked ;;
    *) set_probe unknown load-state ;;
  esac
}

# CUPS's socket unit starts cups.service on the first connection, so an
# active socket is printing that works.
probe_cups() {
  probe_service cups.service
  [[ $probe_state == needed ]] || return 0
  if systemctl is-active --quiet cups.socket; then set_probe ready socket-active; fi
}

# A refusal of the SSH server step says in words what blocks it.
probe_sshd() {
  unit_of service-sshd
  probe_service "$unit"
  case "$probe_state" in
    absent) probe_hint=("The SSH server is not installed on this computer.") ;;
    denied) probe_hint=("The SSH server is masked, which keeps it from starting, and VGS never unmasks it.") ;;
    unknown) probe_hint=("VGS could not read whether the SSH server runs, so it changed nothing.") ;;
  esac
}

# Sets operator to the operator tailscaled names; 1 when it cannot be read.
read_operator() {
  operator="$(tailscale get operator 2>/dev/null)" || return 1
  [[ -z $operator || $operator =~ $name_pattern ]] || return 1
}

probe_tailscale_operator() {
  command -v tailscale >/dev/null || { set_probe absent tailscale-missing; return; }
  # The name reaches tailscale's argv and the NixOS snippet only from here.
  [[ $user =~ $name_pattern ]] || { set_probe unknown user-unsupported; return; }
  read_operator || { set_probe unknown tailscaled-unreachable; return; }
  if [[ $operator == "$user" ]]; then set_probe ready granted
  elif [[ -z $operator ]]; then set_probe needed operator-unset
  else set_probe denied operator-other
  fi
}

# The resolved binary and its parents must be root's and writable by no
# other account. A writable parent would let that account replace the
# binary between the question and the root command.
capture_binary() {
  local found dir search_path="$safe_path"
  # NixOS puts configured wrappers first in a terminal's PATH. Their file
  # grants include cap_setpcap so the wrapper can pass the grant to its source:
  # https://github.com/NixOS/nixpkgs/blob/master/nixos/modules/security/wrappers/default.nix
  if [[ $detected_system == nix ]]; then search_path="$prefix/run/wrappers/bin:$search_path"; fi
  found="$(PATH="$search_path" command -v bandwhich)" || { set_probe absent bandwhich-missing; return 1; }
  capture_path="$(readlink -f -- "$found")" || { set_probe unknown path-unreadable; return 1; }
  [[ -f $capture_path && -x $capture_path ]] || { set_probe unknown path-unreadable; return 1; }
  dir="$capture_path"
  while :; do
    trusted "${dir:-/}" || { set_probe denied install-untrusted; return 1; }
    [[ -n $dir ]] || break
    dir="${dir%/*}"
  done
}

probe_bandwhich_capture() {
  local output clause names flags action operation name cap clauses=() members=()
  local system_known=0
  local -A granted=()
  detect_system && system_known=1
  capture_binary || return 0
  ((system_known == 1)) || { set_probe unknown system-undetected; return; }
  command -v getcap >/dev/null || { set_probe unknown getcap-missing; return; }
  output="$(getcap -n -- "$capture_path" 2>/dev/null)" || { set_probe unknown getcap-failed; return; }
  [[ -n $output ]] || { set_probe needed capture-needed; return; }
  [[ $output == "$capture_path "* && $output != *$'\n'* ]] || { set_probe unknown capabilities-unreadable; return; }
  output="${output#"$capture_path "}"
  # cap_to_text clauses act in order, with = resetting the named sets.
  # -n exposes a namespace root id, whose grant is not global. libcap's
  # manuals: https://man7.org/linux/man-pages/man7/cap_text_formats.7.html
  # and https://man7.org/linux/man-pages/man8/getcap.8.html
  if [[ $output == *' [rootid='* ]]; then set_probe needed capture-needed; return; fi
  read -r -a clauses <<<"$output"
  for clause in "${clauses[@]}"; do
    names="${clause%%[=+-]*}"
    action="${clause#"$names"}"
    if [[ -z $names && $action == =* || $names == all ]]; then names="$capture_caps"
    else
      [[ $names =~ ^cap_[abcdefghijklmnopqrstuvwxyz0123456789_]+(,cap_[abcdefghijklmnopqrstuvwxyz0123456789_]+)*$ ]] || { set_probe unknown capabilities-unreadable; return; }
    fi
    IFS=, read -r -a members <<<"$names"
    [[ -n $action ]] || { set_probe unknown capabilities-unreadable; return; }
    while [[ -n $action ]]; do
      [[ $action =~ ^([=+-])([epi]*)(.*)$ ]] || { set_probe unknown capabilities-unreadable; return; }
      operation="${BASH_REMATCH[1]}" flags="${BASH_REMATCH[2]}" action="${BASH_REMATCH[3]}"
      [[ $operation == = || -n $flags ]] || { set_probe unknown capabilities-unreadable; return; }
      for name in "${members[@]}"; do
        case "$operation" in
          =) granted[$name]="$flags" ;;
          +) granted[$name]="${granted[$name]-}$flags" ;;
          -)
            for cap in e p i; do
              if [[ $flags == *"$cap"* ]]; then
                granted[$name]="${granted[$name]-}"
                granted[$name]="${granted[$name]//"$cap"/}"
              fi
            done
            ;;
        esac
      done
    done
  done
  IFS=, read -r -a members <<<"$capture_caps"
  for cap in "${members[@]}"; do
    [[ ${granted[$cap]-} == *e* && ${granted[$cap]-} == *p* ]] || { set_probe needed capture-needed; return; }
  done
  set_probe ready granted
}

# Sets compositor to the greeter compositor's command words as the greeter
# runs them: start-hyprland, which passes what follows `--` to Hyprland,
# else Hyprland itself; 1 when neither is in the system directories.
greeter_compositor() {
  local found
  if found="$(command -v start-hyprland)"; then compositor="${found#"$prefix"} --"
  elif found="$(command -v Hyprland)"; then compositor="${found#"$prefix"}"
  else return 1
  fi
}

# Sets greeter_name, greeter_uid and greeter_gid to the greeter account's:
# the first of `greeter`, Arch's and Fedora's name, and `_greetd`, Debian's,
# that exists. 1 when neither exists, 2 when getent cannot answer.
greeter_account() {
  local name entry status
  for name in greeter _greetd; do
    status=0
    entry="$(getent passwd "$name")" || status=$?
    case "$status" in
      0) ;;
      2) continue ;;
      *) return 2 ;;
    esac
    [[ $entry =~ ^$name:[^:]*:($digit+):($digit+): ]] || return 2
    greeter_name="$name" greeter_uid="${BASH_REMATCH[1]}" greeter_gid="${BASH_REMATCH[2]}"
    return 0
  done
  return 1
}

# Sets vt to the `[terminal] vt` of the distribution's greetd configuration
# when it is a number, else 1; 1 when the file is there and cannot be read.
greeter_vt() {
  local line section=""
  vt=1
  [[ -e $greetd_packaged || -L $greetd_packaged ]] || return 0
  [[ -f $greetd_packaged && -r $greetd_packaged ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line%%#*}"
    if [[ $line =~ ^[[:space:]]*\[[[:space:]]*([^]]*[^][:space:]])[[:space:]]*\][[:space:]]*$ ]]; then
      section="${BASH_REMATCH[1]}"
      continue
    fi
    if [[ $section == terminal && $line =~ ^[[:space:]]*vt[[:space:]]*=[[:space:]]*($digit+)[[:space:]]*$ ]]; then vt="${BASH_REMATCH[1]}"; fi
  done <"$greetd_packaged" || return 1
}

# Whether the greeter account runs only what root alone can change: the
# install tree and every directory above it, its shell, config/system/greeter
# and plugin directories, and the files greetd and Hyprland start. The
# greeter is where every account's password is typed, so a tree its owner
# can write, a checkout or a per-user install, would let any process of
# that owner read them.
install_trusted() {
  local dir="$install_root" path
  while :; do
    trusted "${dir:-/}" || return 1
    [[ -n $dir ]] || break
    dir="${dir%/*}"
  done
  for path in "$install_root/shell" "$install_root/config/system/greeter" "$greeter_plugin" "$greeter_lua" "$greeter_host" "$greeter_view" \
    "$bin_dir/vgshell-greeter-layout" "$lib_dir/greeter-layout.js" "$lib_dir/qml-library.js" "$lib_dir/judge-files.js" "$install_root/shell/Core/MonitorLogic.js"; do
    # Every parent matters: a root-owned file in an account-writable directory
    # can be replaced just as easily as an account-owned executable.
    while [[ $path != "$install_root" ]]; do
      trusted "$path" || return 1
      path="${path%/*}"
    done
  done
}

# Whether DIR is a real directory UID alone can write.
owned_by() { # DIR UID
  local owner permissions
  [[ -d $1 && ! -L $1 ]] || return 1
  owner="$(stat -c %u -- "$1")" || return 1
  permissions="$(stat -c %a -- "$1")" || return 1
  [[ $owner == "$2" ]] && (((8#$permissions & 8#022) == 0))
}

# Sets sum to TEXT's sha256 as a file holds it: TEXT and one newline, the
# bytes `tee` writes from a here-string.
text_sum() { # TEXT
  sum="$(sha256sum <<<"$1")" || refuse 1 "hash=failed text=rendered"
  sum="${sum%% *}"
}

# The udev executable follows the same safe system path lookup as every
# root command. The fixture prefix locates files, never a shipped RUN.
render_disk_rule() {
  local hdparm
  program hdparm hdparm
  disk_rule_text="$(<"$disk_rule_source")" || refuse 1 "source=unreadable path=$disk_rule_source"
  disk_rule_text="${disk_rule_text//\/usr\/bin\/hdparm/${hdparm#"$prefix"}}"
  text_sum "$disk_rule_text"; disk_rule_sum="$sum"
}

# Whether the files the greeter step reads from the install tree are there.
greeter_sources() {
  local file
  for file in "$greeter_pam_source" "$greeter_lua" "$greeter_host" "$greeter_view"; do
    [[ -f $file && ! -L $file ]] || return 1
  done
}

# Sets greeter_command to the command greetd runs as the greeter account
# for the install tree ROOT, which the NixOS snippet names by its package.
# Needs compositor.
greeter_command_of() { # ROOT
  local found env_bin
  found="$(command -v env)" || refuse 1 "command=missing name=env"
  env_bin="${found#"$prefix"}"
  greeter_command="$env_bin VGS_GREETER_ROOT=$1 VGS_GREETER_VIEW=$1/shell/plugins/vgs.greeter/Greeter.qml XDG_CONFIG_HOME=$greeter_home/theme XDG_STATE_HOME=$greeter_home/state XDG_CACHE_HOME=$greeter_home/state/cache $compositor --config $1/config/system/greeter/hyprland.lua"
}

# Sets greeter_toml and greeter_unit to the greetd configuration and the
# drop-in apply writes, and config_sum, pam_sum and dropin_sum to the
# hashes of the three files. Needs compositor, greeter_name and vt.
render_greeter() {
  local found greetd_bin
  found="$(command -v greetd)" || refuse 1 "command=missing name=greetd"
  greetd_bin="${found#"$prefix"}"
  greeter_command_of "$install_root"
  greeter_toml="# Written by vgshell system apply greeter; vgshell system undo greeter removes it.
[terminal]
vt = $vt

[general]
service = \"vgs-greeter\"

[default_session]
user = \"$greeter_name\"
command = \"$greeter_command\""
  greeter_unit="# Written by vgshell system apply greeter; vgshell system undo greeter removes it.
[Service]
ExecStart=
ExecStart=$greetd_bin --config /etc/greetd/vgshell.toml"
  text_sum "$greeter_toml"; config_sum="$sum"
  text_sum "$greeter_unit"; dropin_sum="$sum"
  sha256_of "$greeter_pam_source"; pam_sum="$sum"
}

# Whether FILE is a regular file whose bytes hash to SUM; 2 when it cannot
# be hashed.
file_holds() { # FILE SUM
  local got
  [[ -f $1 && ! -L $1 ]] || return 1
  got="$(sha256sum -- "$1")" || return 2
  [[ ${got%% *} == "$2" ]]
}

# Whether the greeter's files hold what apply would write now and its
# directories exist; 2 when a file cannot be hashed.
greeter_in_place() {
  local file status dir
  for file in "$greeter_config:$config_sum" "$greeter_pam:$pam_sum" "$greeter_dropin:$dropin_sum"; do
    status=0
    file_holds "${file%:*}" "${file##*:}" || status=$?
    ((status == 0)) || return "$status"
  done
  for dir in "$greeter_theme" "$greeter_copy" "$greeter_state"; do
    [[ -d $dir && ! -L $dir ]] || return 1
  done
  trusted "$greeter_dir" && trusted "$greeter_theme" || return 1
}

# Sets manager to the unit display-manager.service is an alias of, its own
# name while no display manager is enabled. Sets the probe and returns 1
# while it names another display manager or cannot be read.
display_manager() {
  manager="$(systemctl show --property=Id --value display-manager.service 2>/dev/null)" || { set_probe unknown systemctl-failed; return 1; }
  [[ $manager =~ ^($lower|$upper|$digit|[@._:-])+$ ]] || { set_probe unknown display-manager-unreadable; return 1; }
  case "$manager" in
    greetd.service|display-manager.service) ;;
    *)
      set_probe denied other-display-manager
      probe_fix="disable-$manager"
      probe_hint=("$manager is the enabled display manager, and VGS never disables it." "Disable it to use the VGS login screen, or keep it and pick \"Hyprland (uwsm-managed)\" on its login screen.")
      return 1
      ;;
  esac
}

# Sets default_target to the unit `systemctl get-default` names; 1 when it
# cannot be read.
read_default_target() {
  default_target="$(systemctl get-default 2>/dev/null)" || return 1
  [[ $default_target =~ ^($lower|$digit|[@._:-])+\.target$ ]]
}

# On NixOS the configuration snippet sets greetd up and VGS writes nothing.
# NixOS's greetd module makes greetd.service the display-manager.service
# alias and the `greeter` account, so the step reads ready once the alias
# names greetd and the snippet's directories exist with their owners.
probe_greeter_nixos() {
  local status=0
  greeter_compositor || { set_probe absent hyprland-missing; return; }
  display_manager || return 0
  command -v getent >/dev/null || { set_probe unknown getent-missing; return; }
  greeter_account || status=$?
  case "$status" in
    0) ;;
    1) set_probe needed not-set-up; return ;;
    *) set_probe unknown getent-failed; return ;;
  esac
  if [[ $manager == greetd.service ]] && owned_by "$greeter_copy" "$uid" && owned_by "$greeter_state" "$greeter_uid"; then set_probe ready granted
  else set_probe needed not-set-up
  fi
}

probe_greeter() {
  local load status=0
  command -v systemctl >/dev/null || { set_probe unknown systemctl-missing; return; }
  load="$(systemctl show --property=LoadState --value greetd.service 2>/dev/null)" || { set_probe unknown systemctl-failed; return; }
  case "$load" in
    loaded|not-found) ;;
    masked) set_probe denied unit-masked; return ;;
    *) set_probe unknown load-state; return ;;
  esac
  detect_system || { set_probe unknown system-undetected; return; }
  if [[ $detected_system == nix ]]; then probe_greeter_nixos; return; fi
  [[ $load == loaded ]] || { set_probe absent greetd-missing; return; }
  command -v greetd >/dev/null || { set_probe absent greetd-missing; return; }
  greeter_compositor || { set_probe absent hyprland-missing; return; }
  command -v getent >/dev/null || { set_probe unknown getent-missing; return; }
  greeter_account || status=$?
  case "$status" in
    0) ;;
    1) set_probe absent greeter-user-missing; return ;;
    *) set_probe unknown getent-failed; return ;;
  esac
  display_manager || return 0
  [[ $install_root =~ $install_path_pattern ]] || { set_probe denied install-path-unsupported; return; }
  greeter_sources || { set_probe unknown source-missing; return; }
  install_trusted || { set_probe denied install-untrusted; return; }
  if [[ -e $greeter_copy ]]; then
    owned_by "$greeter_copy" "$uid" || { set_probe denied other-account; return; }
  fi
  greeter_vt || { set_probe unknown greetd-config-unreadable; return; }
  render_greeter
  status=0
  greeter_in_place || status=$?
  case "$status" in
    0) ;;
    1) set_probe needed not-set-up; return ;;
    *) set_probe unknown hash-failed; return ;;
  esac
  systemctl is-enabled --quiet greetd.service || { set_probe needed greetd-disabled; return; }
  read_default_target || { set_probe unknown default-target-unreadable; return; }
  [[ $default_target == graphical.target ]] || { set_probe needed not-graphical-target; return; }
  set_probe ready granted
}

# Sets sum to FILE's sha256; 1 when it cannot be hashed. sha256_of refuses
# instead, which a probe never does.
probe_sum() { # FILE
  sum="$(sha256sum -- "$1" 2>/dev/null)" || return 1
  sum="${sum%% *}"
  [[ $sum =~ ^$hex{64}$ ]]
}

# Whether the kill switch's five files are regular files in the install tree.
kill_switch_sources() {
  local entry key name dest file_mode
  for entry in "${kill_switch_files[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    [[ -f $kill_switch_source/$name && ! -L $kill_switch_source/$name ]] || return 1
  done
}

# The rule itself needs root to read, so the probe compares bytes and reads
# the units' enablement; vgs-kill-switch status reads the rule.
probe_vpn_kill_switch() {
  local entry key name dest file_mode status unit
  detect_system || { set_probe unknown system-undetected; return; }
  [[ $detected_system != nix ]] || { set_probe denied nixos-unsupported; return; }
  command -v systemctl >/dev/null || { set_probe denied systemd-missing; return; }
  command -v nft >/dev/null || { set_probe denied nft-missing; return; }
  kill_switch_sources || { set_probe unknown source-missing; return; }
  # A link there is refused by apply, as a link at a file is.
  if [[ -L $vpn_state_dir ]]; then set_probe needed not-set-up; return; fi
  if [[ -e $vpn_state_dir ]]; then
    owned_by "$vpn_state_dir" "$uid" || { set_probe denied other-account; return; }
  fi
  for entry in "${kill_switch_files[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    probe_sum "$kill_switch_source/$name" || { set_probe unknown hash-failed; return; }
    status=0
    file_holds "$dest" "$sum" || status=$?
    case "$status" in
      0) ;;
      1) set_probe needed not-set-up; return ;;
      *) set_probe unknown hash-failed; return ;;
    esac
  done
  if [[ ! -d $vpn_state_dir ]] || ! trusted "$vpn_cache_dir"; then set_probe needed not-set-up; return; fi
  for unit in "${kill_switch_units[@]}"; do
    systemctl is-enabled --quiet "$unit" || { set_probe needed units-disabled; return; }
  done
  for unit in "${kill_switch_watchers[@]}"; do
    if systemctl is-failed --quiet "$unit"; then set_probe needed units-failed; return; fi
  done
  set_probe ready granted
}

# Sets notice_state to what is at the reboot notice's link path: none,
# off for a link to /dev/null, or foreign for any other file or link; 1
# when the link cannot be read.
read_notice_link() {
  local target
  if [[ -L $notice_link ]]; then
    target="$(readlink -- "$notice_link")" || return 1
    if [[ $target == /dev/null ]]; then notice_state=off; else notice_state=foreign; fi
  elif [[ -e $notice_link ]]; then notice_state=foreign
  else notice_state=none
  fi
}

# A link to /dev/null is VGS's only while VGS's record names it: undo
# removes no other, so one the user made reads denied, never ready with an
# undo that does nothing. The record is read in a subshell, since a record
# that cannot be read refuses, and that refusal makes the link foreign too.
probe_reboot_notice() {
  [[ -f $notice_hook ]] || { set_probe absent hook-missing; return; }
  read_notice_link || { set_probe unknown link-unreadable; return; }
  case "$notice_state" in
    off)
      if (read_record reboot-notice && [[ ${record[link]-} == 1 ]]) 2>/dev/null; then set_probe ready notice-off
      else set_probe denied foreign-link
      fi
      ;;
    none) set_probe needed notice-on ;;
    *) set_probe denied foreign-file ;;
  esac
}

# repolist --enabled is provided by both supported dnf binaries. The repo
# id is COPR's published identity; another Quickshell COPR cannot satisfy it.
probe_vgs_quickshell_repository() {
  local listing line repo rest
  command -v dnf >/dev/null || command -v dnf5 >/dev/null || { set_probe absent command-missing; return; }
  detect_system || { set_probe unknown system-undetected; return; }
  [[ $detected_system == dnf ]] || { set_probe absent distribution-unsupported; return; }
  line="${system_detect_output%%$'\n'*}"
  program copr_dnf "${line##* binary=}"
  listing="$(LC_ALL=C "$copr_dnf" repolist --enabled)" || { set_probe unknown repositories-unreadable; return; }
  while read -r repo rest; do
    if [[ $repo == copr:copr.fedorainfracloud.org:vanillagreen:vgshell ]]; then set_probe ready repository-enabled; return; fi
  done <<<"$listing"
  set_probe needed repository-disabled
}

probe_voxtype_engine() {
  local engine compiled
  command -v voxtype >/dev/null || { set_probe absent command-missing; return; }
  source "$lib_dir/voxtype.sh"
  engine="$(vgs_voxtype_value engine)" || { set_probe unknown config-unreadable; return; }
  compiled="$(vgs_voxtype_compiled "$engine")" || { set_probe unknown engines-unreadable; return; }
  if [[ $compiled == yes ]]; then set_probe ready compiled
  else set_probe needed engine-not-compiled
  fi
}

# Whether /etc/resolv.conf links to resolved's stub, as
# systemd-resolved.service(8) § /ETC/RESOLV.CONF sets it up; any other
# file sends lookups past resolved and the profiles' servers.
resolv_stub() {
  local target
  [[ -L $resolv_conf ]] || return 1
  target="$(readlink -- "$resolv_conf")" || return 1
  [[ $target == "$resolved_stub" || $target == "..$resolved_stub" ]] && [[ -f $prefix$resolved_stub ]]
}

# Reads NetworkManager's Wi-Fi and Ethernet profiles, Omarchy's filter
# (bin/omarchy-dns:168-173), less every port but a VRF's,
# into dns_uuids and each one's DNS fields, and
# its connected Wi-Fi and Ethernet devices into dns_devices: once, until a
# plan clears dns_read_done; 1 with dns_unread naming why. One nmcli call
# prints every profile's fields in the order asked, with a blank line
# between profiles (nmcli 1.58.1 on cachy, 2026-11-08), so a profile name
# holding a newline misaligns the UUID check and reads unreadable.
dns_read_done=""
dns_read() {
  local listing line uuid device out i base n args=() lines=()
  case "$dns_read_done" in ok) return 0 ;; failed) return 1 ;; esac
  dns_read_done=failed dns_uuids=() dns_devices=()
  declare -gA dns_v4m=() dns_v4i=() dns_v4d=() dns_v6m=() dns_v6i=() dns_v6d=() dns_name=()
  listing="$(nmcli -t -f UUID,TYPE,PORT connection show 2>/dev/null)" || { dns_unread="nmcli-failed"; return 1; }
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    [[ $line =~ ^(($hex|-){36}):([^:]+):(.*)$ ]] || { dns_unread="profiles-unreadable"; return 1; }
    # PORT is connection.port-type (NetworkManager 1.58.1 src/nmcli/
    # connections.c, NMC_GENERIC_INFO_TYPE_CON_SHOW_PORT). A port of a
    # bridge, bond, team or Open vSwitch port has no ipv4 or ipv6
    # setting, so no DNS to set, and nmcli prints no line for those
    # fields; a VRF port keeps both (src/libnm-core-impl/nm-connection.c,
    # _supports_addr_family; `nmcli --offline connection add type
    # ethernet port-type bridge|vrf controller c0` on cachy, nmcli
    # 1.58.1, 2026-11-09).
    [[ -z ${BASH_REMATCH[4]} || ${BASH_REMATCH[4]} == vrf ]] || continue
    case "${BASH_REMATCH[3]}" in 802-11-wireless|802-3-ethernet) dns_uuids+=("${BASH_REMATCH[1]}") ;; esac
  done <<<"$listing"
  n=${#dns_uuids[@]}
  if ((n > 0)); then
    for uuid in "${dns_uuids[@]}"; do args+=(uuid "$uuid"); done
    out="$(nmcli --escape no -g connection.uuid,ipv4.method,ipv4.ignore-auto-dns,ipv4.dns,ipv6.method,ipv6.ignore-auto-dns,ipv6.dns,connection.id connection show "${args[@]}" 2>/dev/null)" ||
      { dns_unread="nmcli-failed"; return 1; }
    mapfile -t lines <<<"$out"
    ((${#lines[@]} == 9 * n - 1)) || { dns_unread="profiles-unreadable"; return 1; }
    for ((i = 0; i < n; i++)); do
      base=$((9 * i)) uuid="${dns_uuids[i]}"
      [[ ${lines[base]} == "$uuid" ]] && { ((i == n - 1)) || [[ -z ${lines[base + 8]} ]]; } &&
        [[ ${lines[base + 1]} =~ ^($lower|-)+$ && ${lines[base + 2]} =~ ^(yes|no)$ && ${lines[base + 3]} =~ $dns_list_pattern ]] &&
        [[ ${lines[base + 4]} =~ ^($lower|-)+$ && ${lines[base + 5]} =~ ^(yes|no)$ && ${lines[base + 6]} =~ $dns_list_pattern ]] ||
        { dns_unread="profiles-unreadable"; return 1; }
      dns_v4m[$uuid]="${lines[base + 1]}" dns_v4i[$uuid]="${lines[base + 2]}" dns_v4d[$uuid]="${lines[base + 3]}"
      dns_v6m[$uuid]="${lines[base + 4]}" dns_v6i[$uuid]="${lines[base + 5]}" dns_v6d[$uuid]="${lines[base + 6]}"
      dns_name[$uuid]="${lines[base + 7]//[^[:print:]]/?}"
    done
  fi
  out="$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)" || { dns_unread="nmcli-failed"; return 1; }
  while IFS= read -r line; do
    # `connected (externally)`, such as tailscale0's, is not NetworkManager's
    # own connection, and only wifi and ethernet devices are reapplied.
    [[ $line =~ ^(.*):(wifi|ethernet):connected$ ]] || continue
    device="${BASH_REMATCH[1]}"
    [[ $device =~ ^($lower|$upper|$digit|[._-])+$ ]] || { dns_unread="devices-unreadable"; return 1; }
    dns_devices+=("$device")
  done <<<"$out"
  dns_read_done=ok
}

# Whether family 4 or 6 of a profile whose method is METHOD takes DNS
# servers: NetworkManager 1.58.1 refuses ipvX.dns for the others
# (nm-setting-ip4-config.c and nm-setting-ip6-config.c, verify()).
dns_family_takes() { # 4|6 METHOD
  case "$1:$2" in
    4:link-local|4:shared|4:disabled|6:ignore|6:link-local|6:disabled) return 1 ;;
  esac
  return 0
}

# Whether profile UUID holds IPV4 and IPV6, comma-joined, in every family
# that takes servers, with that family's automatic servers ignored.
dns_holds() { # UUID IPV4 IPV6
  if dns_family_takes 4 "${dns_v4m[$1]}"; then
    [[ ${dns_v4i[$1]} == yes && ${dns_v4d[$1]} == "$2" ]] || return 1
  fi
  if dns_family_takes 6 "${dns_v6m[$1]}"; then
    [[ ${dns_v6i[$1]} == yes && ${dns_v6d[$1]} == "$3" ]] || return 1
  fi
  return 0
}

# Sets want4 and want6 to the comma-joined servers PROVIDER sets; custom's
# are IPV4 and IPV6.
dns_servers() { # PROVIDER [IPV4 IPV6]
  case "$1" in
    custom) want4="$2" want6="$3" ;;
    *) want4="${dns_ipv4[$1]}" want6="${dns_ipv6[$1]}" ;;
  esac
}

# A record's list, `-` for none, as a comma-joined list.
dns_unlisted() { if [[ $1 == - ]]; then printf ''; else printf '%s' "$1"; fi; } # VALUE
dns_listed() { printf '%s' "${1:--}"; } # LIST

# Sets recorded4 and recorded6 to what the DNS record's provider set; 1
# without a record in `record`.
dns_recorded() {
  [[ -n ${record[provider]-} ]] || return 1
  dns_servers "${record[provider]}" "$(dns_unlisted "${record[ipv4]--}")" "$(dns_unlisted "${record[ipv6]--}")"
  recorded4="$want4" recorded6="$want6"
}

# Sets held4 and held6 to the servers VGS set that profile UUID holds:
# the recorded provider's, or the `prior-` servers of a change of
# provider that stopped before it reached this profile; 1 for neither.
dns_vgs_held() { # UUID
  local prior="${record[prior-$1]-}"
  if dns_recorded && dns_holds "$1" "$recorded4" "$recorded6"; then
    held4="$recorded4" held6="$recorded6"
    return 0
  fi
  [[ -n $prior ]] || return 1
  held4="$(dns_unlisted "${prior% *}")" held6="$(dns_unlisted "${prior#* }")"
  dns_holds "$1" "$held4" "$held6"
}

# Whether profile UUID carries servers no provider VGS recorded set.
dns_foreign() { # UUID
  [[ -n ${dns_v4d[$1]} || -n ${dns_v6d[$1]} ]] || return 1
  ! dns_vgs_held "$1"
}

# Sets dns_dropin_text and dns_dropin_sum to the drop-in PROVIDER's step
# writes: Omarchy's resolved.conf for that provider less its DNS= line.
render_dns_dropin() { # PROVIDER
  dns_dropin_text="# Written by vgshell system apply dns-$1; vgshell system undo dns-$1 removes it.
[Resolve]
FallbackDNS=$dns_fallback"
  [[ $1 == custom ]] || dns_dropin_text+=$'\n'"DNSOverTLS=opportunistic"
  text_sum "$dns_dropin_text"; dns_dropin_sum="$sum"
}

# Fills `record` from the DNS record for a probe; 1 when it is there and
# cannot be read. The read runs in a subshell, since read_record refuses.
dns_probe_record() {
  local dump line
  record=()
  [[ -e $record_dir/dns || -L $record_dir/dns ]] || return 0
  dump="$( { read_record dns && for line in "${!record[@]}"; do printf '%s=%s\n' "$line" "${record[$line]}"; done; } 2>/dev/null)" || return 1
  while IFS= read -r line; do record[${line%%=*}]="${line#*=}"; done <<<"$dump"
}

probe_dns() { # STEP
  local provider="${1#dns-}" uuid status
  command -v nmcli >/dev/null || { set_probe absent networkmanager-missing; return; }
  command -v systemctl >/dev/null || { set_probe unknown systemctl-missing; return; }
  systemctl is-active --quiet NetworkManager.service || { set_probe absent networkmanager-inactive; return; }
  systemctl is-active --quiet systemd-resolved.service || { set_probe unknown resolved-inactive; return; }
  resolv_stub || { set_probe unknown resolv-conf-not-stub; return; }
  dns_read || { set_probe unknown "$dns_unread"; return; }
  ((${#dns_uuids[@]} > 0)) || { set_probe absent no-profile; return; }
  dns_probe_record || { set_probe unknown record-unreadable; return; }
  if [[ -e $dns_dropin || -L $dns_dropin ]]; then
    status=1
    [[ -z ${record[dropin]-} ]] || { status=0; file_holds "$dns_dropin" "${record[dropin]}" || status=$?; }
    case "$status" in
      0) ;;
      1) set_probe denied foreign-dropin; return ;;
      *) set_probe unknown hash-failed; return ;;
    esac
  fi
  for uuid in "${dns_uuids[@]}"; do
    if dns_foreign "$uuid"; then set_probe needed foreign; return; fi
  done
  [[ ${record[provider]-} == "$provider" ]] || { set_probe needed not-set; return; }
  dns_recorded
  render_dns_dropin "$provider"
  file_holds "$dns_dropin" "$dns_dropin_sum" || { set_probe needed partial; return; }
  for uuid in "${dns_uuids[@]}"; do
    dns_holds "$uuid" "$recorded4" "$recorded6" || { set_probe needed partial; return; }
  done
  set_probe ready in-effect
}

probe() { # STEP
  case "$1" in
    apple-displays) probe_apple_displays ;;
    disk-sleep) probe_disk_sleep ;;
    wake-sources) probe_wake_sources ;;
    i2c-dev) probe_i2c_dev ;;
    service-bluetooth|service-tailscaled) unit_of "$1"; probe_service "$unit" ;;
    service-cups) probe_cups ;;
    service-sshd) probe_sshd ;;
    tailscale-operator) probe_tailscale_operator ;;
    tailscale-account-add)
      if ! command -v tailscale >/dev/null; then set_probe absent tailscale-missing
      elif [[ ! $user =~ $name_pattern ]]; then set_probe unknown user-unsupported
      else set_probe needed account-add
      fi ;;
    greeter) probe_greeter ;;
    vpn-kill-switch) probe_vpn_kill_switch ;;
    bandwhich-capture) probe_bandwhich_capture ;;
    reboot-notice) probe_reboot_notice ;;
    voxtype-engine) probe_voxtype_engine ;;
    vgs-quickshell-repository) probe_vgs_quickshell_repository ;;
    dns-cloudflare|dns-google|dns-custom) probe_dns "$1" ;;
    *) refuse 1 "internal=probe step=$1" "the step table has no probe for it" ;;
  esac
}

# ---------------------------------------------------------------- NixOS

# Reads the package-manager table the same way `vgshell pkg detect` does, and
# sets detected_system to the first line's primary id or none, once a run.
detected_system=
detect_system() {
  local first status=0
  [[ -z $detected_system ]] || return 0
  system_detect_output="$(env PATH="$caller_path" node "$bin_dir/vgshell-pkg" detect 2>&1)" || status=$?
  system_detect_status="$status"
  first="${system_detect_output%%$'\n'*}"
  detected_system=
  ((status == 0)) || return 1
  if [[ $first == primary=none ]]; then detected_system=none; return 0; fi
  [[ $first =~ ^primary=($lower($lower|$digit|[_-])*)\ binary=.+$ ]] || return 1
  detected_system="${BASH_REMATCH[1]}"
}

detect_or_refuse() {
  detect_system && return
  refuse 1 "system=undetected exit=$system_detect_status" "${system_detect_output:-the package manager detector printed no first line}"
}

nixos_snippet() { # STEP
  case "$1" in
    apple-displays|wake-sources)
      printf 'services.udev.extraRules = %s\n' "''"
      local source="$rule_source"
      [[ $1 != wake-sources ]] || source="$wake_rule_source"
      awk '!/^[[:space:]]*(#|$)/ { print "  " $0 }' "$source"
      printf "'';\n"
      ;;
    disk-sleep)
      printf 'services.udev.extraRules = %s\n' "''"
      awk '!/^[[:space:]]*(#|$)/ { gsub("/usr/bin/hdparm", "${pkgs.hdparm}/bin/hdparm"); print "  " $0 }' "$disk_rule_source"
      printf "'';\n"
      ;;
    voxtype-engine) printf 'environment.systemPackages = [ pkgs.voxtype ];\n' ;;
    i2c-dev) printf 'boot.kernelModules = [ "i2c-dev" ];\n' ;;
    service-bluetooth) printf 'hardware.bluetooth.enable = true;\n' ;;
    service-tailscaled) printf 'services.tailscale.enable = true;\n' ;;
    service-cups) printf 'services.printing.enable = true;\n' ;;
    service-sshd) printf 'services.openssh.enable = true;\n' ;;
    tailscale-operator) printf 'services.tailscale.extraSetFlags = [ "--operator=%s" ];\n' "$user" ;;
    bandwhich-capture)
      printf 'security.wrappers.bandwhich = {\n  source = "${pkgs.bandwhich}/bin/bandwhich";\n  owner = "root";\n  group = "root";\n  capabilities = "%s+ep";\n};\n' "$capture_caps"
      ;;
    greeter)
      # The greeter runs the VGS package, never this script's own tree, so
      # the store keeps it while the configuration names it.
      greeter_compositor || refuse 1 "command=missing name=Hyprland"
      greeter_command_of '${vgshell}'
      printf '# inputs.vgshell is the VGS flake, github:vanillagreencom/vgshell.\n'
      printf 'services.greetd.enable = true;\n'
      printf 'services.greetd.settings.default_session = let\n  vgshell = "${inputs.vgshell.packages.${pkgs.stdenv.hostPlatform.system}.default}/share/vgshell";\nin {\n  user = "greeter";\n  command = "%s";\n};\n' "$greeter_command"
      printf 'security.pam.services.greetd.enableGnomeKeyring = true;\n'
      printf 'systemd.tmpfiles.rules = [\n  "d %s 0755 root root -"\n  "d %s/theme 0755 root root -"\n  "d %s/theme/vgshell 0755 %s - -"\n  "d %s/state 0700 greeter greeter -"\n];\n' "$greeter_home" "$greeter_home" "$greeter_home" "$uid" "$greeter_home"
      ;;
    dns-cloudflare|dns-google|dns-custom)
      # NixOS 26.05's resolved module takes resolved.conf keys under
      # settings.Resolve (nixos/modules/system/boot/resolved.nix). The
      # profiles are NetworkManager's own state, which no option sets.
      local server fallback=""
      for server in $dns_fallback; do fallback+=" \"$server\""; done
      printf 'services.resolved.enable = true;\n'
      printf 'services.resolved.settings.Resolve.FallbackDNS = [%s ];\n' "$fallback"
      if [[ $1 == dns-custom ]]; then want4='<your IPv4 servers>' want6='<your IPv6 servers>'
      else
        printf 'services.resolved.settings.Resolve.DNSOverTLS = "opportunistic";\n'
        dns_servers "${1#dns-}"
      fi
      printf '# NetworkManager keeps the DNS servers of each network in its profile.\n'
      printf '# For each Wi-Fi and Ethernet profile, run:\n'
      printf '#   nmcli connection modify <profile> ipv4.ignore-auto-dns yes ipv4.dns "%s" ipv6.ignore-auto-dns yes ipv6.dns "%s"\n' "$want4" "$want6"
      ;;
    *) refuse 1 "internal=nixos-snippet step=$1" ;;
  esac
}

# ---------------------------------------------------------------- records

# Reads STEP's record into the associative array `record`: returns 1 with
# it empty when there is none, and refuses a record that is not root's, not
# of its step's keys or written for another uid. The DNS steps share the
# record `dns`, so undo of any of them is the network default.
read_record() { # STEP
  local file line key value allowed name="$1"
  [[ $name != dns-* ]] || name=dns
  file="$record_dir/$name"
  record=()
  [[ -e $file || -L $file ]] || return 1
  trusted "$record_dir" || refuse 1 "untrusted=$record_dir"
  trusted "$file" && [[ -f $file ]] || refuse 1 "record=untrusted path=$file"
  case "$name" in
    apple-displays|disk-sleep|wake-sources) allowed=' uid rule ' ;;
    i2c-dev) allowed=' uid loaded boot ' ;;
    service-*) allowed=' uid enabled started boot ' ;;
    greeter) allowed=' uid config pam dropin enabled target deferred dropin-dir greeter-dir theme-dir copy-dir state-dir ' ;;
    vpn-kill-switch) allowed=' uid script sync-unit path-unit socket-unit status-unit state-dir cache-dir ' ;;
    bandwhich-capture) allowed=' uid binary hash ' ;;
    reboot-notice) allowed=' uid link hooks-dir ' ;;
    voxtype-engine|vgs-quickshell-repository) allowed=' uid enabled ' ;;
    dns) allowed=' uid provider ipv4 ipv6 dropin dropin-dir ' ;;
    *) refuse 1 "internal=record step=$1" ;;
  esac
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || refuse 1 "record=malformed path=$file"
    key="${line%%=*}" value="${line#*=}"
    [[ ($allowed == *" $key "* || ($name == dns && ($key == profile-* || $key == prior-*) && ${key#*-} =~ $uuid_pattern)) && -z ${record[$key]+set} ]] || refuse 1 "record=malformed path=$file"
    case "$key" in
      uid) [[ $value =~ ^$digit+$ ]] ;;
      rule|config|pam|dropin|hash) [[ $value =~ ^$hex{64}$ ]] ;;
      script|sync-unit|path-unit|socket-unit|status-unit) [[ $value =~ ^$hex{64}$ ]] ;;
      binary) [[ $value == /* && $value != *$'\r'* ]] ;;
      loaded|enabled|started|link|*-dir) [[ $value == 1 ]] ;;
      boot|deferred) [[ $value =~ ^($hex|-){36}$ ]] ;;
      target) [[ $value =~ ^($lower|$digit|[@._:-])+\.target$ ]] ;;
      provider) [[ $value == cloudflare || $value == google || $value == custom ]] ;;
      ipv4|ipv6) [[ $value == - || $value =~ $dns_list_pattern ]] ;;
      profile-*) [[ $value =~ $dns_saved_pattern ]] ;;
      prior-*) [[ $value =~ $dns_prior_pattern ]] ;;
    esac || refuse 1 "record=malformed path=$file"
    record[$key]="$value"
  done <"$file" || refuse 1 "record=unreadable path=$file"
  [[ -n ${record[uid]+set} ]] || refuse 1 "record=malformed path=$file"
  [[ ${record[uid]} == "$uid" ]] || refuse 1 "record=other-uid uid=${record[uid]} path=$file" "another account applied this step; only it can undo it"
}

# ---------------------------------------------------------------- plans

# A plan is a function that calls `cmd` once per root command. Run with
# mode=show it appends each command's text to `shown`; with mode=run it
# runs them through sudo. Both passes resolve the same programs.
mode=show
shown=""
shown_commands=()
cmd() { # [--terminal] ARGV...
  local status=0 line input=/dev/null
  if [[ ${1-} == --terminal ]]; then input=/dev/tty; shift; fi
  case "$mode" in
    show)
      line="sudo$(printf ' %q' "$@")"
      shown+="$line"$'\n'
      shown_commands+=("$line")
      ;;
    run)
      sudo -- "$@" <"$input" || status=$?
      ((status == 0)) || refuse 1 "command=failed exit=$status argv=$(printf '%q' "$*")"
      ;;
    *) refuse 1 "internal=mode value=$mode" ;;
  esac
}
# The same, with TEXT on the command's stdin and its stdout dropped.
cmd_in() { # TEXT ARGV...
  local text="$1" status=0 line
  shift
  case "$mode" in
    show)
      # The closed table makes records and greeter files, none with a
      # VGS_SYSTEM_INPUT line. Quoting the delimiter shows their literal
      # bytes without merging every record field into one escaped word.
      line="sudo$(printf ' %q' "$@") <<'VGS_SYSTEM_INPUT'"$'\n'"$text"$'\n''VGS_SYSTEM_INPUT'
      shown+="$line"$'\n'
      shown_commands+=("$line")
      ;;
    run)
      sudo -- "$@" <<<"$text" >/dev/null || status=$?
      ((status == 0)) || refuse 1 "command=failed exit=$status argv=$(printf '%q' "$*")"
      ;;
    *) refuse 1 "internal=mode value=$mode" ;;
  esac
}

# Writes STEP's record, TEXT, to a dotted name and renames it into place.
record_put() { # STEP TEXT
  local tee mv
  program tee tee
  program mv mv
  cmd_in "$2" "$tee" -- "$record_dir/.$1"
  cmd "$mv" -fT -- "$record_dir/.$1" "$record_dir/$1"
}
record_drop() { # STEP
  local rm
  program rm rm
  cmd "$rm" -f -- "$record_dir/$1"
}

udev_reload() { # SUBSYSTEM
  local udevadm
  program udevadm udevadm
  cmd "$udevadm" control --reload
  cmd "$udevadm" trigger "--subsystem-match=$1" --action=change --settle
}

# Refuses PATH when it is a symbolic link: no destination is followed.
no_symlink() { [[ ! -L $1 ]] || refuse 1 "destination=symlink path=$1"; } # PATH

# Sets dest_state for the file at DEST: `none`, or `own` when its bytes
# hash to HASH, VGS's record, leaving sum at that hash; refuses any other
# file.
dest_state_of() { # DEST HASH
  no_symlink "$1"
  if [[ ! -e $1 ]]; then dest_state=none; return; fi
  [[ -f $1 ]] || refuse 1 "destination=not-a-file path=$1"
  sha256_of "$1"
  [[ -n $2 && $sum == "$2" ]] || refuse 1 "destination=foreign path=$1" "a file VGS did not write is never overwritten"
  dest_state=own
}
udev_rule_of() { # STEP
  case "$1" in
    apple-displays) source="$rule_source" destination="$rule_dest" subsystem=hidraw ;;
    wake-sources) source="$wake_rule_source" destination="$wake_rule_dest" subsystem=usb ;;
  esac
}

apply_udev_rule() { # STEP
  local hash recorded="" install source destination subsystem
  udev_rule_of "$1"
  [[ -f $source && ! -L $source ]] || refuse 1 "source=missing path=$source"
  trusted "$rules_dir" || refuse 1 "untrusted=$rules_dir"
  sha256_of "$source"
  hash="$sum"
  if read_record "$1"; then recorded="${record[rule]}"; fi
  # Leaves sum at the destination's hash when the file there is VGS's.
  dest_state_of "$destination" "$recorded"
  record_put "$1" "uid=$uid"$'\n'"rule=$hash"
  if [[ $dest_state == none || $sum != "$hash" ]]; then
    program install install
    cmd "$install" -m 0644 -o root -g root -T -- "$source" "$destination"
  fi
  udev_reload "$subsystem"
}

apply_disk_sleep() {
  local hash recorded="" udevadm
  [[ -f $disk_rule_source && ! -L $disk_rule_source ]] || refuse 1 "source=missing path=$disk_rule_source"
  trusted "$rules_dir" || refuse 1 "untrusted=$rules_dir"
  render_disk_rule
  hash="$disk_rule_sum"
  if read_record disk-sleep; then recorded="${record[rule]}"; fi
  dest_state_of "$disk_rule_dest" "$recorded"
  record_put disk-sleep "uid=$uid"$'\n'"rule=$hash"
  if [[ $dest_state == none || $sum != "$hash" ]]; then
    put_text "$disk_rule_dest" "$disk_rule_text"
  fi
  program udevadm udevadm
  cmd "$udevadm" control --reload
  cmd "$udevadm" trigger --subsystem-match=block --property-match=DEVTYPE=disk --attr-match=queue/rotational=1 --action=change --settle
}

undo_disk_sleep() {
  local rm udevadm
  trusted "$rules_dir" || refuse 1 "untrusted=$rules_dir"
  dest_state_of "$disk_rule_dest" "${record[rule]}"
  if [[ $dest_state == own ]]; then
    program rm rm
    cmd "$rm" -f -- "$disk_rule_dest"
    program udevadm udevadm
    cmd "$udevadm" control --reload
  fi
  record_drop disk-sleep
}

apply_i2c_dev() {
  local modprobe udevadm
  read_record i2c-dev || true
  program modprobe modprobe
  program udevadm udevadm
  record_put i2c-dev "uid=$uid"$'\n'"loaded=1"$'\n'"boot=$boot"
  cmd "$modprobe" i2c-dev
  # The package's uaccess rule reaches the new nodes through udev's queue,
  # after modprobe returns; the probe after the commands must read it.
  cmd "$udevadm" settle
}

apply_service() { # STEP
  local unit systemctl text="uid=$uid" enabled=""
  unit_of "$1"
  program systemctl systemctl
  # A unit VGS enabled before stays VGS's to disable after it stopped.
  if read_record "$1"; then enabled="${record[enabled]-}"; fi
  systemctl is-enabled --quiet "$unit" || enabled=1
  [[ -z $enabled ]] || text+=$'\n'"enabled=1"
  text+=$'\n'"started=1"$'\n'"boot=$boot"
  record_put "$1" "$text"
  cmd "$systemctl" enable --now "$unit"
}

apply_vgs_quickshell_repository() {
  probe_vgs_quickshell_repository
  [[ $probe_state == needed ]] || refuse 1 "state=$probe_state reason=$probe_reason step=vgs-quickshell-repository"
  read_record vgs-quickshell-repository || true
  record_put vgs-quickshell-repository "uid=$uid"$'\n'"enabled=1"
  # COPR reads its repository confirmation from stdin.
  cmd --terminal "$copr_dnf" copr enable vanillagreen/vgshell
}

undo_vgs_quickshell_repository() {
  probe_vgs_quickshell_repository
  [[ $probe_state == ready || $probe_state == needed ]] || refuse 1 "state=$probe_state reason=$probe_reason step=vgs-quickshell-repository"
  [[ ${record[enabled]-} != 1 || $probe_state != ready ]] || cmd "$copr_dnf" copr disable vanillagreen/vgshell
  record_drop vgs-quickshell-repository
}

apply_voxtype_engine() {
  local voxtype
  program voxtype voxtype
  read_record voxtype-engine || true
  record_put voxtype-engine "uid=$uid"$'\n'"enabled=1"
  cmd "$voxtype" setup onnx --enable
}

undo_voxtype_engine() {
  local voxtype
  program voxtype voxtype
  [[ ${record[enabled]-} != 1 ]] || cmd "$voxtype" setup onnx --disable
  record_drop voxtype-engine
}

apply_bandwhich_capture() {
  local setcap
  capture_binary || refuse 1 "state=$probe_state reason=$probe_reason step=bandwhich-capture"
  read_record bandwhich-capture || true
  program setcap setcap
  sha256_of "$capture_path"
  record_put bandwhich-capture "uid=$uid"$'\n'"binary=$capture_path"$'\n'"hash=$sum"
  cmd "$setcap" "$capture_caps+ep" "$capture_path"
}

undo_bandwhich_capture() {
  local setcap
  capture_binary || refuse 1 "state=$probe_state reason=$probe_reason step=bandwhich-capture"
  sha256_of "$capture_path"
  [[ $capture_path == "${record[binary]-}" && $sum == "${record[hash]-}" ]] || refuse 1 "record=binary-changed step=bandwhich-capture"
  program setcap setcap
  cmd "$setcap" -r "$capture_path"
  record_drop bandwhich-capture
}

# Writes TEXT as DEST through a dotted name in the same directory, renamed
# into place; tee makes it root's with mode 0644 under the script's umask.
put_text() { # DEST TEXT
  local tee mv dir="${1%/*}" name="${1##*/}"
  program tee tee
  program mv mv
  cmd_in "$2" "$tee" -- "$dir/.$name"
  cmd "$mv" -fT -- "$dir/.$name" "$1"
}

# Refuses DIR when it is a symbolic link or, being there, is no directory
# root owns and only root can write.
owned_dir() { # DIR
  local dir="$1"
  while :; do
    no_symlink "$dir"
    [[ ! -e $dir ]] || trusted "$dir" || refuse 1 "untrusted=$dir"
    [[ $dir != / ]] || break
    dir="${dir%/*}"
    dir="${dir:-/}"
  done
}

apply_greeter() {
  local text recorded_config="" recorded_pam="" recorded_dropin="" made=() entry key dir \
    config_state pam_state dropin_state enabled="" target="" install systemctl
  greeter_sources || refuse 1 "source=missing path=$install_root/config/system/greeter"
  greeter_compositor || refuse 1 "command=missing name=Hyprland"
  greeter_account || refuse 1 "account=unavailable name=greeter"
  greeter_vt || refuse 1 "greetd-config=unreadable path=$greetd_packaged"
  read_default_target || refuse 1 "default-target=unreadable"
  program install install
  program systemctl systemctl
  for dir in "$greetd_dir" "$pam_dir" "$units_dir"; do trusted "$dir" || refuse 1 "untrusted=$dir"; done
  for dir in "$dropin_dir" "$greeter_dir" "$greeter_theme"; do owned_dir "$dir"; done
  for dir in "$greeter_copy" "$greeter_state"; do no_symlink "$dir"; done
  [[ ! -e $greeter_copy ]] || owned_by "$greeter_copy" "$uid" || refuse 1 "destination=ownership path=$greeter_copy"
  if read_record greeter; then
    recorded_config="${record[config]-}" recorded_pam="${record[pam]-}" recorded_dropin="${record[dropin]-}"
    enabled="${record[enabled]-}" target="${record[target]-}"
    for entry in "${greeter_dirs[@]}"; do
      [[ -z ${record[${entry%%:*}]+set} ]] || made+=("${entry%%:*}")
    done
  fi
  render_greeter
  # Each leaves sum at the hash of the file in place when it is VGS's.
  dest_state_of "$greeter_config" "$recorded_config"; [[ $dest_state == none || $sum != "$config_sum" ]] && config_state=write || config_state=keep
  dest_state_of "$greeter_pam" "$recorded_pam"; [[ $dest_state == none || $sum != "$pam_sum" ]] && pam_state=write || pam_state=keep
  dest_state_of "$greeter_dropin" "$recorded_dropin"; [[ $dest_state == none || $sum != "$dropin_sum" ]] && dropin_state=write || dropin_state=keep
  for entry in "${greeter_dirs[@]}"; do
    [[ -e ${entry#*:} ]] || made+=("${entry%%:*}")
  done
  # A greetd VGS enabled before stays VGS's to disable, and the default it
  # replaced stays the one undo restores.
  systemctl is-enabled --quiet greetd.service || enabled=1
  [[ -n $target || $default_target == graphical.target ]] || target="$default_target"
  text="uid=$uid"$'\n'"config=$config_sum"$'\n'"pam=$pam_sum"$'\n'"dropin=$dropin_sum"
  [[ -z $enabled ]] || text+=$'\n'"enabled=1"
  [[ -z $target ]] || text+=$'\n'"target=$target"
  for entry in "${greeter_dirs[@]}"; do
    key="${entry%%:*}"
    [[ " ${made[*]} " != *" $key "* ]] || text+=$'\n'"$key=1"
  done
  record_put greeter "$text"
  [[ $config_state == keep ]] || put_text "$greeter_config" "$greeter_toml"
  [[ $pam_state == keep ]] || cmd "$install" -m 0644 -o root -g root -T -- "$greeter_pam_source" "$greeter_pam"
  [[ -e $dropin_dir ]] || cmd "$install" -d -m 0755 -o root -g root -- "$dropin_dir"
  [[ $dropin_state == keep ]] || put_text "$greeter_dropin" "$greeter_unit"
  [[ -e $greeter_dir ]] || cmd "$install" -d -m 0755 -o root -g root -- "$greeter_dir"
  # The theme directory is root's, so the owner, who writes the copy in its
  # `vgs` directory, controls nothing else the greeter reads under it.
  [[ -e $greeter_theme ]] || cmd "$install" -d -m 0755 -o root -g root -- "$greeter_theme"
  [[ -e $greeter_copy ]] || cmd "$install" -d -m 0755 -o "$uid" -g "$gid" -- "$greeter_copy"
  [[ -e $greeter_state ]] || cmd "$install" -d -m 0700 -o "$greeter_uid" -g "$greeter_gid" -- "$greeter_state"
  [[ $dropin_state == keep ]] || cmd "$systemctl" daemon-reload
  # Enabled, never started: a start inside a running session takes over its
  # console.
  systemctl is-enabled --quiet greetd.service || cmd "$systemctl" enable greetd.service
  # greetd is the display-manager.service alias, which only graphical.target
  # pulls in.
  [[ $default_target == graphical.target ]] || cmd "$systemctl" set-default graphical.target
}

# Whether greetd may still run VGS's configuration, which it read when it
# started: it is active, and no earlier boot's undo already kept its files.
greetd_runs_vgs() {
  systemctl is-active --quiet greetd.service || return 1
  [[ -z ${record[deferred]+set} || ${record[deferred]} == "$boot" ]]
}
greeter_deferred_text="greetd still runs the VGS login screen, so /etc/pam.d/vgs-greeter and its directories stay; the login screen returns to the previous setup after a restart, and undo then removes them."

undo_greeter() {
  local rm rmdir systemctl file dir entry key keep="" reload="" text
  program rm rm
  program rmdir rmdir
  program systemctl systemctl
  # Leaves dest_state at the PAM service's, refusing one VGS did not write.
  dest_state_of "$greeter_pam" "${record[pam]-}"
  if [[ $dest_state == own ]] && greetd_runs_vgs; then keep=1; fi
  for file in "$greeter_config:config" "$greeter_pam:pam" "$greeter_dropin:dropin"; do
    dest_state_of "${file%:*}" "${record[${file##*:}]-}"
    [[ $dest_state == none || (-n $keep && ${file##*:} == pam) ]] || cmd "$rm" -f -- "${file%:*}"
    [[ $dest_state == none || ${file##*:} != dropin ]] || reload=1
  done
  if [[ -z $keep ]]; then
    for dir in "$greeter_copy:copy-dir" "$greeter_state:state-dir"; do
      no_symlink "${dir%:*}"
      [[ -z ${record[${dir##*:}]+set} || ! -e ${dir%:*} ]] || cmd "$rm" -rf -- "${dir%:*}"
    done
    for dir in "$greeter_theme:theme-dir" "$greeter_dir:greeter-dir"; do
      no_symlink "${dir%:*}"
      [[ -z ${record[${dir##*:}]+set} || ! -e ${dir%:*} ]] || cmd "$rmdir" --ignore-fail-on-non-empty -- "${dir%:*}"
    done
  fi
  no_symlink "$dropin_dir"
  [[ -z ${record[dropin-dir]+set} || ! -e $dropin_dir ]] || cmd "$rmdir" --ignore-fail-on-non-empty -- "$dropin_dir"
  [[ -z ${record[enabled]+set} ]] || cmd "$systemctl" disable greetd.service
  if [[ -n ${record[target]+set} ]]; then
    read_default_target || refuse 1 "default-target=unreadable"
    # A default someone chose after apply stays.
    [[ $default_target != graphical.target ]] || cmd "$systemctl" set-default "${record[target]}"
  fi
  [[ -z $reload ]] || cmd "$systemctl" daemon-reload
  if [[ -z $keep ]]; then
    record_drop greeter
    return
  fi
  text="uid=$uid"$'\n'"pam=${record[pam]}"
  for entry in "${greeter_dirs[@]}"; do
    key="${entry%%:*}"
    [[ $key == dropin-dir || -z ${record[$key]+set} ]] || text+=$'\n'"$key=1"
  done
  record_put greeter "$text"$'\n'"deferred=$boot"
  greeter_kept=1
}

apply_vpn_kill_switch() {
  local entry key name dest file_mode hash dir unit install systemctl reload="" text="uid=$uid" writes=() restarts=() failed=()
  kill_switch_sources || refuse 1 "source=missing path=$kill_switch_source"
  program install install
  program systemctl systemctl
  for dir in "$local_bin" "$units_dir"; do trusted "$dir" || refuse 1 "untrusted=$dir"; done
  owned_dir "${vpn_state_dir%/*}"
  for dir in "$vpn_state_dir" "$vpn_cache_dir"; do no_symlink "$dir"; done
  [[ ! -e $vpn_state_dir ]] || owned_by "$vpn_state_dir" "$uid" || refuse 1 "destination=ownership path=$vpn_state_dir"
  [[ ! -e $vpn_cache_dir ]] || trusted "$vpn_cache_dir" || refuse 1 "untrusted=$vpn_cache_dir"
  read_record vpn-kill-switch || true
  for entry in "${kill_switch_files[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    sha256_of "$kill_switch_source/$name"
    hash="$sum"
    # Leaves sum at the destination's hash when the file there is VGS's.
    dest_state_of "$dest" "${record[$key]-}"
    [[ $dest_state == own && $sum == "$hash" ]] || writes+=("$entry")
    text+=$'\n'"$key=$hash"
  done
  # A directory VGS made before stays VGS's to remove.
  if [[ -n ${record[state-dir]+set} || ! -e $vpn_state_dir ]]; then text+=$'\n'"state-dir=1"; fi
  if [[ -n ${record[cache-dir]+set} || ! -e $vpn_cache_dir ]]; then text+=$'\n'"cache-dir=1"; fi
  record_put vpn-kill-switch "$text"
  for entry in "${writes[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    cmd "$install" -m "$file_mode" -o root -g root -T -- "$kill_switch_source/$name" "$dest"
    [[ $key == script ]] || reload=1
    # enable --now leaves a running path unit or socket on the settings it
    # started with; a restart loads the new ones.
    if [[ $key == path-unit || $key == socket-unit ]] && "$systemctl" is-enabled --quiet "${dest##*/}"; then restarts+=("${dest##*/}"); fi
  done
  [[ -e $vpn_state_dir ]] || cmd "$install" -d -m 0755 -o "$uid" -g "$gid" -- "$vpn_state_dir"
  [[ -e $vpn_cache_dir ]] || cmd "$install" -d -m 0700 -o root -g root -- "$vpn_cache_dir"
  for unit in "${kill_switch_watchers[@]}"; do
    if "$systemctl" is-failed --quiet "$unit"; then
      failed+=("$unit")
      [[ " ${restarts[*]} " == *" $unit "* ]] || restarts+=("$unit")
    fi
  done
  [[ -z $reload ]] || cmd "$systemctl" daemon-reload
  # enable --now leaves a failed unit failed; reset-failed and a restart run it.
  for unit in "${failed[@]}"; do cmd "$systemctl" reset-failed "$unit"; done
  for unit in "${restarts[@]}"; do cmd "$systemctl" restart "$unit"; done
  for unit in "${kill_switch_units[@]}"; do cmd "$systemctl" enable --now "$unit"; done
}

# The units stop first, so no change starts a sync once the table is gone.
# Declaring the table before its delete makes the delete hold whether or
# not the rule is armed, in one transaction.
undo_vpn_kill_switch() {
  local entry key name dest file_mode unit nft rm systemctl dir reload="" present=()
  program rm rm
  program systemctl systemctl
  # A table outlives nft's removal, and this delete is the one undo owes.
  program nft nft
  for entry in "${kill_switch_files[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    # Refuses a file VGS did not write; leaves dest_state at own or none.
    dest_state_of "$dest" "${record[$key]-}"
    [[ $dest_state == none ]] || present+=("$entry")
  done
  for unit in "${kill_switch_units[@]}"; do
    [[ ! -e $units_dir/$unit ]] || cmd "$systemctl" disable --now "$unit"
  done
  cmd_in "table inet vgshell_kill_switch {}"$'\n'"delete table inet vgshell_kill_switch" "$nft" -f -
  for entry in "${present[@]}"; do
    IFS='|' read -r key name dest file_mode <<<"$entry"
    cmd "$rm" -f -- "$dest"
    [[ $key == script ]] || reload=1
  done
  [[ -z $reload ]] || cmd "$systemctl" daemon-reload
  for dir in "$vpn_cache_dir:cache-dir" "$vpn_state_dir:state-dir"; do
    no_symlink "${dir%:*}"
    if [[ -n ${record[${dir##*:}]+set} && -e ${dir%:*} ]]; then cmd "$rm" -rf -- "${dir%:*}"; fi
  done
  record_drop vpn-kill-switch
}

apply_reboot_notice() {
  local ln install text="uid=$uid" made_dir=""
  trusted "$pacman_dir" || refuse 1 "untrusted=$pacman_dir"
  owned_dir "$hooks_dir"
  read_notice_link || refuse 1 "link=unreadable path=$notice_link"
  [[ $notice_state == none ]] || refuse 1 "destination=foreign path=$notice_link" "a file VGS did not write is never replaced"
  program ln ln
  # A directory VGS made before stays VGS's to remove.
  if read_record reboot-notice; then made_dir="${record[hooks-dir]-}"; fi
  [[ -e $hooks_dir ]] || made_dir=1
  [[ -z $made_dir ]] || text+=$'\n'"hooks-dir=1"
  record_put reboot-notice "$text"$'\n'"link=1"
  if [[ ! -e $hooks_dir ]]; then
    program install install
    cmd "$install" -d -m 0755 -o root -g root -- "$hooks_dir"
  fi
  cmd "$ln" -s -- /dev/null "$notice_link"
}

undo_reboot_notice() {
  local rm rmdir
  no_symlink "$hooks_dir"
  read_notice_link || refuse 1 "link=unreadable path=$notice_link"
  [[ $notice_state != foreign ]] || refuse 1 "destination=foreign path=$notice_link" "a file VGS did not write is never removed"
  if [[ $notice_state == off && -n ${record[link]+set} ]]; then
    program rm rm
    cmd "$rm" -f -- "$notice_link"
  fi
  if [[ -n ${record[hooks-dir]+set} && -e $hooks_dir ]]; then
    program rmdir rmdir
    cmd "$rmdir" --ignore-fail-on-non-empty -- "$hooks_dir"
  fi
  record_drop reboot-notice
}

undo_udev_rule() { # STEP
  local rm source destination subsystem
  udev_rule_of "$1"
  dest_state_of "$destination" "${record[rule]}"
  if [[ $dest_state == own ]]; then
    program rm rm
    cmd "$rm" -f -- "$destination"
    udev_reload "$subsystem"
  fi
  record_drop "$1"
}

undo_i2c_dev() {
  local modprobe
  if [[ ${record[boot]} == "$boot" && -d $sys/class/i2c-dev ]]; then
    program modprobe modprobe
    cmd "$modprobe" -r i2c-dev
  fi
  record_drop i2c-dev
}

undo_service() { # STEP
  local unit systemctl
  unit_of "$1"
  program systemctl systemctl
  [[ -z ${record[enabled]+set} ]] || cmd "$systemctl" disable "$unit"
  [[ -z ${record[started]+set} || ${record[boot]} != "$boot" ]] || cmd "$systemctl" stop "$unit"
  record_drop "$1"
}

# Omarchy's reload order, reload_dns_stack in bin/omarchy-dns:222-238,
# whose comment says a single reload leaves the choice one selection
# behind: NetworkManager's configuration, each connected Wi-Fi or
# Ethernet device, resolved, restarted when its reload fails, then
# NetworkManager's DNS once more. NetworkManager refuses a reapply while
# the device's profile holds a saved change reapply cannot take, such as
# a new Wi-Fi password (NetworkManager 1.58.1 src/core/devices/
# nm-device.c, check_and_reapply_connection); the profiles already
# hold the choice, and the device takes it when it next connects, so a
# refused reapply warns and the step goes on.
dns_reload() {
  local nmcli systemctl device line
  program nmcli nmcli
  program systemctl systemctl
  cmd "$nmcli" general reload conf
  for device in "${dns_devices[@]}"; do
    case "$mode" in
      show) cmd "$nmcli" device reapply "$device" ;;
      run) sudo -- "$nmcli" device reapply "$device" </dev/null || vgs_tui_warn "$device keeps its earlier DNS servers until it next connects." ;;
      *) refuse 1 "internal=mode value=$mode" ;;
    esac
  done
  case "$mode" in
    show)
      cmd "$systemctl" reload systemd-resolved.service
      line="On failure: sudo$(printf ' %q' "$systemctl" restart systemd-resolved.service)"
      shown+="$line"$'\n'
      shown_commands+=("$line")
      ;;
    run) sudo -- "$systemctl" reload systemd-resolved.service </dev/null || cmd "$systemctl" restart systemd-resolved.service ;;
    *) refuse 1 "internal=mode value=$mode" ;;
  esac
  cmd "$nmcli" general reload dns-full
}

# Sets args to the nmcli property words that give profile UUID IGNORE4,
# IPV4, IGNORE6 and IPV6, leaving a family whose method takes no servers
# as it is, since NetworkManager refuses ipvX.dns there.
dns_fields() { # UUID IGNORE4 IPV4 IGNORE6 IPV6
  args=()
  if dns_family_takes 4 "${dns_v4m[$1]}"; then args+=(ipv4.ignore-auto-dns "$2" ipv4.dns "$3"); fi
  if dns_family_takes 6 "${dns_v6m[$1]}"; then args+=(ipv6.ignore-auto-dns "$4" ipv6.dns "$5"); fi
  return 0
}

# dns-custom's servers, set by dns_ask_servers before the plan.
dns_custom4="" dns_custom6=""

# Splits the words of argv[1], commas as spaces as Omarchy's
# normalize_servers reads them, into IPv4 and IPv6 literals and prints
# both families on one line, each comma-joined or `-`, in the form NetworkManager
# prints them back: ipaddress's compressed IPv6 form matched glibc's
# inet_ntop, which nm_dns_uri_normalize prints through, on 200009 random
# addresses (python3 -I on cachy, 2026-11-08), save the embedded IPv4
# forms inet_ntop prints dotted, which are refused. Any other word prints
# `invalid <word>` and exits 1.
dns_split_servers='
import ipaddress, sys
families = {4: [], 6: []}
words = sys.argv[1].replace(",", " ").split()
if not words:
    print("empty -")
    sys.exit(1)
for word in words:
    try:
        address = ipaddress.ip_address(word)
    except ValueError:
        print("invalid " + word)
        sys.exit(1)
    packed = address.packed
    if address.version == 6 and ("%" in word or address.ipv4_mapped is not None or (packed[:12] == bytes(12) and packed[12:14] != bytes(2))):
        print("invalid " + word)
        sys.exit(1)
    text = str(address) if address.version == 4 else address.compressed
    if text not in families[address.version]:
        families[address.version].append(text)
print((",".join(families[4]) or "-") + " " + (",".join(families[6]) or "-"))
'

# Asks on the step's terminal for dns-custom's servers, as Omarchy reads
# them on its own (bin/omarchy-dns:293-305), and sets dns_custom4 and
# dns_custom6; refuses a word that is not an IPv4 or IPv6 address before
# anything is written. The answer reaches root only as these literals.
dns_ask_servers() {
  local python typed parsed answer=0 status=0
  program python python3
  source "$lib_dir/tui.sh" || refuse 1 "library=missing path=$lib_dir/tui.sh"
  typed="$(vgs_tui_input --header 'The DNS servers to use: IPv4 and IPv6 addresses, separated by spaces.' --placeholder '1.1.1.1 2606:4700:4700::1111')" || answer=$?
  case "$answer" in
    0) ;;
    2) exit 2 ;;
    *) exit 130 ;;
  esac
  parsed="$("$python" -I -c "$dns_split_servers" "$typed")" || status=$?
  if ((status != 0)); then
    [[ $parsed == "invalid "* || $parsed == "empty -" ]] || refuse 1 "servers=unreadable exit=$status"
    refuse 1 "servers=${parsed%% *} word=$(printf '%q' "${parsed#* }")" "Type IPv4 and IPv6 addresses only. No change made."
  fi
  [[ $parsed =~ ^($dns_char+)\ ($dns_char+)$ ]] || refuse 1 "servers=unreadable exit=0"
  dns_custom4="$(dns_unlisted "${BASH_REMATCH[1]}")" dns_custom6="$(dns_unlisted "${BASH_REMATCH[3]}")"
}

# A note the plan sets for confirm_and_run to print before its commands.
step_note=""

apply_dns() { # STEP
  local provider="${1#dns-}" install nmcli text pending uuid saved servers made_dir="" recorded_dropin="" new4 new6 replaced=""
  program install install
  program nmcli nmcli
  trusted "$systemd_dir" || refuse 1 "untrusted=$systemd_dir"
  owned_dir "$resolved_conf_dir"
  dns_read_done=""
  dns_read || refuse 1 "networkmanager=$dns_unread"
  ((${#dns_uuids[@]} > 0)) || refuse 1 "state=absent reason=no-profile step=$1"
  if read_record dns; then
    recorded_dropin="${record[dropin]-}" made_dir="${record[dropin-dir]-}"
  fi
  [[ -e $resolved_conf_dir ]] || made_dir=1
  dns_servers "$provider" "$dns_custom4" "$dns_custom6"
  new4="$want4" new6="$want6"
  render_dns_dropin "$provider"
  # Leaves sum at the hash of the drop-in in place when it is VGS's.
  dest_state_of "$dns_dropin" "$recorded_dropin"
  text="uid=$uid"$'\n'"provider=$provider"
  [[ $provider != custom ]] || text+=$'\n'"ipv4=$(dns_listed "$new4")"$'\n'"ipv6=$(dns_listed "$new6")"
  text+=$'\n'"dropin=$dns_dropin_sum"
  [[ -z $made_dir ]] || text+=$'\n'"dropin-dir=1"
  pending=""
  for uuid in "${dns_uuids[@]}"; do
    saved="${record[profile-$uuid]-}"
    # Values a provider VGS recorded set are not the profile's own, so a
    # second provider keeps what the first change replaced; a profile
    # someone changed since is recorded as it is now. Until the change
    # reaches a profile, pending names the servers VGS set on it, which
    # cmd's refusal of a failed modify leaves in the record.
    if [[ -n $saved ]] && dns_vgs_held "$uuid"; then
      dns_holds "$uuid" "$new4" "$new6" || pending+=$'\n'"prior-$uuid=$(dns_listed "$held4") $(dns_listed "$held6")"
    else
      saved="${dns_v4i[$uuid]} $(dns_listed "${dns_v4d[$uuid]}") ${dns_v6i[$uuid]} $(dns_listed "${dns_v6d[$uuid]}")"
    fi
    text+=$'\n'"profile-$uuid=$saved"
    if dns_foreign "$uuid"; then
      servers="${dns_v4d[$uuid]}${dns_v4d[$uuid]:+${dns_v6d[$uuid]:+,}}${dns_v6d[$uuid]}"
      replaced+="${replaced:+; }${dns_name[$uuid]}: ${servers//,/, }"
    fi
  done
  step_note=""
  [[ -z $replaced ]] || step_note="These networks have DNS servers of their own, which VGS replaces and undo puts back. $replaced."
  record_put dns "$text$pending"
  [[ -e $resolved_conf_dir ]] || cmd "$install" -d -m 0755 -o root -g root -- "$resolved_conf_dir"
  [[ $dest_state == own && $sum == "$dns_dropin_sum" ]] || put_text "$dns_dropin" "$dns_dropin_text"
  for uuid in "${dns_uuids[@]}"; do
    dns_holds "$uuid" "$new4" "$new6" && continue
    dns_fields "$uuid" yes "$new4" yes "$new6"
    cmd "$nmcli" connection modify uuid "$uuid" "${args[@]}"
  done
  [[ -z $pending ]] || record_put dns "$text"
  dns_reload
  dns_read_done=""
}

undo_dns() {
  local nmcli rm rmdir uuid saved ignore4 ipv4 ignore6 ipv6
  program nmcli nmcli
  program rm rm
  program rmdir rmdir
  [[ -n ${record[dropin]-} ]] && dns_recorded || refuse 1 "record=malformed path=$record_dir/dns"
  no_symlink "$resolved_conf_dir"
  dns_read_done=""
  dns_read || refuse 1 "networkmanager=$dns_unread"
  # Refuses a drop-in edited after apply, and leaves the record.
  dest_state_of "$dns_dropin" "${record[dropin]}"
  [[ $dest_state != own ]] || cmd "$rm" -f -- "$dns_dropin"
  [[ -z ${record[dropin-dir]+set} || ! -e $resolved_conf_dir ]] || cmd "$rmdir" --ignore-fail-on-non-empty -- "$resolved_conf_dir"
  for uuid in "${dns_uuids[@]}"; do
    saved="${record[profile-$uuid]-}"
    # A profile changed after apply keeps its newer servers.
    [[ -n $saved ]] && dns_vgs_held "$uuid" || continue
    read -r ignore4 ipv4 ignore6 ipv6 <<<"$saved"
    dns_fields "$uuid" "$ignore4" "$(dns_unlisted "$ipv4")" "$ignore6" "$(dns_unlisted "$ipv6")"
    ((${#args[@]} == 0)) || cmd "$nmcli" connection modify uuid "$uuid" "${args[@]}"
  done
  dns_reload
  record_drop dns
  dns_read_done=""
}

# Calls VERB's plan for STEP in the current mode.
plan() { # VERB STEP
  case "$2" in
    apple-displays|wake-sources) "$1_udev_rule" "$2" ;;
    disk-sleep) "$1_disk_sleep" ;;
    i2c-dev) "$1_i2c_dev" ;;
    service-bluetooth|service-tailscaled|service-cups|service-sshd) "$1_service" "$2" ;;
    greeter) "$1_greeter" ;;
    vpn-kill-switch) "$1_vpn_kill_switch" ;;
    bandwhich-capture) "$1_bandwhich_capture" ;;
    reboot-notice) "$1_reboot_notice" ;;
    voxtype-engine) "$1_voxtype_engine" ;;
    vgs-quickshell-repository) "$1_vgs_quickshell_repository" ;;
    dns-cloudflare|dns-google|dns-custom) "$1_dns" "$2" ;;
    *) refuse 1 "internal=plan step=$2" ;;
  esac
}

# Shows VERB's plan for STEP, asks once, then under one sudo session and
# the record directory's lock plans again and runs it.
confirm_and_run() { # VERB STEP
  local verb="$1" step="$2" planned make_dir="" install answer=0 lock commands=()
  mode=show shown="" shown_commands=()
  plan "$verb" "$step"
  planned="$shown"
  commands=("${shown_commands[@]}")
  if [[ ! -d $record_dir ]]; then
    program install install
    make_dir="sudo$(printf ' %q' "$install" -d -m 0755 -o root -g root -- "$record_dir")"$'\n'
    commands=("${make_dir%$'\n'}" "${commands[@]}")
  fi
  # shellcheck source=lib/tui.sh
  source "$lib_dir/tui.sh" || refuse 1 "library=missing path=$lib_dir/tui.sh"
  vgs_tui_step "${step_description[$verb:$step]}"
  [[ -z $step_note ]] || vgs_tui_text "$step_note"
  vgs_tui_text 'These commands run as root:'
  vgs_tui_commands "${commands[@]}"
  # A root command is never answered for the user, unattended or not.
  VGS_TUI_UNATTENDED='' vgs_tui_confirm "Run these commands as root?" || answer=$?
  case "$answer" in
    0) ;;
    1) refuse 1 "declined=$verb step=$step" "No change made." ;;
    *) exit "$answer" ;;
  esac
  vgs_tui_sudo_session start || refuse 1 "sudo=not-authorized"
  mode=run
  if [[ -n $make_dir ]]; then cmd "$install" -d -m 0755 -o root -g root -- "$record_dir"; fi
  trusted "$record_dir" || refuse 1 "untrusted=$record_dir"
  exec {lock}<"$record_dir" || refuse 1 "lock=open path=$record_dir"
  flock -w 60 "$lock" || refuse 1 "lock=busy path=$record_dir" "another system step held the lock for 60 s"
  mode=show shown="" shown_commands=()
  plan "$verb" "$step"
  [[ $shown == "$planned" ]] || refuse 1 "plan=changed step=$step" "the commands differ from the ones shown; nothing more was run"
  mode=run
  plan "$verb" "$step"
  vgs_tui_sudo_session end
}

# Profile IDs and recovery intent are read by the transaction, never supplied
# by a plugin. Keep the session and record lock until its children are reaped
# and recovery is verified; the independent TUI owns this whole lifetime.
tailscale_transaction() { # apply|undo STEP
  local verb="$1" step="$2" python tailscale install tee mv rm record_name answer=0 lock result=0 action
  local commands=()
  program python python3
  program tailscale tailscale
  program install install
  program tee tee
  program mv mv
  program rm rm
  case "$verb:$step" in
    apply:tailscale-account-add) action=add ;;
    apply:tailscale-operator) action=operator ;;
    undo:tailscale-operator) action=undo-operator ;;
    *) refuse 1 "operation=not-undoable step=$step" ;;
  esac
  commands=("sudo$(printf ' %q' "$tailscale" switch --list --json)"
    "sudo$(printf ' %q' "$tailscale" debug prefs)"
    "sudo$(printf ' %q' "$tailscale" get operator)"
    "sudo$(printf ' %q' "$tailscale" status --json)")
  if [[ $action == add ]]; then
    commands+=("sudo$(printf ' %q' "$tailscale" login "--operator=$user" --timeout 0)")
  elif [[ $action == operator ]]; then
    commands+=("sudo$(printf ' %q' "$tailscale" set "--operator=$user")")
  else
    commands+=("sudo $tailscale set --operator=<previous operator recorded for this profile>")
  fi
  # These conditional commands take only the retained daemon reading. Their
  # exact argv is displayed by the owner before execution, after preflight.
  commands+=("On failure: sudo $tailscale switch <previous profile ID>, then sudo $tailscale up or down to restore its connection setting."
    "With no previous profile: sudo $tailscale logout.")
  if [[ ! -d $record_dir ]]; then
    commands+=("sudo$(printf ' %q' "$install" -d -m 0755 -o root -g root -- "$record_dir")")
  fi
  for record_name in tailscale-operator tailscale-account-add; do
    commands+=("sudo$(printf ' %q' "$tee" -- "$record_dir/.$record_name") (verified profile data on stdin)"
      "sudo$(printf ' %q' "$mv" -fT -- "$record_dir/.$record_name" "$record_dir/$record_name")")
  done
  commands+=("sudo$(printf ' %q' "$rm" -f -- "$record_dir/tailscale-account-add")")
  source "$lib_dir/tui.sh" || refuse 1 "library=missing path=$lib_dir/tui.sh"
  vgs_tui_step "${step_description[${verb}:${step}]}"
  vgs_tui_text 'This transaction runs these commands as root. The browser runs as your own login.'
  vgs_tui_commands "${commands[@]}"
  VGS_TUI_UNATTENDED="" vgs_tui_confirm 'Run this Tailscale transaction as root?' || answer=$?
  case "$answer" in
    0) ;;
    1) refuse 1 "declined=$verb step=$step" "No change made." ;;
    *) return "$answer" ;;
  esac
  vgs_tui_sudo_session start || refuse 1 "sudo=not-authorized"
  mode=run
  if [[ ! -d $record_dir ]]; then cmd "$install" -d -m 0755 -o root -g root -- "$record_dir"; fi
  trusted "$record_dir" || refuse 1 "untrusted=$record_dir"
  exec {lock}<"$record_dir" || refuse 1 "lock=open path=$record_dir"
  flock -w 60 "$lock" || refuse 1 "lock=busy path=$record_dir"
  # Terminal group signals also reach the transaction. Keep the sudo session
  # alive while its foreground owner handles them and verifies recovery.
  trap ':' HUP INT TERM
  "$python" -I "$lib_dir/tailscale-account.py" "$action" || result=$?
  exec {lock}>&-
  vgs_tui_sudo_session end
  return "$result"
}

# ---------------------------------------------------------------- verbs

json_status() {
  local step out="" sep=""
  for step in "${steps[@]}"; do
    out+="$sep\"$step\":{\"state\":\"${state_of[$step]}\",\"reason\":\"${reason_of[$step]}\"}"
    sep=,
  done
  printf '{"steps":{%s}}\n' "$out"
}

# Whether STEP's last probe, probe_state and probe_reason, reads what a
# NixOS configuration grants: a needed step, or a service step whose unit
# is missing, which its configuration snippet installs and enables
# (nixos_snippet).
nixos_grants() { # STEP
  [[ $1 != tailscale-account-add ]] || return 1
  [[ $probe_state == needed ]] || [[ $1 == service-* && $probe_state == absent && $probe_reason == unit-missing ]]
}

# Probes every step into state_of and reason_of, reading each step
# nixos_grants admits as nixos on NixOS, and a needed one as unknown when
# the system cannot be told.
probe_all() {
  local step
  local -a granted=()
  declare -gA state_of=() reason_of=()
  for step in "${steps[@]}"; do
    probe "$step"
    state_of[$step]="$probe_state" reason_of[$step]="$probe_reason"
    if nixos_grants "$step"; then granted+=("$step"); fi
  done
  ((${#granted[@]} > 0)) || return 0
  if ! detect_system; then
    for step in "${granted[@]}"; do
      [[ ${state_of[$step]} != needed ]] || state_of[$step]=unknown reason_of[$step]=system-undetected
    done
  elif [[ $detected_system == nix ]]; then
    for step in "${granted[@]}"; do state_of[$step]=nixos; done
  fi
}

verb_status() { # [--json]
  local step
  probe_all
  if [[ ${1:-} == --json ]]; then json_status; return; fi
  for step in "${steps[@]}"; do
    printf 'system=%s state=%s reason=%s\n' "$step" "${state_of[$step]}" "${reason_of[$step]}"
  done
}

verb_apply() { # STEP
  local step="$1"
  probe "$step"
  case "$probe_state" in
    # dns-custom asks for its servers again: the ones typed may differ
    # from those in effect.
    ready) [[ $step == dns-custom ]] || { printf 'ok system=%s state=ready\n' "$step"; return; } ;;
    needed) ;;
    absent)
      # A missing service unit is one the NixOS configuration installs.
      nixos_grants "$step" && detect_system && [[ $detected_system == nix ]] ||
        refuse 1 "state=$probe_state reason=$probe_reason step=$step${probe_fix:+ fix=$probe_fix}" ${probe_hint[@]+"${probe_hint[@]}"}
      ;;
    denied|unknown) refuse 1 "state=$probe_state reason=$probe_reason step=$step${probe_fix:+ fix=$probe_fix}" ${probe_hint[@]+"${probe_hint[@]}"} ;;
    *) refuse 1 "internal=state value=$probe_state" ;;
  esac
  if [[ $step == tailscale-account-add ]]; then
    tailscale_transaction apply "$step"
    return
  fi
  detect_or_refuse
  if [[ $detected_system == nix ]]; then
    printf 'ok system=%s skipped=nixos-config\n' "$step"
    printf 'NixOS builds the system from its configuration, so VGS changes nothing here.\n'
    printf 'Add this to your system configuration, then rebuild it:\n'
    nixos_snippet "$step"
    return
  fi
  read_boot_id
  if [[ $step == tailscale-operator ]]; then
    tailscale_transaction apply "$step"
    return
  fi
  if [[ $step == dns-custom ]]; then
    dns_ask_servers
    # `record` is still the probe's reading of the DNS record.
    if [[ $probe_state == ready && ${record[ipv4]-} == "$(dns_listed "$dns_custom4")" && ${record[ipv6]-} == "$(dns_listed "$dns_custom6")" ]]; then
      printf 'ok system=%s state=ready\n' "$step"
      return
    fi
  fi
  confirm_and_run apply "$step"
  probe "$step"
  [[ $probe_state == ready ]] ||
    refuse 1 "state=$probe_state reason=$probe_reason step=$step" "the commands ran, but the access is still missing"
  printf 'ok system=%s state=ready\n' "$step"
}

verb_undo() { # STEP
  local step="$1"
  detect_or_refuse
  if [[ $detected_system == nix ]]; then
    printf 'ok system=%s skipped=nixos-config\n' "$step"
    printf 'VGS changed nothing on NixOS. Remove the lines from your system configuration and rebuild it.\n'
    return
  fi
  if [[ $step == tailscale-operator || $step == tailscale-account-add ]]; then
    tailscale_transaction undo "$step"
    return
  fi
  if ! read_record "$step"; then
    printf 'ok system=%s state=untouched\n' "$step"
    return
  fi
  read_boot_id
  greeter_kept=""
  if [[ $step == greeter && -n ${record[deferred]+set} ]] && greetd_runs_vgs; then greeter_kept=1
  else confirm_and_run undo "$step"
  fi
  if [[ -n $greeter_kept ]]; then
    printf 'ok system=%s state=deferred\n%s\n' "$step" "$greeter_deferred_text"
    return
  fi
  printf 'ok system=%s state=undone\n' "$step"
}

main() {
  local verb="${1:-}"
  (($# == 0)) || shift
  case "$verb" in
    status)
      (($# == 0)) || [[ $# == 1 && $1 == --json ]] || bad_invocation "argument=$(printf '%q' "$1")"
      ;;
    apply|undo)
      (($# == 1)) || bad_invocation "count=$# verb=$verb"
      known_step "$1" || bad_invocation "step=$(printf '%q' "$1")"
      ;;
    *) bad_invocation "verb=$(printf '%q' "$verb")" ;;
  esac
  ((EUID != 0)) || refuse 1 "caller=root" "run vgshell system as your own user; sudo asks for the password"
  uid="$(id -u)" || refuse 1 "user=unknown"
  gid="$(id -g)" || refuse 1 "user=unknown"
  user="$(id -un)" || refuse 1 "user=unknown"
  declare -gA record=()
  "verb_$verb" "$@"
}

main "$@"
