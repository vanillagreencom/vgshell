#!/usr/bin/env bash
# vgshell-tui: open and run tasks in VGS floating terminals, and open an ssh
# session to a device in the user's own terminal.
#
# Usage:
#   vgshell-tui launch --title <text> [--size default|wide|tall] [--presentation full|plain]
#                   [--plugin <id> --dir <snapshot>] [--record <key> --run <run>] -- <command...>
#       Open a floating terminal and run the command.
#   vgshell-tui present [--presentation full|plain] [--plugin <id> --dir <snapshot>]
#                    [--record <key> --run <run> --record-dir <dir> --app-id <id> --window-title <text>]
#                    -- <command...>
#       Run the command in this terminal. Full shows the VGS logo.
#       Plain skips the logo and the close prompt.
#   vgshell-tui check
#       Check that xdg-terminal-exec is installed.
#   vgshell-tui reap
#       Update the saved results for tasks whose terminal has closed.
#   vgshell-tui wait --record <key> --run <run>
#       Wait for a task to end and print its saved result.
#   vgshell-tui ssh --name <name> --host <host>
#       Open the user's terminal, tiled, on ssh-session.
#   vgshell-tui ssh-session --name <name> --host <host>
#       In that terminal: ssh-run in a new window <name> of the tmux session
#       tailnet, created when absent, or with no tmux on PATH alone.
#   vgshell-tui ssh-run -- <host>
#       Run `ssh -- <host>` and keep a failure on screen until a key.

# launch runs `setsid -f xdg-terminal-exec --app-id=<app-id> --title="VGS ·
# <text>" -- <this file> present ...`, with no shell between, so the
# terminal outlives the process that asked for it: a shell restart kills the
# launchers it started, never their terminals. Without --record it exits 0
# once setsid has forked. The terminal does not inherit VGSHELL_RUNNER_PID, the
# variable that marks the shell's own processes: `vgshell pkg run` refuses a
# caller that carries it, and a single-instance terminal hands its
# environment to every later window. The size
# classes and their app-ids are shell/Core/HyprlandLayer.js's TUI_WINDOWS,
# the table the Hyprland layer writes its window rules from, read under
# node; a size it does not hold is a bad invocation. Everything present
# needs travels in its argv, never in the environment: a single-instance
# terminal opens the window from a process that was already running.
#
# present clears the screen, prints bin/lib/logo.txt in the theme accent at
# the library's content edge, the column its text starts at,
# runs argv as a list, never through a shell, and keeps its exit code.
# Unless the code is 130, a Ctrl-C, it shows the library's closing prompt,
# vgs_tui_close_prompt: `● Done. Press any key to close.`, `● Press any
# key to close.` for 69, a refusal before anything ran, or `● The task failed.
# Press any key to close.` on /dev/tty, not on stdout, and waits for
# one key. The prompt hides the exit code; the ended run record below keeps
# `code` for logs and readers. `plain` skips the logo and the prompt. A plugin's
# recorded run that failed first makes the failure marker
# <stem>@<run>.failed beside its records, and its prompt also ends once the
# marker is gone: a later present of any key of the same plugin removes that
# plugin's markers, <plugin id>@*.failed, before it runs its command, so an
# older failed window of the plugin closes itself instead of waiting behind
# the new one. present removes its own marker when it exits. A marker's name
# does not end in .json, so the shell's record listing skips it. Before the
# command runs it exports:
#   - each line of ${XDG_STATE_HOME:-~/.local/state}/vgshell/theme/gum.env, which
#     is parsed and never sourced: every line must be a colour name of
#     gum_colour_line below with #rrggbb, or empty for no colour, which
#     drops gum's own default for that key, or a bold name of
#     gum_bold_line with true, or a declared formatter selector naming
#     gum.glamour.json in the generated theme directory; otherwise no line is
#     exported and a warning names
#     the first bad line. With no gum.env, as before any theme apply, the
#     lines are `vgshell-theme-judge gum-default`'s, under the same rule:
#     the shipped vgs accent and bold on the selection and no colour
#     elsewhere, so gum keeps the terminal's own background and text;
#     when the judge fails, present warns `vgshell-tui:
#     gum-env=default-unavailable exit=<n>` and exports none;
#   - VGS_TUI_LIB, this checkout's bin/lib/tui.sh, and VGS_TUI_LOGO, its
#     bin/lib/logo.txt;
#   - VGS_TUI_MARK, the window's blank row mark that bin/lib/tui.sh keeps,
#     a private file under $XDG_RUNTIME_DIR that present removes when it
#     exits; under the full presentation it marks the blank row under the
#     logo, so the first block draws no second one. Without the file,
#     unset when mktemp fails, every block draws its own row;
#   - with --record, the package outcome channel: VGS_TUI_OUTCOME, a private
#     empty file under $XDG_RUNTIME_DIR that present removes when it exits, VGS_TUI_OUTCOME_PID, present's
#     own pid, and VGS_TUI_RECORD_KEY and VGS_TUI_RECORD_RUN, the run's key
#     and id; without --record all four are unset. Only the package owner,
#     bin/vgshell-pkg as present's own command, writes the file
#     (bin/lib/pkg-retry.js), and present reads it once the command exits;
#   - with --plugin, VGS_PLUGIN_ID and VGS_PLUGIN_DIR, a private copy of the
#     whole snapshot under $XDG_RUNTIME_DIR that present removes when it
#     exits, so a `vgshell restart`, which removes the snapshot, cannot pull a
#     file from under a running script, the plugin's own data and programs
#     beside tui/ included. argv[0] is then a path
#     relative to the snapshot, inside its tui/ directory, and runs from the
#     copy. Without --plugin both are unset.
#
# The exit record. With --record <key> --run <run>, launch hands present the
# record directory, ${XDG_RUNTIME_DIR}/vgshell/tui, and the app-id and title it
# opened the window with, and after the fork waits up to start_ceiling
# seconds for the run's record before it exits 0. Before the logo, present
# holds <stem>.lock in that directory, the key lock, <stem> being the key
# with its `/` as `@`, for as long as it lives, removes the running records
# and run locks earlier runs of the key left, holds <stem>@<run>.lock, the
# run lock, and writes <stem>@<run>.running.json. When it exits, after the
# prompt and on a hang-up or a termination too, it writes
# <stem>@<run>.ended.json, removes every older ended record of the key, and
# removes its run lock's name; the lock itself goes with the process. Its
# own running record stays for the next run of the key or reap to remove:
# the shell may not have read that file yet. A record is one JSON object
# written whole under a hidden name and moved into place, and is never
# rewritten: a new state is a new file, so a watcher of the directory's
# names sees every change, and an ended record stands over its run's
# running one.
#   { "key", "run", "state": "running" | "ended", "code": <int> | null,
#     "startedAt": <ISO 8601 UTC>, "endedAt": <ISO 8601 UTC> | null,
#     "window": { "appId", "title" }, "package": <outcome> }
# code is the command's exit code, or present's own when the command never
# ran to its end; null only in a record reap or wait wrote. package, only
# in an ended record whose command ran to its end and wrote the outcome
# channel, is that outcome as bin/lib/pkg-outcome.js reads it, judged by
# shell/Core/PackageReview.js packageOutcome against the run and its code;
# an outcome the judge refuses leaves the field out after the keyed line
# `vgshell-tui: package-outcome=unavailable reason=<key>`. Its kinds:
#   { "kind": "package-installed", "manager", "helper" [, "package",
#     "testsSkipped": true] }
#   { "kind": "package-skipped", "manager" }
#   { "kind": "package-failed", "manager", "helper", "status" }
#   { "kind": "package-cancelled", "manager", "status" }
#   { "kind": "package-check-failed", "manager", "helper", "package",
#     "status", "retry": null | { "originRun", "state": "available" |
#     "consumed" } }
# The shell reads the field through the same judge. reap ends every
# running record whose key's lock no process holds, since the kernel drops a
# lock with its holder, with a null code, and prints `reaped=<key> run=<run>`
# per record; a running record whose run already has its ended record it only
# removes. Either way it removes the run's lock name. wait opens the run's
# lock, blocks in flock until the presenter releases it, prints exactly one
# ended record line for the run, and removes the lock's name. A later
# run of the key holds only the key lock, so it never delays the wait. If the
# run still has only a running record, wait takes the key lock, which orders
# it against reap and a later run, and ends the run with the same null-code
# record reap writes and prints that record. If the run has no running or
# ended record, a later run of the key removed them after this run ended, and
# wait refuses with `vgshell-tui: refused: wait=<key> run=<run> reason=gone`.
# The key is two segments of [a-z0-9.-], each starting with a letter or
# digit, joined by one `/`, and the run [a-z0-9-] starting with one: the
# shell judges both, and this file only keeps its file names safe. A key
# lock's name holds one `@` and a run lock's two, and neither ends in .json.
#
# The ssh verbs open no floating TUI: no app-id, so no window rule floats
# the window and it tiles, and no record, key, lock or wait. ssh runs
# `setsid -w xdg-terminal-exec --title=<name> -- <this file> ssh-session
# --name <name> --host <host>` through the same open_terminal launch uses,
# in the background, and exits 0 once xdg-terminal-exec handed the session
# on: it exited 0 within terminal_start_ceiling seconds, as a
# single-instance terminal's hand-over does, or still runs at their end.
# An earlier nonzero exit, such as xdg-terminal-exec finding no terminal
# entry, is the refusal `terminal=failed exit=<n>`, exit 1, followed by
# xdg-terminal-exec's stderr. It runs no tmux, so no tmux client runs in
# the shell's process tree. ssh-session runs inside the terminal:
# it unsets TMUX and TMUX_PANE, which a shell started from a tmux pane
# hands on and which make tmux refuse to nest, then with no tmux on PATH
# execs `<this file> ssh-run -- <host>`; while `tmux has-session -t
# =tailnet` fails it runs `tmux new-session -s tailnet -n <window> --
# <this file> ssh-run -- <host>`; otherwise `tmux new-window -P -F
# '#{window_id}' -t =tailnet: -n <window> -- ...`, then `tmux
# select-window -t <that id>`, since a user's after-new-window hook can make
# another window current, then `tmux attach-session -t =tailnet`. `=`
# matches the session name exactly, not as a prefix. Every client of
# tailnet shows its one current window, so a second connect also moves a
# terminal already open on tailnet to the new device. The window is the
# name with each `#` doubled: tmux reads -n as a format, where `#(...)`
# runs a command. tmux 3.0 and later runs a command given as several
# arguments with no shell, so the name and the host stay argv data end to
# end. A tmux step that fails shows the library's close prompt. ssh-run
# runs ssh as a child and exits with its code. ssh's own failure, 255, and
# a missing ssh, 127, show vgs_tui_close_prompt's failed prompt, since a
# terminal or a tmux window closes as soon as its command exits; any other
# code is the remote shell's last status, ssh(1) EXIT STATUS, which a
# normal logout can carry, and closes at once. The shell judges the name and the
# host (PluginLogic.tuiSsh); this file keeps only `--` before the host and
# refuses a host that starts with `-`.
#
# bin/lib/logo.txt is the VGS mark: the letters V, G and S in full blocks
# with a light-shade shadow, 9 lines by 48 columns. It is the one copy of
# the mark; every caller reads the file.
#
# Every refusal prints one keyed line first: `vgshell-tui: refused: <key>=<value>`.
# launch exits 2 on a bad invocation, 69 when xdg-terminal-exec is not on
# PATH (`terminal=missing`), 1 when the size table cannot be read
# (`size-table=unreadable`), and 1 when no record of the run appeared
# within start_ceiling seconds (`terminal=silent`). check runs launch's own
# terminal test and exits 0, or 69 with the same refusal, or 2 on a bad
# invocation; the shell runs it to answer `launcher-missing` before it
# starts a launcher. present exits with the command's code, 2 on a bad
# invocation, 75 with no logo and no record while another presenter holds
# the key's lock (`record=<key> reason=busy`), and 1 after refusing the
# plugin copy, the script, the run lock or the running record, a refusal it
# reports under the same Done/Failed prompt. reap exits 0, or 1 on a record
# it could not end (`reap=<file>`). wait exits 0 after printing one ended
# record, 3 when the run is gone (`wait=<key> run=<run> reason=gone`), which
# the shell reads as a normal end of a run it already saw end and as a
# failure otherwise, 1 on any other refused wait (`wait=<key> run=<run>`),
# and 2 on a bad invocation. ssh, ssh-session and ssh-run exit 2 on a bad
# invocation, a missing --name or --host (`name=missing`, `host=missing`)
# or a host that starts with `-` (`host=<host>`); ssh exits 69 with launch's
# `terminal=missing`, and 1 with `terminal=failed exit=<n>` or, when it
# cannot make or open the file that holds xdg-terminal-exec's stderr,
# `terminal=unconfirmed reason=mktemp` or `reason=open`. ssh-session and ssh-run exit with
# the code of what they ran. docs/architecture/commands-are-data.md § Floating TUIs.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"
lib="$root/bin/lib/tui.sh"
logo="$root/bin/lib/logo.txt"
rt_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
gum_env="${XDG_STATE_HOME:-$HOME/.local/state}/vgshell/theme/gum.env"

# shellcheck source=lib/tui.sh
source "$lib"

# The one rule a gum.env line passes: a colour name gum reads, the
# library's rule, or one of the library's own VGS_TUI_ colours, with
# #rrggbb or nothing; or a bold name gum reads with true, since gum refuses
# to start on any other bold value; or one of the two native formatter
# selectors with the generated filename. Classes are spelled out, since a range
# follows the user's locale.
gum_colour_line="^($_vgs_tui_gum_colours|VGS_TUI_$_vgs_tui_upper+)=(#$_vgs_tui_hex{6})?\$"
gum_bold_line="^($_vgs_tui_gum_bolds)=true\$"
# The names an exit record's file is made from, and the app-id and title it
# carries: the header states each rule.
record_key_rule="^$_vgs_tui_lower($_vgs_tui_lower|[.-])*/$_vgs_tui_lower($_vgs_tui_lower|[.-])*\$"
record_run_rule="^$_vgs_tui_lower($_vgs_tui_lower|-)*\$"
record_app_id_rule="^($_vgs_tui_lower|$_vgs_tui_upper|[._-])+\$"
record_dir="$rt_dir/vgshell/tui"
# How long launch waits for the presenter to write its record: a ceiling
# on a terminal's start, not a measurement of one. A terminal slower than
# this is reported silent, and its run still writes its records.
start_ceiling=30
# How long the ssh launcher waits on xdg-terminal-exec before it counts a
# terminal still running as started: a ceiling on how soon a failed start
# reports, not a measurement of one.
terminal_start_ceiling=1
# wait's exit status for a run whose records a later run of the key
# removed: shell/Core/PluginLogic.js's TUI_WAIT_GONE.
wait_gone=3

# The app-id of size class SIZE, from the table the layer's window rules
# are written from. Exits 3 for a size the table does not hold; the loader
# exits 2 with its own refusal line for an unreadable file.
app_id_of() { # SIZE
  node -e '
    "use strict";
    const path = require("path");
    const [root, size] = process.argv.slice(1);
    const layer = require(path.join(root, "bin", "lib", "qml-library.js")).load(path.join(root, "shell", "Core", "HyprlandLayer.js"));
    if (!Object.prototype.hasOwnProperty.call(layer.TUI_WINDOWS, size)) process.exit(3);
    process.stdout.write(layer.TUI_WINDOWS[size].appId);
  ' "$root" "$1"
}

# The one terminal test launch, ssh and check share: exits 69 with the
# refusal when xdg-terminal-exec is not on PATH.
require_terminal() {
  command -v xdg-terminal-exec >/dev/null || {
    printf 'vgshell-tui: refused: terminal=missing\nVGS cannot open a terminal because xdg-terminal-exec is missing. Install it, then try the action again.\n' >&2
    exit 69
  }
}

# The one launch of the user's terminal, launch's and ssh's: xdg-terminal-exec,
# the one terminal chooser, with OPTIONS up to `--` and the argv after it,
# in a session of its own so a shell restart, which kills the launchers,
# leaves the terminal. The terminal does not inherit VGSHELL_RUNNER_PID,
# nor the descriptors 8 and 9 a caller may hold a lock on. MODE `forked`
# returns once setsid has forked, for launch, whose presenter's record
# confirms the start. MODE `confirmed`, for ssh, which keeps no record,
# waits as the header states and exits 1 on a failed start.
open_terminal() { # forked|confirmed OPTION... -- ARGV...
  local mode="$1" errors err_out err_in pid n status=0
  shift
  require_terminal
  unset VGSHELL_RUNNER_PID
  if [[ $mode == forked ]]; then
    setsid -f xdg-terminal-exec "$@" 8>&- 9>&-
    return 0
  fi
  errors="$(mktemp -- "$rt_dir/vgs-terminal.XXXXXX")" || {
    printf 'vgshell-tui: refused: terminal=unconfirmed reason=mktemp\nVGS cannot check that your terminal opened. Try the action again.\n' >&2
    exit 1
  }
  # The file is opened for writing and for reading, then unlinked at once,
  # so a launcher killed during the wait, as a shell restart kills it,
  # leaves no name behind, and a terminal still running writes its stderr
  # to an inode no directory lists.
  # shellcheck disable=SC2094 # one file, opened once to write and once to read
  if ! { exec {err_out}>"$errors" {err_in}<"$errors"; } 2>/dev/null; then
    rm -f -- "${errors:?}"
    printf 'vgshell-tui: refused: terminal=unconfirmed reason=open\nVGS cannot check that your terminal opened. Try the action again.\n' >&2
    exit 1
  fi
  rm -f -- "${errors:?}"
  # A background child of a non-interactive shell leads no process group,
  # so setsid makes its session in place and execs; where it must fork
  # instead, -w waits on the fork and exits with its status. Either way
  # the job is xdg-terminal-exec, which holds the write end alone.
  setsid -w xdg-terminal-exec "$@" 2>&"$err_out" {err_out}>&- {err_in}<&- 8>&- 9>&- &
  pid=$!
  exec {err_out}>&-
  # The job table, not the process number, says whether the job runs:
  # bash records the job's end itself, so a reused number cannot answer.
  for ((n = 0; n < terminal_start_ceiling * 20; n++)); do
    jobs -rp | grep -qx -- "$pid" || break
    sleep 0.05
  done
  if jobs -rp | grep -qx -- "$pid"; then
    exec {err_in}<&-
    return 0
  fi
  wait "$pid" || status=$?
  if [[ $status != 0 ]]; then
    printf 'vgshell-tui: refused: terminal=failed exit=%d\nVGS cannot open your terminal. The terminal launcher said:\n' "$status" >&2
    cat <&"$err_in" >&2 || :
  fi
  exec {err_in}<&-
  [[ $status == 0 ]] || exit 1
}

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self" >&2; }

bad_invocation() { # FIRST_LINE
  printf 'vgshell-tui: refused: %s\nVGS cannot open this task because its request is incomplete or invalid. Close this window and try the action again.\n' "$1" >&2
  usage
  exit 2
}

# Parses VERB's options, up to `--`, into title, size, presentation,
# plugin_id, plugin_dir, record_key, record_run, window_dir, window_app_id
# and window_title, and the command into argv. present takes no title or
# size: the terminal window carries both. The record directory, app-id and
# window title are launch's to hand present, never a caller's to choose.
parse() { # VERB ARGS...
  local verb="$1"
  shift
  title="" size=default presentation=full plugin_id="" plugin_dir="" argv=()
  record_key="" record_run="" window_dir="" window_app_id="" window_title=""
  engine_source="" engine_payload="" engine_copy=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title|--size|--presentation|--plugin|--dir|--record|--run|--record-dir|--app-id|--window-title|--engine-source|--engine-payload|--engine-copy)
        case "$verb:$1" in
          present:--title|present:--size|launch:--engine-copy|launch:--record-dir|launch:--app-id|launch:--window-title) bad_invocation "argument=$1" ;;
        esac
        [[ $# -ge 2 ]] || bad_invocation "option=$1 value=missing"
        case "$1" in
          --title) title="$2" ;;
          --size) size="$2" ;;
          --presentation) presentation="$2" ;;
          --plugin) plugin_id="$2" ;;
          --dir) plugin_dir="$2" ;;
          --record) record_key="$2" ;;
          --run) record_run="$2" ;;
          --record-dir) window_dir="$2" ;;
          --app-id) window_app_id="$2" ;;
          --window-title) window_title="$2" ;;
          --engine-source) engine_source="$2" ;;
          --engine-payload) engine_payload="$2" ;;
          --engine-copy) engine_copy="$2" ;;
        esac
        shift 2
        ;;
      --) shift; argv=("$@"); return 0 ;;
      *) bad_invocation "argument=$1" ;;
    esac
  done
  bad_invocation "separator=missing"
}

parse_wait() {
  record_key="" record_run=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --record)
        [[ $# -ge 2 ]] || bad_invocation "option=$1 value=missing"
        record_key="$2"; shift 2
        ;;
      --run)
        [[ $# -ge 2 ]] || bad_invocation "option=$1 value=missing"
        record_run="$2"; shift 2
        ;;
      *) bad_invocation "argument=$1" ;;
    esac
  done
  [[ -n $record_key ]] || bad_invocation "record=missing"
  [[ -n $record_run ]] || bad_invocation "run=missing record=$record_key"
  [[ $record_key =~ $record_key_rule ]] || bad_invocation "record=$record_key"
  [[ $record_run =~ $record_run_rule ]] || bad_invocation "run=$record_run"
}

check_common() {
  [[ ${#argv[@]} -gt 0 && -n ${argv[0]} ]] || bad_invocation "command=missing"
  case "$presentation" in full|plain) ;; *) bad_invocation "presentation=$presentation" ;; esac
  if [[ -n $engine_copy ]]; then
    # Only the presenter executing the transferred tree may release it.
    [[ -z $engine_source && ${engine_copy%/*} == "$rt_dir" && ${engine_copy##*/} == vgs-engine.*
      && -d $engine_copy && ! -L $engine_copy && ! -L $engine_copy/source
      && $root == "$(readlink -f -- "$engine_copy/source")" ]] || bad_invocation "engine=copy-owner"
  fi
  if [[ -n $plugin_id && -z $plugin_dir ]]; then bad_invocation "dir=missing plugin=$plugin_id"; fi
  if [[ -z $plugin_id && -n $plugin_dir ]]; then bad_invocation "plugin=missing dir=$plugin_dir"; fi
  if [[ -n $record_key && -z $record_run ]]; then bad_invocation "run=missing record=$record_key"; fi
  if [[ -z $record_key && -n $record_run ]]; then bad_invocation "record=missing run=$record_run"; fi
  if [[ -n $record_key ]]; then
    [[ $record_key =~ $record_key_rule ]] || bad_invocation "record=$record_key"
    [[ $record_run =~ $record_run_rule ]] || bad_invocation "run=$record_run"
  fi
}

# present's window options: all three with --record, none without it.
check_window() {
  if [[ -z $record_key ]]; then
    [[ -z $window_dir && -z $window_app_id && -z $window_title ]] || bad_invocation "record=missing"
    return 0
  fi
  [[ $window_dir == /* ]] || bad_invocation "record-dir=${window_dir:-missing}"
  [[ $window_app_id =~ $record_app_id_rule ]] || bad_invocation "app-id=${window_app_id:-missing}"
  [[ -n $window_title && $window_title != *[[:cntrl:]]* ]] || bad_invocation "window-title=missing-or-control"
}

launch() {
  local app_id status=0 pass=()
  [[ -n $title ]] || bad_invocation "title=missing"
  app_id="$(app_id_of "$size")" || status=$?
  case "$status" in
    0) ;;
    3) bad_invocation "size=$size" ;;
    *) printf 'vgshell-tui: refused: size-table=unreadable exit=%s\nVGS cannot read its terminal window sizes. Repair the VGS installation, then try again.\n' "$status" >&2; exit 1 ;;
  esac
  # present runs in the terminal's working directory, not this one.
  [[ -z $plugin_id ]] || { [[ $plugin_dir == /* ]] || plugin_dir="$PWD/$plugin_dir"; pass=(--plugin "$plugin_id" --dir "$plugin_dir"); }
  [[ -z $record_key ]] || pass+=(--record "$record_key" --run "$record_run" --record-dir "$record_dir" --app-id "$app_id" --window-title "VGS · $title")
  # Before the engine copy, which a refusal would leave behind.
  require_terminal
  # This terminal may start after its caller times out or removes staging.
  # Transfer its inputs before detachment; present alone releases the copy.
  if [[ -n $engine_source ]]; then
    copy_engine
    pass+=(--engine-copy "$engine_copy")
    self="$engine_copy/source/bin/vgshell-tui"
  fi
  open_terminal forked --app-id="$app_id" --title="VGS · $title" -- \
    "$self" present --presentation "$presentation" "${pass[@]}" -- "${argv[@]}"
  [[ -z $record_key ]] || await_record
}

# Parses the ssh verbs' --name and --host into ssh_name and ssh_host. The
# shell judged both; a host that starts with `-` is refused here too, so
# no argv this file builds reads it as an option.
parse_ssh() { # ARGS...
  ssh_name="" ssh_host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name|--host)
        [[ $# -ge 2 ]] || bad_invocation "option=$1 value=missing"
        if [[ $1 == --name ]]; then ssh_name="$2"; else ssh_host="$2"; fi
        shift 2
        ;;
      *) bad_invocation "argument=$1" ;;
    esac
  done
  [[ -n $ssh_name ]] || bad_invocation "name=missing"
  check_host "$ssh_host"
}

check_host() { # HOST
  [[ -n $1 ]] || bad_invocation "host=missing"
  [[ $1 != -* ]] || bad_invocation "host=$1"
}

ssh_launch() {
  open_terminal confirmed --title="$ssh_name" -- "$self" ssh-session --name "$ssh_name" --host "$ssh_host"
}

# Exits with CODE, after the library's close prompt for any code but 0 and
# 130, so an error stays on screen until a key: the terminal closes as soon
# as its command exits.
end_shown() { # CODE
  if [[ $1 != 0 && $1 != 130 ]]; then
    export_gum_env
    vgs_tui_close_prompt "$1"
  fi
  exit "$1"
}

# Runs ARGV as a child and ends as end_shown does with its code.
held() { # ARGV...
  local code=0
  "$@" || code=$?
  end_shown "$code"
}

ssh_session() {
  local ssh_argv=("$self" ssh-run -- "$ssh_host") window id status=0
  unset TMUX TMUX_PANE
  command -v tmux >/dev/null || exec "${ssh_argv[@]}"
  window="${ssh_name//#/##}"
  if ! tmux has-session -t =tailnet 2>/dev/null; then
    held tmux new-session -s tailnet -n "$window" -- "${ssh_argv[@]}"
  fi
  id="$(tmux new-window -P -F '#{window_id}' -t =tailnet: -n "$window" -- "${ssh_argv[@]}")" || status=$?
  [[ $status == 0 ]] || end_shown "$status"
  tmux select-window -t "$id" || end_shown "$?"
  held tmux attach-session -t =tailnet
}

# ssh to the host, as the header states: the failed prompt for ssh's own
# failure and a missing ssh alone.
ssh_run() {
  local code=0
  ssh -- "$ssh_host" || code=$?
  case "$code" in
    255|127) end_shown "$code" ;;
  esac
  exit "$code"
}

parse_ssh_run() { # ARGS...
  [[ $# -gt 0 ]] || bad_invocation "separator=missing"
  [[ $1 == -- ]] || bad_invocation "argument=$1"
  [[ $# -le 2 ]] || bad_invocation "argument=$3"
  ssh_host="${2:-}"
  check_host "$ssh_host"
}

# Waits for the run's record, running or already ended, so the shell holds
# the key busy until the presenter holds it.
await_record() {
  local stem="${record_key/\//@}" n
  for ((n = 0; n < start_ceiling * 20; n++)); do
    [[ -e $record_dir/$stem@$record_run.running.json || -e $record_dir/$stem@$record_run.ended.json ]] && return 0
    sleep 0.05
  done
  printf 'vgshell-tui: refused: terminal=silent run=%s\nThe terminal does not confirm that the task started within %d seconds. Check for an open task window before trying again.\n' "$record_run" "$start_ceiling" >&2
  exit 1
}

# Exports the colours of the gum.env lines on stdin when every line passes,
# else warns and exports none. SOURCE, `path=<file>` or `default=gum`, names
# them in the warning.
export_gum_lines() { # SOURCE
  local line n=0 keys=() values=() i value
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    value="${line#*=}"
    if [[ ${line%%=*} =~ ^($_vgs_tui_gum_paths)$ && $value == gum.glamour.json && -f ${gum_env%/*}/gum.glamour.json && ! -L ${gum_env%/*}/gum.glamour.json ]]; then
      # GLAMOUR_STYLE affects every Glamour consumer in this environment.
      # Activate it only for this presented TUI and its children, alongside
      # Gum's Markdown selector; never write a session-wide environment.
      keys+=("${line%%=*}")
      values+=("${gum_env%/*}/gum.glamour.json")
    elif [[ $line =~ $gum_colour_line || $line =~ $gum_bold_line ]]; then
      keys+=("${line%%=*}")
      values+=("${line#*=}")
    else
      printf 'vgshell-tui: gum-env=rejected line=%d %s\nVGS cannot read the saved terminal colours. The task continues. Apply your theme again to restore its colours.\n' "$n" "$1" >&2
      return 0
    fi
  done
  for i in "${!keys[@]}"; do export "${keys[i]}=${values[i]}"; done
}

# Exports gum.env's styles, or with no gum.env the judge's no-theme
# environment: the shipped vgs accent and bold on the selection only. A judge that
# cannot render it warns and exports none, so the command still runs.
export_gum_env() {
  local text status=0
  if [[ -e $gum_env ]]; then
    export_gum_lines "path=$gum_env" <"$gum_env" || printf 'vgshell-tui: gum-env=unreadable path=%s\nVGS cannot read the saved terminal colours. The task continues. Apply your theme again to restore its colours.\n' "$gum_env" >&2
    return 0
  fi
  text="$(node "$root/bin/vgshell-theme-judge" gum-default 2>/dev/null)" || status=$?
  if [[ $status != 0 ]]; then
    printf 'vgshell-tui: gum-env=default-unavailable exit=%d\nVGS cannot load its default terminal colours. The task continues. Repair the VGS installation to restore its colours.\n' "$status" >&2
    return 0
  fi
  export_gum_lines "default=gum" <<<"$text"
}

# Copies the whole snapshot into a fresh directory under the runtime dir
# and points argv[0] at the copy of the script it names. Sets
# copy_dir, which the EXIT trap removes, and refusal on a refusal.
copy_plugin() {
  local rel="${argv[0]}" script
  copy_dir="$(mktemp -d -- "$rt_dir/vgs-tui.XXXXXX")" || { refusal="copy=$rt_dir reason=mktemp"; return 1; }
  cp -R -- "$plugin_dir/." "$copy_dir/" || { refusal="copy=$plugin_dir reason=failed"; return 1; }
  # readlink -f resolves every link and `..`, so the prefix test is on the
  # file that runs.
  script="$(readlink -f -- "$copy_dir/$rel")" && [[ $script == "$copy_dir/tui/"* && -f $script ]] ||
    { refusal="script=$rel reason=outside-tui"; return 1; }
  [[ -x $script ]] || { refusal="script=$rel reason=not-executable"; return 1; }
  argv[0]="$script"
}

# The engine operation has exactly one source and optionally one verified
# Debian payload. The independent presenter owns both through command exit.
copy_engine() {
  local i arg
  engine_copy="$(mktemp -d -- "$rt_dir/vgs-engine.XXXXXX")" || bad_invocation "engine=copy-failed"
  if ! cp -R -- "$engine_source" "$engine_copy/source"; then
    rm -rf -- "${engine_copy:?}"
    bad_invocation "engine=copy-failed"
  fi
  if [[ -n $engine_payload ]] && ! cp -- "$engine_payload" "$engine_copy/engine.deb"; then
    rm -rf -- "${engine_copy:?}"
    bad_invocation "engine=payload-copy-failed"
  fi
  for i in "${!argv[@]}"; do
    arg="${argv[i]}"
    if [[ -n $engine_payload && $arg == "$engine_payload" ]]; then argv[i]="$engine_copy/engine.deb"
    elif [[ $arg == "$engine_source" ]]; then argv[i]="$engine_copy/source"
    elif [[ $arg == "$engine_source/"* ]]; then argv[i]="$engine_copy/source/${arg#"$engine_source/"}"
    fi
  done
}

# The time now as a record carries it.
record_now() { date -u +%Y-%m-%dT%H:%M:%S.%3NZ; }

# TEXT as a JSON string. check_window refused every control character, so
# the backslash and the quote are all JSON asks to escape.
json_text() { # TEXT
  local text="${1//\\/\\\\}"
  printf '"%s"' "${text//\"/\\\"}"
}

# Writes TEXT as the record NAME in DIR whole: under a hidden name the
# shell's watcher skips, then moved into place.
put_record() { # DIR NAME TEXT
  local hidden="$1/.$2.tmp"
  { printf '%s\n' "$3" >"$hidden" && mv -f -- "$hidden" "$1/$2"; } 2>/dev/null
}

# This run's record in STATE, with CODE and ENDED_AT as JSON values, and
# the judged package outcome in an ended one that has it.
record_text() { # STATE CODE ENDED_AT
  printf '{"key":"%s","run":"%s","state":"%s","code":%s,"startedAt":"%s","endedAt":%s,"window":{"appId":"%s","title":%s}%s}' \
    "$record_key" "$record_run" "$1" "$2" "$started_at" "$3" "$window_app_id" "$(json_text "$window_title")" \
    "${package_outcome:+,\"package\":$package_outcome}"
}

# The outcome the command wrote to the channel, judged against this run
# and CODE, into package_outcome, and its kind into package_kind, the
# footer's: both stay empty when it wrote none or the judge refused it. A
# retry without tests that ran and failed failed for another cause, so its
# footer is the generic one. The judge writes the fields in one order.
read_package_outcome() { # CODE
  local judged
  [[ -n $outcome_file && $1 =~ ^[0123456789]+$ ]] || return 0
  judged="$(node "$root/bin/lib/pkg-outcome.js" "$outcome_file" "$record_run" "$1")" || return 0
  [[ $judged =~ ^\{\"kind\":\"([abcdefghijklmnopqrstuvwxyz-]+)\" ]] || return 0
  package_outcome="$judged" package_kind="${BASH_REMATCH[1]}"
  [[ $judged != *'"state":"consumed"}}' ]] || package_kind=""
}

# Holds the key's lock for the rest of present's life, exiting 75 while
# another presenter holds it, removes the running records and run locks
# earlier runs of the key left, holds this run's lock and writes this run's
# running record. Sets refusal when the directory, the run lock or the
# record cannot be had, run_lock once the run lock is held, and
# record_active once the record is there.
record_start() {
  local status=0 stale
  stem="${record_key/\//@}"
  { mkdir -p -- "$window_dir" && exec {record_fd}>>"$window_dir/$stem.lock"; } 2>/dev/null ||
    { refusal="record=$window_dir reason=unwritable"; record_fd=""; return 1; }
  flock -n -E 75 "$record_fd" || status=$?
  case "$status" in
    0) ;;
    75)
      printf 'vgshell-tui: refused: record=%s reason=busy\nThis task is already open. Finish or close its other window first.\n' "$record_key" >&2
      exit 75
      ;;
    *) refusal="record=$record_key reason=flock-failed"; return 1 ;;
  esac
  # Holding the key lock proves every earlier presenter of the key is gone;
  # a lock name one left is only a name, and a waiter that holds its inode
  # keeps it.
  for stale in "$window_dir/$stem@"*.running.json "$window_dir/$stem@"*.lock; do
    if [[ -e $stale ]]; then rm -f -- "$stale"; fi
  done
  # A waiter for this run starts only once the running record below is
  # there, so no process holds the run lock yet. flock -n makes one that
  # does a refusal, not a deadlock: a waiter holding it may wait on the key
  # lock this presenter holds.
  { exec {run_fd}>>"$window_dir/$stem@$record_run.lock"; } 2>/dev/null ||
    { refusal="record=$window_dir/$stem@$record_run.lock reason=unwritable"; run_fd=""; return 1; }
  flock -n "$run_fd" || { refusal="record=$record_key run=$record_run reason=run-held"; return 1; }
  run_lock="$window_dir/$stem@$record_run.lock"
  started_at="$(record_now)"
  put_record "$window_dir" "$stem@$record_run.running.json" "$(record_text running null null)" ||
    { refusal="record=$window_dir/$stem@$record_run.running.json reason=unwritable"; return 1; }
  record_active=1
}

# Writes this run's ended record with CODE, then removes every older ended
# record of the key; the shell read each of them before it launched this run.
record_end() { # CODE
  local own="$stem@$record_run.ended.json" old
  if ! put_record "$window_dir" "$own" "$(record_text ended "$1" "\"$(record_now)\"")"; then
    printf 'vgshell-tui: refused: record=%s reason=unwritable\nVGS cannot save the task result. If VGS still shows the task as running, restart VGS.\n' "$window_dir/$own" >&2
    return 0
  fi
  for old in "$window_dir/$stem@"*.ended.json; do
    if [[ $old != "$window_dir/$own" ]]; then rm -f -- "$old"; fi
  done
}

# The EXIT trap: removes the plugin copy, ends the record, with the
# command's code when it ran to its end and present's own otherwise, and
# then removes the run lock's name. A waiter that opened the name before
# holds its inode and gets the lock when present exits; one that opens the
# name after makes a new lock, gets it at once, and finds the ended record
# already written.
present_exit() {
  local status=$?
  [[ -z $copy_dir ]] || rm -rf -- "$copy_dir"
  [[ -z $fail_marker ]] || rm -f -- "$fail_marker"
  [[ -z $mark_file ]] || rm -f -- "$mark_file"
  [[ -z $outcome_file ]] || rm -f -- "$outcome_file"
  if [[ $record_active == 1 ]]; then record_end "${ran_code:-$status}"; fi
  [[ -z $run_lock ]] || rm -f -- "$run_lock"
}

present() {
  local code refusal=""
  copy_dir="$engine_copy" record_fd="" run_fd="" run_lock="" record_active=0 ran_code="" stem="" started_at="" fail_marker="" mark_file=""
  outcome_file="" package_outcome="" package_kind=""
  trap present_exit EXIT
  if [[ -n $engine_source ]]; then copy_engine; copy_dir="$engine_copy"; fi
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  [[ -z $record_key ]] || record_start || :
  # A window of this plugin that failed and still waits for its key closes
  # once this run starts: its prompt waits on the marker removed here.
  if [[ -n $plugin_id && -n $record_key ]]; then rm -f -- "${window_dir:?}/${record_key%%/*}@"*.failed; fi
  export_gum_env
  export VGS_TUI_LIB="$lib" VGS_TUI_LOGO="$logo"
  if mark_file="$(mktemp -p "$rt_dir" vgs-tui-mark.XXXXXXXX 2>/dev/null)"; then export VGS_TUI_MARK="$mark_file"; else mark_file=""; unset VGS_TUI_MARK; fi
  unset VGS_TUI_OUTCOME VGS_TUI_OUTCOME_PID VGS_TUI_RECORD_KEY VGS_TUI_RECORD_RUN
  # mktemp makes the file 0600 and refuses a name that exists.
  if [[ $record_active == 1 ]] && outcome_file="$(mktemp -p "$rt_dir" vgs-tui-outcome.XXXXXXXX 2>/dev/null)"; then
    export VGS_TUI_OUTCOME="$outcome_file" VGS_TUI_OUTCOME_PID=$$ VGS_TUI_RECORD_KEY="$record_key" VGS_TUI_RECORD_RUN="$record_run"
  else
    outcome_file=""
  fi
  if [[ -n $plugin_id ]]; then
    export VGS_PLUGIN_ID="$plugin_id"
    if copy_plugin; then export VGS_PLUGIN_DIR="$copy_dir"; else unset VGS_PLUGIN_DIR; fi
  else
    unset VGS_PLUGIN_ID VGS_PLUGIN_DIR
  fi
  if [[ $presentation == full ]]; then
    local logo_lines=() edge
    printf '\033[H\033[2J\033[3J%s' "$(vgs_tui_sgr "${VGS_TUI_ACCENT:-}" 33)"
    mapfile -t logo_lines <"$logo" || :
    printf -v edge '%*s' "$_vgs_tui_edge" ''
    (( ${#logo_lines[@]} == 0 )) || printf '%s\n' "${logo_lines[@]/#/$edge}"
    printf '\033[0m\n'
    _vgs_tui_mark here
  fi
  if [[ -n $refusal ]]; then
    printf 'vgshell-tui: refused: %s\nVGS cannot prepare the files for this task. Close this window and try again. If it still fails, report the details above.\n' "$refusal" >&2
    code=1
  else
    # A Ctrl-C reaches the command, which the trap resets to the default;
    # present outlives it to report the code and remove the copy.
    trap : INT
    set +e
    # The command inherits neither lock: a process it leaves behind would
    # hold the key busy, or keep the run's waiter blocked, after present is
    # gone.
    if [[ -n $record_fd ]]; then "${argv[@]}" {record_fd}>&- {run_fd}>&- 8>&- 9>&-; else "${argv[@]}" 8>&- 9>&-; fi
    code=$?
    set -e
    trap - INT
  fi
  read_package_outcome "$code"
  ran_code="$code"
  if [[ $presentation == full && $code != 0 && $code != 130 && -n $plugin_id && -n $record_key ]]; then
    { : >"$window_dir/$stem@$record_run.failed"; } 2>/dev/null && fail_marker="$window_dir/$stem@$record_run.failed"
  fi
  [[ $presentation == plain ]] || vgs_tui_close_prompt "$code" "$fail_marker" "$package_kind"
  exit "$code"
}

# Ends one running record as a record with a null code and the time it was
# found. Sets ended_record_text to the record it wrote.
end_running_record() { # FILE STEM RUN REFUSAL_KEY
  local file="$1" stem="$2" run="$3" refusal_key="$4" text ended
  ended_record_text=""
  if ! text="$(cat -- "$file" 2>/dev/null)"; then
    [[ ! -e $file ]] && return 2
    printf 'vgshell-tui: refused: %s reason=unreadable\nVGS cannot read the task result. Check whether the task succeeded before trying it again.\n' "$refusal_key" >&2
    return 1
  fi
  ended="${text/\"state\":\"running\"/\"state\":\"ended\"}"
  ended="${ended/\"endedAt\":null/\"endedAt\":\"$(record_now)\"}"
  if [[ $ended != *'"state":"ended"'* || $ended == *'"endedAt":null'* || $ended == *'"state":"running"'* ]]; then
    printf 'vgshell-tui: refused: %s reason=malformed\nVGS cannot read the task result. Check whether the task succeeded before trying it again.\n' "$refusal_key" >&2
    return 1
  fi
  if ! put_record "$record_dir" "$stem@$run.ended.json" "$ended"; then
    printf 'vgshell-tui: refused: %s reason=unwritable\nVGS cannot save the task result. Check whether the task succeeded before trying it again.\n' "$refusal_key" >&2
    return 1
  fi
  rm -f -- "$file"
  ended_record_text="$ended"
}

# Ends every running record whose key's lock no process holds, as a record
# with a null code and the time it was found.
reap() {
  local file name stem run fd status failed=0 ended_record_text
  for file in "$record_dir"/*.running.json; do
    [[ -e $file ]] || continue
    name="${file##*/}"
    name="${name%.running.json}"
    stem="${name%@*}" run="${name##*@}"
    if ! { exec {fd}>>"$record_dir/$stem.lock"; } 2>/dev/null; then
      printf 'vgshell-tui: refused: reap=%s reason=lock-unopenable\nVGS cannot check a closed task. Restart VGS. If it still fails, report the details above.\n' "$file" >&2
      failed=1
      continue
    fi
    status=0
    flock -n -E 75 "$fd" || status=$?
    exec {fd}>&-
    case "$status" in
      0) ;;
      75) continue ;;
      *) printf 'vgshell-tui: refused: reap=%s reason=flock-failed\nVGS cannot check a closed task. Restart VGS. If it still fails, report the details above.\n' "$file" >&2; failed=1; continue ;;
    esac
    # A presenter that died between writing its ended record and removing
    # its running one left both: its ended record stands. Either way the
    # run's presenter is gone, and so is any use of its run lock's name.
    if [[ -e $record_dir/$stem@$run.ended.json ]]; then
      rm -f -- "$file" "$record_dir/$stem@$run.lock"
      continue
    fi
    status=0
    end_running_record "$file" "$stem" "$run" "reap=$file" || status=$?
    [[ $status == 2 ]] && continue
    [[ $status == 0 ]] || { failed=1; continue; }
    rm -f -- "$record_dir/$stem@$run.lock"
    printf 'reaped=%s run=%s\n' "${stem/@//}" "$run"
  done
  return "$failed"
}

wait_refused() { # REASON
  printf 'vgshell-tui: refused: wait=%s run=%s reason=%s\nVGS cannot read the task result. Check the task window before trying the action again.\n' "$record_key" "$record_run" "$1" >&2
}

# Prints the run's ended record, or ends a run that has only its running
# record and prints the record that ends it. Returns wait_gone when the run
# has neither, which only a later presenter of the key leaves, after this
# run ended, and 1 on any other refusal. The caller holds the run's lock.
wait_read() { # STEM
  local stem="$1" ended file key_fd status=0 ended_record_text=""
  ended="$record_dir/$stem@$record_run.ended.json"
  file="$record_dir/$stem@$record_run.running.json"
  if [[ ! -e $ended && -e $file ]]; then
    # The presenter is gone without its ended record, or it held no run
    # lock. The key lock orders this end against reap and a later run of
    # the key, and the records are read again under it.
    { exec {key_fd}>>"$record_dir/$stem.lock"; } 2>/dev/null || { wait_refused lock-unopenable; return 1; }
    flock "$key_fd" || { exec {key_fd}>&-; wait_refused flock-failed; return 1; }
    if [[ ! -e $ended && -e $file ]]; then
      end_running_record "$file" "$stem" "$record_run" "wait=$record_key run=$record_run" || status=$?
    fi
    exec {key_fd}>&-
    case "$status" in
      0) if [[ -n $ended_record_text ]]; then printf '%s\n' "$ended_record_text"; return 0; fi ;;
      2) ;;
      *) return 1 ;;
    esac
  fi
  if [[ -e $ended ]]; then
    cat -- "$ended" 2>/dev/null && return 0
    if [[ -e $ended ]]; then wait_refused unreadable; return 1; fi
  fi
  wait_refused gone
  return "$wait_gone"
}

# Waits on the run's own lock, never the key's, so a later run of the key,
# which holds the key lock, cannot delay it; then reads the run's records
# and removes the run lock's name.
wait_record() {
  local stem="${record_key/\//@}" lock run_fd status=0
  lock="$record_dir/$stem@$record_run.lock"
  [[ -d $record_dir ]] || { wait_refused gone; return "$wait_gone"; }
  { exec {run_fd}>>"$lock"; } 2>/dev/null || { wait_refused lock-unopenable; return 1; }
  flock "$run_fd" || { exec {run_fd}>&-; wait_refused flock-failed; return 1; }
  wait_read "$stem" || status=$?
  rm -f -- "$lock"
  exec {run_fd}>&-
  return "$status"
}

verb="${1:-}"
[[ $# -gt 0 ]] && shift
case "$verb" in
  launch) parse "$verb" "$@"; check_common; launch ;;
  present) parse "$verb" "$@"; check_common; check_window; present ;;
  check) [[ $# -eq 0 ]] || bad_invocation "argument=$1"; require_terminal ;;
  reap) [[ $# -eq 0 ]] || bad_invocation "argument=$1"; reap ;;
  wait) parse_wait "$@"; wait_record ;;
  ssh) parse_ssh "$@"; ssh_launch ;;
  ssh-session) parse_ssh "$@"; ssh_session ;;
  ssh-run) parse_ssh_run "$@"; ssh_run ;;
  -h|--help|help) usage; exit 0 ;;
  *) bad_invocation "verb=${verb:-missing}" ;;
esac
