#!/usr/bin/env bash
# vgshell-lock: ask the running shell's lock plugin to lock the session.
#
#   vgshell lock
#       call `lock` on vgs.lock's IPC target and wait for the compositor
#
# It is the route a user script, an idle daemon or a lid-switch bind calls;
# the shortcut, the launcher's Lock row, the plugin's idle watch and its
# before-sleep hook reach the same function inside the shell. The plugin
# answers `ok` once it asked the core for the lock; the compositor answers
# after that, so the command reads the plugin's `status` reply every 100 ms
# for up to 2 s. It prints `ok` once the lock is confirmed (`secure`), and
# refuses when the compositor refused the lock (`refusals` grew), as
# Hyprland does while another lock screen holds the session with
# misc:allow_session_lock_restore off, or never confirmed it:
# docs/decisions/D062-native-lock-and-polkit-plugins.md.
#
# Refusals, each one keyed first line on stderr:
#   vgshell: refused: argument=<arg>              exit 2; lock takes no argument
#   vgshell: refused: shell=not-running ...       exit 69; vgshell pid's refusal
#   vgshell: refused: lock=no-answer pid=<pid>    exit 1; the shell runs but no
#                                              client call answered
#   vgshell: refused: lock=disabled pid=<pid>     exit 1; vgs.lock is disabled
#   vgshell: refused: lock=starting pid=<pid>     exit 1; vgs.lock is not loaded
#                                              after the startup wait
#   vgshell: refused: ipc-judge=failed            exit 70; bin/lib/ipc-reply.sh
#                                              could not classify a reply
#   vgshell: refused: <refusal>                   exit 1; the plugin's own refusal,
#                                              its `refused: ` prefix dropped
#   vgshell: refused: lock=refused-by-compositor  exit 1; the compositor refused
#                                              or ended the lock
#   vgshell: refused: lock=unconfirmed            exit 1; no confirmation in 2 s
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
vgshell="$(dirname -- "$self")/vgshell"
ipc_judge="$(dirname -- "$self")/lib/ipc-reply.sh"

refuse() { # STATUS KEY [DETAIL]
  printf 'vgshell: refused: %s\n' "$2" >&2
  [[ -z ${3:-} ]] || printf '%s\n' "$3" >&2
  exit "$1"
}

[[ $# -eq 0 ]] || refuse 2 "argument=$1" "vgshell lock takes no argument"
# shellcheck source=bin/lib/ipc-reply.sh
source "$ipc_judge" || refuse 1 "library=missing path=$ipc_judge"

pid="$("$vgshell" pid)" || exit $?
# One call on vgs.lock's target: qs prints its own log lines on stdout
# ahead of the reply, so the reply is the last line. Quickshell 0.3.1's
# client exits 0 on its own failures, such as `Target not found.` while
# vgs.lock is disabled, so bin/lib/ipc-reply.sh judges that line, as
# `vgshell ipc` does. Returns 75 for its target-not-found key, 1 for other
# failed calls, and 70 when the judge could not classify the line.
call() { # FUNCTION
  local out reason status=0
  out="$(qs ipc --pid "$pid" call vgs.lock invoke "$1" "" 2>&1)" || return 1
  vgs_ipc_last_line_into "$out"
  reason="$(vgs_ipc_reply_failure "$vgs_ipc_last_line")" || status=$?
  [[ $status != 0 || $reason != target-not-found ]] || return 75
  [[ $status != 0 ]] || return 1
  [[ $status == 1 ]] || return 70
  printf '%s\n' "$vgs_ipc_last_line"
}
# The whole number after `"refusals":` in a status reply, -1 for none.
refusals_of() { [[ $1 =~ \"refusals\":([0-9]+) ]] && echo "${BASH_REMATCH[1]}" || echo -1; }

no_answer() { refuse 1 "lock=no-answer pid=$pid" "the shell did not answer"; }
# After a failed call: its status, 70 for a reply the judge could not
# classify, else no answer.
unanswered() { # STATUS
  [[ $1 != 70 ]] || refuse 70 "ipc-judge=failed" "bin/lib/ipc-reply.sh could not classify vgs.lock's reply"
  no_answer
}

# Registry.listJson reports scanned/config.ready and the effective enabled
# flag; Plugins.builtJson reports service construction. Read those shell
# answers only while the target or its function is missing. listPlugins
# can page its reply; the shared IPC library owns reassembly.
shell_reply() { # FUNCTION
  local reply
  reply="$("$vgshell" ipc call shell "$1" 2>/dev/null)" || no_answer
  if vgs_ipc_paged_id shell "$reply"; then
    vgs_ipc_pages shell_page "$vgs_ipc_paged" || no_answer
    reply="$vgs_ipc_document"
  fi
  printf '%s\n' "$reply"
}
shell_page() { # ID INDEX
  vgs_ipc_page="$("$vgshell" ipc call shell page "$@" 2>/dev/null)"
}

starting_call() { # FUNCTION
  local reply status listing enabled built loaded attempt
  # At most 20 missing-function/target attempts, with 100 ms between them
  # while shell built says the service is still loading (2 s of delays).
  # A built service is retried immediately, without an unconditional sleep.
  for ((attempt = 0; attempt < 20; attempt++)); do
    status=0
    reply="$(call "$1")" || status=$?
    if [[ $status == 0 && $reply != "unknown: $1" ]]; then printf '%s\n' "$reply"; return; fi
    [[ $status == 0 || $status == 75 ]] || unanswered "$status"
    listing="$(shell_reply listPlugins)" || exit $?
    enabled="$(jq -er '
      if (.scanned | type) != "boolean" or (.config.ready | type) != "boolean" or (.plugins | type) != "array" then error("plugin listing")
      elif .scanned and .config.ready and any(.plugins[]; .id == "vgs.lock" and .enabled == false) then "disabled"
      else "loading" end' <<<"$listing")" || no_answer
    [[ $enabled != disabled ]] || refuse 1 "lock=disabled pid=$pid" "vgs.lock is disabled; enable it in the Plugins window"
    built="$(shell_reply built)" || exit $?
    loaded="$(jq -er 'if type != "object" then error("built plugins") else any(.service[]?; .id == "vgs.lock") | tostring end' <<<"$built")" || no_answer
    [[ $loaded == true ]] || sleep 0.1
  done
  refuse 1 "lock=starting pid=$pid" "the shell is still starting, or vgs.lock is not loaded"
}

before="$(starting_call status)" || exit $?
reply="$(starting_call lock)" || exit $?
case "$reply" in
  ok) ;;
  *) refuse 1 "${reply#refused: }" ;;
esac
refusals="$(refusals_of "$before")"
for _ in $(seq 1 20); do
  now="$(call status)" || { status=$?; [[ $status != 70 ]] || unanswered 70; now=""; }
  if [[ $now == *'"secure":true'* ]]; then echo ok; exit 0; fi
  if (( refusals >= 0 )) && (( $(refusals_of "$now") > refusals )); then
    refuse 1 "lock=refused-by-compositor" "Hyprland refused the lock: another lock screen, such as hyprlock, holds the session, and misc:allow_session_lock_restore is off"
  fi
  sleep 0.1
done
refuse 1 "lock=unconfirmed" "the compositor did not confirm the lock within 2 s"
